window._ALL_INSTALLED_PLUGINS = DEFAULT_BUILTIN_PLUGINS.slice();
window.PLUGIN_NAV = DEFAULT_BUILTIN_PLUGINS.filter(function(p){ return p.nav; });
window.PLUGIN_FAB = DEFAULT_BUILTIN_PLUGINS.filter(function(p){ return p.fab && p.fab.length; });
window.PLUGIN_WIDGETS = DEFAULT_BUILTIN_PLUGINS.filter(function(p){ return p.widgets && p.widgets.length; });

// Material icon path if known, else a letter-badge fallback.
function _pluginIconHtml(icon, size, color){
  var name=icon||'extension';
  if(_iconPaths[name])return '<svg viewBox="0 -960 960 960" width="'+size+'" height="'+size+'" fill="'+color+'" style="flex-shrink:0"><path d="'+_iconPaths[name]+'"/></svg>';
  return '<span style="width:'+size+'px;height:'+size+'px;display:inline-flex;align-items:center;justify-content:center;border:1px solid '+color+';border-radius:50%;flex-shrink:0;font-family:\'Space Mono\',monospace;font-size:'+Math.round(size*0.6)+'px;color:'+color+'">'+(name.charAt(0).toUpperCase())+'</span>';
}

async function loadPluginNav(){
  try{
    var r=await fetch(BASE+'/plugins/registry');
    var j=await r.json();
    var plugins=(j&&j.plugins)||[];
    
    // Merge server response with builtins to guarantee all 7 builtins are always present
    var merged = DEFAULT_BUILTIN_PLUGINS.slice();
    plugins.forEach(function(serverP){
      var idx = merged.findIndex(function(m){ return m.id === serverP.id; });
      if(idx !== -1){
        merged[idx] = Object.assign({}, merged[idx], serverP);
        if(!merged[idx].widgets || !merged[idx].widgets.length) merged[idx].widgets = DEFAULT_BUILTIN_PLUGINS[idx].widgets;
        if(!merged[idx].fab || !merged[idx].fab.length) merged[idx].fab = DEFAULT_BUILTIN_PLUGINS[idx].fab;
        if(!merged[idx].nav) merged[idx].nav = DEFAULT_BUILTIN_PLUGINS[idx].nav;
      } else {
        merged.push(serverP);
      }
    });

    window._ALL_INSTALLED_PLUGINS = merged;
    var enabled = merged.filter(function(p){ return p.enabled === true; });
    window.PLUGIN_NAV = enabled.filter(function(p){ return p.nav && pluginFeatureEnabled(p,'nav'); });
    window.PLUGIN_FAB = enabled.filter(function(p){
      return p.fab && p.fab.length && pluginFeatureEnabled(p,'fab') && pluginFabUserEnabled(p.id);
    });
    window.PLUGIN_WIDGETS = enabled.filter(function(p){
      return p.widgets && p.widgets.length && pluginFeatureEnabled(p,'widgets') && pluginWidgetUserVisible(p.id);
    });
  }catch(e){
    window._ALL_INSTALLED_PLUGINS = DEFAULT_BUILTIN_PLUGINS.slice();
    window.PLUGIN_NAV = DEFAULT_BUILTIN_PLUGINS.filter(function(p){ return p.nav; });
    window.PLUGIN_FAB = DEFAULT_BUILTIN_PLUGINS.filter(function(p){ return p.fab && p.fab.length; });
    window.PLUGIN_WIDGETS = DEFAULT_BUILTIN_PLUGINS.filter(function(p){ return p.widgets && p.widgets.length && pluginWidgetUserVisible(p.id); });
  }
  ensurePluginRunners();
  renderPluginWidgets();
}

// Whether a plugin's surface/feature toggle is allowed (absent => allowed by default).
function pluginFeatureEnabled(p, f){
  if(!p.features)return true;
  for(var i=0;i<p.features.length;i++){
    if(p.features[i].id===f)return p.features[i].enabled!==false;
  }
  return true;
}

var _pluginRunnerFrames={};

function ensurePluginRunners(){
  var want={};
  window.PLUGIN_FAB.forEach(function(p){want[p.id]=p;});
  Object.keys(_pluginRunnerFrames).forEach(function(id){
    if(!want[id]){
      var f=_pluginRunnerFrames[id];
      if(f&&f.parentNode)f.parentNode.removeChild(f);
      delete _pluginRunnerFrames[id];
    }
  });
  Object.keys(want).forEach(function(id){
    if(_pluginRunnerFrames[id])return;
    var f=document.createElement('iframe');
    f.id='pluginRun_'+id;
    f.setAttribute('data-plugin','true');
    f.setAttribute('tabindex','-1');
    f.style.setProperty('position','fixed');
    f.style.setProperty('left','-9999px');
    f.style.setProperty('top','0');
    f.style.setProperty('width','1px');
    f.style.setProperty('height','1px');
    f.style.setProperty('visibility','hidden');
    f.src=BASE+'/plugins/'+encodeURIComponent(id)+'/index.html?v07mode=runner';
    _pluginRunnerFrames[id]=f;
    document.body.appendChild(f);
  });
}

function runPluginAction(id, fabEntry){
  if(fabEntry && fabEntry.fn){
    if(typeof window[fabEntry.fn] === 'function'){
      try {
        window[fabEntry.fn](fabEntry.args === undefined ? null : fabEntry.args);
        return;
      } catch(e){}
    }
    var f = _pluginRunnerFrames[id];
    if(f && f.contentWindow && typeof f.contentWindow[fabEntry.fn] === 'function'){
      try {
        f.contentWindow[fabEntry.fn](fabEntry.args === undefined ? null : fabEntry.args);
        return;
      } catch(e){}
    }
  }
  openPluginPage(id);
}
window.v07OpenPlugin = function(args){
  var id = (typeof args === 'string') ? args : (args && args.id ? args.id : 'com.v07.chronosynth');
  openPluginPage(id);
};

var PLUGIN_WIDGETS_ORDER_KEY = 'v07_plugin_widgets_order';
function pluginWidgetsSavedOrder(){
  try{ return JSON.parse(localStorage.getItem(PLUGIN_WIDGETS_ORDER_KEY)||'[]'); }catch(e){ return []; }
}
function pluginWidgetsSaveOrder(ids){
  try{ localStorage.setItem(PLUGIN_WIDGETS_ORDER_KEY, JSON.stringify(ids)); }catch(e){}
}

var _pluginDragEl = null;
var _pluginDragActive = false;
var _pluginDragPointerId = null;
var _pluginJustDragged = false;
var _pluginStartY = 0;

function pluginWidgetReorderDOM(clientY){
  var area = document.getElementById('pluginWidgetsArea');
  if(!area || !_pluginDragEl) return;
  var t = document.elementFromPoint(100, clientY);
  var target = null;
  while(t && t !== area){
    if(t.getAttribute && t.getAttribute('data-widget') && t !== _pluginDragEl){
      target = t;
      break;
    }
    t = t.parentNode;
  }
  if(!target) return;
  var rect = target.getBoundingClientRect();
  if(typeof animateFLIP === 'function'){
    animateFLIP(area, _pluginDragEl, function(){
      if(clientY > rect.top + rect.height / 2){
        area.insertBefore(_pluginDragEl, target.nextSibling);
      } else {
        area.insertBefore(_pluginDragEl, target);
      }
    });
  } else {
    if(clientY > rect.top + rect.height / 2){
      area.insertBefore(_pluginDragEl, target.nextSibling);
    } else {
      area.insertBefore(_pluginDragEl, target);
    }
  }
}

function pluginWidgetSaveCurrentOrder(){
  var area = document.getElementById('pluginWidgetsArea');
  if(area){
    var ids = [];
    area.querySelectorAll('[data-widget]').forEach(function(el){
      var wid = el.getAttribute('data-widget');
      if(wid && ids.indexOf(wid) === -1) ids.push(wid);
    });
    pluginWidgetsSaveOrder(ids);
  }
}

function pluginWidgetTouchStart(e){
  try{ window.getSelection()?.removeAllRanges(); }catch(err){}
  var card = e.currentTarget.closest('[data-widget]');
  if(!card) return;
  var touch = e.touches[0];
  if(!touch) return;
  e.preventDefault();
  e.stopPropagation();
  _pluginDragEl = card;
  _pluginDragActive = true;
  _pluginJustDragged = false;
  _pluginStartY = touch.clientY;
  card.classList.add('plugin-widget-dragging');
  document.body.style.userSelect = 'none';

  function onTouchMove(ev){
    if(!_pluginDragActive || !_pluginDragEl) return;
    var t0 = ev.touches[0];
    if(!t0) return;
    if(ev.cancelable) ev.preventDefault();
    if(Math.abs(t0.clientY - _pluginStartY) > 5) _pluginJustDragged = true;
    pluginWidgetReorderDOM(t0.clientY);
  }

  function onTouchEnd(ev){
    window.removeEventListener('touchmove', onTouchMove);
    window.removeEventListener('touchend', onTouchEnd);
    window.removeEventListener('touchcancel', onTouchEnd);
    document.body.style.userSelect = '';
    _pluginDragActive = false;
    if(_pluginDragEl) _pluginDragEl.classList.remove('plugin-widget-dragging');
    _pluginDragEl = null;
    pluginWidgetSaveCurrentOrder();
    setTimeout(function(){ _pluginJustDragged = false; }, 200);
  }

  window.addEventListener('touchmove', onTouchMove, {passive: false});
  window.addEventListener('touchend', onTouchEnd, {passive: false});
  window.addEventListener('touchcancel', onTouchEnd, {passive: false});
}

function pluginWidgetOnPointerDown(e){
  try{ window.getSelection()?.removeAllRanges(); }catch(err){}
  var card = e.currentTarget.closest('[data-widget]');
  if(!card) return;
  e.preventDefault();
  e.stopPropagation();
  _pluginDragEl = card;
  _pluginDragActive = true;
  _pluginDragPointerId = e.pointerId;
  _pluginJustDragged = false;
  _pluginStartY = e.clientY;
  card.classList.add('plugin-widget-dragging');
  document.body.style.userSelect = 'none';

  function onPointerMove(ev){
    if(!_pluginDragActive || !_pluginDragEl) return;
    if(ev.pointerId !== _pluginDragPointerId) return;
    if(ev.cancelable) ev.preventDefault();
    if(Math.abs(ev.clientY - _pluginStartY) > 5) _pluginJustDragged = true;
    pluginWidgetReorderDOM(ev.clientY);
  }

  function onPointerUp(ev){
    if(ev.pointerId !== _pluginDragPointerId) return;
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('pointercancel', onPointerUp);
    document.body.style.userSelect = '';
    _pluginDragActive = false;
    _pluginDragPointerId = null;
    if(_pluginDragEl) _pluginDragEl.classList.remove('plugin-widget-dragging');
    _pluginDragEl = null;
    pluginWidgetSaveCurrentOrder();
    setTimeout(function(){ _pluginJustDragged = false; }, 200);
  }

  window.addEventListener('pointermove', onPointerMove, {passive: false});
  window.addEventListener('pointerup', onPointerUp, {passive: false});
  window.addEventListener('pointercancel', onPointerUp, {passive: false});
}

function pluginWidgetCardClicked(e, pluginId){
  if(_pluginJustDragged || _pluginDragActive) return;
  if(e.target && e.target.closest('.plugin-widget-drag-handle')) return;
  openPluginPage(pluginId);
}

function openAddWidgetModal(){
  var modal = document.getElementById('pluginAddWidgetModal');
  if(!modal) return;
  renderAddWidgetModalContent();
  modal.style.display = 'flex';
}

function closeAddWidgetModal(){
  var modal = document.getElementById('pluginAddWidgetModal');
  if(modal) modal.style.display = 'none';
  renderPluginWidgets();
}

function renderAddWidgetModalContent(){
  var container = document.getElementById('pluginAddWidgetList');
  if(!container) return;
  var all = window._ALL_INSTALLED_PLUGINS || [];
  var plugins = all.filter(function(p){
    return p.widgets && p.widgets.length && p.enabled !== false;
  });
  if(!plugins.length){
    container.innerHTML = '<div style="font-size:12px;color:var(--pencil-muted);text-align:center;padding:20px">No installed plugins with widgets found.</div>';
    return;
  }
  var html = '';
  plugins.forEach(function(p){
    var s = getPluginSettings(p.id);
    var defWidget = p.widgets[0] || {};
    var defSize = normalizeWidgetSize(defWidget.defaultSize || 'medium');
    var curSize = normalizeWidgetSize(s.widgetSize || defSize);
    var col = defWidget.color || (p.nav && p.nav.color) || 'var(--crayon-blue)';
    var icon = defWidget.icon || (p.nav && p.nav.icon) || 'extension';
    var dispName = getPluginDisplayName(p);

    html += '<div style="border:1.5px solid var(--paper-border);border-left:3px solid ' + col + ';background:var(--paper-surface);border-radius:var(--radius);padding:10px 12px;margin-bottom:10px">';
    html += '  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">';
    html += '    <div style="display:flex;align-items:center;gap:6px">';
    html +=        _pluginIconHtml(icon, 16, col);
    html += '      <span style="font-family:\'Space Mono\',monospace;font-size:11px;font-weight:700;color:' + col + ';text-transform:uppercase">' + dispName + '</span>';
    html += '    </div>';
    html += '    <span class="widget-cur-size-tag" style="font-size:9.5px;color:var(--pencil-muted);font-family:\'Space Mono\',monospace">' + (curSize === 'hidden' ? 'OFF' : curSize.toUpperCase()) + '</span>';
    html += '  </div>';
    html += '  <div style="font-size:11px;color:var(--ink-text);margin-bottom:8px;line-height:1.3">' + (p.description || '') + '</div>';
    html += '  <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center">';
    var sizes = ['compact', 'small', 'medium', 'large', 'hidden'];
    var labels = { compact: 'COMPACT', small: 'SMALL', medium: 'MEDIUM', large: 'LARGE', hidden: 'OFF' };
    sizes.forEach(function(sz){
      var isSel = (curSize === sz);
      html += '    <button class="chip' + (isSel ? ' selected' : '') + '" onclick="setPluginWidgetFromModal(\'' + p.id + '\', \'' + sz + '\', this)" style="font-size:10px;padding:4px 8px">' + labels[sz] + '</button>';
    });
    html += '  </div>';
    html += '</div>';
  });
  container.innerHTML = html;
}

function setPluginWidgetFromModal(pluginId, size, clickedBtn){
  var s = getPluginSettings(pluginId);
  s.widgetSize = size;
  savePluginSettings(pluginId, s);
  
  if(clickedBtn && clickedBtn.parentNode){
    clickedBtn.parentNode.querySelectorAll('.chip').forEach(function(btn){
      btn.classList.remove('selected');
    });
    clickedBtn.classList.add('selected');
    var card = clickedBtn.closest('div[style*="border-left"]');
    var statusSpan = card ? card.querySelector('.widget-cur-size-tag') : null;
    if(statusSpan) statusSpan.textContent = (size === 'hidden' ? 'OFF' : size.toUpperCase());
  }
  
  loadPluginNav();
  var all = window._ALL_INSTALLED_PLUGINS || [];
  var p = all.find(function(x){ return x.id === pluginId; });
  var name = p ? getPluginDisplayName(p) : pluginId;
  toast(name + (size === 'hidden' ? ' widget hidden' : ' widget set to ' + size.toUpperCase()));
}

function renderPluginWidgets(){
  var section = document.getElementById('pluginWidgetsSection');
  var area = document.getElementById('pluginWidgetsArea');
  if(!section || !area) return;

  var all = window._ALL_INSTALLED_PLUGINS || [];
  var candidatePlugins = all.filter(function(p){
    return p.widgets && p.widgets.length && p.enabled !== false;
  });
  if(!candidatePlugins.length && (!window.PLUGIN_WIDGETS || !window.PLUGIN_WIDGETS.length)){
    section.style.display = 'block';
    area.innerHTML = '<div style="border:1.5px dashed var(--paper-line);border-radius:var(--radius);padding:18px 14px;text-align:center;background:rgba(0,0,0,0.02)">' +
      '<div style="font-family:\'Space Mono\',monospace;font-size:11px;font-weight:700;color:var(--pencil-muted);margin-bottom:6px">NO PLUGIN WIDGETS</div>' +
      '<button class="btn btn-wax" onclick="openAddWidgetModal()" style="font-size:11px;padding:6px 14px">+ ADD WIDGETS</button>' +
      '</div>';
    return;
  }

  // Sort according to saved order
  var savedOrder = pluginWidgetsSavedOrder();
  if(savedOrder && savedOrder.length){
    window.PLUGIN_WIDGETS.sort(function(a, b){
      var idxA = savedOrder.indexOf(a.id);
      var idxB = savedOrder.indexOf(b.id);
      if(idxA === -1) idxA = 999;
      if(idxB === -1) idxB = 999;
      return idxA - idxB;
    });
  }

  var visibleCount = 0;
  var h = '';
  window.PLUGIN_WIDGETS.forEach(function(p){
    var pSettings = getPluginSettings(p.id);
    var rawSize = pSettings.widgetSize || 'medium';
    var userSize = normalizeWidgetSize(rawSize);
    if(userSize === 'hidden') return;
    visibleCount++;

    var w = (p.widgets && p.widgets.find(function(item){
      return item.defaultSize === userSize || (item.supportedSizes && item.supportedSizes.indexOf(userSize) !== -1);
    })) || (p.widgets && p.widgets[0]) || {};

    var col = w.color || (p.nav && p.nav.color) || 'var(--crayon-blue)';
    var lbl = w.title || getPluginDisplayName(p).toUpperCase();
    var icon = w.icon || (p.nav && p.nav.icon) || 'extension';
    var rawPath = w.path || 'widget.html';
    var basePath = rawPath.split('?')[0];
    var baseQuery = (rawPath.indexOf('?') !== -1) ? rawPath.substring(rawPath.indexOf('?') + 1) : '';

    var sizeClass = 'size-' + userSize;
    var widgetHeight = (userSize === 'compact' || userSize === '1*1') ? '72px' :
                       (userSize === 'small' || userSize === '2*1') ? '110px' :
                       (userSize === 'medium' || userSize === '3*1') ? '170px' : '250px';

    h += '<div class="plugin-widget-card ' + sizeClass + '" data-widget="' + p.id + '" onclick="pluginWidgetCardClicked(event, \'' + p.id + '\')" style="border:1.5px solid var(--paper-border);border-left:3px solid ' + col + ';background:var(--paper-surface);border-radius:var(--radius);overflow:hidden;margin-bottom:10px">';
    h += '  <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-bottom:1px solid var(--paper-line);background:var(--paper-surface);user-select:none">';
    h += '    <div style="display:flex;align-items:center;gap:6px;min-width:0;flex:1">';
    h +=        _pluginIconHtml(icon, 14, col);
    h += '      <span class="widget-title-text" style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:' + col + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + lbl + '</span>';
    h += '    </div>';
    h += '    <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">';
    h += '      <span class="widget-open-label" style="display:inline-flex;align-items:center;gap:2px;font-family:\'Space Mono\',monospace;font-size:9px;font-weight:600;color:var(--pencil-muted);letter-spacing:0.06em">OPEN <svg viewBox="0 -960 960 960" width="12" height="12" fill="currentColor" style="display:block"><path d="m321-80-71-71 329-329-329-329 71-71 400 400L321-80Z"/></svg></span>';
    h += '      <span class="plugin-widget-drag-handle" style="display:flex;align-items:center;justify-content:center;touch-action:none;cursor:grab;padding:2px 4px;color:var(--pencil-muted);border-radius:4px" ontouchstart="pluginWidgetTouchStart(event)" onpointerdown="pluginWidgetOnPointerDown(event)" title="Drag to reorder">';
    h += '        <svg viewBox="0 -960 960 960" width="15" height="15" fill="currentColor"><path d="M360-160q-33 0-56.5-23.5T280-240q0-33 23.5-56.5T360-320q33 0 56.5 23.5T440-240q0 33-23.5 56.5T360-160Zm240 0q-33 0-56.5-23.5T520-240q0-33 23.5-56.5T600-320q33 0 56.5 23.5T680-240q0 33-23.5 56.5T600-160Zm-240-240q-33 0-56.5-23.5T280-480q0-33 23.5-56.5T360-560q33 0 56.5 23.5T440-480q0 33-23.5 56.5T360-400Zm240 0q-33 0-56.5-23.5T520-480q0-33 23.5-56.5T600-560q33 0 56.5 23.5T680-480q0 33-23.5 56.5T600-400Zm-240-240q-33 0-56.5-23.5T280-720q0-33 23.5-56.5T360-800q33 0 56.5 23.5T440-720q0 33-23.5 56.5T360-640Zm240 0q-33 0-56.5-23.5T520-720q0-33 23.5-56.5T600-800q33 0 56.5 23.5T680-720q0 33-23.5 56.5T600-640Z"/></svg>';
    h += '      </span>';
    h += '    </div>';
    h += '  </div>';
    var srcUrl = (BASE || '') + '/plugins/' + encodeURIComponent(p.id) + '/' + basePath + '?size=' + encodeURIComponent(userSize) + (baseQuery ? '&' + baseQuery : '');
    h += '  <iframe class="plugin-widget-frame" src="' + srcUrl + '" style="width:100%;max-width:100%;border:none;background:var(--paper-surface);display:block;pointer-events:auto;height:' + widgetHeight + '"></iframe>';
    h += '</div>';
  });

  if(visibleCount === 0){
    section.style.display = 'block';
    area.innerHTML = '<div style="border:1.5px dashed var(--paper-line);border-radius:var(--radius);padding:18px 14px;text-align:center;background:rgba(0,0,0,0.02)">' +
      '<div style="font-family:\'Space Mono\',monospace;font-size:11px;font-weight:700;color:var(--pencil-muted);margin-bottom:6px">NO WIDGETS PINNED TO HOME</div>' +
      '<div style="font-size:11px;color:var(--pencil-muted);margin-bottom:12px">Customize your daily dashboard with widgets from your plugins.</div>' +
      '<button class="btn btn-wax" onclick="openAddWidgetModal()" style="font-size:11px;padding:6px 14px">+ PIN WIDGETS TO HOME</button>' +
      '</div>';
  } else {
    section.style.display = 'block';
    area.innerHTML = h;
    sizePluginWidgets();
  }
}

function sizePluginWidgets(){
  if(currentTab !== 'home') return;
  var isLight = document.documentElement.dataset.theme === 'light';
  var frames = document.querySelectorAll('.plugin-widget-frame');
  for(var i = 0; i < frames.length; i++){
    try{
      var w = frames[i].contentWindow;
      if(w && w.document && w.document.body){
        if(isLight) w.document.documentElement.setAttribute('data-theme', 'light');
        else w.document.documentElement.removeAttribute('data-theme');
        var card = frames[i].closest('.plugin-widget-card');
        if(card && (card.classList.contains('size-compact') || card.classList.contains('size-small') || card.classList.contains('size-medium') || card.classList.contains('size-large') || card.classList.contains('size-1-1') || card.classList.contains('size-2-1') || card.classList.contains('size-3-1') || card.classList.contains('size-4-1') || card.classList.contains('size-4-2'))){
          continue;
        }
        var h = w.document.body.scrollHeight;
        if(h > 40) frames[i].style.height = h + 'px';
      }
    }catch(e){}
  }
}

function openPluginPage(id){
  setNavTabActive('toolkit');
  document.getElementById('mainFab').style.display='none';
  _pushOv();
  var all = window._ALL_INSTALLED_PLUGINS || [];
  var p = all.find(function(x){ return x.id === id; });
  if(!p) p = (window.PLUGIN_WIDGETS || []).find(function(x){ return x.id === id; });
  var titleText = p ? p.name.toUpperCase() : id.replace(/^com\.v07\./, '').toUpperCase();
  var titleEl = document.getElementById('pluginFrameTitle');
  if(titleEl) titleEl.textContent = titleText;

  var frame=document.getElementById('pluginFrame');
  frame.src=BASE+'/plugins/'+encodeURIComponent(id)+'/index.html';
  frame.onload = function(){
    try {
      var isLight = document.documentElement.dataset.theme === 'light';
      if(frame.contentDocument && frame.contentDocument.documentElement){
        if(isLight) frame.contentDocument.documentElement.setAttribute('data-theme', 'light');
        else frame.contentDocument.documentElement.removeAttribute('data-theme');
      }
    }catch(e){}
  };
  _activePluginId=id;
  var el=document.getElementById('pluginFramePage');
  el.scrollTop=0;el.classList.add('show');
}
function closePluginPage(){
  document.getElementById('mainFab').style.display='none';
  var frame=document.getElementById('pluginFrame');
  frame.src='about:blank';
  _activePluginId=null;
  document.getElementById('pluginFramePage').classList.remove('show');
  var logDash = document.getElementById('logDashboardPage');
  if(logDash){
    logDash.classList.add('show');
    setNavTabActive('toolkit');
  } else {
    setNavTabActive('home');
  }
}

// ─── Plugin Settings Engine (The 5 Pillars) ─────────────────────────────────
var _activePluginSettingsMeta = null;
var _tempPluginSettings = {};

function getPluginSettings(id){
  try {
    return JSON.parse(localStorage.getItem('v07_plugin_settings_' + id) || '{}');
  } catch(e){ return {}; }
}

function savePluginSettings(id, s){
  try {
    localStorage.setItem('v07_plugin_settings_' + id, JSON.stringify(s));
  } catch(e){}
}

function normalizeWidgetSize(s){
  if(!s) return 'medium';
  if(s === 'compact' || s === '1*1') return 'compact';
  if(s === 'small' || s === '2*1') return 'small';
  if(s === 'medium' || s === '3*1') return 'medium';
  if(s === 'large' || s === '4*2' || s === '4*1') return 'large';
  if(s === 'hidden' || s === 'off') return 'hidden';
  return s;
}

function pluginFabUserEnabled(id){
  var all = window._ALL_INSTALLED_PLUGINS || [];
  var p = all.find(function(x){ return x.id === id; });
  if(!p) p = (window.PLUGIN_WIDGETS || []).find(function(x){ return x.id === id; });
  var hasFab = !!(p && p.fab && p.fab.length);
  if(!hasFab) return false;
  var s = getPluginSettings(id);
  return s.fabEnabled !== false;
}

function pluginWidgetUserVisible(id){
  var s = getPluginSettings(id);
  var sz = normalizeWidgetSize(s.widgetSize);
  return sz !== 'hidden';
}

function openPluginSettings(id){
  var modal = document.getElementById('pluginSettingsModal');
  if(!modal) return;

  var all = window._ALL_INSTALLED_PLUGINS || [];
  var p = all.find(function(x){ return x.id === id; });
  if(!p){
    p = (window.PLUGIN_WIDGETS || []).find(function(x){ return x.id === id; });
  }
  if(!p) p = { id: id, name: id, version: '1.0.0', author: 'Prabal' };
  _activePluginSettingsMeta = p;

  var saved = getPluginSettings(id);
  var defWidget = (p.widgets && p.widgets[0]) || {};
  var defNotif = p.notifications || {};
  var hasFab = !!(p.fab && p.fab.length);
  var defSize = normalizeWidgetSize(defWidget.defaultSize || 'medium');
  var currentSize = normalizeWidgetSize(saved.widgetSize || defSize);

  _tempPluginSettings = {
    widgetSize: currentSize,
    fabEnabled: hasFab ? (saved.fabEnabled !== false) : false,
    notifEnabled: saved.notifEnabled !== undefined ? saved.notifEnabled : true,
    notifTime: saved.notifTime || defNotif.defaultTime || '09:00'
  };

  // Populate Header
  var col = (defWidget.color) || (p.nav && p.nav.color) || 'var(--primary)';
  var icon = (defWidget.icon) || (p.nav && p.nav.icon) || 'extension';
  document.getElementById('psmIcon').innerHTML = _pluginIconHtml(icon, 18, col);
  document.getElementById('psmTitle').textContent = getPluginDisplayName(p).toUpperCase();
  document.getElementById('psmMeta').textContent = 'v' + (p.version || '1.0.0') + (p.author ? ' • by ' + p.author : '');

  // Section 1: Widget Size
  updatePsmSizePills(_tempPluginSettings.widgetSize);

  // Section 2: FAB
  var fabRow = (p.fab && p.fab[0]);
  var fabLabel = document.getElementById('psmFabLabel');
  var fabOnBtn = document.getElementById('psmFabOn');
  var fabOffBtn = document.getElementById('psmFabOff');
  if(!hasFab){
    if(fabLabel) fabLabel.textContent = 'Show in FAB Menu (No Actions)';
    if(fabOnBtn) fabOnBtn.style.display = 'none';
    if(fabOffBtn){
      fabOffBtn.style.display = 'inline-block';
      fabOffBtn.classList.add('selected');
    }
    _tempPluginSettings.fabEnabled = false;
  } else {
    if(fabOnBtn) fabOnBtn.style.display = 'inline-block';
    if(fabOffBtn) fabOffBtn.style.display = 'inline-block';
    if(fabLabel) fabLabel.textContent = fabRow && fabRow.label ? ('FAB: ' + fabRow.label) : 'Show in FAB Menu';
    updatePsmFabPills(_tempPluginSettings.fabEnabled);
  }

  // Section 3: Notifications
  var notifSection = document.getElementById('psmNotifSection');
  if(defNotif.supported !== false || (p.permissions && p.permissions.indexOf('notification') !== -1)){
    notifSection.style.display = 'block';
    updatePsmNotifPills(_tempPluginSettings.notifEnabled);
    document.getElementById('psmNotifTime').value = _tempPluginSettings.notifTime;
  } else {
    notifSection.style.display = 'none';
  }

  // Section 4: Plugin-Specific Settings
  var customFrame = document.getElementById('psmSettingsFrame');
  var noSettingsMsg = document.getElementById('psmNoSettingsMsg');
  var openCustomBtn = document.getElementById('psmOpenCustomBtn');
  var hasSettings = p.settings || (p.entry && p.entry !== 'index.html');

  if(hasSettings){
    customFrame.style.display = 'block';
    noSettingsMsg.style.display = 'none';
    openCustomBtn.style.display = 'inline-block';
    customFrame.src = BASE + '/plugins/' + encodeURIComponent(p.id) + '/' + encodeURIComponent(p.settings || 'settings.html');
  } else {
    customFrame.style.display = 'none';
    noSettingsMsg.style.display = 'inline';
    openCustomBtn.style.display = 'none';
  }

  modal.style.display = 'flex';
}

function closePluginSettings(){
  var modal = document.getElementById('pluginSettingsModal');
  if(modal) modal.style.display = 'none';
  var customFrame = document.getElementById('psmSettingsFrame');
  if(customFrame) customFrame.src = 'about:blank';
  _activePluginSettingsMeta = null;
}

function setPluginWidgetSizeChoice(size){
  var norm = normalizeWidgetSize(size);
  _tempPluginSettings.widgetSize = norm;
  updatePsmSizePills(norm);
}

function updatePsmSizePills(size){
  var norm = normalizeWidgetSize(size);
  document.querySelectorAll('#psmSizePills .chip').forEach(function(btn){
    var bSize = normalizeWidgetSize(btn.getAttribute('data-size'));
    btn.classList.toggle('selected', bSize === norm);
  });
}

function setPluginFabChoice(enabled){
  _tempPluginSettings.fabEnabled = enabled;
  updatePsmFabPills(enabled);
}

function updatePsmFabPills(enabled){
  var onBtn = document.getElementById('psmFabOn');
  var offBtn = document.getElementById('psmFabOff');
  if(onBtn) onBtn.classList.toggle('selected', enabled === true);
  if(offBtn) offBtn.classList.toggle('selected', enabled === false);
}

function setPluginNotifChoice(enabled){
  _tempPluginSettings.notifEnabled = enabled;
  updatePsmNotifPills(enabled);
}

function updatePsmNotifPills(enabled){
  var onBtn = document.getElementById('psmNotifOn');
  var offBtn = document.getElementById('psmNotifOff');
  if(onBtn) onBtn.classList.toggle('selected', enabled === true);
  if(offBtn) offBtn.classList.toggle('selected', enabled === false);
  var timeRow = document.getElementById('psmNotifTimeRow');
  if(timeRow) timeRow.style.opacity = enabled ? '1' : '0.4';
}

function testPluginNotification(){
  var p = _activePluginSettingsMeta;
  if(!p) return;
  if(!window.AndroidV07 || !AndroidV07.call){
    toast('Notification bridge unavailable');
    return;
  }
  var notif = p.notifications || {};
  var title = notif.title || (p.name + ' Notification');
  var body = notif.body || ('Active test alert from ' + p.name);
  try {
    var res = JSON.parse(AndroidV07.call('scheduleReminder', JSON.stringify({
      pluginId: p.id,
      title: title,
      body: body,
      delayMs: 0,
      id: 'test_' + Date.now()
    })));
    if(res && res.ok !== false) toast('Test notification sent');
    else toast('Notification: ' + ((res && res.error) || 'Sent'));
  } catch(e){
    toast('Test notification sent');
  }
}

function copyCompanionUrl(){
  var url = window.location.origin + '/companion.html';
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(url).then(function(){ toast('Companion link copied'); });
  } else {
    try {
      var ta = document.createElement('textarea');
      ta.value = url;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      toast('Companion link copied');
    } catch(e){
      toast('URL: ' + url);
    }
  }
}

function pinHomeScreenWidget(widgetType){
  var type = widgetType || (document.getElementById('homeWidgetTypeSelect') ? document.getElementById('homeWidgetTypeSelect').value : '');
  if(window.AndroidV07 && AndroidV07.call){
    if(!type){
      try { AndroidV07.call('openWidgetChooser', '{}'); } catch(e){}
      return;
    }
    try {
      var res = JSON.parse(AndroidV07.call('pinHomeScreenWidget', JSON.stringify({ widgetType: type })));
      if(res && res.ok){
        toast('Pinning ' + type.toUpperCase() + ' widget to Home Screen');
      } else {
        AndroidV07.call('openWidgetChooser', '{}');
      }
    } catch(e){
      try { AndroidV07.call('openWidgetChooser', '{}'); } catch(err){ toast('Widget pinning opened'); }
    }
  } else {
    toast('Android widget pinning is only available inside the Android app');
  }
}

