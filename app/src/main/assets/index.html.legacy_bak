<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="/manifest.json">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" media="none" onload="this.media='all'">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300..600,0..1&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              brand: {
                teal: "#2E7D6A",
                "teal-light": "#E6F4F1",
                mint: "#3F9A83",
                cedar: "#8C5E58",
                "cedar-light": "#FAF0EE",
                "cedar-border": "#EADCDA",
                slate: "#182230",
                subslate: "#5B6A78",
                canvas: "#F4F7F5",
                card: "#FFFFFF",
                border: "#DDE7E2",
              }
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            },
            boxShadow: {
              'soft': '0 8px 24px rgba(30, 45, 40, 0.05)',
              'card': '0 12px 30px rgba(30, 45, 40, 0.04)',
              'glow': '0 8px 20px rgba(46, 125, 106, 0.22)',
              'nav': '0 12px 36px rgba(24, 34, 48, 0.08)',
            },
            borderRadius: {
              '2xl': '1.25rem',
              '3xl': '1.75rem',
              '4xl': '2.25rem',
            }
          }
        }
      }
    };
</script>
<title>Sarah's Calm Space</title>
<style>
@font-face{font-family:'Bricolage';src:url('fonts/BricolageGrotesque-Bold.ttf') format('truetype');font-weight:700;font-style:normal;font-display:swap}
@font-face{font-family:'Bricolage';src:url('fonts/BricolageGrotesque-ExtraBold.ttf') format('truetype');font-weight:800;font-style:normal;font-display:swap}
@font-face{font-family:'GSans';src:url('fonts/GeneralSans-Regular.ttf') format('truetype');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'GSans';src:url('fonts/GeneralSans-Medium.ttf') format('truetype');font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:'GSans';src:url('fonts/GeneralSans-SemiBold.ttf') format('truetype');font-weight:600;font-style:normal;font-display:swap}
@font-face{font-family:'Mono';src:url('fonts/JetBrainsMono-Regular.ttf') format('truetype');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Mono';src:url('fonts/JetBrainsMono-Medium.ttf') format('truetype');font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:'Mono';src:url('fonts/JetBrainsMono-SemiBold.ttf') format('truetype');font-weight:600;font-style:normal;font-display:swap}
@font-face{font-family:'Marcellus';src:url('fonts/Marcellus-Regular.ttf') format('truetype');font-weight:400;font-style:normal;font-display:swap}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
*:focus{outline:none}
*:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
button,a,.btn,.chip,.stat,.card,.cl-item,.kb-card,.fab,.cmd-palette-row{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
input,textarea,select,[contenteditable="true"]{-webkit-user-select:text;user-select:text;-webkit-touch-callout:default}
:root{
  --brand-teal:#2E7D6A;
  --brand-teal-light:#E6F4F1;
  --brand-mint:#3F9A83;
  --brand-cedar:#8C5E58;
  --brand-cedar-light:#FAF0EE;
  --brand-cedar-border:#EADCDA;
  --brand-slate:#182230;
  --brand-subslate:#5B6A78;
  --brand-canvas:#F4F7F5;
  --brand-card:#FFFFFF;
  --brand-border:#DDE7E2;
  --paper-bg:#F4F7F5;
  --paper-surface:#FFFFFF;
  --paper-surface-hover:#E6F4F1;
  --paper-line:#E8EFEB;
  --paper-border:#DDE7E2;
  --ink-text:#182230;
  --pencil-text:#5B6A78;
  --pencil-muted:#8C98A4;
  --crayon-blue:#2E7D6A;
  --crayon-green:#3F9A83;
  --crayon-amber:#8C5E58;
  --crayon-red:#C53030;
  --crayon-purple:#2E7D6A;
  --crayon-yellow:#FAF0EE;
  --bg:#F4F7F5;
  --surface:#FFFFFF;
  --surface-container:#F4F7F5;
  --surface-container-low:#FFFFFF;
  --surface-container-high:#E6F4F1;
  --surface-container-highest:#E8EFEB;
  --surface-primary:#FFFFFF;
  --card:#FFFFFF;
  --card2:#F8FAF9;
  --card-bg:#FFFFFF;
  --card-border:#DDE7E2;
  --card-shadow:0 8px 24px rgba(30, 45, 40, 0.04);
  --accent:#2E7D6A;
  --accent-container:#E6F4F1;
  --accent2:#3F9A83;
  --primary:#2E7D6A;
  --primary-container:#E6F4F1;
  --on-primary:#FFFFFF;
  --secondary:#8C5E58;
  --secondary-container:#FAF0EE;
  --text:#182230;
  --text-inactive:#5B6A78;
  --muted:#8C98A4;
  --red:#C53030;
  --green:#2E7D6A;
  --yellow:#8C5E58;
  --border:#DDE7E2;
  --border-subtle:rgba(0, 0, 0, 0.05);
  --divider:#E8EFEB;
  --radius:1.25rem;
  --gap:12px;
  --nav-dock-bg:rgba(255, 255, 255, 0.96);
  --nav-dock-border:#DDE7E2;
  --nav-dock-shadow:0 12px 32px rgba(24, 34, 48, 0.08);
  --appbar-bg:rgba(244, 247, 245, 0.92);
  --appbar-border:#DDE7E2;
}
:root[data-theme="light"]{
  --brand-teal:#2E7D6A;
  --brand-teal-light:#E6F4F1;
  --brand-mint:#3F9A83;
  --brand-cedar:#8C5E58;
  --brand-cedar-light:#FAF0EE;
