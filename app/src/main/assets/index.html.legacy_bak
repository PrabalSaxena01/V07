    <!-- Section 4: Plugin-Specific Options -->
    <div class="kb-settings-group" style="padding:10px;margin-bottom:0" id="psmCustomSection">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
