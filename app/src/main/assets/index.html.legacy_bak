        <img src="v07_logo.png" style="width:20px;height:20px;border-radius:5px;object-fit:contain" alt="Home">
        <span style="font-family:'JetBrains Mono','Mono',monospace;font-weight:600;font-size:16px;color:var(--primary)">&#x1F3F7; MANAGE_TAGS</span>
