  --border-subtle:rgba(0, 0, 0, 0.05);
  --divider:#E8EFEB;
  --radius:1.25rem;
  --gap:12px;
  --nav-dock-bg:rgba(255, 255, 255, 0.96);
  --nav-dock-border:#DDE7E2;
  --nav-dock-shadow:0 12px 32px rgba(24, 34, 48, 0.08);
  --appbar-bg:rgba(244, 247, 245, 0.92);
  --appbar-border:#DDE7E2;
}
:root[data-theme="dark"]{
  --brand-teal:#38BDF8;
  --brand-teal-light:rgba(56, 189, 248, 0.15);
  --brand-mint:#4DE086;
  --brand-cedar:#CCBEFF;
  --brand-cedar-light:rgba(204, 190, 255, 0.15);
  --brand-cedar-border:#33353A;
  --brand-slate:#F1F5F9;
  --brand-subslate:#94A3B8;
  --brand-canvas:#111318;
  --brand-card:#151821;
  --brand-border:#262C3E;
  --paper-bg:#111318;
  --paper-surface:#151821;
  --paper-surface-hover:#1D2230;
  --paper-line:#262C3E;
  --paper-border:#262C3E;
  --ink-text:#F1F5F9;
  --pencil-text:#94A3B8;
  --pencil-muted:#64748B;
  --crayon-blue:#38BDF8;
  --crayon-green:#4DE086;
  --crayon-amber:#FFC176;
  --crayon-red:#EF4444;
  --crayon-purple:#CCBEFF;
  --crayon-yellow:#FFB84D;
  --bg:#111318;
  --surface:#151821;
  --surface-container:#1A1B21;
  --surface-container-low:#111318;
  --surface-container-high:#1D2230;
  --surface-container-highest:#262C3E;
  --surface-primary:#151821;
  --card:#151821;
  --card2:#1D2230;
  --card-bg:#151821;
  --card-border:#262C3E;
  --card-shadow:0 8px 24px rgba(0, 0, 0, 0.35);
  --accent:#38BDF8;
  --accent-container:#004965;
  --accent2:#4DE086;
  --primary:#38BDF8;
  --primary-container:#004965;
  --on-primary:#00354A;
  --secondary:#CCBEFF;
  --secondary-container:#4D20BC;
  --text:#F1F5F9;
  --text-inactive:#94A3B8;
  --muted:#64748B;
  --red:#EF4444;
  --green:#4DE086;
  --yellow:#FFB84D;
  --border:#262C3E;
  --border-subtle:rgba(255, 255, 255, 0.08);
  --divider:#262C3E;
  --radius:1.25rem;
  --gap:12px;
  --nav-dock-bg:rgba(21, 24, 33, 0.94);
  --nav-dock-border:#262C3E;
  --nav-dock-shadow:0 12px 32px rgba(0, 0, 0, 0.45);
  --appbar-bg:rgba(17, 19, 24, 0.92);
  --appbar-border:#262C3E;
}
.btn-wax{background:var(--primary);color:#fff;font-weight:600;border-radius:9999px;border:none;box-shadow:0 4px 12px rgba(46,125,106,0.25);cursor:pointer;transition:transform 0.08s ease,box-shadow 0.08s ease;display:inline-flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-size:12px;padding:8px 16px}
.btn-wax:active{transform:scale(0.96);box-shadow:0 2px 6px rgba(46,125,106,0.2)}
.btn-wax-amber{background:var(--secondary);box-shadow:0 4px 12px rgba(140,94,88,0.25)}
.btn-wax-green{background:var(--green)}
.btn-wax-red{background:var(--red);box-shadow:0 4px 12px rgba(197,48,48,0.25)}
.btn-pencil{background:transparent;color:var(--text);border:1px solid var(--border);border-radius:9999px;padding:6px 14px;font-size:12px;font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;transition:background 0.15s,border-color 0.15s;display:inline-flex;align-items:center;justify-content:center}
.btn-pencil:active{background:var(--surface-container-high);border-color:var(--primary)}
.jot-checkbox{width:22px;height:22px;border:2px solid #CBD5CE;border-radius:9999px;background:#FFFFFF;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all 0.15s ease;font-size:12px;font-weight:700;line-height:1}
.jot-checkbox.checked{background:var(--primary);border-color:var(--primary);color:#fff}
.notebook-section{background:var(--surface);border:1px solid var(--border);border-radius:1.75rem;padding:20px;margin-bottom:16px;box-shadow:0 8px 24px rgba(30,45,40,0.04);transition:border-color 0.15s}
.notebook-section-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid var(--divider);font-family:'Plus Jakarta Sans',sans-serif;font-size:11px;font-weight:700;color:var(--text-inactive);letter-spacing:0.08em;text-transform:uppercase}
html{height:100%;min-height:100%;min-height:100dvh;width:100%;max-width:100vw;overflow-x:hidden;background:var(--bg) !important;color:var(--text) !important;transition:background-color 0.2s ease,color 0.2s ease}
body{font-family:'Plus Jakarta Sans',-apple-system,sans-serif;background:var(--bg) !important;color:var(--text) !important;padding:0 16px;padding-top:80px;padding-bottom:calc(96px + env(safe-area-inset-bottom, 16px));max-width:480px;margin:0 auto;font-size:14px;min-height:100%;min-height:100dvh;width:100%;max-width:100vw;overflow-x:hidden;-webkit-font-smoothing:antialiased;-webkit-touch-callout:none;box-sizing:border-box;transition:background-color 0.2s ease,color 0.2s ease}
body>section{margin-bottom:16px}
body>section:last-of-type{margin-bottom:0}
.calm-card{background:var(--card-bg) !important;border:1px solid var(--card-border) !important;border-radius:1.75rem;box-shadow:var(--card-shadow) !important;transition:transform 0.12s ease,box-shadow 0.15s ease,background-color 0.2s ease,border-color 0.2s ease;color:var(--text) !important}
.calm-card:active{transform:scale(0.99)}
.task-item{transition:all 0.2s ease}
.task-item.done .task-pill{background-color:var(--primary) !important;border-color:var(--primary) !important}
.task-item.done .task-pill span{opacity:1 !important}
.task-item.done .task-text{text-decoration:line-through;color:var(--muted) !important}
.topappbar{position:fixed;top:0;left:0;right:0;z-index:40;background:var(--appbar-bg) !important;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--appbar-border) !important;height:68px;display:flex;justify-content:space-between;align-items:center;padding:0 20px;max-width:480px;margin:0 auto;box-sizing:border-box;transition:background-color 0.2s ease,border-color 0.2s ease}
.topappbar .logo{width:36px;height:36px;border-radius:9999px;object-fit:contain;display:block;box-shadow:0 2px 8px rgba(0,0,0,0.12)}
.topappbar .title{font-family:'Plus Jakarta Sans',sans-serif;font-size:16px;font-weight:700;letter-spacing:-0.01em;color:var(--text) !important}
.bottomnav{position:fixed;bottom:0;left:0;right:0;z-index:50;background:var(--surface);border-top:1px solid var(--border);display:flex;justify-content:space-around;align-items:center;height:calc(58px + env(safe-area-inset-bottom, 0px));padding:0 8px;padding-bottom:env(safe-area-inset-bottom, 0px);max-width:600px;margin:0 auto;box-sizing:border-box}
.bottomnav a{display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--text-inactive);text-decoration:none;flex:1;height:100%;transition:color 0.2s;font-family:'Space Mono','Mono',monospace;font-size:10px;letter-spacing:0.1em;user-select:none;-webkit-tap-highlight-color:transparent}
.bottomnav a.active{color:var(--primary);font-weight:700}
.bottomnav a svg{width:22px;height:22px;margin-bottom:2px;fill:currentColor}
.bottomnav a span:last-child{margin-top:2px}
.scanline{width:100%;height:1px;background:rgba(167,200,255,0.04);position:fixed;top:0;left:0;pointer-events:none;z-index:51;animation:scan 8s linear infinite}
@keyframes scan{0%{top:0}100%{top:100vh}}
.section-title{font-family:'Space Mono','Mono',monospace;font-size:11px;font-weight:500;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;margin:12px 0 6px}
.page-header h2{font-family:'JetBrains Mono','Mono',monospace;font-weight:600;font-size:18px}
h2{font-family:'JetBrains Mono','Mono',monospace;font-weight:600;font-size:18px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);margin-bottom:6px}
.grid-3{grid-template-columns:1fr 1fr 1fr}
.btn{background:var(--surface-container-low);border:1px solid var(--border);color:var(--text);padding:10px 8px;border-radius:6px;font-size:13px;cursor:pointer;text-align:center;transition:background 0.15s;font-family:'JetBrains Mono','Mono',monospace;font-weight:500;letter-spacing:0.03em}
.btn:active{background:var(--surface-container-high)}
.btn:disabled{opacity:0.4;cursor:not-allowed}
.btn-accent{background:var(--accent-container);border-color:var(--accent-container);color:#000}
.btn-green{background:var(--green);color:#000;border-color:var(--green)}
.btn-red{background:var(--red);color:#fff;border-color:var(--red)}
.btn-yellow{background:var(--yellow);color:#000;border-color:var(--yellow)}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--text)}
.stats-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:var(--gap);margin-bottom:12px}
.stat{background:var(--surface-container-low);border-radius:var(--radius);padding:8px;text-align:center;border:1px solid var(--border)}
.stat .val{font-family:'JetBrains Mono','Mono',monospace;font-size:16px;font-weight:600}
.stat .lbl{font-family:'Space Mono','Mono',monospace;font-size:10px;color:var(--text-inactive);margin-top:1px;letter-spacing:0.05em}
.tasks-card{background:var(--surface-container-low);border-radius:var(--radius);padding:10px;margin-bottom:8px;border:1px solid var(--border)}
.task-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:13px;border-bottom:1px solid var(--divider);gap:8px}
.task-row:last-child{border-bottom:none}
.task-done{text-decoration:line-through;color:var(--muted)}
.task-title{flex:1}
.task-toggle{cursor:pointer;width:22px;height:22px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid var(--text-inactive);font-size:12px;flex-shrink:0}
.task-toggle.ok{border-color:var(--green);background:var(--green);color:#000}
.feed-card{background:var(--surface-container-low);border-radius:var(--radius);padding:10px;max-height:200px;overflow-y:auto;border:1px solid var(--border)}
.feed-item{font-size:13px;padding:4px 0;border-bottom:1px solid var(--divider);color:var(--text-inactive);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.feed-item:last-child{border-bottom:none}
.overflow-row{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.overflow-row.expandable{cursor:pointer}
.overflow-row.expandable:active{opacity:0.7}
.overflow-row.expanded{white-space:normal;overflow:visible;word-wrap:break-word;overflow-wrap:break-word}
.shrink-0{flex-shrink:0}
.gita-card{background:var(--card);border-radius:var(--radius);padding:12px;margin-top:12px;border-left:3px solid var(--accent-purple)}
.gita-card .id{font-family:'JetBrains Mono','Mono',monospace;font-size:13px;font-weight:600;margin-bottom:6px}
.gita-card .shloka{font-size:16px;line-height:1.6;margin:8px 0;font-weight:500}
.gita-card .trans{color:var(--text-inactive);font-size:14px;line-height:1.5}
.gita-card .trans-heading{font-family:'Space Mono','Mono',monospace;font-size:12px;font-weight:600;color:var(--accent2);margin-top:8px;margin-bottom:2px;letter-spacing:0.05em}
.gita-card .gita-actions{display:flex;gap:8px;margin-top:10px}
.gita-card .gita-actions .btn{flex:1;padding:8px;font-size:13px}
.gita-card .progress{font-family:'JetBrains Mono','Mono',monospace;font-size:12px;color:var(--text-inactive);margin-top:8px;text-align:center}
.fab{position:fixed;bottom:calc(74px + env(safe-area-inset-bottom, 0px));right:16px;width:52px;height:52px;background:#E7DFC8;color:#1a1a1a;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,0.35);z-index:110;transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.2s;border:none;cursor:pointer}
.fab:active{transform:scale(0.92);box-shadow:0 2px 8px rgba(0,0,0,0.2)}
.fab span{font-size:22px;font-weight:500;font-family:system-ui,-apple-system,sans-serif;color:#1a1a1a;line-height:1}
.chip{background:var(--surface-container);border:1px solid var(--border);border-radius:14px;padding:4px 10px;font-size:12px;cursor:pointer;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em;transition:border-color 0.15s}
.chip:active,.chip.selected{border-color:var(--accent-container);color:var(--accent-container)}
.chip-list{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0}
.gita-sidebar{position:fixed;top:0;right:-60%;width:60%;max-width:400px;height:100%;background:var(--bg);border-left:1px solid var(--border);z-index:110;overflow-y:auto;overflow-x:hidden;transition:right 0.3s;padding:12px;box-sizing:border-box}
.gita-sidebar.open{right:0}
.gita-sidebar-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:109}
.gita-sidebar-overlay.show{display:block}
.timeline-sidebar{position:fixed;top:0;right:-100%;width:85%;max-width:360px;height:100%;background:var(--bg);border-left:1px solid var(--border);z-index:110;overflow-y:auto;overflow-x:hidden;transition:right 0.3s;padding:12px;box-sizing:border-box}
.timeline-sidebar.open{right:0}
.gita-sidebar .ch-header{display:flex;justify-content:space-between;align-items:center;padding:8px 0;cursor:pointer;font-size:14px;font-weight:600;border-bottom:1px solid var(--border)}
.gita-sidebar .ch-header .ch-count{font-size:11px;color:var(--muted);font-weight:400}
.gita-sidebar .ch-verses{display:none;padding:4px 0 8px 16px}
.gita-sidebar .ch-verses.open{display:block}
.gita-sidebar .verse-row{display:flex;align-items:center;gap:6px;padding:3px 0;font-size:13px}
.gita-sidebar .verse-row input[type=checkbox]{accent-color:var(--green);width:16px;height:16px;cursor:pointer}
.gita-sidebar .verse-row .verse-label{flex:1;cursor:pointer}
.gita-sidebar .verse-row.read .verse-label{text-decoration:line-through;color:var(--muted)}
.gita-reading{scroll-behavior:smooth;transition:opacity 0.12s ease,transform 0.12s ease}
.gita-reading.slide-out-next{opacity:0;transform:translateX(-20px)}
.gita-reading.slide-out-prev{opacity:0;transform:translateX(20px)}
.gita-section{opacity:0;transform:translateY(24px);transition:opacity 0.5s ease,transform 0.5s ease}
.gita-section.visible{opacity:1;transform:translateY(0)}
.gita-divider{width:40px;height:1px;background:var(--border);margin:0 auto}
#gitaPage{display:none;position:fixed;top:0;left:0;right:0;bottom:0;width:100%;max-width:600px;margin:0 auto;background:var(--bg);z-index:100;overflow:hidden;padding:0;box-sizing:border-box;flex-direction:column}
#gitaPage.show{display:flex}
#gitaPage .gita-reading::-webkit-scrollbar{width:2px}
#gitaPage .gita-reading::-webkit-scrollbar-thumb{background:var(--border);border-radius:1px}
.checklist-page{display:none;position:fixed;top:0;left:0;right:0;bottom:calc(58px + env(safe-area-inset-bottom, 0px));width:100%;max-width:600px;margin:0 auto;background:var(--bg);z-index:100;overflow-y:auto;overflow-x:hidden;padding:12px 0 20px;box-sizing:border-box;flex-direction:column;-webkit-overflow-scrolling:touch}
.checklist-page.show{display:flex}
.checklist-page .page-header{padding:0 16px}
.checklist-page .cl-input-area{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.checklist-page .cl-input-area input{flex:1;min-width:0;width:100%;background:transparent;border:none;color:var(--primary);font-family:'JetBrains Mono','Mono',monospace;font-size:16px;font-weight:500;outline:none;padding:0}
.checklist-page .cl-input-area input::placeholder{color:var(--text-inactive)}
.cl-item{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);background:var(--surface);transition:border-color 0.15s;touch-action:manipulation}
.cl-item:hover{border-color:var(--primary)}
.cl-item.done{background:var(--surface-secondary);opacity:0.6}
.cl-item.overdue{border-color:var(--accent-orange)}
.page-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;width:100%;max-width:100vw;margin:0;background:var(--bg);z-index:100;overflow-y:auto;overflow-x:hidden;padding:12px 16px calc(92px + env(safe-area-inset-bottom, 16px));box-sizing:border-box;-webkit-overflow-scrolling:touch}
.page-overlay.show{display:block}
#pluginFramePage{position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;max-width:100vw;height:100%;margin:0;background:var(--bg);z-index:200;display:none;padding-bottom:calc(76px + env(safe-area-inset-bottom, 0px));box-sizing:border-box}
#pluginFramePage.show{display:flex !important;flex-direction:column !important;overflow:hidden !important}
#pluginFramePage .page-header{padding:12px 16px 10px !important;margin-bottom:0 !important;flex-shrink:0 !important;border-bottom:1px solid var(--border) !important;background:var(--surface) !important}
#pluginFrame{flex:1 !important;width:100% !important;height:100% !important;border:none !important;border-radius:0 !important;background:var(--bg) !important;display:block !important}
.bottom-nav-item{width:44px;height:44px;min-width:44px;min-height:44px;border-radius:9999px;display:flex;align-items:center;justify-content:center;text-decoration:none;background-color:transparent;color:var(--text-inactive);border:1px solid transparent;box-shadow:none;padding:0;cursor:pointer;transition:all 0.2s cubic-bezier(0.2, 0, 0, 1);box-sizing:border-box;-webkit-tap-highlight-color:transparent}
.bottom-nav-item:active{transform:scale(0.92)}
.bottom-nav-item.active{width:auto !important;min-width:unset !important;height:auto !important;padding:7px 14px !important;gap:6px !important;background-color:var(--primary) !important;color:var(--on-primary, #FFFFFF) !important;border:1px solid var(--primary) !important;box-shadow:0 3px 12px rgba(0,0,0,0.22) !important;font-weight:700 !important;font-size:12px !important;white-space:nowrap !important}
.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.page-header h2{font-family:'JetBrains Mono','Mono',monospace;font-size:16px;font-weight:600;color:var(--primary);letter-spacing:0.05em}
.page-header .btn{padding:6px 12px;font-size:12px}
.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:101;justify-content:center;align-items:center;padding:20px;box-sizing:border-box}
.modal-overlay.show{display:flex}
.modal{background:var(--surface-container);border:1px solid var(--border);border-radius:var(--radius);padding:20px;width:100%;max-width:400px;max-height:90vh;overflow-y:auto;-webkit-overflow-scrolling:touch;box-sizing:border-box}
.modal h2{font-family:'JetBrains Mono','Mono',monospace;font-size:16px;margin-bottom:12px;font-weight:600;color:var(--primary)}
.modal label{display:block;font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);margin:8px 0 3px;letter-spacing:0.1em;text-transform:uppercase}
.modal input,.modal select,.modal textarea{width:100%;padding:10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px;outline:none;font-family:'JetBrains Mono','Mono',monospace;-webkit-appearance:none;box-sizing:border-box}
.modal input:focus,.modal select:focus,.modal textarea:focus{border-color:var(--accent-container)}
.modal textarea{resize:vertical;min-height:60px}
.modal-btns{display:flex;gap:8px;margin-top:14px}
.modal-btns .btn{flex:1}
.toast{position:fixed;bottom:calc(76px + env(safe-area-inset-bottom, 0px));left:50%;transform:translateX(-50%);background:var(--accent-container);color:#fff;padding:10px 20px;border-radius:var(--radius);font-size:14px;z-index:200;opacity:0;transition:opacity 0.3s;pointer-events:none;font-family:'JetBrains Mono','Mono',monospace}
.toast.show{opacity:1}
.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--divider)}
.toggle-row:last-child{border-bottom:none}
.toggle-row span{font-size:14px}
.toggle-row input[type=checkbox]{accent-color:var(--accent-container);width:20px;height:20px}
#kitGrid.kit-reordering{outline:2px dashed var(--red);outline-offset:5px;padding:5px;border-radius:6px}
#kitGrid.kit-reordering [data-kid]{opacity:0.92;touch-action:none}
.kit-dragging{opacity:0.45 !important;outline:2px solid var(--primary)}
.card{background:var(--surface-container-low);border-radius:var(--radius);padding:12px;border:1px solid var(--border);box-sizing:border-box;max-width:100%}
@keyframes dtFade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
#dayTrackerCarousel::-webkit-scrollbar{display:none}
.kb-section-label{font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--primary);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px}
.kb-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-bottom:10px;position:relative;overflow:hidden}
.kb-card-ghost{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'JetBrains Mono','Mono',monospace;font-size:80px;font-weight:800;color:var(--primary);opacity:0.03;white-space:nowrap;pointer-events:none;letter-spacing:0.05em}
.kb-status-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--divider)}
.kb-status-row:last-child{border-bottom:none}
.kb-status-label{font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);letter-spacing:0.1em;text-transform:uppercase}
.kb-status-val{font-family:'JetBrains Mono','Mono',monospace;font-size:13px;color:var(--text)}
.kb-progress-bar{height:2px;background:var(--divider);border-radius:1px;overflow:hidden;margin:8px 0}
.kb-progress-fill{height:100%;border-radius:1px;transition:width 0.3s}
.kb-alert{background:rgba(255,159,69,0.05);border:1px solid rgba(255,159,69,0.3);border-radius:var(--radius);padding:12px;margin-bottom:10px;display:flex;align-items:center;gap:10px}
.kb-alert-dot{width:8px;height:8px;border-radius:50%;background:#FF9F45;animation:pulse-dot 2s infinite;flex-shrink:0}
@keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:0.4}}
@keyframes blink{50%{opacity:0}}
.kb-scroll-row{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:4px;margin-bottom:10px}
.kb-scroll-row::-webkit-scrollbar{display:none}
.kb-scroll-card{flex-shrink:0;scroll-snap-align:start;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px;min-width:150px}
.kb-timer-display{font-family:'JetBrains Mono','Mono',monospace;font-size:48px;font-weight:600;color:var(--primary);letter-spacing:0.02em;text-align:center;line-height:1;margin:16px 0;font-variant-numeric:tabular-nums}
.kb-log-entry{font-family:'Space Mono','Mono',monospace;font-size:12px;padding:4px 0;color:var(--text)}
.kb-log-time{color:var(--text-inactive);margin-right:4px}
.kb-log-tag{font-weight:600}
/* Command Palette (vertical panel) */
.cmd-palette-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);backdrop-filter:blur(8px);z-index:200;display:none}
.cmd-palette-overlay.open{display:block}
.cmd-palette-panel{position:fixed;bottom:100px;right:20px;width:240px;background:#E7DFC8;border-radius:28px;padding:8px 0;box-shadow:0 8px 32px rgba(0,0,0,0.35);transform-origin:bottom right;opacity:0;transform:scale(0.95) translateY(8px);transition:all 0.25s cubic-bezier(0.34,1.56,0.64,1)}
.cmd-palette-panel.show{opacity:1;transform:scale(1) translateY(0)}
.cmd-palette-row{display:flex;align-items:center;gap:14px;height:46px;padding:0 20px;cursor:pointer;border-radius:16px;margin:2px 8px;transition:background 0.15s}
.cmd-palette-row:active{background:rgba(0,0,0,0.08)}
.cmd-palette-row svg{width:18px;height:18px;fill:#1a1a1a;flex-shrink:0}
.cmd-palette-row .cmd-label{font-family:'JetBrains Mono','Mono',monospace;font-size:13px;color:#1a1a1a;letter-spacing:0.05em;flex:1}
.cmd-palette-row .cmd-arrow{font-size:14px;color:rgba(0,0,0,0.3);font-family:system-ui}
/* Light mode palette overrides */
:root[data-theme="light"] .cmd-palette-panel{background:#fff;box-shadow:0 8px 32px rgba(0,0,0,0.12)}
:root[data-theme="light"] .cmd-palette-row svg{fill:#1a1a2e}
:root[data-theme="light"] .cmd-palette-row .cmd-label{color:#1a1a2e}
:root[data-theme="light"] .cmd-palette-row:active{background:rgba(0,0,0,0.05)}
.kb-toggle{position:relative;cursor:pointer;min-width:44px;height:24px}
.kb-toggle input{opacity:0;width:0;height:0;position:absolute}
.kb-toggle-track{position:absolute;top:0;left:0;right:0;bottom:0;background:var(--divider);border-radius:12px;border:1px solid var(--border);transition:all 0.2s;font-family:'JetBrains Mono','Mono',monospace;font-size:9px;display:flex;align-items:center;justify-content:center;letter-spacing:0.08em}
.kb-toggle input:checked+.kb-toggle-track{background:rgba(77,224,134,0.15);border-color:var(--green)}
.kb-toggle-track::after{content:attr(data-off);color:var(--text-inactive)}
.kb-toggle input:checked+.kb-toggle-track::after{content:attr(data-on);color:var(--green)}
.kb-settings-time{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:6px 10px;color:var(--primary);font-family:'JetBrains Mono','Mono',monospace;font-size:13px;width:90px;outline:none}
.kb-settings-time:focus{border-color:var(--primary)}
.kb-settings-select{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:8px 12px;color:var(--text);font-family:'JetBrains Mono','Mono',monospace;font-size:13px;width:100%;outline:none;-webkit-appearance:none;appearance:none}
.kb-settings-select:focus{border-color:var(--primary)}
.kb-settings-group{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px;display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
.settings-tab{flex:1;height:34px;background:var(--surface);border:1px solid var(--border);color:var(--text-inactive);font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;border-radius:4px;transition:all 0.15s;display:flex;align-items:center;justify-content:center}
.settings-tab.active{background:rgba(167,200,255,0.12);border-color:var(--primary);color:var(--primary);font-weight:700}

/* ─── Light mode overrides for hardcoded dark colors ─── */
:root[data-theme="light"] .topappbar{background:var(--appbar-bg) !important}
:root[data-theme="light"] .fab{background:#E7DFC8;color:#1a1a1a;border-color:rgba(0,0,0,0.18);box-shadow:0 4px 14px rgba(0,0,0,0.18)}
:root[data-theme="light"] .fab svg{fill:#1a1a1a}
:root[data-theme="light"] .topappbar .logo{box-shadow:2px 2px 0px rgba(0,0,0,0.1)}
:root[data-theme="light"] .modal-overlay{background:rgba(0,0,0,0.4)}

/* ─── Dark Mode Overrides (Stitch V3 Design System) ─── */
:root[data-theme="dark"] html, :root[data-theme="dark"] body {
  background: var(--bg) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] .calm-card,
:root[data-theme="dark"] .notebook-section,
:root[data-theme="dark"] .stat,
:root[data-theme="dark"] .tasks-card,
:root[data-theme="dark"] .feed-card,
:root[data-theme="dark"] .gita-card,
:root[data-theme="dark"] .kb-settings-group,
:root[data-theme="dark"] .plugin-widget-card {
  background: var(--card-bg) !important;
  border-color: var(--card-border) !important;
  color: var(--text) !important;
  box-shadow: var(--card-shadow) !important;
}
:root[data-theme="dark"] .topappbar {
  background: var(--appbar-bg) !important;
  border-bottom: 1px solid var(--appbar-border) !important;
}
:root[data-theme="dark"] .topappbar .title {
  color: var(--text) !important;
}
:root[data-theme="dark"] #bottomNavDock {
  background: var(--nav-dock-bg) !important;
  border-color: var(--nav-dock-border) !important;
  box-shadow: var(--nav-dock-shadow) !important;
}
:root[data-theme="dark"] .page-overlay {
  background: var(--bg) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] .page-header {
  background: var(--surface) !important;
  border-color: var(--border) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] h1, :root[data-theme="dark"] h2, :root[data-theme="dark"] h3, :root[data-theme="dark"] h4, :root[data-theme="dark"] h5 {
  color: var(--text) !important;
}
:root[data-theme="dark"] input, :root[data-theme="dark"] textarea, :root[data-theme="dark"] select {
  background: var(--surface-container) !important;
  border-color: var(--border) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] input::placeholder, :root[data-theme="dark"] textarea::placeholder {
  color: var(--muted) !important;
}
:root[data-theme="dark"] #habitWeekBubbles {
  background: var(--surface-subtle) !important;
  border-color: var(--border) !important;
}
:root[data-theme="dark"] .jot-checkbox {
  background: var(--surface-container) !important;
  border-color: var(--border) !important;
}
:root[data-theme="dark"] .jot-checkbox.checked {
  background: var(--primary) !important;
  border-color: var(--primary) !important;
  color: var(--on-primary) !important;
}
:root[data-theme="dark"] .btn {
  background: var(--surface-container-high) !important;
  border-color: var(--border) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] .btn:active {
  background: var(--surface-container-highest) !important;
}
:root[data-theme="dark"] .btn-wax {
  background: var(--primary) !important;
  color: var(--on-primary) !important;
  box-shadow: 0 4px 14px rgba(56, 189, 248, 0.28) !important;
}
:root[data-theme="dark"] .btn-pencil {
  border-color: var(--border) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] .btn-pencil:active {
  background: var(--surface-container-high) !important;
  border-color: var(--primary) !important;
}
:root[data-theme="dark"] .modal {
  background: var(--surface) !important;
  border-color: var(--border) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] .modal-overlay {
  background: rgba(0, 0, 0, 0.75) !important;
}
:root[data-theme="dark"] .chip {
  background: var(--surface-container) !important;
  border-color: var(--border) !important;
  color: var(--text) !important;
}
:root[data-theme="dark"] .settings-tab {
  background: var(--surface) !important;
  border-color: var(--border) !important;
  color: var(--text-inactive) !important;
}
:root[data-theme="dark"] .settings-tab.active {
  background: var(--surface-container-high) !important;
  border-color: var(--primary) !important;
  color: var(--primary) !important;
}
:root[data-theme="dark"] .calm-card [style*="background: #FFFFFF"],
:root[data-theme="dark"] .calm-card [style*="background: #F4F7F5"],
:root[data-theme="dark"] .calm-card [style*="background: #FAFBF9"],
:root[data-theme="dark"] .calm-card [style*="background: #FAF0EE"],
:root[data-theme="dark"] .calm-card [style*="background: #E6F4F1"],
:root[data-theme="dark"] .calm-card [style*="background-color: #F4F7F5"] {
  background: var(--surface-container-high) !important;
  border-color: var(--border) !important;
}
:root[data-theme="dark"] .calm-card [style*="color: #182230"] {
  color: var(--text) !important;
}
:root[data-theme="dark"] .calm-card [style*="color: #5B6A78"] {
  color: var(--text-inactive) !important;
}
:root[data-theme="dark"] .calm-card [style*="color: #8C5E58"] {
  color: var(--secondary) !important;
}
:root[data-theme="dark"] .calm-card [style*="color: #2E7D6A"] {
  color: var(--primary) !important;
}
:root[data-theme="dark"] .calm-card [style*="border: 1px solid #DDE7E2"],
:root[data-theme="dark"] .calm-card [style*="border: 1px solid #EADCDA"],
:root[data-theme="dark"] .calm-card [style*="border: 1px solid #D0EBE5"] {
  border-color: var(--border) !important;
}
:root[data-theme="dark"] .topappbar [style*="background: #FFFFFF"] {
  background: var(--surface-container-high) !important;
  border-color: var(--border) !important;
  color: var(--primary) !important;
}
:root[data-theme="dark"] .topappbar [style*="color: #182230"] {
  color: var(--text) !important;
}
:root[data-theme="dark"] .topappbar [style*="color: #5B6A78"] {
  color: var(--text-inactive) !important;
}
:root[data-theme="dark"] .topappbar [style*="color: #2E7D6A"] {
  color: var(--primary) !important;
}
:root[data-theme="dark"] .topappbar [style*="background: #2E7D6A"] {
  background: var(--primary) !important;
}
:root[data-theme="dark"] #moodPromptBar {
  background: var(--card-bg) !important;
  border-color: var(--card-border) !important;
}
:root[data-theme="dark"] #moodPromptBar [style*="color:#8C5E58"] {
  color: var(--secondary) !important;
}
:root[data-theme="dark"] #moodPromptBar [style*="color:#5B6A78"] {
  color: var(--text-inactive) !important;
}

/* ─── Plugin Widgets & Multi-Size Cards ─── */
#pluginWidgetsSection{width:100%;max-width:100%;box-sizing:border-box}
#pluginWidgetsArea{display:grid;grid-template-columns:1fr;gap:10px;width:100%;max-width:100%;box-sizing:border-box}
.plugin-widget-card{grid-column:1/-1 !important;width:100%;min-width:0;max-width:100%;overflow:hidden;display:flex;flex-direction:column;border:1px solid var(--border);border-radius:10px;background:var(--surface);box-sizing:border-box;cursor:pointer;user-select:none;-webkit-tap-highlight-color:transparent;transition:border-color 0.15s,box-shadow 0.15s,opacity 0.15s}
.plugin-widget-card.size-compact, .plugin-widget-card.size-1-1{grid-column:1/-1 !important}
.plugin-widget-card.size-small, .plugin-widget-card.size-2-1{grid-column:1/-1 !important}
.plugin-widget-card.size-medium, .plugin-widget-card.size-3-1{grid-column:1/-1 !important}
.plugin-widget-card.size-large, .plugin-widget-card.size-4-2, .plugin-widget-card.size-4-1{grid-column:1/-1 !important}
.plugin-widget-card.size-hidden, .plugin-widget-card.size-off{display:none !important}
.plugin-widget-card.size-compact .plugin-widget-frame, .plugin-widget-card.size-1-1 .plugin-widget-frame{height:70px !important}
.plugin-widget-card.size-small .plugin-widget-frame, .plugin-widget-card.size-2-1 .plugin-widget-frame{height:100px !important}
.plugin-widget-card.size-medium .plugin-widget-frame, .plugin-widget-card.size-3-1 .plugin-widget-frame{height:160px !important}
.plugin-widget-card.size-large .plugin-widget-frame, .plugin-widget-card.size-4-2 .plugin-widget-frame, .plugin-widget-card.size-4-1 .plugin-widget-frame{height:240px !important}
.plugin-widget-card{transition:transform 0.22s cubic-bezier(0.2, 0, 0, 1),border-color 0.15s,box-shadow 0.2s cubic-bezier(0.2, 0, 0, 1),opacity 0.15s}
.plugin-widget-card:hover{border-color:rgba(255,255,255,0.2)}
.plugin-widget-card:active{border-color:var(--primary)}
.plugin-widget-card.plugin-widget-dragging{opacity:0.9;transform:scale(1.02) translateY(-4px);z-index:50;border-color:var(--primary);box-shadow:0 14px 32px rgba(0,0,0,0.65), 0 0 0 1px var(--primary);touch-action:none !important;transition:transform 0.15s ease,box-shadow 0.15s ease,opacity 0.15s ease}
.plugin-widget-drag-handle{touch-action:none !important;-webkit-touch-callout:none;user-select:none;-webkit-user-select:none;cursor:grab}
.plugin-widget-drag-handle:active{cursor:grabbing}
.plugin-widget-frame{width:100%;max-width:100%;box-sizing:border-box;display:block;border:none;background:var(--surface);pointer-events:auto}
.plugin-widget-dragging .plugin-widget-frame, body.plugin-reordering .plugin-widget-frame{pointer-events:none !important}

/* ─── Modern Skeleton Loading System ─── */
@keyframes v07-shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
@keyframes v07-skeleton-fade {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}
.skeleton-shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(167, 200, 255, 0.12) 50%, rgba(255,255,255,0.03) 75%);
  background-size: 200% 100%;
  animation: v07-shimmer 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  border-radius: 4px;
  will-change: background-position;
}
:root[data-theme="light"] .skeleton-shimmer {
  background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(59, 130, 246, 0.12) 50%, rgba(0,0,0,0.04) 75%);
  background-size: 200% 100%;
}
.skeleton-card {
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: v07-skeleton-fade 2s ease-in-out infinite;
}
.skeleton-bar-row {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  height: 120px;
  padding: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 12px;
  animation: v07-skeleton-fade 2s ease-in-out infinite;
}
</style>
</head>
<body>

<script>
function renderSkeleton(type, count){
  count = count || 3;
  var h = '';
  if(type === 'cards'){
    for(var i=0; i<count; i++){
      h += '<div class="skeleton-card">';
      h += '  <div style="display:flex;justify-content:space-between;align-items:center">';
      h += '    <div class="skeleton-shimmer" style="width:' + (55 + (i*15)%35) + '%;height:14px"></div>';
      h += '    <div class="skeleton-shimmer" style="width:40px;height:12px;border-radius:10px"></div>';
      h += '  </div>';
      h += '  <div class="skeleton-shimmer" style="width:' + (80 + (i*10)%20) + '%;height:10px;opacity:0.7"></div>';
      h += '  <div style="display:flex;gap:8px;margin-top:2px">';
      h += '    <div class="skeleton-shimmer" style="width:50px;height:10px;border-radius:3px"></div>';
      h += '    <div class="skeleton-shimmer" style="width:40px;height:10px;border-radius:3px"></div>';
      h += '  </div>';
      h += '</div>';
    }
    return h;
  }
  if(type === 'list'){
    h += '<div style="display:flex;flex-direction:column;gap:8px;padding:4px 0">';
    for(var i=0; i<count; i++){
      h += '<div style="display:flex;align-items:center;gap:10px;padding:8px 4px;border-bottom:1px solid var(--divider)">';
      h += '  <div class="skeleton-shimmer" style="width:16px;height:16px;border-radius:3px;flex-shrink:0"></div>';
      h += '  <div style="flex:1;display:flex;flex-direction:column;gap:6px">';
      h += '    <div class="skeleton-shimmer" style="width:' + (60 + (i*12)%35) + '%;height:12px"></div>';
      h += '    <div class="skeleton-shimmer" style="width:35%;height:9px;opacity:0.6"></div>';
      h += '  </div>';
      h += '</div>';
    }
    h += '</div>';
    return h;
  }
  if(type === 'chart'){
    h += '<div class="skeleton-bar-row">';
    for(var i=0; i<12; i++){
      var rh = 20 + ((i * 37) % 75);
      h += '<div class="skeleton-shimmer" style="flex:1;height:' + rh + '%;border-radius:3px 3px 0 0"></div>';
    }
    h += '</div>';
    return h;
  }
  if(type === 'grid'){
    h += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px">';
    for(var i=0; i<count; i++){
      h += '<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:8px">';
      h += '  <div class="skeleton-shimmer" style="width:50%;height:10px"></div>';
      h += '  <div class="skeleton-shimmer" style="width:70%;height:22px"></div>';
      h += '</div>';
    }
    h += '</div>';
    return h;
  }
  return '<div class="skeleton-card"><div class="skeleton-shimmer" style="width:70%;height:16px"></div><div class="skeleton-shimmer" style="width:90%;height:12px"></div></div>';
}
