function setHomeScreenWidgetModule(widgetType){
  var type = widgetType || (document.getElementById('homeWidgetTypeSelect') ? document.getElementById('homeWidgetTypeSelect').value : 'weekly');
  updateHomeWidgetPreview(type);
  if(window.AndroidV07 && AndroidV07.call){
    try {
      var res = JSON.parse(AndroidV07.call('setHomeScreenWidgetType', JSON.stringify({ widgetType: type })));
      toast('Home widget set to: ' + type.toUpperCase());
    } catch(e){
      toast('Failed to set widget: ' + (e.message || e));
    }
  } else {
    toast('Home widget module set to: ' + type.toUpperCase());
  }
}

function loadHomeScreenWidgetPref(){
  var compEl = document.getElementById('companionUrlDisplay');
  if(compEl) compEl.textContent = window.location.origin + '/companion.html';
  var sel = document.getElementById('homeWidgetTypeSelect');
  if(!sel) return;
  if(window.AndroidV07 && AndroidV07.call){
    try {
      var res = JSON.parse(AndroidV07.call('getHomeScreenWidgetType', '{}'));
      if(res && res.type) {
        sel.value = res.type;
        updateHomeWidgetPreview(res.type);
        return;
      }
    } catch(e){}
  }
  updateHomeWidgetPreview(sel.value || 'weekly');
}

function pinCurrentPluginWidget(){
  var p = _activePluginSettingsMeta;
  var widgetType = '';
  if(p){
    if(p.id === 'com.v07.chronosynth') widgetType = 'weekly';
    else if(p.id === 'com.v07.reader') widgetType = 'reader';
    else if(p.id === 'com.v07.timetracker') widgetType = 'timetracker';
    else if(p.id === 'com.v07.tasks') widgetType = 'tasks';
    else if(p.id === 'com.v07.habits') widgetType = 'habits';
    else if(p.id === 'com.v07.gamify') widgetType = 'gamify';
    else if(p.id === 'com.v07.vitals') widgetType = 'vitals';
    else widgetType = p.id;
  }
  pinHomeScreenWidget(widgetType);
}

function saveCurrentPluginSettings(){
  var p = _activePluginSettingsMeta;
  if(!p) return;
  var timeInput = document.getElementById('psmNotifTime');
  if(timeInput && timeInput.value) _tempPluginSettings.notifTime = timeInput.value;

  savePluginSettings(p.id, _tempPluginSettings);

  // Notifications bridge
  if(window.AndroidV07 && AndroidV07.call){
    if(_tempPluginSettings.notifEnabled){
      schedulePluginDailyReminder(p.id, p.name, (p.notifications && p.notifications.title), (p.notifications && p.notifications.body), _tempPluginSettings.notifTime);
    } else {
      try {
        AndroidV07.call('cancelReminder', JSON.stringify({ pluginId: p.id, id: 'daily' }));
      } catch(e){}
    }
  }

  toast(p.name + ' settings applied');
  closePluginSettings();
  loadPluginNav();
  renderPluginWidgets();
}

function schedulePluginDailyReminder(pluginId, pluginName, title, body, timeStr){
  if(!window.AndroidV07 || !AndroidV07.call) return;
  var parts = (timeStr || '09:00').split(':');
  var targetH = parseInt(parts[0], 10) || 9;
  var targetM = parseInt(parts[1], 10) || 0;

  var now = new Date();
  var target = new Date();
  target.setHours(targetH, targetM, 0, 0);
  if(target.getTime() <= now.getTime()){
    target.setDate(target.getDate() + 1);
  }
  var delayMs = target.getTime() - now.getTime();

  try {
    AndroidV07.call('scheduleReminder', JSON.stringify({
      pluginId: pluginId,
      title: title || (pluginName + ' Reminder'),
      body: body || ('Check in with ' + pluginName),
      delayMs: delayMs,
      id: 'daily'
    }));
  } catch(e){}
}

function openPluginCustomSettings(){
  var p = _activePluginSettingsMeta;
  if(!p) return;
  closePluginSettings();
  openPluginPage(p.id);
}

// ─── Plugins Manager (Settings → Plugins) ───────────────────────────────────
async function refreshPluginNavThen(openPage){
  await loadPluginNav();
  if(openPage)openPluginPage(openPage);
}

async function loadPluginsManager(){
  var list=document.getElementById('pluginsInstalledList');
  var store=document.getElementById('pluginsStoreList');
  if(!list&&!store)return;
  var installed=[];
  try{
    var r=await fetch(BASE+'/plugins/registry');
    var j=await r.json();
    installed=(j&&j.plugins)||[];
  }catch(e){}
  if(list){
    if(!installed.length){list.innerHTML='<div style="color:var(--text-inactive);padding:16px 0;text-align:center;font-size:11px">No plugins installed</div>';}
    else{
      var h='';
      var colors=['var(--primary)','var(--secondary)','var(--accent)','#68A6FF','#FF9F45'];
      installed.forEach(function(p, idx){
        var col = (p.widgets && p.widgets[0] && p.widgets[0].color) || colors[idx % colors.length];
        var tag = p.builtin ? '<span style="font-size:9px;color:var(--crayon-green);border:1px solid var(--crayon-green);padding:1px 5px;margin-left:6px;font-family:\'Space Mono\',monospace">[BUILTIN]</span>' : '';
        var isHomeVisible = pluginWidgetUserVisible(p.id);
        var hasWidgets = p.widgets && p.widgets.length;
        var dispName = getPluginDisplayName(p);
        h+='<div style="border:1.5px solid var(--paper-border);border-left:3px solid '+col+';background:var(--paper-surface);border-radius:var(--radius);margin-bottom:12px;box-sizing:border-box;width:100%;box-shadow:2px 2px 0px rgba(0,0,0,0.04)">';
        h+='  <div style="padding:8px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--paper-line);font-family:\'JetBrains Mono\',monospace;font-size:10px;font-weight:700">';
        h+='    <span style="color:'+col+'">'+dispName.toUpperCase()+'</span>';
        h+='    <span style="color:var(--pencil-muted)">v'+p.version+' '+tag+'</span>';
        h+='  </div>';
        h+='  <div style="padding:12px;display:flex;flex-direction:column;gap:6px">';
        h+='    <div style="font-size:12px;color:var(--ink-text);line-height:1.4">'+p.description+'</div>';
        h+='    <div style="font-size:9.5px;color:var(--pencil-muted);font-family:\'Space Mono\',monospace">'+p.id+'</div>';
        if(p.enabled && hasWidgets){
          h+='    <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;margin-top:6px;font-size:12px;color:var(--ink-text);user-select:none">';
          h+='      <input type="checkbox" onchange="togglePluginHomeSection(\''+p.id+'\', this.checked)" '+(isHomeVisible?'checked':'')+' style="width:16px;height:16px;accent-color:var(--crayon-blue);cursor:pointer">';
          h+='      <span>Show section in Today\'s Notebook</span>';
          h+='    </label>';
        }
        h+='  </div>';
        h+='  <div style="padding:8px 12px;background:var(--paper-surface-hover);border-top:1px solid var(--paper-line);display:flex;gap:8px;align-items:center;flex-wrap:wrap;box-sizing:border-box">';
        if(p.enabled){
          h+='    <button class="btn btn-pencil" onclick="closePluginsManager();openPluginPage(\''+p.id+'\')" style="flex:1;min-width:70px;padding:6px 10px;font-size:10px;font-family:\'Space Mono\',monospace">OPEN</button>';
          h+='    <button class="btn btn-pencil" onclick="openPluginSettings(\''+p.id+'\')" style="padding:6px 10px;font-size:10px;font-family:\'Space Mono\',monospace">⚙ SETTINGS</button>';
        }
        h+='    <button class="btn '+(p.enabled?'btn-pencil':'btn-wax')+'" onclick="pluginToggle(\''+p.id+'\','+(p.enabled?'false':'true')+')" style="flex:1;min-width:70px;padding:6px 10px;font-size:10px;font-family:\'Space Mono\',monospace">'+(p.enabled?'DISABLE':'ENABLE')+'</button>';
        if(!p.builtin){
          h+='    <button class="btn btn-wax-red" onclick="pluginRemove(\''+p.id+'\')" style="padding:6px 8px;font-size:11px" title="Uninstall">&#x1F5D1;</button>';
        }
        h+='  </div>';
        h+='</div>';
      });
      list.innerHTML=h;
    }
  }
  loadPluginsStore(store, installed);
}

function togglePluginHomeSection(id, checked){
  var s = getPluginSettings(id);
  s.widgetSize = checked ? 'medium' : 'hidden';
  savePluginSettings(id, s);
  loadPluginNav();
  toast(checked ? 'Section pinned to Today\'s Notebook' : 'Section removed from Today\'s Notebook');
}
async function loadPluginsStore(el, installed){
  if(!el)return;
  var store=[];
  try{
    var r=await fetch(BASE+'/plugins/index');
    var j=await r.json();
    store=(j&&j.plugins)||[];
  }catch(e){}
  if(!store.length){el.innerHTML='<div style="color:var(--text-inactive);padding:8px 0">Store unavailable. Plugin index could not be fetched.</div>';return;}
  var h='';
  store.forEach(function(p){
    var isInstalled=installed.some(function(i){return i.id===p.id;});
    h+='<div style="border:1px solid var(--border);border-radius:10px;padding:10px;margin-bottom:8px;background:var(--surface)">';
    h+='<div style="display:flex;justify-content:space-between;align-items:center">';
    h+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:12px;font-weight:700;letter-spacing:0.04em">'+p.name+'</span>';
    h+='<span style="font-size:10px;color:var(--text-inactive)">v'+p.version+'</span>';
    h+='</div>';
    h+='<div style="font-size:11px;color:var(--text-inactive);margin-top:4px">'+p.shortDescription+'</div>';
    h+='<div style="font-size:10px;color:var(--text-inactive);margin-top:4px;font-family:\'Space Mono\',monospace">'+p.author+'</div>';
    h+='<button class="btn" onclick="pluginInstall(\''+p.id+'\',\''+p.bundleUrl.replace(/'/g,"\\'")+'\')" style="width:100%;margin-top:10px;padding:8px;font-size:11px;font-family:\'Space Mono\',monospace;'+(isInstalled?'opacity:0.5':'')+'" '+(isInstalled?'disabled':'')+'>'+(isInstalled?'INSTALLED':'INSTALL')+'</button>';
    h+='</div>';
  });
  el.innerHTML=h;
}
function openPluginsManager(){
  document.getElementById('mainFab').style.display='none';
  _pushOv();
  var el=document.getElementById('pluginsPage');el.scrollTop=0;el.classList.add('show');
  loadPluginsManager();
}
function openCompanion(){
  try{fetch(BASE+'/sync/trigger',{method:'POST'})}catch(e){}
  var url=window.location.origin+'/companion.html';
  window.open(url,'_blank');
  toast('Opening companion...');
}
function closePluginsManager(){
  document.getElementById('mainFab').style.display='flex';
  document.getElementById('pluginsPage').classList.remove('show');
}
async function pluginToggle(id,enabled){
  try{
    await fetch(BASE+'/plugins/'+id+'/'+(enabled?'enable':'disable'),{method:'POST'});
    toast(enabled?'Plugin enabled':'Plugin disabled');
  }catch(e){toast('Failed to toggle plugin');}
  await loadPluginNav();
  loadPluginsManager();
}
async function pluginRemove(id){
  if(!confirm('Uninstall plugin '+id+'?'))return;
  try{
    var r=await fetch(BASE+'/plugins/'+id+'/remove',{method:'POST'});
    var j=await r.json();
    if(j.ok)toast('Plugin uninstalled');
    else toast('Failed to uninstall');
  }catch(e){toast('Failed to uninstall');}
  await loadPluginNav();
  loadPluginsManager();
}
async function pluginToggleFeature(id,feature,enabled){
  try{
    await fetch(BASE+'/plugins/'+id+'/feature',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({feature:feature,enabled:enabled})});
    toast(feature.toUpperCase()+(enabled?' ON':' OFF'));
  }catch(e){toast('Failed to update '+feature);}
  await loadPluginNav();
  loadPluginsManager();
}
async function pluginInstall(id,bundleUrl){
  try{
    toast('Installing '+id+'...');
    var r=await fetch(BASE+'/plugins/install',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,bundle_url:bundleUrl})});
    var j=await r.json();
    if(j.ok){toast('Plugin installed!');}
    else {toast('Install failed: '+(j.error||'unknown'));}
  }catch(e){toast('Install failed');}
  await loadPluginNav();
  loadPluginsManager();
}
/* Import a plugin bundle (.zip) selected via the Android SAF picker. The bridge
   call is async: it returns immediately and pushes the result back through
   window._v07PluginImportDone when the picker finishes. */
var _zipImportPending=false;
async function pluginImportZip(){
  if(_zipImportPending)return;
  var status=document.getElementById('pluginsImportStatus');
  if(!window.AndroidV07||!AndroidV07.call){if(status)status.textContent='Import unavailable here';return;}
  var r;
  try{ r=JSON.parse(AndroidV07.call('importPlugin',null)); }
  catch(e){ if(status)status.textContent='Import failed'; toast('Import failed'); return; }
  if(r&&r.ok){ _zipImportPending=true; if(status)status.textContent='Selecting file…'; }
  else{ if(status)status.textContent=(r&&r.error)||'Import failed'; toast('Import failed: '+((r&&r.error)||'unknown')); }
}
window._v07PluginImportDone=function(res){
  _zipImportPending=false;
  var status=document.getElementById('pluginsImportStatus');
  if(res&&res.ok){ toast('Plugin installed from zip!'); if(status)status.textContent='Imported ✓'; }
  else{ toast('Import failed: '+((res&&res.error)||'unknown')); if(status)status.textContent=(res&&res.error)||'Import failed'; }
  loadPluginNav();
  loadPluginsManager();
};


function openPalettePanel() {
  var overlay = document.createElement('div');
  overlay.id = 'cmdPaletteOverlay';
  overlay.className = 'cmd-palette-overlay';
  var panel = document.createElement('div');
  panel.className = 'cmd-palette-panel';
  var icons = {
    task:'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z',
    think:'M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z',
    mood:'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5-6c.78 2.34 2.72 4 5 4s4.22-1.66 5-4H7zm1-2c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm8 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1z',
    bolt:'M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21z',
    run:'M13.49 5.48c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm-3.6 13.9l1-4.4 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.56-.89-1.68-1.25-2.65-.84L7 11v5h2v-3.4l1.8-.7-1.6 8.1-4.9-1-.4 2 7 1.4z',
    win:'M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z',
    habit:'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z',
    pushups:'M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z',
    panic:'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z'
  };
  function makeRow(icon, label, arrow, onclick) {
    var row = document.createElement('div');
    row.className = 'cmd-palette-row';
    row.innerHTML = '<svg viewBox="0 0 24 24"><path d="'+icons[icon]+'"/></svg><span class="cmd-label">'+label+'</span>'+(arrow?'<span class="cmd-arrow">\u2192</span>':'');
    row.onclick = onclick;
    return row;
  }
  function makeDivider(text) {
    var d = document.createElement('div');
    d.style.cssText = "padding:6px 16px 2px;font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.2em";
    d.textContent = text;
    return d;
  }
  function makeFabRow(pluginId, fab) {
    var row = document.createElement('div');
    row.className = 'cmd-palette-row';
    var icon = fab.icon || 'extension';
    var label = fab.label || 'PLUGIN';
    row.innerHTML = _pluginIconHtml(icon, 18, 'var(--text)')+'<span class="cmd-label">'+label+'</span><span class="cmd-arrow">\u2192</span>';
    row.onclick = function(){ closeCmdPalette(); runPluginAction(pluginId, fab); };
    return row;
  }
  function renderPage1() {
    panel.innerHTML = '';
    panel.appendChild(makeRow('task','TASK+',false,function(){closeCmdPalette();openModal('task')}));
    panel.appendChild(makeRow('think','THINK',false,function(){closeCmdPalette();openModal('think')}));
    panel.appendChild(makeRow('mood','MOOD',false,function(){closeCmdPalette();openModal('mood')}));
    panel.appendChild(makeRow('bolt','ENERGY',false,function(){closeCmdPalette();openModal('energy')}));
    panel.appendChild(makeRow('run','RUN',false,function(){closeCmdPalette();openModal('run')}));
    if(window.PLUGIN_FAB&&window.PLUGIN_FAB.length){
      panel.appendChild(makeDivider('PLUGINS'));
      (window.PLUGIN_FAB||[]).forEach(function(p){
        (p.fab||[]).forEach(function(fab){panel.appendChild(makeFabRow(p.id, fab));});
      });
    }
    var moreRow = makeRow(null,'MORE',true,function(){renderPage2()});
    moreRow.innerHTML = '<span class="cmd-label" style="font-size:16px;letter-spacing:2px"> \u2026 </span><span class="cmd-label">MORE</span><span class="cmd-arrow">\u2192</span>';
    panel.appendChild(moreRow);
    panel.querySelectorAll('.cmd-palette-row').forEach(function(r,i){
      r.style.opacity='0';r.style.transform='translateY(8px)';
      setTimeout(function(){r.style.transition='all 0.18s ease';r.style.opacity='1';r.style.transform='translateY(0)'},40+i*25);
    });
  }
  function renderPage2() {
    panel.innerHTML = '';
    var backRow = document.createElement('div');
    backRow.className = 'cmd-palette-row';
    backRow.innerHTML = '<span class="cmd-label" style="font-size:14px">\u2190</span><span class="cmd-label">BACK</span>';
    backRow.onclick = function(){renderPage1()};
    panel.appendChild(backRow);
    panel.appendChild(makeRow('win','WIN',false,function(){closeCmdPalette();openModal('win')}));
    panel.appendChild(makeRow('habit','HABIT',false,function(){closeCmdPalette();openModal('habit')}));
    panel.appendChild(makeRow('pushups','PUSHUPS',false,function(){closeCmdPalette();openModal('pushups')}));
    panel.appendChild(makeRow('panic','PANIC',false,function(){closeCmdPalette();openModal('panic')}));
    panel.querySelectorAll('.cmd-palette-row').forEach(function(r,i){
      r.style.opacity='0';r.style.transform='translateX(20px)';
      setTimeout(function(){r.style.transition='all 0.18s ease';r.style.opacity='1';r.style.transform='translateX(0)'},30+i*25);
    });
  }
  overlay.onclick = function(e){if(e.target===overlay)closeCmdPalette()};
  overlay.appendChild(panel);
  document.body.appendChild(overlay);
  requestAnimationFrame(function(){overlay.classList.add('open')});
  renderPage1();
  requestAnimationFrame(function(){requestAnimationFrame(function(){panel.classList.add('show')})});
}




function closeCmdPalette() {
  var overlay = document.getElementById('cmdPaletteOverlay');
  if(overlay){overlay.remove()}
}

// BASE is initialized at the top of this script
const DEFAULT_DAILY_TARGET = 150;
function _pushOv(){try{history.pushState({ov:1},'',location.href)}catch(e){}}
var CATEGORY_ICONS = {
  mood: '\u{1F60A}',
  energy: '\u{26A1}',
  metrics: '\u{1F4CA}',
  habits: '\u{1F3AF}',
  journal: '\u{1F4DD}',
  thought: '\u{1F4AD}',
  dsa: '\u{1F4DA}',
  chess: '\u{265F}',
  running: '\u{1F3C3}',
  panics: '\u{1F630}',
  sessions: '\u{23F1}',
  tasks: '\u{1F4CB}',
  shares: '\u{1F512}'
};
const MOOD_LABELS={happy:'\u{1F60A} Happy',energetic:'\u{26A1} Energetic',motivated:'\u{1F680} Motivated',stressed:'\u{1F630} Stressed',anxious:'\u{1F61F} Anxious',tired:'\u{1F634} Tired',confused:'\u{1F615} Confused',relaxed:'\u{1F60C} Relaxed',frustrated:'\u{1F624} Frustrated',hopeful:'\u{1F31F} Hopeful'};
const ENERGY_LABELS={high:'\u{1F525} High',moderate:'\u{26A1} Moderate',balanced:'\u{2696}\u{FE0F} Balanced',low:'\u{1FAB5} Low',exhausted:'\u{1F480} Exhausted'};
function moodLabel(m){return MOOD_LABELS[m]||(m?m:'--')}
function energyLabel(e){return ENERGY_LABELS[e]||(e?e:'--')}
function localDate(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function localDateTime(){return localDate()+'T'+String(new Date().getHours()).padStart(2,'0')+':'+String(new Date().getMinutes()).padStart(2,'0')}
function activityLabel(a){
  if(!a) return '--';
  if(a === '__custom__') return '+ Add Activity';
  var str = String(a).replace(/_/g, ' ');
  return str.replace(/\b\w/g, function(l){ return l.toUpperCase(); });
}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}

function formatRunSeconds(raw, distKm){
  if(raw == null || raw === '') return 0;
  if(typeof raw === 'string' && raw.includes(':')){
    var p = raw.split(':');
    return (parseInt(p[0], 10) || 0) * 60 + (parseInt(p[1], 10) || 0);
  }
  var val = Number(raw);
  if(isNaN(val) || val <= 0) return 0;
  var dist = Number(distKm) || 0;
  var isSec = (dist > 0) ? (val / dist > 20) : (val >= 100);
  return isSec ? Math.round(val) : Math.round(val * 60);
}

function formatRunDuration(raw, distKm){
  if(raw == null || raw === '') return '--';
  if(typeof raw === 'string' && raw.includes(':')){
    var p = raw.split(':');
    var rm = parseInt(p[0], 10) || 0;
    var rs = parseInt(p[1], 10) || 0;
    return rm + 'm' + (rs > 0 ? ' ' + (rs < 10 ? '0' : '') + rs + 's' : '');
  }
  var sec = formatRunSeconds(raw, distKm);
  if(sec <= 0) return '--';
  var m = Math.floor(sec / 60);
  var s = sec % 60;
  if(s > 0) return m + 'm ' + (s < 10 ? '0' : '') + s + 's';
  return m + 'm';
}

window.addEventListener('message', function(e){
  if(!e.data || typeof e.data !== 'object') return;
  if(e.data.type === 'setPluginWidgetSize'){
    var pid = e.data.pluginId;
    var sz = e.data.size;
    if(pid && sz){
      var s = getPluginSettings(pid);
      s.widgetSize = sz;
      savePluginSettings(pid, s);
      renderPluginWidgets();
      toast('Widget updated to ' + sz.toUpperCase());
    }
  } else if(e.data.type === 'refreshDashboardWidgets'){
    renderPluginWidgets();
  }
});

function toast(msg){
  const el=document.getElementById('toast');
  if(!el){ console.error('Toast element not found'); return; }
  el.textContent=msg;
  el.classList.add('show');
  setTimeout(()=>el.classList.remove('show'),2000);
}

function customPrompt(message,defaultVal){
  return new Promise(function(resolve){
    var overlay=document.createElement('div');
    overlay.style.cssText='position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
    var box=document.createElement('div');
    box.style.cssText='background:var(--surface-container);border:1px solid var(--border);border-radius:12px;padding:20px;width:100%;max-width:340px';
    box.innerHTML='<div style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:14px;font-weight:600;margin-bottom:12px;color:var(--primary)">'+message+'</div>'+
      '<input id="customPromptInput" type="text" value="'+(defaultVal||'')+'" style="width:100%;padding:10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px;outline:none;font-family:\'JetBrains Mono\',\'Mono\',monospace;margin-bottom:12px">'+
      '<div style="display:flex;gap:8px">'+
      '<button id="customPromptOk" class="btn btn-accent" style="flex:1">OK</button>'+
      '<button id="customPromptCancel" class="btn" style="flex:1">Cancel</button></div>';
    overlay.appendChild(box);
    document.body.appendChild(overlay);
    var input=document.getElementById('customPromptInput');
    input.focus();
    function close(val){document.body.removeChild(overlay);resolve(val)}
    document.getElementById('customPromptOk').onclick=function(){close(input.value)};
    document.getElementById('customPromptCancel').onclick=function(){close(null)};
    input.onkeydown=function(e){if(e.key==='Enter')close(input.value);if(e.key==='Escape')close(null)}
  });
}

function closeModal(){
  document.getElementById('modalOverlay').classList.remove('show');
}

async function logClientError(context,error,extra){
  try{
    var payload={level:'error',context:context,message:error?.toString?.()||String(error)};
    if(extra) Object.assign(payload,extra);
    await fetch(BASE+'/client/log',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  }catch(_){}
}

function wrapFetch(promise,context,extra){
  return promise.catch(function(e){logClientError(context,e,extra);return Promise.reject(e)});
}

async function api(method,path,body){
  const opts={method,headers:{}};
  if(body){
    opts.headers['Content-Type']='application/json';
    opts.body=JSON.stringify(body);
  }
  const r=await wrapFetch(fetch(BASE+path,opts),'api',{method:method,path:path});
  return r.json();
}

async function fetchPost(path){
  try{
    const r=await wrapFetch(fetch(BASE+path,{method:'POST'}),'fetchPost',{path:path});
    const j=await r.json().catch(()=>({ok:false,detail:'Invalid JSON'}));
    if(j.ok) toast('Done!');
    else if(j.detail) toast(j.detail);
    else toast('Done!');
    loadDashboard();
  }catch(e){logClientError('fetchPost',e,{path:path});toast('Error: '+e.message)}
}

async function fetchPostParams(path,params){
  const qs=new URLSearchParams();
  for(const[k,v]of Object.entries(params)){
    if(v!==null && v!==undefined && v!=='') qs.append(k,v);
  }
  try{
    const r=await wrapFetch(fetch(BASE+path+'?'+qs.toString(),{method:'POST'}),'fetchPostParams',{path:path,params:JSON.stringify(params)});
    const j=await r.json().catch(()=>({ok:false,detail:'Invalid JSON'}));
    if(j.ok) toast('Logged!');
    else if(j.detail) toast(j.detail);
    loadDashboard();
  }catch(e){logClientError('fetchPostParams',e,{path:path});toast('Error: '+e.message)}
}

function buildFields(container,fields,extra){
  container.innerHTML='';
  fields.forEach(function(f){
    var label=document.createElement('label');
    label.textContent=f.label;
    container.appendChild(label);
    var el;
    if(f.type==='select'){
      el=document.createElement('select');
      (f.options||[]).forEach(function(o){
        var opt=document.createElement('option');
        if(typeof o==='object'&&o!==null){opt.value=o.value;opt.textContent=o.label}
        else{opt.value=o;opt.textContent=o}
        el.appendChild(opt)
      });
    }else if(f.type==='textarea'){
      el=document.createElement('textarea');
    }else if(f.type==='number'){
      el=document.createElement('input');el.type='number';if(f.step)el.step=f.step;
    }else if(f.type==='date'){
      el=document.createElement('input');el.type='date';
    }else if(f.type==='time'){
      el=document.createElement('input');el.type='time';
    }else{
      el=document.createElement('input');el.type='text';
    }
    el.dataset.key=f.key;
    el.dataset.required=f.required!==false?'1':'0';
    el.id='modal_field_'+f.key;
    container.appendChild(el);
    if(f.chips){
      var chipDiv=document.createElement('div');
      chipDiv.className='chip-list';
      chipDiv.id='chips_'+f.key;
      f.chips.forEach(function(c){
        var chip=document.createElement('span');
        chip.className='chip';
        chip.textContent=c;
        chip.onclick=function(){el.value=c;chipDiv.querySelectorAll('.chip').forEach(function(x){x.classList.remove('selected')});chip.classList.add('selected')};
        chipDiv.appendChild(chip);
      });
      container.appendChild(chipDiv);
    }
  });
  if(extra) Object.assign(extra,{});
}

// ─── Edit quick-log ───────────────────────────────────────────────────────────

document.querySelectorAll('[data-edit]').forEach(function(btn){
  btn.addEventListener('click',async function(){
    var field=btn.dataset.edit;
    var value=await customPrompt('What should the new value be for "'+field+'"?');
    if(value===null||value.trim()==='')return;
    var qs='field='+encodeURIComponent(field)+'&value='+encodeURIComponent(value.trim());
    wrapFetch(fetch(BASE+'/edit?'+qs,{method:'POST'}),'edit',{field:field,value:value}).then(function(r){return r.json()}).then(function(j){
      if(j.ok) toast('Edited '+field+'!');
      else if(j.detail) toast(j.detail);
      loadDashboard();
    }).catch(function(e){logClientError('edit',e,{field:field});toast('Error')});
  });
});

// ─── Modals ───────────────────────────────────────────────────────────────────

var thinkTopics=[];

const MODALS={
  mood:{title:'Log Mood',fields:[{type:'select',label:'Mood',key:'mood',options:[]},{type:'text',label:'Note (optional)',key:'note',required:false}],submit:async function(vals){return fetchPostParams('/log/mood',vals)}},
  energy:{title:'Log Energy',fields:[{type:'select',label:'Energy',key:'energy',options:[]},{type:'text',label:'Note (optional)',key:'note',required:false}],submit:async function(vals){return fetchPostParams('/log/energy',vals)}},
  doom:{title:'Log Doom Scroll',fields:[{type:'number',label:'Minutes',key:'minutes'}],submit:async function(vals){return fetchPostParams('/log/doom',vals)}},
  pushups:{title:'Log Pushups',fields:[{type:'number',label:'Count',key:'count'}],submit:async function(vals){return fetchPostParams('/log/pushups',vals)}},
  panic:{title:'Log Panic',fields:[{type:'text',label:'Trigger (optional)',key:'trigger',required:false}],submit:async function(vals){return fetchPostParams('/log/panic',vals)}},
  think:{title:'Capture Thought',fields:[{type:'text',label:'Topic',key:'topic',chips:[]},{type:'textarea',label:'Text',key:'text'}],submit:async function(vals){return fetchPostParams('/log/think',vals)},onOpen:async function(){
    var topicField=document.getElementById('modal_field_topic');
    var chipsDiv=document.getElementById('chips_topic');
    if(!chipsDiv)return;
    var topics=[];
    try{
      topics=thinkTopics.slice();
    }catch(e){}
    if(topics.length===0){
      try{
        var r=await fetch(BASE+'/meta/think-topics');
        var j=await r.json();
        if(Array.isArray(j))topics=j;
      }catch(e){}
    }
    chipsDiv.innerHTML='';
    if(topics.length>0){
      topics.forEach(function(t){
        var chip=document.createElement('span');
        chip.className='chip';
        chip.textContent=t;
        chip.onclick=function(){topicField.value=t;chipsDiv.querySelectorAll('.chip').forEach(function(x){x.classList.remove('selected')});chip.classList.add('selected')};
        chipsDiv.appendChild(chip);
      });
    }
    var otherChip=document.createElement('span');
    otherChip.className='chip';
    otherChip.textContent='Other\u2026';
    otherChip.style.borderStyle='dashed';
    otherChip.onclick=function(){topicField.value='';topicField.focus();chipsDiv.querySelectorAll('.chip').forEach(function(x){x.classList.remove('selected')});otherChip.classList.add('selected')};
    chipsDiv.appendChild(otherChip);
    topicField.value='Quick';
    chipsDiv.querySelectorAll('.chip').forEach(function(c){if(c.textContent==='Quick'){c.classList.add('selected')}else{c.classList.remove('selected')}});
  }},
  win:{title:'Log Win',fields:[{type:'textarea',label:'Win',key:'text'}],submit:async function(vals){return fetchPostParams('/log/win',vals)}},
  journal:{title:'Journal Entry',fields:[{type:'textarea',label:'Entry',key:'text'}],submit:async function(vals){return fetchPostParams('/log/journal',vals)}},
  dsa:{title:'Log DSA Problem',fields:[{type:'text',label:'Topic',key:'topic'},{type:'text',label:'Problem Name',key:'name'},{type:'select',label:'Platform',key:'platform',options:['LeetCode','Codeforces','CodeChef','HackerRank','Striver','Other']},{type:'select',label:'Difficulty',key:'difficulty',options:['easy','medium','hard']},{type:'text',label:'Description (optional)',key:'description',required:false},{type:'text',label:'Approach (optional)',key:'approach',required:false}],submit:async function(vals){return fetchPostParams('/log/dsa',vals)}},
  chess:{title:'Log Chess Match',fields:[{type:'text',label:'Opponent',key:'opponent'},{type:'select',label:'Result',key:'result',options:['win','loss','draw']},{type:'select',label:'Color',key:'color',options:['white','black']},{type:'text',label:'Notes (optional)',key:'notes',required:false}],submit:async function(vals){return fetchPostParams('/log/chess',vals)}},
  run:{title:'Log Run',fields:[{type:'number',label:'Distance (km)',key:'distance_km',step:0.1},{type:'text',label:'Duration (mm:ss)',key:'duration_min',placeholder:'25:30'},{type:'select',label:'Type',key:'run_type',options:['easy','tempo','interval','long','race']},{type:'text',label:'Notes (optional)',key:'notes',required:false}],submit:async function(vals){return fetchPostParams('/log/run',vals)}},
  task:{title:'Create Task',fields:[{type:'text',label:'Title',key:'title'},{type:'date',label:'Deadline',key:'deadline',required:true},{type:'time',label:'Time (optional)',key:'time',required:false},{type:'select',label:'Priority',key:'priority',options:['low','medium','high']}],submit:async function(vals){try{var r=await fetch(BASE+'/task?'+new URLSearchParams(vals).toString(),{method:'POST'});var j=await r.json();if(j.ok)toast('Task created!');else if(j.detail)toast(j.detail);loadDashboard()}catch(e){toast('Error')}}},
  habit:{title:'Toggle Habit',fields:[{type:'select',label:'Activity',key:'activity',options:[]},{type:'select',label:'State',key:'on',options:[{value:'true',label:'Done'},{value:'false',label:'Skipped'}]},{type:'text',label:'Notes (optional)',key:'notes',required:false}],submit:async function(vals){return fetchPostParams('/log/habit',{activity:vals.activity,on:vals.on==='true',notes:vals.notes})}},
  'session-start':{title:'Start Session',fields:[{type:'select',label:'Activity',key:'activity',options:[]},{type:'text',label:'Custom Label (optional)',key:'custom_label',required:false}],submit:async function(vals){try{var existing=await fetch(BASE+'/session/active').then(function(r){return r.json()});if(existing.active||existing.paused){toast('Session already active — stop it first');return}const r=await fetch(BASE+'/session/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({activity:vals.activity,custom_label:vals.custom_label||null,timer_mode:timerMode,timer_seconds:timerMode==='countdown'?timerSeconds:0})});const j=await r.json();if(j.ok){toast('Session started!');if(!timerRunning)timerStart();loadDashboard();loadSessionStatus()}else if(j.detail)toast(j.detail)}catch(e){toast('Error')}}}
};

async function loadMeta(){
  try{
    var[td]=await Promise.allSettled([
      wrapFetch(fetch(BASE+'/meta/dsa-topics'),'loadMeta',{endpoint:'/meta/dsa-topics'}).then(function(r){return r.json()})]);
    if(td.status==='fulfilled'&&Array.isArray(td.value))MODALS.dsa.fields[0].options=td.value;
    var acts=await wrapFetch(fetch(BASE+'/meta/activities'),'loadMeta',{endpoint:'/meta/activities'}).then(function(r){return r.json()}).catch(function(){return[]});
    if(Array.isArray(acts)){MODALS.habit.fields[0].options=acts;MODALS['session-start'].fields[0].options=acts}
    var moodRes=await wrapFetch(fetch(BASE+'/meta/moods'),'loadMeta',{endpoint:'/meta/moods'}).then(function(r){return r.json()}).catch(function(){return[]});
    var energyRes=await wrapFetch(fetch(BASE+'/meta/energies'),'loadMeta',{endpoint:'/meta/energies'}).then(function(r){return r.json()}).catch(function(){return[]});
    if(Array.isArray(moodRes))MODALS.mood.fields[0].options=moodRes;
    if(Array.isArray(energyRes))MODALS.energy.fields[0].options=energyRes;
    thinkTopics=await wrapFetch(fetch(BASE+'/meta/think-topics'),'loadMeta',{endpoint:'/meta/think-topics'}).then(function(r){return r.json()}).catch(function(){return[]});
    if(Array.isArray(thinkTopics))MODALS.think.fields[0].chips=thinkTopics;
  }catch(e){}
}
loadMeta();

document.querySelectorAll('[data-modal]').forEach(function(btn){
  btn.addEventListener('click',function(){openModal(btn.dataset.modal)});
});

function openModal(name){
  var cfg=MODALS[name];
  if(!cfg)return;
  document.getElementById('modalTitle').textContent=cfg.title;
  var fieldsDiv=document.getElementById('modalFields');
  buildFields(fieldsDiv,cfg.fields);
  if(cfg.onOpen) cfg.onOpen();
  document.getElementById('modalSubmit').onclick=async function(){
    var data={};
    var valid=true;
    fieldsDiv.querySelectorAll('input,select,textarea').forEach(function(inp){
      var v=inp.value.trim();
      if(!v&&inp.dataset.required==='1')valid=false;
      data[inp.dataset.key]=v;
    });
    if(!valid){toast('Fill required fields');return}
    closeModal();
    await cfg.submit(data);
  };
  document.getElementById('modalOverlay').classList.add('show');
}

async function logCheckin(){
  var overlay=document.getElementById('modalOverlay');
  document.getElementById('modalTitle').textContent='Check-in';
  document.getElementById('modalFields').innerHTML=
    '<label>Note (optional)</label><input id="ciNote" placeholder="How are you?">'+
    '<label>Date & Time</label><input type="datetime-local" id="ciDateTime" value="'+localDateTime()+'">';
  document.getElementById('modalSubmit').onclick=async function(){
    var note=document.getElementById('ciNote').value;
    var dt=document.getElementById('ciDateTime').value;
    var ts=dt?dt+':00':'';
    var params={note:note||''};
    if(ts){params.ts=ts;params.date=dt.slice(0,10)}
    await fetchPostParams('/log/checkin',params);
    closeModal();loadDashboard();loadSleepUpTimeline();
  };
  overlay.classList.add('show');
}
