          <div id="psmMeta" style="font-family:'Space Mono','Mono',monospace;font-size:9.5px;color:var(--text-inactive);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">v1.0.0 &bull; by Author</div>
        </div>
