      <span id="tasksProgressLabel" style="font-size:11px;color:var(--secondary);font-family:'JetBrains Mono','Mono',monospace"></span>
    </div>
    <div style="width:100%;height:2px;background:var(--border);overflow:hidden">
      <div id="tasksProgressBar" style="height:100%;background:var(--secondary);transition:width 0.3s"></div>
