      <input type="text" id="newTagName" placeholder="New tag name..." style="flex:1;padding:8px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13px;font-family:'JetBrains Mono','Mono',monospace;outline:none">
      <button class="btn btn-accent" onclick="createTag()" style="padding:8px 12px;font-size:12px">ADD</button>
