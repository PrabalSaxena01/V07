</div>

<div class="page-overlay" id="appUsagePage">
  <div class="page-header">
    <div style="display:flex;align-items:center;gap:8px">
      <img src="v07_logo.png" onclick="goToHome()" style="width:24px;height:24px;border-radius:6px;object-fit:contain;cursor:pointer" alt="Home">
      <h2>SCREEN TIME</h2>
    </div>
  </div>
  <div style="display:flex;gap:8px;margin-bottom:12px;align-items:center">
    <button onclick="screenDateNav(-1)" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:none;border:1px solid var(--border);border-radius:6px;cursor:pointer;color:var(--text-inactive);font-family:'Space Mono','Mono',monospace;font-size:12px;flex-shrink:0">&lt;</button>
    <input type="date" id="appUsageDate" onchange="loadAppUsageForDate()" style="background:var(--surface-container-low);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:8px 12px;font-size:12px;font-family:'JetBrains Mono','Mono',monospace;flex:1">
    <button onclick="screenDateNav(1)" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:none;border:1px solid var(--border);border-radius:6px;cursor:pointer;color:var(--text-inactive);font-family:'Space Mono','Mono',monospace;font-size:12px;flex-shrink:0">&gt;</button>
    <div id="screenTimeBadge" style="font-family:'JetBrains Mono','Mono',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em"></div>
  </div>
  <div id="appUsageContent">
    <div style="color:var(--text-inactive);font-size:13px;text-align:center;padding:20px">Loading...</div>
  </div>
</div>

<div class="page-overlay" id="sessionsPage">
  <div class="page-header">
    <div style="display:flex;align-items:center;gap:8px">
      <img src="v07_logo.png" onclick="goToHome()" style="width:24px;height:24px;border-radius:6px;object-fit:contain;cursor:pointer" alt="Home">
      <h2>FOCUS TIMER</h2>
    </div>
  </div>

  <!-- DAILY TARGET -->
  <div class="section-title">DAILY FOCUS TARGET</div>
  <div class="card" style="border:1px solid var(--border)">
    <div style="display:flex;gap:8px;align-items:flex-end">
      <div style="flex:1">
        <label style="display:block;font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:4px">DAILY TARGET (MINUTES)</label>
        <input type="number" id="sessTargetMinutes" min="1" style="width:100px;padding:10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:14px;text-align:center;outline:none;font-family:'JetBrains Mono','Mono',monospace">
      </div>
      <button onclick="saveDailyTarget()" class="btn btn-wax" style="padding:10px 16px;font-size:10px">SET</button>
    </div>
  </div>

  <!-- TIMER -->
  <div class="section-title">TIMER &amp; STOPWATCH</div>
  <div class="card" style="text-align:center;border:1px solid var(--border)">
    <div style="display:flex;gap:0;margin-bottom:12px;border-bottom:1px solid var(--border)">
      <button id="modeCountdown" onclick="setTimerMode('countdown')" style="flex:1;padding:10px;background:none;border:none;border-bottom:2px solid var(--primary);color:var(--primary);font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.1em;cursor:pointer;text-transform:uppercase">COUNTDOWN</button>
      <button id="modeStopwatch" onclick="setTimerMode('stopwatch')" style="flex:1;padding:10px;background:none;border:none;border-bottom:2px solid transparent;color:var(--text-inactive);font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.1em;cursor:pointer;text-transform:uppercase">STOPWATCH</button>
    </div>
    <div style="font-family:'JetBrains Mono','Mono',monospace;font-size:56px;font-weight:600;color:var(--ink-text);letter-spacing:-0.02em;margin:12px 0 16px;font-variant-numeric:tabular-nums;line-height:1" id="timerDisplay">25:00</div>
    <div id="timerPresets">
      <div style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap">
        <button id="timerPreset25" onclick="setTimer(25,0)" class="btn-pencil" style="padding:6px 12px;font-size:11px">25M</button>
        <button id="timerPreset15" onclick="setTimer(15,0)" class="btn-pencil" style="padding:6px 12px;font-size:11px">15M</button>
        <button id="timerPreset10" onclick="setTimer(10,0)" class="btn-pencil" style="padding:6px 12px;font-size:11px">10M</button>
        <button id="timerPreset5" onclick="setTimer(5,0)" class="btn-pencil" style="padding:6px 12px;font-size:11px">5M</button>
        <button id="timerPresetCustom" onclick="customTimer()" class="btn-pencil" style="padding:6px 12px;font-size:11px">CUSTOM</button>
      </div>
    </div>
  </div>

  <!-- SESSION ACTIVITY -->
  <div class="section-title">SESSION ACTIVITY</div>
  <div class="card" style="border:1px solid var(--border)">
    <div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
      <div style="flex:1;min-width:120px">
        <label style="display:block;font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:4px">ACTIVITY</label>
        <div class="custom-select" style="position:relative;width:100%">
          <input type="hidden" id="sessActivity" value="">
          <button type="button" id="sessActivityTrigger" onclick="toggleActivityDropdown()" style="width:100%;padding:10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:13px;outline:none;font-family:'JetBrains Mono','Mono',monospace;text-align:left;cursor:pointer;display:flex;justify-content:space-between;align-items:center">
            <span id="sessActivityLabel">Select activity</span>
            <span style="color:var(--text-inactive)">&#x25BE;</span>
          </button>
          <div id="sessActivityDropdown" style="display:none;position:absolute;top:100%;left:0;right:0;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:4px;margin-top:2px;max-height:240px;overflow-y:auto;font-family:'JetBrains Mono','Mono',monospace;font-size:13px"></div>
        </div>
      </div>
      <div style="flex:1;min-width:100px">
        <label style="display:block;font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:4px">LABEL</label>
        <input type="text" id="sessLabel" style="width:100%;padding:10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:13px;outline:none;font-family:'JetBrains Mono','Mono',monospace" placeholder="e.g. System Design">
      </div>
    </div>
    <div style="margin-bottom:10px;display:none" id="customActivityWrap">
      <label style="display:block;font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:4px">CUSTOM ACTIVITY</label>
      <input type="text" id="customActivityInput" style="width:100%;padding:10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:13px;outline:none;font-family:'JetBrains Mono','Mono',monospace" placeholder="e.g. Guitar Practice">
    </div>

    <div style="display:flex;gap:8px">
      <button class="btn-wax btn-wax-green" onclick="sessionStart()" style="flex:1">&#x25B6; START FOCUS</button>
      <button class="btn-wax btn-wax-amber" onclick="sessionPause()" id="sessPauseBtn" style="flex:1;display:none">&#x23F8; PAUSE</button>
      <button class="btn-wax btn-wax-green" onclick="sessionResume()" id="sessResumeBtn" style="flex:1;display:none">&#x25B6; RESUME</button>
      <button class="btn-wax btn-wax-red" onclick="sessionStop()" id="sessStopBtn" style="flex:1;display:none">&#x23F9; END</button>
    </div>
    <div id="sessionStatusText" style="text-align:center;font-family:'JetBrains Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);margin-top:8px"></div>
  </div>

  <div style="display:flex;gap:8px;margin-bottom:12px;margin-top:8px">
    <label style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:9px;color:var(--text-inactive);letter-spacing:0.15em;text-transform:uppercase">DATE
      <input type="date" id="sessDate" style="width:100%;padding:8px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:13px;outline:none;font-family:'JetBrains Mono','Mono',monospace;margin-top:4px">
    </label>
  </div>

  <!-- RECENT SESSIONS -->
  <div class="section-title">RECENT SESSIONS</div>
  <div id="sessionList" style="background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;padding:8px;min-height:60px"><div style="color:var(--text-inactive);font-family:'JetBrains Mono','Mono',monospace;font-size:12px;text-align:center;padding:10px">Loading...</div></div>
</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal" id="modalContent">
    <h2 id="modalTitle">Action</h2>
    <div id="modalFields"></div>
    <div class="modal-btns">
      <button class="btn" onclick="closeModal()">Cancel</button>
      <button class="btn btn-accent" id="modalSubmit">Submit</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<div class="gita-sidebar-overlay" id="gitaSidebarOverlay" onclick="closeGitaSidebar()"></div>
<div class="gita-sidebar" id="gitaSidebar">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border)">
    <div>
      <div id="readerSidebarTitle" style="font-family:'JetBrains Mono','Mono',monospace;font-size:11px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:0.05em">READING TRACKER</div>
      <div id="gitaTrackerProgress" style="font-family:'JetBrains Mono','Mono',monospace;font-size:11px;margin-top:4px"></div>
    </div>
    <button onclick="closeGitaSidebar()" style="color:var(--text-inactive);background:none;border:none;cursor:pointer;padding:4px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
  </div>
  <div id="gitaTrackerList"></div>
</div>

<div class="gita-sidebar-overlay" id="timelineSidebarOverlay" onclick="closeTimelineSidebar()"></div>
<div class="timeline-sidebar" id="timelineSidebar">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
    <div style="display:flex;align-items:center;gap:8px;cursor:pointer" onclick="goToHome()">
      <img src="v07_logo.png" style="width:24px;height:24px;border-radius:6px;object-fit:contain" alt="Home">
      <h2 style="font-size:16px">&#x1F4DC; Timeline</h2>
    </div>
  </div>
  <div style="display:flex;gap:6px;align-items:center;margin-bottom:10px">
    <input type="date" id="timelineSidebarDate" onchange="loadTimelineSidebar()" style="flex:1;padding:8px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13px;font-family:'JetBrains Mono','Mono',monospace;outline:none">
    <button class="btn" onclick="document.getElementById('timelineSidebarDate').value=localDate();loadTimelineSidebar()" style="white-space:nowrap;font-size:11px;padding:6px 10px">TODAY</button>
  </div>
  <div id="timelineSidebarContent" style="font-size:13px">
    <div style="color:var(--muted);text-align:center;padding:20px;">Loading...</div>
  </div>
</div>

<div class="checklist-page" id="checklistPage">
  <div class="page-header">
    <div style="display:flex;align-items:center;gap:8px">
      <img src="v07_logo.png" onclick="goToHome()" style="width:24px;height:24px;border-radius:6px;object-fit:contain;cursor:pointer" alt="Home">
      <h2>CHECKLIST</h2>
    </div>
  </div>
  <div class="cl-input-area">
    <input type="text" id="checklistInput" placeholder="Add a directive or task..." onkeydown="if(event.key==='Enter')addChecklistItem()">
    <div style="display:flex;align-items:center;gap:3px;flex-shrink:0">
      <span id="clFreqS" onclick="toggleClFreq('S')" style="cursor:pointer;font-family:'Space Mono','Mono',monospace;font-size:10px;font-weight:700;padding:4px 8px;border:2px solid var(--primary);color:var(--primary);background:rgba(167,200,255,0.1);text-transform:uppercase;letter-spacing:0.05em;transition:all 0.15s">S</span>
      <span id="clFreqD" onclick="toggleClFreq('D')" style="cursor:pointer;font-family:'Space Mono','Mono',monospace;font-size:10px;font-weight:700;padding:4px 8px;border:2px solid var(--border);color:var(--text-inactive);background:transparent;text-transform:uppercase;letter-spacing:0.05em;transition:all 0.15s">D</span>
      <span id="clFreqW" onclick="toggleClFreq('W')" style="cursor:pointer;font-family:'Space Mono','Mono',monospace;font-size:10px;font-weight:700;padding:4px 8px;border:2px solid var(--border);color:var(--text-inactive);background:transparent;text-transform:uppercase;letter-spacing:0.05em;transition:all 0.15s">W</span>
    </div>
    <button onclick="addChecklistItem()" style="width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;border:2px solid var(--red);background:transparent;color:var(--red);cursor:pointer;flex-shrink:0;transition:all 0.15s;flex-shrink:0"><span class="material-symbols-outlined" style="font-size:24px">add</span></button>
  </div>
  <div id="checklistItems" style="flex:1;overflow-y:auto;padding:0 16px"></div>
</div>

<div class="page-overlay" id="settingsPage">
  <div class="page-header">
    <div style="display:flex;align-items:center;gap:8px">
      <img src="v07_logo.png" onclick="goToHome()" style="width:24px;height:24px;border-radius:6px;object-fit:contain;cursor:pointer" alt="Home">
      <h2>SETTINGS</h2>
    </div>
  </div>



  <div style="display:flex;gap:8px;padding:0 0 12px">
    <button id="settingsTabGeneral" onclick="switchSettingsTab('general')" class="settings-tab active">GENERAL</button>
    <button id="settingsTabAI" onclick="switchSettingsTab('ai')" class="settings-tab">AI</button>
    <button id="settingsTabNotif" onclick="switchSettingsTab('notifications')" class="settings-tab">NOTIFICATIONS</button>
  </div>

  <!-- PANEL: GENERAL -->
  <div id="settingsPanelGeneral">
    <div class="kb-section-label">INTERFACE</div>
    <div class="kb-settings-group">
      <select id="themeSelect" onchange="setTheme(this.value)" class="kb-settings-select">
        <option value="system">System Default</option>
        <option value="dark">Dark</option>
        <option value="light">Light</option>
      </select>
    </div>

    <div class="kb-section-label">APP LIMITS</div>
    <div class="kb-settings-group">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <label style="font-size:13px;flex-shrink:0">Default limit</label>
        <input type="number" id="appLimitDefault" value="30" min="5" max="480" style="width:60px;padding:6px 8px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:13px;text-align:center" onchange="saveAppLimitDefault()">
        <span style="font-size:11px;color:var(--text-inactive)">min</span>
      </div>
      <div id="appLimitsList" style="font-size:12px;color:var(--text-inactive);font-family:'Space Mono',monospace"></div>
      <div style="font-size:10px;color:var(--text-inactive);margin-top:4px">Bubble changes color: green (&lt;50%) → amber (50-100%) → red (&gt;100%)</div>
    </div>

    <div class="kb-section-label">OVERLAY BUBBLE</div>
    <div class="kb-settings-group">
      <label class="toggle-row">
        <span style="font-size:13px">Enable Floating Overlay</span>
        <label class="kb-toggle"><input type="checkbox" id="overlayToggle" onchange="toggleOverlay(this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>
      </label>
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace">Draggable bubble with app timer. Tap to capture thoughts, URLs, or screenshots from any screen.</div>
      <div id="overlayStatus" style="font-size:11px;color:var(--text-inactive)"></div>
    </div>

    <div class="kb-section-label">ACCESSIBILITY</div>
    <div class="kb-settings-group">
      <label class="toggle-row">
        <span style="font-size:13px">Foreground Detection Service</span>
      </label>
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace">Improves app switching detection accuracy. Enable in Settings → Accessibility → V07 Dashboard.</div>
      <div id="accessibilityStatus" style="font-size:11px;color:var(--text-inactive)"></div>
    </div>

    <div class="kb-section-label">FILE VAULT</div>
    <div class="kb-settings-group">
      <div style="font-size:12px;color:var(--text-inactive);font-family:'Space Mono',monospace">PATH: <span id="vaultPathDisplay" style="color:var(--primary)">...</span></div>
      <div style="display:flex;gap:8px">
        <button class="btn" onclick="openNativeVaultPicker()" style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.05em">CHANGE_VAULT</button>
        <button class="btn" onclick="initVault()" style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.05em">INITIALIZE</button>
      </div>
    </div>


    <div class="kb-section-label">PLUGINS</div>
    <div class="kb-settings-group">
      <button class="btn" onclick="openPluginsManager()" style="font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.05em">MANAGE_PLUGINS</button>
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace">Install, enable, disable, and remove extensions.</div>
    </div>

    <div class="kb-section-label">WEB COMPANION</div>
    <div class="kb-settings-group">
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace;margin-bottom:8px;line-height:1.5">
        Connect to V07 from any browser on your computer or local network. Control focus timers, view real-time telemetry, and log notes remotely.
      </div>
      <div style="display:flex;align-items:center;gap:6px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;padding:6px 10px;margin-bottom:8px">
        <span style="font-size:10px;color:var(--primary);font-family:'Space Mono',monospace;user-select:all;word-break:break-all;flex:1" id="companionUrlDisplay">http://127.0.0.1:8765/companion.html</span>
      </div>
      <div style="display:flex;gap:8px">
        <button class="btn" onclick="copyCompanionUrl()" style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.04em">COPY LINK</button>
        <button class="btn btn-primary" onclick="openCompanion()" style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.04em">OPEN COMPANION</button>
      </div>
    </div>

    <div class="kb-section-label">ANDROID HOME SCREEN WIDGETS</div>
    <div class="kb-settings-group">
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace;margin-bottom:8px;line-height:1.5">
        Choose which V07 module renders on your Android Home Screen widget, or pin a new widget directly:
      </div>
      <div style="margin-bottom:8px">
        <label style="font-size:10px;color:var(--text-inactive);font-family:'Space Mono',monospace;display:block;margin-bottom:4px">ACTIVE WIDGET MODULE</label>
        <select id="homeWidgetTypeSelect" class="kb-settings-select" onchange="setHomeScreenWidgetModule(this.value)">
          <option value="weekly">Weekly Digest (AI Summary &amp; Multi-Metric)</option>
          <option value="reader">Book Collection (Library &amp; Reading)</option>
          <option value="tasks">Tasks &amp; Discipline (Execution &amp; Priorities)</option>
          <option value="timetracker">Time Tracker (Deep Work &amp; Focus)</option>
          <option value="habits">Habits Matrix (Streaks &amp; Consistency)</option>
          <option value="gamify">Gamify &amp; Ranks (Level &amp; XP Progression)</option>
          <option value="vitals">Vitals &amp; Mood (State &amp; Wellness)</option>
          <option value="daytracker">Day Tracker (Milestones &amp; Countdowns)</option>
          <option value="checklist">Daily Checklist (Operational Tasks)</option>
          <option value="run">Run &amp; Athletics (Distance &amp; Cadence)</option>
        </select>
      </div>

      <!-- Live Launcher Widget Vector Preview -->
      <div style="margin:10px 0 10px 0;border:1px solid var(--border);border-radius:12px;background:#151821;padding:12px;box-shadow:0 8px 24px rgba(0,0,0,0.35)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <div style="display:flex;align-items:center;gap:6px">
            <span id="hwPrevIcon" style="font-size:13px">⚡</span>
            <span id="hwPrevTitle" style="font-family:'Space Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.04em;color:#EDF2F7">WEEKLY DIGEST</span>
          </div>
          <span id="hwPrevSub" style="font-family:'Space Mono',monospace;font-size:9px;color:#718096">V07 · PREVIEW</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-bottom:8px">
          <div style="background:#191D28;border:1px solid #262C3E;border-radius:6px;padding:6px 2px;text-align:center">
            <div id="hwPrevT1V" style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:#4DE086">14.5h</div>
            <div id="hwPrevT1L" style="font-family:'Space Mono',monospace;font-size:8px;color:#718096;letter-spacing:0.04em">FOCUS</div>
          </div>
          <div style="background:#191D28;border:1px solid #262C3E;border-radius:6px;padding:6px 2px;text-align:center">
            <div id="hwPrevT2V" style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:#68A6FF">28</div>
            <div id="hwPrevT2L" style="font-family:'Space Mono',monospace;font-size:8px;color:#718096;letter-spacing:0.04em">TASKS</div>
          </div>
          <div style="background:#191D28;border:1px solid #262C3E;border-radius:6px;padding:6px 2px;text-align:center">
            <div id="hwPrevT3V" style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:#FFB84D">86%</div>
            <div id="hwPrevT3L" style="font-family:'Space Mono',monospace;font-size:8px;color:#718096;letter-spacing:0.04em">HABITS</div>
          </div>
          <div style="background:#191D28;border:1px solid #262C3E;border-radius:6px;padding:6px 2px;text-align:center">
            <div id="hwPrevT4V" style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:#A78BFA">3.8h</div>
            <div id="hwPrevT4L" style="font-family:'Space Mono',monospace;font-size:8px;color:#718096;letter-spacing:0.04em">SCREEN</div>
          </div>
        </div>
        <div id="hwPrevStatus" style="font-family:'Space Mono',monospace;font-size:9px;color:#A0AEC0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
          Mood 7.8/10 · 18km run · 12 DSA solved
        </div>
      </div>

      <div style="display:flex;gap:8px">
        <button class="btn btn-primary" onclick="setHomeScreenWidgetModule()" style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.04em">APPLY TO WIDGETS</button>
        <button class="btn btn-accent" onclick="pinHomeScreenWidget()" style="flex:1;font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.04em;display:flex;align-items:center;justify-content:center;gap:4px">
          <svg viewBox="0 -960 960 960" width="14" height="14" fill="currentColor"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/></svg>
          PIN TO HOME
        </button>
      </div>
    </div>
  </div>

  <!-- PANEL: AI -->
  <div id="settingsPanelAI" style="display:none">
    <div class="kb-section-label">CORE AI</div>
    <div class="kb-settings-group">
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace;margin-bottom:12px;line-height:1.5">
        Configure your AI credentials for core intelligence and plugin extensions. Supports Claude 3.5 Sonnet/Haiku, Gemini 2.0/1.5, OpenRouter, and OpenAI models. Stored securely on-device and never exposed to plugins.
      </div>

      <div style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <label style="font-size:12px;color:var(--text-inactive);font-family:'Space Mono',monospace">API KEY</label>
          <span id="aiKeyStatusBadge" style="font-size:10px;font-family:'Space Mono',monospace;padding:2px 8px;border-radius:3px;background:rgba(255,255,255,0.06);color:var(--text-inactive)">NOT CONFIGURED</span>
        </div>
        <div style="display:flex;gap:6px">
          <input type="password" id="geminiApiKeyInput" oninput="onApiKeyInput(this.value)" placeholder="Paste your API key (Anthropic, OpenRouter, Gemini, or OpenAI)" style="flex:1;padding:8px 10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:12px">
          <button class="btn" id="geminiKeyToggleBtn" onclick="toggleGeminiKeyVisibility()" style="padding:0 12px;font-family:'Space Mono',monospace;font-size:10px">SHOW</button>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <button class="btn btn-primary" onclick="saveGeminiApiKey()" style="flex:1;font-family:'Space Mono',monospace;font-size:11px">SAVE KEY</button>
          <button class="btn" onclick="clearGeminiApiKey()" style="font-family:'Space Mono',monospace;font-size:11px;color:var(--red)">CLEAR</button>
        </div>
      </div>

      <div style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
          <label style="font-size:12px;color:var(--pencil-muted);font-family:'Space Mono',monospace">ACTIVE AI MODEL</label>
          <span id="aiProviderBadge" style="font-size:9.5px;font-family:'Space Mono',monospace;padding:1px 6px;border-radius:3px;background:rgba(167,200,255,0.12);color:var(--crayon-blue);border:1px solid rgba(167,200,255,0.25)">AUTO</span>
        </div>
        <select id="geminiModelSelect" onchange="onModelSelectChange(this.value)" class="kb-settings-select">
          <option value="gemini-2.0-flash">Gemini 2.0 Flash (Google · Fast Multimodal - Recommended)</option>
          <option value="gemini-1.5-flash">Gemini 1.5 Flash (Google · Free Tier 15 RPM)</option>
          <option value="gemini-1.5-pro">Gemini 1.5 Pro (Google · Deep Reasoning)</option>
          <option value="llama-3.3-70b-versatile">Llama 3.3 70B (Groq · Free &amp; Ultra-Fast)</option>
          <option value="deepseek-r1-distill-llama-70b">DeepSeek R1 Distill 70B (Groq · Free)</option>
          <option value="meta-llama/llama-3.3-70b-instruct:free">Llama 3.3 70B Free (OpenRouter)</option>
          <option value="claude-3-5-sonnet-20241022">Claude 3.5 Sonnet (Anthropic)</option>
          <option value="gpt-4o-mini">GPT-4o Mini (OpenAI)</option>
          <option value="__custom__">Custom Model ID...</option>
        </select>
        <div id="customModelGroup" style="display:none;margin-top:6px">
          <input type="text" id="geminiCustomModelInput" placeholder="e.g. claude-3-5-sonnet-20241022, deepseek-chat" style="width:100%;box-sizing:border-box;padding:8px 10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:11px" onchange="saveCustomModel(this.value)">
        </div>
      </div>

      <div style="margin-bottom:12px">
        <label style="font-size:12px;color:var(--text-inactive);font-family:'Space Mono',monospace;display:block;margin-bottom:4px">PROVIDER PROTOCOL</label>
        <select id="aiProviderSelect" onchange="saveAIProvider(this.value)" class="kb-settings-select">
          <option value="auto">Automatic (Detect from key and model)</option>
          <option value="anthropic">Anthropic Claude (api.anthropic.com)</option>
          <option value="openrouter">OpenRouter (openrouter.ai)</option>
          <option value="gemini">Google Gemini (generativelanguage.googleapis.com)</option>
          <option value="openai">OpenAI / Compatible Gateway</option>
        </select>
      </div>

      <div style="margin-bottom:12px">
        <label style="font-size:12px;color:var(--text-inactive);font-family:'Space Mono',monospace;display:block;margin-bottom:4px">CUSTOM BASE URL / PROXY (OPTIONAL)</label>
        <input type="text" id="geminiBaseUrlInput" placeholder="Leave blank for official endpoints or enter custom gateway" style="width:100%;box-sizing:border-box;padding:8px 10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:11px" onchange="saveGeminiBaseUrl(this.value)">
      </div>

      <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
        <button class="btn" id="btnTestAI" onclick="testGeminiConnection()" style="width:100%;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:0.05em;display:flex;align-items:center;justify-content:center;gap:6px">
          <span>⚡ TEST CONNECTION</span>
        </button>
        <div id="aiTestResult" style="margin-top:8px;font-size:11px;font-family:'Space Mono',monospace;display:none;padding:8px;border-radius:4px;background:rgba(255,255,255,0.03)"></div>
      </div>
    </div>

    <div class="kb-section-label">PLUGIN AI ACCESS</div>
    <div class="kb-settings-group">
      <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace;margin-bottom:8px">
        Granular user control over which installed plugins can access the AI core layer.
      </div>
      <div id="pluginAIList" style="display:flex;flex-direction:column;gap:8px">
        <div style="font-size:11px;color:var(--text-inactive);font-family:'Space Mono',monospace">Loading plugin permissions...</div>
      </div>
    </div>
  </div>

  <!-- PANEL: NOTIFICATIONS -->
  <div id="settingsPanelNotifications" style="display:none">
    <div class="kb-section-label">NOTIFICATION PREFERENCES</div>
    <div class="kb-settings-group">
      <label class="toggle-row">
        <span style="font-size:13px">Overdue Tasks</span>
        <label class="kb-toggle"><input type="checkbox" id="notifOverdue" onchange="saveNotifPref('overdue_alert',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>
      </label>
      <label class="toggle-row">
        <span style="font-size:13px">Due Today (after 6 PM)</span>
        <label class="kb-toggle"><input type="checkbox" id="notifDueToday" onchange="saveNotifPref('due_today_alert',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>
      </label>
      <label class="toggle-row">
        <span style="font-size:13px">Time-Priority Tasks (-60 min)</span>
        <label class="kb-toggle"><input type="checkbox" id="notifTimePriority" onchange="saveNotifPref('time_priority',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>
      </label>
      <label class="toggle-row">
        <span style="font-size:13px">Daily Gita Quote</span>
        <label class="kb-toggle"><input type="checkbox" id="notifGitaDaily" onchange="saveNotifPref('gita_daily',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>
      </label>
      <label class="toggle-row" style="padding-left:16px">
        <span style="font-size:12px;color:var(--text-inactive)">Time</span>
        <input type="time" id="notifGitaDailyTime" onchange="saveNotifPref('gita_daily_time',this.value)" value="07:00" class="kb-settings-time">
      </label>
      <label class="toggle-row">
        <span style="font-size:13px">Checklist Reminder (9 PM)</span>
        <label class="kb-toggle"><input type="checkbox" id="notifChecklist" onchange="saveNotifPref('checklist_reminder',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>
      </label>
    </div>

    <div class="kb-section-label">SYSTEM TEST</div>
    <div class="kb-settings-group">
      <button class="btn" onclick="testNotification()" style="font-family:'Space Mono','Mono',monospace;font-size:11px;letter-spacing:0.05em">TEST_NOTIFICATION</button>
    </div>

    <div class="kb-section-label">PLUGIN NOTIFICATIONS</div>
    <div class="kb-settings-group">
      <div id="pluginNotifList" style="display:flex;flex-direction:column;gap:8px"></div>
    </div>
  </div>
</div>

