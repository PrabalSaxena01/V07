<script>
var BASE = '';
// ─── Log Dashboard ─────────────────────────────────────────────────────────────

function getPluginDisplayName(p){
  if(!p) return '';
  if(typeof p === 'string'){
    var id = p;
    var all = window._ALL_INSTALLED_PLUGINS || [];
    var found = all.find(function(x){ return x.id === id; });
    if(found && found.name && !found.name.startsWith('com.v07.')) return found.name;
    var map = {
      'com.v07.habits': 'Habits',
      'com.v07.gamify': 'Gamify',
      'com.v07.reader': 'Book Collection',
      'com.v07.tasks': 'Tasks',
      'com.v07.timetracker': 'Time Tracker',
      'com.v07.chronosynth': 'Weekly Digest',
      'com.v07.vitals': 'Mood & Energy'
    };
    if(map[id]) return map[id];
    return id.replace(/^com\.v07\./, '').replace(/[-_]/g, ' ').replace(/\b\w/g, function(l){ return l.toUpperCase(); });
  }
  if(p.name && !p.name.startsWith('com.v07.')) return p.name;
  var map = {
    'com.v07.habits': 'Habits',
    'com.v07.gamify': 'Gamify',
    'com.v07.reader': 'Book Collection',
    'com.v07.tasks': 'Tasks',
    'com.v07.timetracker': 'Time Tracker',
    'com.v07.chronosynth': 'Weekly Digest',
    'com.v07.vitals': 'Mood & Energy'
  };
  if(map[p.id]) return map[p.id];
  return (p.name || p.id).replace(/^com\.v07\./, '').replace(/[-_]/g, ' ').replace(/\b\w/g, function(l){ return l.toUpperCase(); });
}

var KIT_MODULES=[
  {id:'sleep',win:'Sleep',icon:'bedtime',label:'Sleep Log',desc:'Record check-in and wake-up sleep data.',color:'#68A6FF',page:'openSleepUpPage()'},
  {id:'run',win:'Running',icon:'directions_run',label:'Running',desc:'View running stats and log a run.',color:'#68A6FF',page:'openRunningPage()'},
  {id:'thoughts',win:'Notes',icon:'psychology',label:'Notes & Thoughts',desc:'Access your stream of consciousness and notes.',color:'var(--accent-purple)',page:'openThoughtsPage()'},
  {id:'capsule',win:'Archive',icon:'hourglass_empty',label:'Time Capsule',desc:'Explore your past memories and archived logs.',color:'var(--yellow)',page:'openVaultPage()'},
  {id:'db',win:'Database',icon:'storage',label:'Database',desc:'The central repository for all recorded metrics.',color:'#FF9F45',page:'openDatabasePage()'},
  {id:'checklist',win:'Checklist',icon:'checklist',label:'Daily Checklist',desc:'Track daily habits and system checks.',color:'#68A6FF',page:'openChecklist()'},
  {id:'appusage',win:'Screen Time',icon:'screen_lock_portrait',label:'Screen Time',desc:'Monitor your digital consumption patterns.',color:'#FF9F45',page:'openAppUsagePage()'},
  {id:'recycle',win:'Trash',icon:'delete_outline',label:'Trash Bin',desc:'Clean up or restore deleted entries.',color:'var(--red)',page:'openRecycleBinPage()',danger:true}
];

// ─── Kit reordering ────────────────────────────────────────────────────────────
var _kitReorderMode = false;
var _kitDragEl = null;
var _kitDragActive = false;
var _kitDragPointerId = null;
var KIT_ORDER_KEY = 'v07_kit_order';

function kitSavedOrder(){
  try{ return JSON.parse(localStorage.getItem(KIT_ORDER_KEY)||'[]'); }catch(e){ return []; }
}
function kitSaveOrder(ids){
  try{ localStorage.setItem(KIT_ORDER_KEY, JSON.stringify(ids)); }catch(e){}
}
function kitCurrentOrder(){
  var grid=document.getElementById('kitGrid');
  var ids=[];
  if(grid){
    grid.querySelectorAll('[data-kid]').forEach(function(el){ ids.push(el.getAttribute('data-kid')); });
  }
  return ids;
}
function kitReorderGrid(){
  var grid=document.getElementById('kitGrid');
  if(!grid)return;
  grid.classList.toggle('kit-reordering', _kitReorderMode);
  var btn=document.getElementById('kitReorderBtn');
  if(btn){
    btn.textContent = _kitReorderMode ? 'DONE' : 'REORDER';
    btn.style.color = _kitReorderMode ? 'var(--primary)' : 'var(--text-inactive)';
    btn.style.borderColor = _kitReorderMode ? 'var(--primary)' : 'var(--border)';
  }
  var handles=grid.querySelectorAll('.kit-drag-handle');
  handles.forEach(function(h){ h.style.display = _kitReorderMode ? 'flex' : 'none'; });
  if(!_kitReorderMode) kitSaveOrder(kitCurrentOrder());
}
function toggleKitReorder(){
  _kitReorderMode = !_kitReorderMode;
  kitReorderGrid();
}
function kitTileOnPointerDown(e){
  try{ window.getSelection()?.removeAllRanges(); }catch(err){}
  if(!_kitReorderMode)return;
  var tile=e.currentTarget.closest('[data-kid]');
  if(!tile)return;
  e.preventDefault();
  _kitDragEl=tile;
  _kitDragActive=true;
  _kitDragPointerId=e.pointerId;
  tile.classList.add('kit-dragging');
  try{ tile.setPointerCapture(e.pointerId); }catch(err){}
}
function kitTileOnPointerMove(e){
  if(!_kitDragActive||!_kitDragEl)return;
  if(e.pointerId!==_kitDragPointerId)return;
  e.preventDefault();
  var grid=_kitDragEl.parentNode;
  var t=document.elementFromPoint(e.clientX, e.clientY);
  var target=null;
  while(t&&t!==grid){ if(t.getAttribute&&t.getAttribute('data-kid')&&t!==_kitDragEl){target=t;break;} t=t.parentNode; }
  if(!target)return;
  var rect=target.getBoundingClientRect();
  if(e.clientY>rect.top+rect.height/2){ grid.insertBefore(_kitDragEl, target.nextSibling); }
  else{ grid.insertBefore(_kitDragEl, target); }
  _kitDragEl.classList.add('kit-dragging');
}
function kitTileOnPointerUp(e){
  if(!_kitDragActive)return;
  if(e.pointerId!==_kitDragPointerId)return;
  _kitDragActive=false;
  _kitDragPointerId=null;
  if(_kitDragEl) _kitDragEl.classList.remove('kit-dragging');
  _kitDragEl=null;
  kitSaveOrder(kitCurrentOrder());
}
function kitTileMarkup(m, isPlugin, col, win, icon, lbl, desc, openAction){
  var kid = isPlugin ? ('plugin:'+m.id) : m.id;
  var html='';
  html+='<div data-kid="'+kid+'" onclick="if(!_kitReorderMode && !(event.target && event.target.closest(\'.kit-settings-btn\'))){'+openAction+'}" style="aspect-ratio:1/1;width:100%;border:1px solid var(--border);border-bottom:2px solid '+col+';border-radius:8px;background:var(--surface);cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;box-sizing:border-box;transition:opacity 0.15s,transform 0.15s;user-select:none;-webkit-user-select:none" onmouseover="this.style.opacity=\'0.85\'" onmouseout="this.style.opacity=\'1\'" onpointerdown="kitTileOnPointerDown(event)" onpointermove="kitTileOnPointerMove(event)" onpointerup="kitTileOnPointerUp(event)" onpointercancel="kitTileOnPointerUp(event)">';
  html+='<div style="padding:5px 8px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.02)">';
  html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:8.5px;font-weight:700;letter-spacing:0.04em;color:'+col+';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:72%">'+win+(m.danger?' &bull; DANGER':'')+'</span>';
  html+='<div style="display:flex;align-items:center;gap:4px">';
  if(isPlugin){
    html+='<span class="kit-settings-btn" onclick="event.stopPropagation();openPluginSettings(\''+m.id+'\')" title="Settings" style="display:inline-flex;align-items:center;justify-content:center;padding:2px 5px;margin:-2px 0;color:var(--pencil-muted);font-size:13px;cursor:pointer;border-radius:3px;touch-action:manipulation" onmouseover="this.style.color=\'var(--ink-text)\'" onmouseout="this.style.color=\'var(--pencil-muted)\'">⚙</span>';
  }
  html+='<span class="kit-drag-handle" style="display:none;align-items:center;justify-content:center;cursor:grab;color:var(--text-inactive)"><span class="material-symbols-outlined" style="font-size:13px">drag_indicator</span></span>';
  html+='</div></div>';
  html+='<div style="padding:8px 10px;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:4px;overflow:hidden">';
  html+='<span class="material-symbols-outlined" style="font-size:26px;color:'+col+'">'+icon+'</span>';
  html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%">'+lbl+'</span>';
  html+='<p style="font-size:9.5px;color:var(--text-inactive);line-height:1.25;margin:0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">'+desc+'</p>';
  html+='</div></div>';
  return html;
}
function openLogDashboard(){
  setNavTabActive('toolkit');
  var el=document.getElementById('logDashboardPage');el.scrollTop=0;el.classList.add('show');
  var container=document.getElementById('logDashboardContent');
  var tiles=[];
  KIT_MODULES.forEach(function(m){ tiles.push({id:m.id, isPlugin:false, m:m}); });
  var allPlugins = (window._ALL_INSTALLED_PLUGINS || []).filter(function(p){ return p.enabled === true; });
  if(!allPlugins.length && window.PLUGIN_NAV && window.PLUGIN_NAV.length){
    allPlugins = window.PLUGIN_NAV;
  }
  allPlugins.forEach(function(p){ tiles.push({id:'plugin:'+p.id, isPlugin:true, m:p}); });
  var saved=kitSavedOrder();
  tiles.sort(function(a,b){
    var ai=saved.indexOf(a.id); if(ai<0)ai=99999;
    var bi=saved.indexOf(b.id); if(bi<0)bi=99999;
    return ai-bi;
  });
  var html='<div id="kitGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:8px">';
  tiles.forEach(function(t){
    if(!t.isPlugin){
      var m=t.m;
      html+=kitTileMarkup(m, false, m.color, m.win, m.icon, m.label, m.desc, m.page);
    }else{
      var p=t.m;
      var dispName = getPluginDisplayName(p);
      var col=p.nav&&p.nav.color?p.nav.color:((p.widgets&&p.widgets[0]&&p.widgets[0].color)||'var(--crayon-blue)');
      var lbl=dispName.toUpperCase();
      var win=dispName.toUpperCase();
      var icon=p.nav&&p.nav.icon?p.nav.icon:((p.widgets&&p.widgets[0]&&p.widgets[0].icon)||'extension');
      var desc=p.description||'';
      html+=kitTileMarkup(p, true, col, win, icon, lbl, desc, 'openPluginPage(\''+p.id+'\')');
    }
  });
  html+='</div>';
  container.innerHTML=html;
  _kitReorderMode=false;
  kitReorderGrid();
}
function closeLogDashboard(){
  _kitReorderMode=false;
  document.getElementById('mainFab').style.display='none';
  document.getElementById('logDashboardPage').classList.remove('show');
  setNavTabActive('home');
}

// ─── Tab Navigation ──────────────────────────────────────────────────────────
var currentTab = 'home';
function closeAllOverlays(){
  var ids=['logDashboardPage','gitaPage','databasePage','vaultPage','sessionsPage','moodEnergyPage','sleepUpPage','checklistPage','recycleBinPage','thoughtsPage','tasksPage','appUsagePage','runningPage','dayTrackerPage','settingsPage','trackPage','pluginsPage','pluginFramePage'];
  ids.forEach(function(id){var el=document.getElementById(id);if(el)el.classList.remove('show')});
  closeGitaSidebar();
  closeTimelineSidebar();
  if(typeof closePluginSettings==='function')closePluginSettings();
  var mob=document.getElementById('modalOverlay');if(mob)mob.classList.remove('show');
}

function goToHome(){
  closeAllOverlays();
  if(typeof closePluginPage==='function')closePluginPage();
  if(typeof closePluginsManager==='function')closePluginsManager();
  if(typeof closeTagManager==='function')closeTagManager();
  if(typeof closeTimelineSidebar==='function')closeTimelineSidebar();
  if(typeof closeGitaSidebar==='function')closeGitaSidebar();
  switchTab('home',true);
  window.scrollTo({top:0,behavior:'smooth'});
}

function getDashboardHeaderName() {
  return localStorage.getItem('v07_dashboard_name') || 'V07';
}
function updateDashboardHeaderName() {
  var el = document.getElementById('dashboardHeaderName');
  if (el) el.textContent = getDashboardHeaderName();
}
function changeDashboardHeaderName() {
  var current = getDashboardHeaderName();
  var val = prompt('Dashboard Header Name:', current);
  if (val !== null) {
    val = val.trim() || 'V07';
    localStorage.setItem('v07_dashboard_name', val);
    updateDashboardHeaderName();
    if (typeof showToast === 'function') showToast('Header updated: ' + val);
    else if (typeof toast === 'function') toast('Header updated: ' + val);
  }
}

function setNavTabActive(tab) {
  var nav = document.getElementById('bottomNav');
  if (!nav) return;
  if (tab === 'log') tab = 'toolkit';
  if (tab === 'track') tab = 'tracker';
  if (tab === 'settings') tab = 'profile';

  currentTab = tab;
  var tabConfigs = {
    home: { icon: 'spa', label: 'Dashboard' },
    toolkit: { icon: 'extension', label: 'Tool Kit' },
    journal: { icon: 'edit_note', label: 'Journal' },
    tracker: { icon: 'insights', label: 'Tracker' },
    profile: { icon: 'person', label: 'Profile' }
  };

  nav.querySelectorAll('a[data-tab]').forEach(function(a) {
    var t = a.dataset.tab;
    var isActive = (t === tab);
    a.classList.toggle('active', isActive);
    a.removeAttribute('style');
    var cfg = tabConfigs[t] || { icon: 'circle', label: t };
    if (isActive) {
      a.innerHTML = '<span class="material-symbols-outlined" style="font-size:19px;line-height:1">' + cfg.icon + '</span><span>' + cfg.label + '</span>';
    } else {
      a.innerHTML = '<span class="material-symbols-outlined" style="font-size:20px;line-height:1">' + cfg.icon + '</span>';
    }
  });
}

function switchTab(tab, fromPopstate) {
  if (tab === 'log') tab = 'toolkit';
  if (tab === 'track') tab = 'tracker';
  if (tab === 'settings') tab = 'profile';

  closeAllOverlays();
  setNavTabActive(tab);

  var titleEl = document.getElementById('pageTitle');
  var titles = {
    home: getDashboardHeaderName(),
    toolkit: 'TOOL KIT',
    journal: 'JOURNAL',
    tracker: 'TRACKER',
    profile: 'PROFILE'
  };
  if (titleEl) titleEl.textContent = titles[tab] || getDashboardHeaderName();

  var fab = document.getElementById('mainFab');
  if (fab) fab.style.display = 'none';

  if (tab === 'profile') {
    openSettingsPage();
  } else if (tab === 'toolkit') {
    openLogDashboard();
  } else if (tab === 'journal') {
    openThoughtsPage();
  } else if (tab === 'tracker') {
    openDatabasePage();
  } else if (tab === 'home') {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  if (!fromPopstate) {
    try { history.pushState({ tab: tab }, '', location.href); } catch(e){}
  }
}

function handleFabClick() {
  if (currentTab === 'settings') return;
  openPalettePanel();
}

