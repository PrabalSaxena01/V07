        <button class="btn btn-outline" id="psmOpenCustomBtn" style="padding:2px 8px;font-size:10px;display:none" onclick="openPluginCustomSettings()">OPEN FULL ↗</button>
      </div>
      <div id="psmCustomContent" style="font-size:11px;color:var(--text-inactive)">
        <iframe id="psmSettingsFrame" style="width:100%;height:280px;border:1px solid var(--border);border-radius:6px;background:var(--surface);display:none"></iframe>
        <span id="psmNoSettingsMsg">No additional options for this plugin.</span>
      </div>
    </div>

    <div style="display:flex;gap:8px;margin-top:4px">
      <button class="btn btn-accent" style="flex:1" onclick="saveCurrentPluginSettings()">SAVE &amp; APPLY</button>
      <button class="btn" style="width:70px" onclick="closePluginSettings()">CANCEL</button>
    </div>
  </div>
</div>

