      <h2>RECYCLE BIN</h2>
    </div>
  </div>
  <div style="display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap">
    <button class="btn btn-accent" data-cat="" onclick="loadRecycleBin('')" style="flex:1;font-size:11px;padding:8px 4px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">ALL</button>
    <button class="btn" data-cat="tasks" onclick="loadRecycleBin('tasks')" style="flex:1;font-size:11px;padding:8px 4px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">TASKS</button>
    <button class="btn" data-cat="sessions" onclick="loadRecycleBin('sessions')" style="flex:1;font-size:11px;padding:8px 4px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">SESSIONS</button>
    <button class="btn" data-cat="mood" onclick="loadRecycleBin('mood')" style="flex:1;font-size:11px;padding:8px 4px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">MOOD</button>
    <button class="btn" data-cat="journal" onclick="loadRecycleBin('journal')" style="flex:1;font-size:11px;padding:8px 4px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">JOURNAL</button>
    <button class="btn" data-cat="thought" onclick="loadRecycleBin('thought')" style="flex:1;font-size:11px;padding:8px 4px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">THOUGHT</button>
  </div>
  <div style="display:flex;gap:8px;margin-bottom:10px">
    <button class="btn btn-red" onclick="clearAllRecycle()" style="flex:1;font-size:12px;padding:8px;font-family:'Space Mono','Mono',monospace;letter-spacing:0.05em">&#x1F5D1; EMPTY RECYCLE BIN</button>
  </div>
  <div id="recycleBinContent">
    <div style="color:var(--muted);font-size:14px;text-align:center;padding:20px">Loading...</div>
  </div>
</div>

