// ─── Gita ─────────────────────────────────────────────────────────────────────

var gitaData=null;

function renderGita(verse){
  if(typeof ReaderEngine !== 'undefined' && ReaderEngine._activeBookId !== 'bhagavad_gita'){
    return;
  }
  gitaData=verse;
  if(!verse||verse.done){
    document.getElementById('gitaChapterLabel').textContent=verse?.message||'All verses read!';
    document.getElementById('gitaVerseCounter').textContent='';
    document.getElementById('gitaPageShloka').textContent='';
    document.getElementById('gitaPageTrans').textContent='';
    document.getElementById('gitaThoughtInput').style.display='none';
    document.getElementById('gitaActionsSection').style.display='none';
    var hTitle0 = document.getElementById('homeGitaVerseTitle');
    var hShloka0 = document.getElementById('homeGitaShloka');
    var hTrans0 = document.getElementById('homeGitaTrans');
    var hBtn0 = document.getElementById('homeGitaReadBtn');
    if(hTitle0) hTitle0.textContent = 'ALL VERSES READ';
    if(hShloka0) hShloka0.textContent = '';
    if(hTrans0) hTrans0.textContent = 'You have read all 700 verses of Bhagavad Gita.';
    if(hBtn0) hBtn0.style.display = 'none';
    return;
  }
  var isRead=verse.already_read;
  var chName='';
  var _chNames={1:'Arjuna Vishada',2:'Sankhya',3:'Karma',4:'Jnana',5:'Karma Vairagya',6:'Dhyana',7:'Jnana Vijnana',8:'Aksara Brahma',9:'Raja Vidya',10:'Vibhuti',11:'Visvarupa',12:'Bhakti',13:'Prakrti Purusha',14:'Gunatraya',15:'Purushottama',16:'Daivasura',17:'Sraddhatraya',18:'Mokshasannyasa'};
  chName=_chNames[verse.chapter]||'';
  document.getElementById('gitaChapterLabel').textContent='CHAPTER '+verse.chapter+': '+chName;
  document.getElementById('gitaVerseCounter').textContent='VERSE '+verse.verse+' / 700';

  var shloka=verse.shloka?.text||'';
  document.getElementById('gitaPageShloka').textContent=shloka;

  var eng=verse.english_sivananda;
  document.getElementById('gitaPageTrans').textContent=eng?.text||'';

  var ht=verse.hindi_translation;
  var htSection=document.getElementById('gitaHindiTransSection');
  if(ht&&ht.text){htSection.style.display='block';document.getElementById('gitaPageHindiTrans').textContent=ht.text}
  else{htSection.style.display='none'}

  var hc=verse.hindi_commentary;
  var hcSection=document.getElementById('gitaHindiCommSection');
  if(hc&&hc.text){
    hcSection.style.display='block';
    var commTitle = hcSection.querySelector('div');
    if(commTitle) commTitle.textContent = 'Hindi Commentary';
    document.getElementById('gitaPageHindiComm').textContent=hc.text;
  }
  else{hcSection.style.display='none'}

  var gb=verse.english_gambirananda;
  var gbSection=document.getElementById('gitaGambSection');
  if(gb&&gb.text){gbSection.style.display='block';document.getElementById('gitaPageGamb').textContent=gb.text}
  else{gbSection.style.display='none'}

  document.getElementById('gitaThoughtInput').style.display='none';
  document.getElementById('gitaActionsSection').style.display='flex';
  loadGitaVerseThoughts();

  var unread=verse.unread_count||0;
  var total=verse.total_verses||701;
  var read=total-unread;
  document.getElementById('gitaPageProgress').textContent=read+'/'+total+' read';

  var readBtn=document.getElementById('gitaPageReadBtn');
  if(readBtn){readBtn.textContent=isRead?'MARK UNREAD':'MARK READ';readBtn.style.borderColor=isRead?'var(--yellow)':'var(--primary)';readBtn.style.color=isRead?'var(--yellow)':'var(--primary)';}

  var hTitle = document.getElementById('homeGitaVerseTitle');
  var hShloka = document.getElementById('homeGitaShloka');
  var hTrans = document.getElementById('homeGitaTrans');
  var hProg = document.getElementById('homeGitaProgress');
  var hBtn = document.getElementById('homeGitaReadBtn');
  if(hTitle) hTitle.textContent = 'CHAPTER ' + verse.chapter + ', VERSE ' + verse.verse + (chName ? ' · ' + chName.toUpperCase() : '');
  if(hShloka) hShloka.textContent = shloka;
  if(hTrans) hTrans.textContent = eng?.text || '';
  if(hProg) hProg.textContent = read + '/' + total + ' read';
  if(hBtn){
    hBtn.style.display = '';
    hBtn.textContent = isRead ? '✓ READ' : '✓ MARK READ';
    hBtn.className = isRead ? 'btn-pencil' : 'btn-wax btn-wax-green';
  }

  var dotsEl=document.getElementById('gitaProgressDots');
  var dots='';
  var chapterCount=Math.ceil(total/(verse.verse_per_chapter||40));
  for(var i=1;i<=chapterCount;i++){
    if(i==verse.chapter){dots+='<div style="width:2px;height:16px;background:var(--primary);border-radius:1px"></div>'}
    else{dots+='<div style="width:4px;height:4px;background:var(--border);border-radius:50%"></div>'}
  }
  dotsEl.innerHTML='<div style="display:flex;flex-direction:column;gap:8px;align-items:center">'+dots+'</div>';

  var readingArea=document.getElementById('gitaReadingArea');
  if(readingArea)readingArea.scrollTop=0;

  setupGitaScrollAnimations();
}

var _gitaObserver=null;
function setupGitaScrollAnimations(){
  if(_gitaObserver)_gitaObserver.disconnect();
  var sections=document.querySelectorAll('#gitaReadingArea .gita-section');
  sections.forEach(function(s){s.classList.remove('visible')});
  _gitaObserver=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){entry.target.classList.add('visible');_gitaObserver.unobserve(entry.target)}
    });
  },{root:document.getElementById('gitaReadingArea'),threshold:0.15});
  sections.forEach(function(s){_gitaObserver.observe(s)});
  setTimeout(function(){sections[0]&&sections[0].classList.add('visible')},100);
}

async function toggleGitaRead(){
  if(typeof ReaderEngine !== 'undefined' && ReaderEngine._activeBookId !== 'bhagavad_gita'){
    ReaderEngine.toggleRead();
    return;
  }
  if(!gitaData||gitaData.done)return;
  try{
    if(gitaData.already_read){
      await fetch(BASE+'/gita/unread?verse_id='+gitaData.id,{method:'POST'});
      gitaData.already_read=false;
      toast('Marked unread');
    }else{
      var r=await fetch(BASE+'/gita/read',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({verse_id:gitaData.id})});
      var j=await r.json();
      if(j.ok){gitaData.already_read=true;toast('Marked read')}
      else if(j.already_read){gitaData.already_read=true;toast('Already read')}
    }
    loadDashboard()
  }catch(e){toast('Error')}
}

async function navGita(dir){
  if(typeof ReaderEngine !== 'undefined' && ReaderEngine._activeBookId !== 'bhagavad_gita'){
    if(dir === 'next') ReaderEngine.next();
    else ReaderEngine.prev();
    return;
  }
  if(!gitaData||gitaData.done)return;
  var area=document.getElementById('gitaReadingArea');
  if(area){
    area.classList.remove('slide-out-next','slide-out-prev');
    area.classList.add(dir==='next'?'slide-out-next':'slide-out-prev');
  }
  var endpoint=dir==='next'?'/gita/next?verse_id=':'/gita/prev?verse_id=';
  try{
    var r=await fetch(BASE+endpoint+gitaData.id);
    var j=await r.json();
    if(j.done){if(area)area.classList.remove('slide-out-next','slide-out-prev');toast(j.message);return}
    j.already_read=j.already_read||false;
    renderGita(j);
    if(area){
      requestAnimationFrame(function(){
        area.classList.remove('slide-out-next','slide-out-prev');
      });
    }
  }catch(e){if(area)area.classList.remove('slide-out-next','slide-out-prev');toast('Error')}
}

async function submitGitaThought(){
  var ta=document.getElementById('gitaThoughtText');
  var text=ta.value.trim();
  if(!text){toast('Write something first');return}
  if(typeof ReaderEngine !== 'undefined' && ReaderEngine._activeBookId !== 'bhagavad_gita'){
    ReaderEngine.saveThought(text);
    ta.value='';
    document.getElementById('gitaThoughtInput').style.display='none';
    toast('Thought saved');
    return;
  }
  if(!gitaData||!gitaData.id){toast('No verse selected');return}
  try{
    var r=await fetch(BASE+'/gita/review',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({verse_id:gitaData.id,text:text,rating:3,type:'reflection'})});
    var j=await r.json();
    if(!j.ok){toast('Failed to save');return}
    ta.value='';
    document.getElementById('gitaThoughtInput').style.display='none';
    toast('Thought saved!');
    loadGitaVerseThoughts();
  }catch(e){toast('Error saving thought')}
}

async function loadGitaVerseThoughts(){
  var el=document.getElementById('gitaVerseThoughts');
  if(!el||!gitaData||!gitaData.id){if(el)el.innerHTML='';return}
  try{
    var r=await fetch(BASE+'/gita/thoughts?verse_id='+encodeURIComponent(gitaData.id));
    if(!r.ok){el.innerHTML='';return}
    var j=await r.json();
    var thoughts=j.thoughts||[];
    if(thoughts.length===0){el.innerHTML='';return}
    var html='<div style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.2em;margin-bottom:12px;text-align:center">Thoughts on this verse</div>';
    thoughts.forEach(function(t){
      var ts=(t.ts||'').slice(0,16).replace('T',' ');
      html+='<div style="padding:10px 12px;border:1px solid var(--border);background:var(--surface);margin-bottom:8px;display:flex;align-items:flex-start;gap:10px">';
      html+='<div style="flex:1;font-family:\'General Sans\',sans-serif;font-size:13px;line-height:1.6;color:var(--text)">'+esc(t.text||'')+'</div>';
      html+='<span onclick="deleteGitaVerseThought(\''+t.id+'\')" style="cursor:pointer;color:var(--text-inactive);flex-shrink:0;transition:color 0.15s" onmouseenter="this.style.color=\'var(--red)\'" onmouseleave="this.style.color=\'var(--text-inactive)\'"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>';
      html+='</div>';
    });
    el.innerHTML=html;
  }catch(e){el.innerHTML=''}
}

async function deleteGitaVerseThought(id){
  if(!confirm('Delete this thought?'))return;
  try{
    await fetch(BASE+'/event/thought/'+id,{method:'DELETE'});
    toast('Thought deleted');
    loadGitaVerseThoughts();
  }catch(e){toast('Error')}
}



function openGitaPage(){document.getElementById('mainFab').style.display='none';var el=document.getElementById('gitaPage');el.scrollTop=0;el.classList.add('show');var ra=document.getElementById('gitaReadingArea');if(ra)ra.scrollTop=0;initGitaSwipe();setTimeout(function(){setupGitaScrollAnimations()},200);if(typeof ReaderEngine!=='undefined'&&ReaderEngine._activeBookId!=='bhagavad_gita'){ReaderEngine.renderCurrentItem();}else{loadGitaVerseThoughts();}try{history.pushState({overlay:'gitaPage'},'',location.href)}catch(e){}}
function closeGitaPage(){document.getElementById('mainFab').style.display='flex';closeGitaSidebar();document.getElementById('gitaPage').classList.remove('show');document.getElementById('gitaThoughtInput').style.display='none'}
var _gitaSwipeInit=false;var _gitaSwipeX=0;var _gitaSwipeY=0;
function initGitaSwipe(){if(_gitaSwipeInit)return;_gitaSwipeInit=true;var el=document.getElementById('gitaReadingArea');if(!el)return;el.addEventListener('touchstart',function(e){_gitaSwipeX=e.touches[0].clientX;_gitaSwipeY=e.touches[0].clientY},{passive:true});el.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-_gitaSwipeX;var dy=Math.abs(e.changedTouches[0].clientY-_gitaSwipeY);if(dy>40)return;if(dx<-80){navGita('next')}else if(dx>80){navGita('prev')}},{passive:true})}
function toggleGitaThoughtInput(){var s=document.getElementById('gitaThoughtInput');if(s.style.display==='none'||!s.style.display){s.style.display='block';var ta=document.getElementById('gitaThoughtText');if(ta){ta.value='';setTimeout(function(){ta.focus()},100)}setTimeout(function(){var ra=document.getElementById('gitaReadingArea');if(ra)ra.scrollTop=ra.scrollHeight},50)}else{s.style.display='none'}}
function closeGitaThoughtInput(){document.getElementById('gitaThoughtInput').style.display='none'}

// ─── Database ─────────────────────────────────────────────────────────────────

var DB_LABELS={
  sessions:'Session',habits:'Habit',metrics:'Metric',panics:'Panic',
  journal:'Journal',dsa:'DSA',chess:'Chess',tasks:'Task',
  running:'Running',mood:'Mood',energy:'Energy',thought:'Thought',
  checklist:'Checklist',daytracker:'Time Tracker',shares:'Time Capsule'
};
var DB_ALL_CATS=['all','sessions','habits','metrics','panics','journal','dsa','chess','tasks','running','mood','energy','thought','checklist','daytracker','shares'];
var DB_ACTIVE_FILTER='all';
var _dbData=[];
var _dbDays=30;

function _dbIconSvg(name,size,color){
  var d=_iconPaths[name]||_iconPaths['analytics']||_iconPaths['history'];if(!d)return '';
  return '<svg viewBox="0 -960 960 960" width="'+size+'" height="'+size+'" fill="'+color+'" style="flex-shrink:0"><path d="'+d+'"/></svg>';
}
function changeDbDays(){
  _dbDays=parseInt(document.getElementById('dbDays').value);if(isNaN(_dbDays))_dbDays=30;
  loadDatabasePage();
}

var DB_MOD_ICONS={
  sessions:'history',habits:'emoji_events',metrics:'analytics',
  panics:'warning',journal:'edit_note',dsa:'school',chess:'chess',
  tasks:'checklist',checklist:'checklist',daytracker:'calendar_month',
  thought:'psychology',running:'directions_run',mood:'mood',
  energy:'bolt',shares:'hourglass_empty',all:'keyboard_command_key'
};
var DB_MOD_COLORS={
  sessions:'var(--primary)',habits:'var(--secondary)',metrics:'var(--primary)',
  panics:'var(--accent-red)',journal:'var(--accent-orange)',dsa:'var(--accent-purple)',
  chess:'var(--text-inactive)',tasks:'var(--accent-orange)',checklist:'var(--accent-blue)',
  daytracker:'var(--secondary)',thought:'var(--accent-purple)',running:'var(--green)',
  mood:'var(--green)',energy:'var(--primary)',shares:'var(--accent-orange)'
};

function renderDbFilters(){
  var c=document.getElementById('databaseFilters');
  if(!c)return;
  c.innerHTML=DB_ALL_CATS.map(function(cat){
    var active=DB_ACTIVE_FILTER===cat;
    var label=cat==='all'?'ALL':(DB_LABELS[cat]||cat).toUpperCase();
    var icName=DB_MOD_ICONS[cat]||'analytics';
    var ic=_dbIconSvg(icName,10,active?'#001b3c':'var(--text-inactive)');
    var s=active
      ?'padding:4px 8px;border:1px solid var(--primary);color:#001b3c;background:rgba(167,200,255,0.1);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:3px'
      :'padding:4px 8px;border:1px solid var(--border);color:var(--text-inactive);background:transparent;font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.08em;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:3px;transition:border-color 0.15s,color 0.15s';
    return '<span onclick="setDbFilter(\''+cat+'\')" style="'+s+'">'+ic+label+'</span>';
  }).join('');
}
function setDbFilter(cat){DB_ACTIVE_FILTER=cat;renderDbFilters();renderDbEvents()}

function renderDbEvents(){
  var container=document.getElementById('databaseContent');
  if(!container)return;
  var cutoff=new Date();
  if(_dbDays>0){
    cutoff.setDate(cutoff.getDate()-_dbDays);
    var cutoffStr=cutoff.getFullYear()+'-'+String(cutoff.getMonth()+1).padStart(2,'0')+'-'+String(cutoff.getDate()).padStart(2,'0');
    var filtered=_dbData.filter(function(e){var d=(e.date||(e.ts||'').slice(0,10));return d>=cutoffStr});
  }else{
    var filtered=_dbData;
  }
  if(DB_ACTIVE_FILTER!=='all')filtered=filtered.filter(function(e){return e.category===DB_ACTIVE_FILTER});
  filtered.sort(function(a,b){return(b.ts||b.date||'').localeCompare(a.ts||a.date||'')});
  var cntEl=document.getElementById('databaseCount');
  if(cntEl)cntEl.textContent=filtered.length;
  if(filtered.length===0){
    container.innerHTML='<div style="color:var(--text-inactive);text-align:center;padding:20px;font-size:12px;font-family:\'JetBrains Mono\',\'Mono\',monospace">No records for this period</div>';
    return;
  }
  var html='<table style="width:100%;border-collapse:collapse;table-layout:auto">';
  html+='<colgroup><col style="width:1%"><col style="width:1%"><col></colgroup>';
  html+='<thead><tr style="border-bottom:1px solid var(--border);background:var(--surface-container-low)">';
  html+='<th style="padding:6px 8px;font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;border-right:1px solid var(--border);white-space:nowrap">Timestamp</th>';
  html+='<th style="padding:6px 8px;font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;border-right:1px solid var(--border);white-space:nowrap">Module</th>';
  html+='<th style="padding:6px 8px;font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em">Event / Value</th>';
  html+='</tr></thead>';
  html+='<tbody style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px">';
  filtered.forEach(function(e,i){
    var bg=i%2===1?'background:rgba(11,14,19,0.3)':'';
    var ts=(e.ts||e.date||'').replace('T','<br>');
    var cat=e.category||'unknown';
    var color=DB_MOD_COLORS[cat]||'var(--primary)';
    var label=(DB_LABELS[cat]||cat).toUpperCase();
    var eventText='';
    var eventStyle='color:var(--text)';
    if(cat==='sessions'){
      var act=activityLabel(e.activity);
      if(e.type==='start')eventText=act+(e.custom_label?' \u00b7 '+e.custom_label:'')+' started';
      else if(e.type==='end')eventText=act+' ended <span style="color:var(--text-inactive);margin-left:6px">('+e.duration+'m)</span>';
      else eventText=act;
    }else if(cat==='habits'){
      var act=activityLabel(e.activity);
      eventText=(e.on?'\u2713':'\u2717')+' '+act;
    }else if(cat==='metrics'){
      var parts=[];
      if(e.pushups)parts.push('PUSHUPS: <span style="color:var(--secondary);font-weight:600">'+e.pushups+'</span>');
      if(e.doom_scroll)parts.push('DOOM_SCROLL: <span style="color:var(--accent-red);font-weight:600">'+e.doom_scroll+'m</span>'+(e.trigger?' <span style="color:var(--text-inactive)">TRIGGER: '+esc(e.trigger)+'</span>':''));
      if(e.type==='checkin')parts.push('CHECK-IN: <span style="color:var(--primary);font-weight:600">'+esc(e.time||(e.ts?e.ts.slice(11,16):''))+'</span>');
      if(e.type==='checkout')parts.push('CHECK-OUT: <span style="color:var(--primary);font-weight:600">'+esc(e.time||(e.ts?e.ts.slice(11,16):''))+'</span>');
      if(e.label||e.name||e.metric){
        var mVal=e.value!=null?e.value:(e.count!=null?e.count:'');
        parts.push(esc((e.label||e.name||e.metric).toUpperCase())+': <span style="color:var(--secondary);font-weight:600">'+esc(String(mVal))+'</span>');
      }
      if(e.note)parts.push('<span style="color:var(--text-inactive);font-size:11px">Note: '+esc(e.note)+'</span>');
      eventText=parts.join('<br>')||'METRIC_LOG';
    }else if(cat==='panics'){
      eventText='PANIC_EVENT';eventStyle='color:var(--accent-red);font-weight:600';
      if(e.trigger)eventText+=' <span style="color:var(--text-inactive);font-weight:400">'+esc(e.trigger)+'</span>';
    }else if(cat==='journal'){
      eventText='<em>"'+esc((e.text||'').slice(0,80))+'"</em>';eventStyle='color:var(--accent-orange);font-style:italic';
    }else if(cat==='dsa'){
      eventText='LEETCODE: <span style="color:var(--accent-purple);font-weight:500">#'+esc(e.problem||'?')+'</span>'+(e.topic?' <span style="color:var(--text-inactive)">('+esc(e.topic)+')</span>':'');
    }else if(cat==='chess'){
      eventText='CHESS \u2014 '+(e.result||'')+(e.opponent?' vs '+esc(e.opponent):'');
    }else if(cat==='tasks'){
      eventText=(e.action==='completed'?'\u2713 ':e.action==='reopened'?'\u21BA ':'')+esc(e.title||e.task_id||'Task')+(e.deadline?' <span style="color:var(--text-inactive);font-size:11px">['+esc(e.deadline)+']</span>':'');
    }else if(cat==='running'){
      var durFmt = e.duration_formatted || formatRunDuration(e.duration_min || e.duration_sec, e.distance_km);
      var paceStr = e.pace ? ' · ' + esc(e.pace) + (e.pace.includes('/') ? '' : '/km') : '';
      var typeStr = e.run_type ? ' <span style="font-size:10px;padding:1px 5px;border-radius:3px;background:rgba(0,255,136,0.1);color:var(--green)">' + esc(e.run_type).toUpperCase() + '</span>' : '';
      eventText = (e.distance_km || 0) + 'km in ' + durFmt + paceStr + typeStr;
    }else if(cat==='mood'){
      eventText='MOOD: '+esc(e.mood||'?')+(e.note?' <span style="color:var(--text-inactive);font-size:11px">('+esc(e.note)+')</span>':'');
    }else if(cat==='energy'){
      eventText='ENERGY: '+esc(e.energy||'?')+(e.note?' <span style="color:var(--text-inactive);font-size:11px">('+esc(e.note)+')</span>':'');
    }else if(cat==='thought'){
      eventText=(e.topic?'['+esc(e.topic)+'] ':'')+esc((e.text||'').slice(0,80));
    }else if(cat==='checklist'){
      eventText=(e.done?'\u2713 ':'\u2717 ')+esc(e.label||e.title||e.text||'Checklist item');
    }else if(cat==='daytracker'){
      eventText=(e.hour!=null?'@'+String(e.hour).padStart(2,'0')+':00 ':'')+esc(e.title||e.activity||'')+' <span style="color:var(--text-inactive);font-size:10px">['+esc(e.category||'others')+']</span>';
    }else if(cat==='shares'){
      eventText='['+esc(e.type||'capsule').toUpperCase()+'] '+esc(e.title||'Untitled');
    }else if(cat==='gamify'){
      var kind = e.kind || e.action || e.type || 'Activity';
      var pts = e.points != null ? ' (+' + e.points + ' pts)' : (e.xp != null ? ' (+' + e.xp + ' XP)' : '');
      var note = e.description || e.note || e.title || '';
      eventText = '<span style="font-weight:600;color:var(--secondary);">' + esc(kind.toUpperCase()) + '</span>' + pts + (note ? ' \u2014 ' + esc(note) : '');
    }else if(cat==='reader'){
      eventText = '<span style="font-weight:600;color:var(--primary);">' + esc(e.title || 'Book') + '</span>' + (e.author ? ' by ' + esc(e.author) : '') + (e.progress != null ? ' \u00b7 ' + e.progress + '%' : '');
    }else if(cat==='vitals'){
      var vitalsParts = [];
      if(e.sleep) vitalsParts.push(e.sleep + 'h sleep');
      if(e.water) vitalsParts.push(e.water + 'ml water');
      if(e.steps) vitalsParts.push(e.steps + ' steps');
      eventText = vitalsParts.length ? vitalsParts.join(' \u00b7 ') : 'VITALS LOG';
    }else{
      var titleStr = e.title || e.label || e.activity || e.name || e.text || e.kind || e.type || e.action || '';
      if(titleStr){
        eventText = esc(titleStr) + (e.value != null ? ': ' + esc(String(e.value)) : '') + (e.note ? ' (' + esc(e.note) + ')' : '');
      } else {
        var cleanObj = {};
        for(var k in e){
          if(k !== 'id' && k !== 'ts' && k !== 'date' && k !== 'category' && k !== '_syncedAt'){
            cleanObj[k] = e[k];
          }
        }
        var s = JSON.stringify(cleanObj);
        eventText = s.length > 2 && s !== '{}' ? esc(s) : esc(e.id || 'Event');
      }
    }
    html+='<tr onclick="showDbEventDetail('+i+')" style="border-bottom:1px solid var(--border);'+bg+';cursor:pointer" onmouseenter="this.style.background=\'rgba(167,200,255,0.05)\'" onmouseleave="this.style.background=\''+(i%2===1?'rgba(11,14,19,0.3)':'')+'\'">';
    html+='<td style="padding:6px 8px;border-right:1px solid var(--border);color:var(--text-inactive);white-space:nowrap;font-size:11px">'+ts+'</td>';
    html+='<td style="padding:6px 8px;border-right:1px solid var(--border);text-transform:uppercase;font-size:10px;font-weight:600;color:'+color+';white-space:nowrap">'+label+'</td>';
    html+='<td style="padding:6px 8px;word-break:break-word;'+eventStyle+'">'+eventText+'</td>';
    html+='</tr>';
  });
  html+='</tbody></table>';
  container.innerHTML=html;
}

async function openDatabasePage(){
  setNavTabActive('tracker');
  document.getElementById('mainFab').style.display='none';_pushOv();
  document.getElementById('databasePage').classList.add('show');
  document.getElementById('databasePage').scrollTop=0;
  _dbDays=30;
  var sel=document.getElementById('dbDays');if(sel)sel.value='30';
  DB_ACTIVE_FILTER='all';
  renderDbFilters();
  loadDatabasePage();
}
function closeDatabasePage(){
  document.getElementById('mainFab').style.display='none';
  document.getElementById('databasePage').classList.remove('show');
  setNavTabActive('home');
}

var _dbDetailIdx=null;
function showDbEventDetail(idx){
  var cutoff=new Date();
  if(_dbDays>0){
    cutoff.setDate(cutoff.getDate()-_dbDays);
    var cutoffStr=cutoff.getFullYear()+'-'+String(cutoff.getMonth()+1).padStart(2,'0')+'-'+String(cutoff.getDate()).padStart(2,'0');
    var filtered=_dbData.filter(function(e){return(e.ts||'').slice(0,10)>=cutoffStr});
  }else{
    var filtered=_dbData;
  }
  if(DB_ACTIVE_FILTER!=='all')filtered=filtered.filter(function(e){return e.category===DB_ACTIVE_FILTER});
  filtered.sort(function(a,b){return(b.ts||'').localeCompare(a.ts||'')});
  var e=filtered[idx];
  if(!e)return;
  _dbDetailIdx=e;
  var cat=e.category||'unknown';
  var color=DB_MOD_COLORS[cat]||'var(--primary)';
  var label=(DB_LABELS[cat]||cat).toUpperCase();
  var html='<div style="margin-bottom:12px;display:flex;align-items:center;gap:8px">';
  html+='<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:'+color+'"></span>';
  html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:12px;font-weight:600;color:'+color+';text-transform:uppercase">'+label+'</span>';
  html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:11px;color:var(--text-inactive)">'+esc(e.ts||'')+'</span>';
  html+='</div>';
  html+='<div style="display:flex;flex-direction:column;gap:6px">';
  var keys=Object.keys(e);
  keys.forEach(function(k){
    if(k==='category')return;
    var val=e[k];
    if(typeof val==='object')val=JSON.stringify(val);
    html+='<div style="display:flex;gap:8px;align-items:baseline">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;min-width:100px;flex-shrink:0">'+esc(k)+'</span>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;color:var(--text);word-break:break-all">'+esc(String(val))+'</span>';
    html+='</div>';
  });
  html+='</div>';
  document.getElementById('dbEventDetailContent').innerHTML=html;
  document.getElementById('dbEventDetailOverlay').style.display='flex';
}
function closeDbEventDetail(){
  document.getElementById('dbEventDetailOverlay').style.display='none';
  _dbDetailIdx=null;
}
async function deleteDbEvent(){
  if(!_dbDetailIdx)return;
  var e=_dbDetailIdx;
  var id=e.id;
  var cat=e.category;
  if(!id||!cat)return;
  if(!confirm('Delete this event? It will be moved to recycle bin.'))return;
  try{
    var r=await fetch('/event/'+encodeURIComponent(cat)+'/'+encodeURIComponent(id),{method:'DELETE'});
    if(r.ok){
      closeDbEventDetail();
      loadDatabasePage();
    }
  }catch(ex){}
}

var VAULT_TAGS_DATA=[];
var VAULT_SELECTED_TAG='';
var VAULT_SEARCH_TIMEOUT=null;
var VAULT_SHARES_DATA=[];

async function openVaultPage(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('vaultPage');el.scrollTop=0;el.classList.add('show');
  document.getElementById('vaultSearch').value='';
  VAULT_SELECTED_TAG='';
  await loadVaultTags();
  loadVaultShares();
}
function closeVaultPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('vaultPage').classList.remove('show')}

async function loadVaultTags(){
  try{
    var data=await api('GET','/tags');
    VAULT_TAGS_DATA=data.tags||[];
    renderVaultTags();
  }catch(e){}
}

function renderVaultTags(){
  var c=document.getElementById('vaultTags');
  var html='<span class="chip'+(VAULT_SELECTED_TAG===''? ' selected':'')+'" onclick="filterVaultByTag(\'\')">All</span>';
  VAULT_TAGS_DATA.forEach(function(t){
    html+='<span class="chip'+(VAULT_SELECTED_TAG===t.name?' selected':'')+'" onclick="filterVaultByTag(\''+esc(t.name)+'\')">'+esc(t.name)+'</span>';
  });
  c.innerHTML=html;
}

function filterVaultByTag(tag){
  VAULT_SELECTED_TAG=tag;
  renderVaultTags();
  loadVaultShares();
}

function debounceVaultSearch(){
  clearTimeout(VAULT_SEARCH_TIMEOUT);
  VAULT_SEARCH_TIMEOUT=setTimeout(loadVaultShares,300);
}

async function loadVaultShares(){
  var container=document.getElementById('vaultContent');
  container.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px;">Loading...</div>';
  try{
    var params=[];
    var search=document.getElementById('vaultSearch').value.trim();
    if(search) params.push('search='+encodeURIComponent(search));
    if(VAULT_SELECTED_TAG) params.push('tag='+encodeURIComponent(VAULT_SELECTED_TAG));
    var qs=params.length?'?'+params.join('&'):'';
    var data=await api('GET','/shares'+qs);
    VAULT_SHARES_DATA=data.shares||[];
    renderVaultShares();
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px;">Failed to load<br><span style="font-size:11px">'+esc(e.message||e)+'</span></div>';
  }
}

function renderVaultShares(){
  var container=document.getElementById('vaultContent');
  if(!VAULT_SHARES_DATA.length){
    container.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px;">No shares found</div>';
    return;
  }
  var html='';
  VAULT_SHARES_DATA.forEach(function(s){
    var typeIcon=s.type==='image'?'&#x1F5BC;':s.type==='url'?'&#x1F517;':s.type==='video'?'&#x1F3AC;':s.type==='audio'?'&#x1F3B5;':s.type==='pdf'?'&#x1F4D6;':'&#x1F4DD;';
    var dateStr=s.date||'';
    var metaParts=[];
    if(s.captured_time) metaParts.push(s.captured_time);
    if(s.location) metaParts.push(s.location);
    var metaStr=metaParts.length?metaParts.join(' \u00b7 '):'';
    var tags=s.tags?s.tags.split(',').filter(function(t){return t.trim()}).map(function(t){
      var tn=t.trim();
      var isBuiltIn=tn==='URL'||tn==='Image'||tn==='Video'||tn==='Audio'||tn==='PDF';
      var bg=isBuiltIn?'var(--card2)':'var(--accent)';
      return '<span style="display:inline-block;padding:2px 8px;background:'+bg+';color:var(--text);border-radius:10px;font-size:10px;margin-left:4px">'+esc(tn)+'</span>';
    }).join(''):'';
    var pinIcon=s.pinned?'&#x1F4CC; ':'';
    var pinStyle=s.pinned?'color:#f5a623;':'';
    html+='<div class="card" style="padding:12px;margin-bottom:8px;cursor:pointer'+(s.pinned?';border-left:3px solid #f5a623':'')+'" onclick="showVaultDetail(\''+esc(s.id)+'\')">';
    html+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">';
    html+='<span style="font-size:14px;cursor:pointer;flex-shrink:0" title="'+(s.pinned?'Unpin':'Pin')+'" onclick="event.stopPropagation();togglePinShare(\''+esc(s.id)+'\')">'+pinIcon+'</span>';
    html+='<span style="font-size:16px">'+typeIcon+'</span>';
    html+='<span style="font-size:14px;font-weight:600;color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(s.title||'Untitled')+'</span>';
    html+='<span style="font-size:11px;color:var(--muted);white-space:nowrap;margin-right:4px">'+esc(dateStr)+'</span>';
    html+='<span onclick="event.stopPropagation();deleteVaultShare(\''+esc(s.id)+'\')" style="font-size:14px;color:var(--red);cursor:pointer;flex-shrink:0" title="Delete">&#x2716;</span>';
    html+='</div>';
    if(metaStr) html+='<div style="font-size:11px;color:var(--muted);margin-bottom:4px">&#x1F4CD; '+esc(metaStr)+'</div>';
    if(s.type==='image'&&s.file_path){
      var fname=s.file_path.split('/').pop();
      html+='<div style="margin:6px 0;border-radius:8px;overflow:hidden;max-height:120px"><img src="/vault-media/'+esc(fname)+'" style="width:100%;height:120px;object-fit:cover" onerror="this.parentElement.style.display=\'none\'"></div>';
    }
    if((s.type==='video'||s.type==='audio')&&s.file_path){
      var fname=s.file_path.split('/').pop();
      var isAudio=s.type==='audio';
      html+='<div style="margin:6px 0">'+(isAudio?'<audio':'<video')+' controls style="width:100%;max-height:100px;border-radius:8px" src="/vault-media/'+esc(fname)+'"></'+(isAudio?'audio':'video')+'></div>';
    }
    if(s.type==='pdf'&&s.file_path){
      var fname=s.file_path.split('/').pop();
      html+='<div style="margin:6px 0;padding:8px;background:var(--card2);border-radius:8px;font-size:12px;color:var(--accent)">&#x1F4D6; PDF Document — <a href="/vault-media/'+esc(fname)+'" target="_blank" style="color:var(--accent)">Open</a></div>';
    }
    if(s.type==='url'&&s.text){
      var isMedia=(s.text).match(/\.(mp4|webm|ogg|mp3|wav|m4a|mkv|avi|mov|opus)$/i);
      var isPdf=(s.text).match(/\.pdf$/i);
      var fname=(s.file_path||s.text).split('/').pop();
      if(isMedia&&s.file_path){
        var isAudio=s.text.match(/\.(ogg|mp3|wav|m4a|opus)$/i);
        html+='<div style="margin:6px 0">'+(isAudio?'<audio':'<video')+' controls style="width:100%;max-height:100px;border-radius:8px" src="/vault-media/'+esc(fname)+'"></'+(isAudio?'audio':'video')+'></div>';
      }else if(isPdf&&s.file_path){
        html+='<div style="margin:6px 0;padding:8px;background:var(--card2);border-radius:8px;font-size:12px;color:var(--accent)">&#x1F4D6; PDF — <a href="/vault-media/'+esc(fname)+'" target="_blank" style="color:var(--accent)">Open</a></div>';
      }else{
        html+='<div style="font-size:12px;color:var(--accent);margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(s.text)+'</div>';
      }
    }
    if(s.type==='text'&&s.text){
      html+='<div style="font-size:12px;color:var(--muted);margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(s.text.substring(0,120))+'</div>';
    }
    if(s.info) html+='<div style="font-size:12px;color:var(--muted);margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(s.info)+'</div>';
    if(tags) html+='<div style="margin-top:4px">'+tags+'</div>';
    html+='</div>';
  });
  container.innerHTML=html;
}

function showVaultDetail(id){
  var s=VAULT_SHARES_DATA.find(function(x){return x.id===id});
  if(!s) return;
  var typeIcon=s.type==='image'?'&#x1F5BC;':s.type==='url'?'&#x1F517;':s.type==='video'?'&#x1F3AC;':s.type==='audio'?'&#x1F3B5;':s.type==='pdf'?'&#x1F4D6;':'&#x1F4DD;';
  var tags=s.tags?s.tags.split(',').filter(function(t){return t.trim()}).map(function(t){
    var tn=t.trim();
    var isBuiltIn=tn==='URL'||tn==='Image'||tn==='Video'||tn==='Audio'||tn==='PDF';
    var bg=isBuiltIn?'var(--card2)':'var(--accent)';
    return '<span style="display:inline-block;padding:3px 10px;background:'+bg+';color:var(--text);border-radius:12px;font-size:11px">'+esc(tn)+'</span>';
  }).join(' '):'';
  var html='<div style="text-align:center;font-size:24px;margin-bottom:8px">'+typeIcon+'</div>';
  html+='<h3 style="font-size:16px;margin:0 0 8px 0;font-family:\'JetBrains Mono\',\'Mono\',monospace">'+esc(s.title||'Untitled')+'</h3>';
  if(s.info) html+='<p style="font-size:13px;color:var(--muted);margin:0 0 8px 0">'+esc(s.info)+'</p>';
  var metaItems=[];
  if(s.date) metaItems.push('&#x1F4C5; '+esc(s.date));
  if(s.captured_time) metaItems.push('&#x1F552; '+esc(s.captured_time));
  if(s.location) metaItems.push('&#x1F4CD; '+esc(s.location));
  if(metaItems.length) html+='<div style="font-size:12px;color:var(--muted);margin-bottom:8px">'+metaItems.join(' &nbsp; ')+'</div>';
  if(s.type==='image'&&s.file_path){
    var fname=s.file_path.split('/').pop();
    html+='<div style="margin-bottom:8px;border-radius:8px;overflow:hidden"><img src="/vault-media/'+esc(fname)+'" style="width:100%;border-radius:8px" onerror="this.style.display=\'none\'"></div>';
  }
  if((s.type==='video'||s.type==='audio')&&s.file_path){
    var fname=s.file_path.split('/').pop();
    var isAudio=s.type==='audio';
    html+='<div style="margin-bottom:8px">'+(isAudio?'<audio':'<video')+' controls style="width:100%;border-radius:8px" src="/vault-media/'+esc(fname)+'"></'+(isAudio?'audio':'video')+'></div>';
  }
  if(s.type==='pdf'&&s.file_path){
    var fname=s.file_path.split('/').pop();
    html+='<div style="margin-bottom:8px;padding:12px;background:var(--card2);border-radius:8px;text-align:center"><div style="font-size:32px;margin-bottom:8px">&#x1F4D6;</div><a href="/vault-media/'+esc(fname)+'" target="_blank" style="color:var(--accent);font-size:14px;text-decoration:underline">Open PDF</a></div>';
  }
  if(s.type==='url'&&s.text){
    var isMedia=(s.text).match(/\.(mp4|webm|ogg|mp3|wav|m4a|mkv|avi|mov|opus)$/i);
    var isPdf=(s.text).match(/\.pdf$/i);
    var fname=(s.file_path||s.text).split('/').pop();
    if(isMedia&&s.file_path){
      var isAudio=s.text.match(/\.(ogg|mp3|wav|m4a|opus)$/i);
      html+='<div style="margin-bottom:8px">'+(isAudio?'<audio':'<video')+' controls style="width:100%;border-radius:8px" src="/vault-media/'+esc(fname)+'"></'+(isAudio?'audio':'video')+'></div>';
    }else if(isPdf&&s.file_path){
      html+='<div style="margin-bottom:8px;padding:12px;background:var(--card2);border-radius:8px;text-align:center"><div style="font-size:32px;margin-bottom:8px">&#x1F4D6;</div><a href="/vault-media/'+esc(fname)+'" target="_blank" style="color:var(--accent);font-size:14px;text-decoration:underline">Open PDF</a></div>';
    }else{
      html+='<a href="'+esc(s.text)+'" target="_blank" style="display:block;padding:10px;background:var(--card2);border-radius:8px;font-size:13px;color:var(--accent);word-break:break-all;margin-bottom:8px;text-decoration:underline">'+esc(s.text)+'</a>';
    }
  }
  if(s.type==='text'&&s.text){
    html+='<div style="padding:10px;background:var(--card2);border-radius:8px;font-size:12px;color:var(--text);word-break:break-word;margin-bottom:8px;white-space:pre-wrap">'+esc(s.text)+'</div>';
  }
  if(tags) html+='<div style="margin-bottom:8px">'+tags+'</div>';
  document.getElementById('modalOverlay').innerHTML='<div class="modal" style="max-width:400px">'+html+'<div class="modal-btns"><button class="btn" onclick="togglePinShare(\''+esc(s.id)+'\')">'+(s.pinned?'Unpin':'Pin')+'</button><button class="btn" onclick="editVaultShare(\''+esc(s.id)+'\')">Edit</button><button class="btn btn-red" onclick="deleteVaultShare(\''+esc(s.id)+'\')">Delete</button><button class="btn" onclick="closeModal()">Close</button></div></div>';
  document.getElementById('modalOverlay').classList.add('show');
}

async function deleteVaultShare(id){
  if(!confirm('Move to Recycle Bin?')) return;
  try{
    var data=await api('DELETE','/shares?id='+id);
    if(data.ok){
      closeModal();
      toast('Moved to Recycle Bin');
      loadVaultShares();
    }else{toast(data.error||'Failed');}
  }catch(e){toast('Error: '+e.message);}
}

async function togglePinShare(id){
  try{
    var data=await api('POST','/shares/pin?id='+id);
    if(data.ok){
      toast(data.pinned?'Pinned':'Unpinned');
      closeModal();
      loadVaultShares();
    }
  }catch(e){toast('Error: '+e.message);}
}

function editVaultShare(id){
  var s=VAULT_SHARES_DATA.find(function(x){return x.id===id});
  if(!s) return;
  var inputStyle='width:100%;padding:9px 10px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13px;outline:none;font-family:\'JetBrains Mono\',\'Mono\',monospace;box-sizing:border-box;margin-bottom:10px';
  var labelStyle='font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;display:block;margin-bottom:4px';
  var html='<h3 style="font-size:15px;margin:0 0 12px 0;font-family:\'JetBrains Mono\',\'Mono\',monospace">EDIT_CAPSULE_ITEM</h3>';
  html+='<span style="'+labelStyle+'">Title</span><input id="ev_title" type="text" value="'+esc(s.title||'')+'" style="'+inputStyle+'">';
  html+='<span style="'+labelStyle+'">Info</span><input id="ev_info" type="text" value="'+esc(s.info||'')+'" style="'+inputStyle+'">';
  html+='<span style="'+labelStyle+'">Tags (comma separated)</span><input id="ev_tags" type="text" value="'+esc(s.tags||'')+'" style="'+inputStyle+'">';
  html+='<span style="'+labelStyle+'">Date</span><input id="ev_date" type="date" value="'+esc((s.date||'').slice(0,10))+'" style="'+inputStyle+'">';
  html+='<span style="'+labelStyle+'">Captured Time</span><input id="ev_cap" type="text" value="'+esc(s.captured_time||'')+'" placeholder="e.g. 14:30" style="'+inputStyle+'">';
  html+='<span style="'+labelStyle+'">Location</span><input id="ev_loc" type="text" value="'+esc(s.location||'')+'" style="'+inputStyle+'">';
  if(s.type==='text'){html+='<span style="'+labelStyle+'">Content</span><textarea id="ev_text" rows="4" style="'+inputStyle+'resize:vertical">'+esc(s.text||'')+'</textarea>';}
  html+='<div class="modal-btns"><button class="btn btn-accent" onclick="saveVaultShare(\''+esc(s.id)+'\')">Save</button><button class="btn" onclick="closeModal()">Cancel</button></div>';
  document.getElementById('modalOverlay').innerHTML='<div class="modal" style="max-width:400px">'+html+'</div>';
  document.getElementById('modalOverlay').classList.add('show');
}

async function saveVaultShare(id){
  var fields=['title','info','tags','date','captured_time','location'];
  var qs=[];
  fields.forEach(function(f){
    var el=document.getElementById('ev_'+f);
    if(el)qs.push(f+'='+encodeURIComponent(el.value.trim()));
  });
  var textEl=document.getElementById('ev_text');
  if(textEl)qs.push('text='+encodeURIComponent(textEl.value));
  if(!qs.length)return;
  try{
    var r=await wrapFetch(fetch(BASE+'/shares/update?id='+encodeURIComponent(id)+'&'+qs.join('&'),{method:'POST'}),'editVaultShare',{id:id}).then(function(r){return r.json()});
    if(r.ok){
      toast('Updated');
      closeModal();
      loadVaultShares();
    }else{toast(r.error||'Failed');}
  }catch(e){toast('Error: '+e.message);}
}

var VAULT_RECYCLE_DATA=[];
async function loadRecycleShares(){
  VAULT_RECYCLE_DATA=[];
  document.getElementById('vaultTags').innerHTML='';
  document.getElementById('vaultSearch').placeholder='Search recycle bin...';
  document.getElementById('vaultSearch').value='';
  var container=document.getElementById('vaultContent');
  container.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px;">Loading...</div>';
  try{
    var data=await api('GET','/shares?deleted=true');
    VAULT_RECYCLE_DATA=data.shares||[];
    renderRecycleShares();
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px;">Failed to load</div>';
  }
}

function renderRecycleShares(){
  var container=document.getElementById('vaultContent');
  var html='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><button class="btn" onclick="backToTimeCapsule()" style="font-size:12px">&#x2190; Back to Time Capsule</button><span style="font-size:12px;color:var(--muted)">'+VAULT_RECYCLE_DATA.length+' items</span></div>';
  if(!VAULT_RECYCLE_DATA.length){
    html+='<div style="color:var(--muted);text-align:center;padding:20px;">Recycle bin is empty</div>';
    container.innerHTML=html;
    return;
  }
  VAULT_RECYCLE_DATA.forEach(function(s){
    var typeIcon=s.type==='image'?'&#x1F5BC;':s.type==='url'?'&#x1F517;':s.type==='video'?'&#x1F3AC;':s.type==='audio'?'&#x1F3B5;':s.type==='pdf'?'&#x1F4D6;':'&#x1F4DD;';
    html+='<div class="card" style="padding:12px;margin-bottom:8px;opacity:0.7">';
    html+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">';
    html+='<span style="font-size:16px">'+typeIcon+'</span>';
    html+='<span style="font-size:14px;font-weight:600;color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(s.title||'Untitled')+'</span>';
    html+='</div>';
    html+='<div style="display:flex;gap:8px;margin-top:6px">';
    html+='<button class="btn" onclick="restoreShare(\''+esc(s.id)+'\')" style="font-size:12px;padding:4px 10px">&#x21A9; Restore</button>';
    html+='<button class="btn btn-red" onclick="permanentlyDeleteShare(\''+esc(s.id)+'\')" style="font-size:12px;padding:4px 10px">&#x1F5D1; Delete Forever</button>';
    html+='</div></div>';
  });
  container.innerHTML=html;
}

function backToTimeCapsule(){
  document.getElementById('vaultSearch').placeholder='Search time capsule...';
  document.getElementById('vaultSearch').value='';
  loadVaultTags();
  loadVaultShares();
}

async function restoreShare(id){
  try{
    var data=await api('POST','/shares/restore?id='+id);
    if(data.ok){
      toast('Restored');
      loadRecycleShares();
    }else{toast(data.error||'Failed');}
  }catch(e){toast('Error: '+e.message);}
}

async function permanentlyDeleteShare(id){
  if(!confirm('Permanently delete this item? This cannot be undone.')) return;
  try{
    var data=await api('DELETE','/shares/permanent?id='+id);
    if(data.ok){
      toast('Permanently deleted');
      loadRecycleShares();
    }else{toast(data.error||'Failed');}
  }catch(e){toast('Error: '+e.message);}
}

function openTagManager(){
  document.getElementById('tagManagerModal').classList.add('show');
  renderTagManagerList();
}
function closeTagManager(){document.getElementById('tagManagerModal').classList.remove('show')}

function renderTagManagerList(){
  var c=document.getElementById('tagManagerList');
  if(!VAULT_TAGS_DATA.length){
    c.innerHTML='<div style="color:var(--muted);text-align:center;padding:12px;font-size:13px">No tags yet</div>';
    return;
  }
  var html='';
  VAULT_TAGS_DATA.forEach(function(t){
    var builtIn=t.id&&t.id.startsWith('_');
    html+='<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:var(--card);border-radius:8px">';
    html+='<span style="font-size:13px;color:var(--text)">'+esc(t.name)+(builtIn?' <span style="font-size:10px;color:var(--muted)">(auto)</span>':'')+'</span>';
    if(!builtIn) html+='<button class="btn btn-red" onclick="deleteTag(\''+esc(t.id)+'\')" style="padding:4px 10px;font-size:11px">Delete</button>';
    html+='</div>';
  });
  c.innerHTML=html;
}

async function createTag(){
  var input=document.getElementById('newTagName');
  var name=input.value.trim();
  if(!name){toast('Enter tag name');return;}
  try{
    var data=await api('POST','/tags',{name:name});
    if(data.ok){
      input.value='';
      await loadVaultTags();
      renderTagManagerList();
      toast('Tag created');
    }else{toast(data.error||'Failed');}
  }catch(e){toast('Error: '+e.message);}
}

async function deleteTag(id){
  try{
    var data=await api('DELETE','/tags?id='+id);
    if(data.ok){
      await loadVaultTags();
      renderTagManagerList();
      if(VAULT_SELECTED_TAG) VAULT_SELECTED_TAG='';
      renderVaultTags();
      toast('Tag deleted');
    }
  }catch(e){toast('Error: '+e.message);}
}

async function loadDatabasePage(){
  var container=document.getElementById('databaseContent');
  if(typeof renderSkeleton==='function') container.innerHTML=renderSkeleton('list',6);
  else container.innerHTML='<div style="color:var(--text-inactive);font-size:12px;text-align:center;padding:20px;font-family:\'JetBrains Mono\',\'Mono\',monospace">Loading...</div>';
  try{
    var fetchDays=_dbDays;
    var data=await wrapFetch(fetch(BASE+'/database?days='+fetchDays),'database',{days:fetchDays}).then(function(r){return r.json()});
    _dbData=data.events||[];

    // Dynamically discover all categories present in the data plus standard ones
    var defaultCats=['sessions','habits','metrics','panics','journal','dsa','chess','tasks','running','mood','energy','thought','checklist','daytracker','shares'];
    var seenCats={};
    defaultCats.forEach(function(c){ seenCats[c]=false; });
    _dbData.forEach(function(e){ if(e.category) seenCats[e.category]=true; });
    var dynCats=['all'];
    defaultCats.forEach(function(c){ if(seenCats[c]) dynCats.push(c); });
    Object.keys(seenCats).forEach(function(c){
      if(c!=='all'&&defaultCats.indexOf(c)===-1&&seenCats[c]) dynCats.push(c);
    });
    if(dynCats.length===1){
      dynCats=['all','sessions','habits','metrics','panics','journal','dsa','chess'];
    }
    DB_ALL_CATS=dynCats;
    if(DB_ACTIVE_FILTER!=='all'&&DB_ALL_CATS.indexOf(DB_ACTIVE_FILTER)===-1){
      DB_ACTIVE_FILTER='all';
    }
    renderDbFilters();
    renderDbEvents();
  }catch(e){
    container.innerHTML='<div style="color:var(--accent-red);text-align:center;padding:20px;font-size:12px;font-family:\'JetBrains Mono\',\'Mono\',monospace">LOAD_FAILED<br>'+esc(e.message||e)+'</div>';
  }
}

function openTimelineSidebar(){
  document.getElementById('timelineSidebarOverlay').classList.add('show');
  document.getElementById('timelineSidebar').classList.add('open');
  var today=localDate();
  document.getElementById('timelineSidebarDate').value=today;
  loadTimelineSidebar();
}
function closeTimelineSidebar(){
  document.getElementById('timelineSidebarOverlay').classList.remove('show');
  document.getElementById('timelineSidebar').classList.remove('open');
}
async function loadTimelineSidebar(){
  var container=document.getElementById('timelineSidebarContent');
  var dateStr=document.getElementById('timelineSidebarDate').value;
  if(typeof renderSkeleton==='function') container.innerHTML=renderSkeleton('cards',3);
  else container.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px;">Loading...</div>';
  try{
    var data=await wrapFetch(fetch(BASE+'/day/'+dateStr),'timeline',{date:dateStr}).then(function(r){return r.json()});
    container.innerHTML='';
    var events=data.events;
    if(!events||events.length===0){
      container.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px;">No events for this day</div>';
      return;
    }
    var lines=events.map(function(e){
      var icon=CATEGORY_ICONS[e._category]||'\u{1F4CB}';
      var time=e.ts?.slice(11,16)||'';
      var text=icon+' '+time+' '+e._label+' ';
      if(e._category==='mood')text+='Mood: '+moodLabel(e.mood||'')+(e.energy?' · Energy: '+energyLabel(e.energy):'')+(e.note?' ('+e.note+')':'');
      else if(e._category==='energy')text+='Energy: '+energyLabel(e.energy||'')+(e.note?' ('+e.note+')':'');
      else if(e._category==='metrics'){
        var tStr=e.time||(e.ts?e.ts.slice(11,16):'');
        if(tStr.indexOf('T')!==-1) tStr=tStr.slice(tStr.indexOf('T')+1, tStr.indexOf('T')+6);
        if(e.type==='checkin')text+='\u2705 Check-in '+esc(tStr)+(e.note?' · '+esc(e.note):'');
        else if(e.type==='checkout')text+='\u{1F534} Checkout '+esc(tStr)+(e.note?' · '+esc(e.note):'');
        else if(e.type==='panic')text+='\u{1F630} Panic'+(e.note?' · '+esc(e.note):'');
        else if(e.doom_scroll)text+='\u{1F4F1} Doom: '+e.doom_scroll+'m'+(e.trigger?' · '+esc(e.trigger):'');
        else if(e.pushups)text+='\u{1F4AA} Pushups: '+e.pushups+(e.note?' · '+esc(e.note):'');
        else if(e.label||e.name||e.metric)text+=(e.label||e.name||e.metric)+': '+(e.value!=null?e.value:(e.count!=null?e.count:''));
        else text+=JSON.stringify(e).slice(0,80);
      }else if(e._category==='habits')text+='\u{1F3AF} '+(e.on?'\u2705':'\u274C')+' '+activityLabel(e.activity)+(e.note?' · '+e.note:'');
      else if(e._category==='journal')text+='\u{1F4DD} '+(e.text||'').slice(0,80);
      else if(e._category==='thought')text+='\u{1F4AD} '+(e.text||'').slice(0,80);
      else if(e._category==='sessions'){
        if(e.type==='start')text+='\u23F1 '+activityLabel(e.activity)+' started';
        else if(e.type==='end')text+='\u23F9 '+activityLabel(e.activity)+' ended ('+e.duration+'m)';
      }else if(e._category==='tasks'){
        if(e.action==='completed')text+='\u2705 '+(e.title||e.task_id);
        else text+='\u{1F4CB} '+(e.action||'')+(e.title?' '+e.title:'');
      }else if(e._category==='dsa')text+='\u{1F4DA} '+(e.problem||'')+(e.topic?' ('+e.topic+')':'');
      else if(e._category==='running'){var durFormatted=e.duration_formatted||formatRunDuration(e.duration_sec||e.duration_min, e.distance_km);text+='\u{1F3C3} '+(e.distance_km||0)+'km in '+durFormatted+(e.pace?' · '+e.pace+(e.pace.includes('/')?'':'/km'):'')+(e.run_type?' ('+e.run_type+')':'');}
      else if(e._category==='checklist')text+='\u2611 '+(e.label||'')+(e.done?' \u2705':'');
      else if(e._category==='daytracker')text+='\u23F0 '+(e.activity||'')+(e.on===true?' ON':e.on===false?' OFF':'')+(e.notes?' · '+e.notes:'');
      else text+=JSON.stringify(e).slice(0,80);
      return '<div style="padding:4px 0;border-bottom:1px solid var(--card2);font-size:12px;color:var(--muted);line-height:1.4">'+esc(text)+'</div>';
    }).join('');
    container.innerHTML=lines;
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px;">Failed to load</div>';
  }
}
// ─── Dashboard ────────────────────────────────────────────────────────────────

var _dashCache={},_dashboardLoading=false,_lastDashboardLoad=0;
function _dc(key,val){var h=JSON.stringify(val);if(_dashCache[key]===h)return false;_dashCache[key]=h;return true}

async function loadDashboard(){
  if(_dashboardLoading)return;
  _dashboardLoading=true;
  try{
    var f=function(p){return wrapFetch(fetch(BASE+p),'loadDashboard',{endpoint:p}).then(function(r){return r.json()})};
    var results=await Promise.allSettled([
      f('/gita/today'),
      f('/streak'),
      f('/tasks?filter=today'),
      f('/tasks?filter=overdue'),
      f('/session/today'),
      f('/events/mood/today'),
      f('/events/energy/today'),
      f('/sleep-up')]);
    function r(i){var x=results[i];return x.status==='fulfilled'?x.value:null}
    var gita=r(0),streak=r(1),tasksRes=r(2),overdueRes=r(3),sessionToday=r(4),moodToday=r(5),energyToday=r(6),sleepUp=r(7);
    if(!tasksRes)tasksRes={tasks:[]};if(!overdueRes)overdueRes={tasks:[]};if(!moodToday)moodToday={events:[]};if(!energyToday)energyToday={events:[]};
    if(_dc('gita',gita)){
      if(typeof ReaderEngine === 'undefined' || ReaderEngine._activeBookId === 'bhagavad_gita'){
        renderGita(gita);
      }
    }
    var allMood=moodToday?.events||[];
    var latestMood=allMood.filter(function(e){return e.mood}).pop();
    var allEnergy=energyToday?.events||[];
    var latestEnergy=allEnergy.filter(function(e){return e.energy}).pop();
    if(_dc('streak',streak)){
      var streakVal=streak?.overall_streak||0;
      document.getElementById('streakBadge').textContent=streakVal>0?'\uD83D\uDD25 '+streakVal+'d':''
    }
    if(_dc('mood',allMood)){
      var sm=document.getElementById('statMood');
      if(sm&&latestMood&&latestMood.mood){
        sm.innerHTML=moodLabel(latestMood.mood)+' <span style="color:var(--text-inactive);font-size:10px" id="statMoodTime"></span>';
        var mt=new Date(latestMood.ts);var th=mt.getHours()%12||12;var tm=String(mt.getMinutes()).padStart(2,'0');var ap=mt.getHours()>=12?'pm':'am';
        var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var smt=document.getElementById('statMoodTime');
        if(smt) smt.textContent='@ '+th+':'+tm+ap+' '+String(mt.getDate()).padStart(2,'0')+'.'+months[mt.getMonth()].slice(0,3).toUpperCase()+'.'+String(mt.getFullYear()).slice(2);
      }
    }
    if(_dc('energy',allEnergy)){
      var se=document.getElementById('statEnergy');
      if(se&&latestEnergy&&latestEnergy.energy){
        se.innerHTML=energyLabel(latestEnergy.energy)+' <span style="color:var(--text-inactive);font-size:10px" id="statEnergyTime"></span>';
        var et=new Date(latestEnergy.ts);var eh=et.getHours()%12||12;var em=String(et.getMinutes()).padStart(2,'0');var ep=et.getHours()>=12?'pm':'am';
        var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var set=document.getElementById('statEnergyTime');
        if(set) set.textContent='@ '+eh+':'+em+ep+' '+String(et.getDate()).padStart(2,'0')+'.'+months[et.getMonth()].slice(0,3).toUpperCase()+'.'+String(et.getFullYear()).slice(2);
      }
    }
    if(_dc('sleep',sleepUp)){
      if(sleepUp){
        var sleepDur=sleepUp.sleep_minutes||0;
        var sleepH=Math.floor(sleepDur/60);var sleepM=sleepDur%60;
        var sl=document.getElementById('statSleepTotal');if(sl)sl.textContent=sleepUp.sleep_formatted||(sleepH>0?sleepH+'h '+sleepM+'m':sleepM+'m');
        var statusLabel='--';
        if(sleepUp.status==='checked_in'){
          statusLabel='\u{1F4A4} Asleep';
          if(sleepUp.up_formatted)statusLabel+=' ('+sleepUp.up_formatted+' up)';
        }else if(sleepUp.status==='checked_out'){
          statusLabel='\u2600\uFE0F Awake';
          if(sleepUp.up_formatted)statusLabel+=' ('+sleepUp.up_formatted+' up)';
        }
        var ss=document.getElementById('statSleepStatus');if(ss)ss.textContent=statusLabel;
      }
    }
    if(_dc('session',sessionToday)){
      if(sessionToday){
        var totalMin=sessionToday.total_minutes||0;
        var sH=Math.floor(totalMin/60);var sM=totalMin%60;
        var sText=sH>0?sH+'h '+sM+'m':sM+'m';
        if(sessionToday.active){sText+=' \u00b7 Active '+sessionToday.active_minutes+'m'}
        var st=document.getElementById('statSessionTotal');if(st)st.textContent=sessionToday.session_count>0?sText:'--';
        var sc=document.getElementById('statSessionCount');if(sc)sc.textContent=sessionToday.session_count+' session'+(sessionToday.session_count!==1?'s':'');
      }
    }
    var tasks=tasksRes?.tasks||[];
    if(_dc('tasks',tasks)){
      var tc=document.getElementById('tasksCard');
      var tpl=document.getElementById('taskProgressLabel');
      var tpb=document.getElementById('taskProgressBarContainer');
      var tpf=document.getElementById('taskProgressBarFill');
      var tpc=document.getElementById('taskProgressCount');
      var done=tasks.filter(function(t){return t.status==='done'}).length;
      if(tpl)tpl.textContent=done+'/'+tasks.length;
      if(tpb&&tasks.length>0){tpb.style.display='';if(tpc)tpc.textContent=done+' / '+tasks.length;if(tpf)tpf.style.width=Math.round((done/tasks.length)*100)+'%';}
      if(tc){
        if(tasks.length===0){
          tc.innerHTML='<div style="color:var(--text-inactive);font-size:13px">No tasks due today</div>';
        }else{
          tc.innerHTML=tasks.map(function(t){
            var isDone=t.status==='done';
            var circle=isDone?'<div class="task-toggle ok" onclick="toggleTask(\''+t.id+'\')">&#10003;</div>':'<div class="task-toggle" onclick="toggleTask(\''+t.id+'\')"></div>';
            var pinBtn='<span onclick="pinTask(\''+t.id+'\','+(t.pinned?'false':'true')+',event)" style="cursor:pointer;font-size:16px;color:'+(t.pinned?'var(--yellow)':'var(--muted)')+';margin-left:4px;padding:4px 2px">'+(t.pinned?'\uD83D\uDCCC':'\u25CB')+'</span>';
            var delBtn='<span onclick="event.stopPropagation();delTaskWidget(\''+t.id+'\')" style="cursor:pointer;font-size:14px;color:var(--muted);margin-left:2px;padding:4px 4px" title="Delete">&#10005;</span>';
            return '<div class="task-row">'+circle+'<span class="task-title'+(isDone?' task-done':'')+'">'+(t.priority==='high'?'\u{1F534}':t.priority==='medium'?'\u{1F7E1}':'\u{1F7E2}')+' '+t.title+(t.deadline_time?' @'+t.deadline_time:'')+'</span>'+pinBtn+delBtn+'<span style="color:var(--muted);flex-shrink:0;font-size:11px">'+t.deadline+'</span></div>'
          }).join('')
        }
      }
    }
    var overdue=overdueRes?.tasks||[];
    if(_dc('overdue',overdue)){
      var nas=document.getElementById('needsAttentionSection');
      if(overdue.length===0){
        if(nas)nas.style.display='none';
      }else{
        if(nas){nas.style.display='block';document.getElementById('attentionText').textContent=overdue.length+' task'+(overdue.length>1?'s':'')+' overdue — review required';}
      }
    }
    loadHomeChecklist();
    loadDailyRituals(streak);
    loadReaderNook();
    loadFeed();
    _lastDashboardLoad=Date.now();
  }catch(e){}
  _dashboardLoading=false;
}

function getTaskCategory(label){
  var l = (label || '').toLowerCase();
  if(l.indexOf('sketch')!==-1||l.indexOf('tea')!==-1||l.indexOf('art')!==-1||l.indexOf('write')!==-1||l.indexOf('creat')!==-1||l.indexOf('music')!==-1||l.indexOf('paint')!==-1){
    return { name: 'Creative', bg: '#FAF0EE', color: '#8C5E58', border: '#EADCDA' };
  }
  if(l.indexOf('walk')!==-1||l.indexOf('water')!==-1||l.indexOf('breath')!==-1||l.indexOf('yoga')!==-1||l.indexOf('sleep')!==-1||l.indexOf('rest')!==-1||l.indexOf('meditat')!==-1){
    return { name: 'Self-care', bg: '#F4F7F5', color: '#5B6A78', border: '#DDE7E2' };
  }
  if(l.indexOf('call')!==-1||l.indexOf('mom')!==-1||l.indexOf('friend')!==-1||l.indexOf('thank')!==-1||l.indexOf('help')!==-1||l.indexOf('message')!==-1){
    return { name: 'Kindness', bg: '#E6F4F1', color: '#2E7D6A', border: '#D0EBE5' };
  }
  return { name: 'Gentle', bg: '#FAF0EE', color: '#8C5E58', border: '#EADCDA' };
}

async function loadHomeChecklist(){
  var container = document.getElementById('homeChecklistItems');
  var badge = document.getElementById('homeChecklistCountBadge');
  if(!container) return;
  try {
    var r1 = await fetch(BASE + '/checklist/today');
    var j1 = await r1.json();
    var dailyItems = (j1.items || []).map(function(i){ i._freq = 'D'; return i; });
    var r2 = await fetch(BASE + '/checklist/week');
    var j2 = await r2.json();
    var weeklyItems = (j2.items || []).map(function(i){ i._freq = 'W'; return i; });
    var allItems = dailyItems.concat(weeklyItems);
    var seenIds = {};
    allItems = allItems.filter(function(i){ if(seenIds[i.id]) return false; seenIds[i.id] = true; return true; });
    
    var active = [], done = [];
    allItems.forEach(function(item){
      if(item.done) done.push(item);
      else active.push(item);
    });

    if(badge){
      if(allItems.length === 0){
        badge.textContent = 'Peaceful day';
      } else if(active.length === 0){
        badge.textContent = 'All complete ✨';
      } else {
        badge.textContent = active.length + ' of ' + allItems.length + ' open';
      }
    }

    if(allItems.length === 0){
      container.innerHTML = '<div style="font-size:12px;color:#5B6A78;font-style:italic;padding:12px 4px;text-align:center;">No pending tasks. Enjoy your quiet space.</div>';
      return;
    }

    var displayList = active.concat(done).slice(0, 5);
    var html = '';
    displayList.forEach(function(item){
      var isDone = !!item.done;
      var cat = getTaskCategory(item.label);
      var textStyle = isDone ? 'text-decoration:line-through;color:var(--text-inactive);opacity:0.6;' : 'color:var(--text);';
      var pillStyle = isDone ? 'background:var(--primary);border:2px solid var(--primary);color:var(--on-primary);' : 'background:var(--surface);border:2px solid var(--border);color:var(--primary);';
      var checkIcon = isDone ? '<span class="material-symbols-outlined" style="font-size:14px;line-height:1;">check</span>' : '';
      var itemBg = isDone ? 'var(--surface-container)' : 'var(--surface-container-high)';

      html += '<div class="task-item" style="padding:10px 12px;border-radius:1rem;display:flex;align-items:center;justify-content:space-between;gap:12px;background:' + itemBg + ';border:1px solid var(--border);transition:all 0.15s ease;">';
      html += '  <div style="display:flex;align-items:center;gap:10px;min-width:0;flex:1;cursor:pointer;" onclick="toggleHomeChecklistItem(\'' + item.id + '\')">';
      html += '    <button aria-label="Toggle task" class="task-pill" style="width:24px;height:24px;border-radius:9999px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;padding:0;' + pillStyle + '">';
      html +=        checkIcon;
      html += '    </button>';
      html += '    <span style="font-size:12px;font-weight:500;' + textStyle + 'white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">';
      html +=        esc(item.label);
      html += '    </span>';
      html += '  </div>';
      html += '  <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">';
      html += '    <span style="font-size:10px;font-weight:600;padding:2px 8px;border-radius:9999px;background:' + cat.bg + ';color:' + cat.color + ';border:1px solid ' + cat.border + ';">' + cat.name + '</span>';
      html += '    <span onclick="deleteHomeChecklistItem(\'' + item.id + '\')" style="cursor:pointer;color:#5B6A78;opacity:0.4;font-size:12px;padding:2px 4px;" title="Delete">✕</span>';
      html += '  </div>';
      html += '</div>';
    });
    if(allItems.length > 5){
      html += '<div style="text-align:center;padding-top:4px;"><span onclick="openChecklist()" style="cursor:pointer;font-size:11px;font-weight:600;color:var(--primary);">+ ' + (allItems.length - 5) + ' more gentle tasks...</span></div>';
    }
    container.innerHTML = html;
  } catch(e){}
}

async function loadDailyRituals(streakData){
  var streakEl = document.getElementById('habitStreakText');
  var bubblesEl = document.getElementById('habitWeekBubbles');
  if(!bubblesEl) return;
  try {
    var streakVal = 0;
    if(streakData && typeof streakData.overall_streak === 'number'){
      streakVal = streakData.overall_streak;
    } else {
      var r = await fetch(BASE + '/streak');
      var j = await r.json();
      streakVal = j.overall_streak || 0;
    }
    if(streakEl){
      streakEl.textContent = streakVal > 0 
        ? (streakVal + '-day streak — you are doing wonderful!')
        : 'Start a gentle streak today — one step at a time.';
    }

    var now = new Date();
    var currentDayOfWeek = (now.getDay() + 6) % 7; // 0 = Mon, 6 = Sun
    var monday = new Date(now);
    monday.setDate(now.getDate() - currentDayOfWeek);
    monday.setHours(0,0,0,0);

    var daysLetters = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
    var html = '';

    for(var i = 0; i < 7; i++){
      var isPast = i < currentDayOfWeek;
      var isToday = (i === currentDayOfWeek);
      var letter = daysLetters[i];
      var letterColor = isToday ? '#2E7D6A' : '#5B6A78';

      var bubbleHtml = '';
      if(isPast){
        bubbleHtml = '<div style="width:32px;height:32px;border-radius:9999px;display:flex;align-items:center;justify-content:center;color:#FFFFFF;font-size:12px;font-weight:700;background:#2E7D6A;">' +
                     '  <span class="material-symbols-outlined" style="font-size:15px;line-height:1;">check</span>' +
                     '</div>';
      } else if(isToday){
        bubbleHtml = '<div style="width:32px;height:32px;border-radius:9999px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:#E6F4F1;color:#2E7D6A;border:2px solid #3F9A83;">' +
                     '  <span class="material-symbols-outlined" style="font-size:15px;line-height:1;">check</span>' +
                     '</div>';
      } else {
        bubbleHtml = '<div style="width:32px;height:32px;border-radius:9999px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:#FFFFFF;border:1px dashed #DDE7E2;color:#5B6A78;">' +
                     '  <span style="width:6px;height:6px;border-radius:9999px;background:#DDE7E2;display:inline-block;"></span>' +
                     '</div>';
      }

      html += '<div style="display:flex;flex-direction:column;align-items:center;gap:6px;">' +
              '  <span style="font-size:11px;font-weight:700;color:' + letterColor + ';">' + letter + '</span>' +
              bubbleHtml +
              '</div>';
    }
    bubblesEl.innerHTML = html;
  } catch(e){}
}

function loadReaderNook(){
  try {
    var titleEl = document.getElementById('readerBookTitle');
    var metaEl = document.getElementById('readerBookMeta');
    var chapterEl = document.getElementById('readerChapterText');
    var pctEl = document.getElementById('readerProgressPct');
    var barEl = document.getElementById('readerProgressBar');

    if(typeof ReaderEngine !== 'undefined' && ReaderEngine._activeBook && ReaderEngine._activeBook.title){
      var b = ReaderEngine._activeBook;
      if(titleEl) titleEl.textContent = b.title;
      if(metaEl) metaEl.textContent = (b.author ? b.author + ' · ' : '') + (b.totalChapters ? ('Chapter ' + (b.currentChapter||1) + ' of ' + b.totalChapters) : 'Reading');
      if(chapterEl) chapterEl.textContent = 'Chapter ' + (b.currentChapter||1);
      var pct = b.progress || 64;
      if(pctEl) pctEl.textContent = pct + '% read';
      if(barEl) barEl.style.width = pct + '%';
    } else {
      if(titleEl && !titleEl.textContent.trim()) titleEl.textContent = 'Quiet: The Power of Introverts';
      if(metaEl && !metaEl.textContent.trim()) metaEl.textContent = 'Susan Cain · p. 142 of 220';
      if(chapterEl && !chapterEl.textContent.trim()) chapterEl.textContent = 'Chapter 4';
      if(pctEl && !pctEl.textContent.trim()) pctEl.textContent = '64% read';
      if(barEl && !barEl.style.width) barEl.style.width = '64%';
    }
  } catch(e){}
}

function openHabitsOrPlugin(){
  if(typeof v07OpenPlugin === 'function'){
    var hasHabits = (window._ALL_INSTALLED_PLUGINS || []).some(function(p){ return p.id === 'com.v07.habits' && p.enabled !== false; });
    if(hasHabits){
      v07OpenPlugin('com.v07.habits');
      return;
    }
  }
  openLogDashboard();
}

function openReaderOrPlugin(){
  if(typeof v07OpenPlugin === 'function'){
    var hasReader = (window._ALL_INSTALLED_PLUGINS || []).some(function(p){ return p.id === 'com.v07.reader' && p.enabled !== false; });
    if(hasReader){
      v07OpenPlugin('com.v07.reader');
      return;
    }
  }
  openGitaPage();
}

async function toggleHomeChecklistItem(id){
  try {
    await fetch(BASE + '/checklist/' + id + '/toggle', { method: 'POST' });
    loadHomeChecklist();
    var clEl = document.getElementById('checklistPage');
    if(clEl && clEl.classList.contains('show')) loadChecklistItems();
  } catch(e){}
}

async function deleteHomeChecklistItem(id){
  try {
    await fetch(BASE + '/checklist/' + id, { method: 'DELETE' });
    loadHomeChecklist();
    var clEl = document.getElementById('checklistPage');
    if(clEl && clEl.classList.contains('show')) loadChecklistItems();
  } catch(e){}
}

async function quickAddHomeDirective(){
  var inp = document.getElementById('homeQuickDirectiveInput');
  if(!inp || !inp.value.trim()) return;
  var text = inp.value.trim();
  try {
    await fetch(BASE + '/checklist/today', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ label: text, frequency: 'D', recurring: false })
    });
    inp.value = '';
    loadHomeChecklist();
    var clEl = document.getElementById('checklistPage');
    if(clEl && clEl.classList.contains('show')) loadChecklistItems();
  } catch(e){}
}

async function toggleTask(id){
  var tc = document.getElementById('tasksCard');
  if(tc){
    var row = Array.from(tc.querySelectorAll('.task-row')).find(function(r){
      return r.querySelector('[onclick*="' + id + '"]');
    });
    if(row){
      var toggle = row.querySelector('.task-toggle');
      var title = row.querySelector('.task-title');
      if(toggle && title){
        var willBeDone = !toggle.classList.contains('ok');
        toggle.classList.toggle('ok', willBeDone);
        toggle.innerHTML = willBeDone ? '&#10003;' : '';
        title.classList.toggle('task-done', willBeDone);
        var doneRows = tc.querySelectorAll('.task-toggle.ok').length;
        var allRows = tc.querySelectorAll('.task-row').length;
        var tpl = document.getElementById('taskProgressLabel');
        var tpf = document.getElementById('taskProgressBarFill');
        var tpc = document.getElementById('taskProgressCount');
        if(tpl) tpl.textContent = doneRows + '/' + allRows;
        if(tpc) tpc.textContent = doneRows + ' / ' + allRows;
        if(tpf && allRows > 0) tpf.style.width = Math.round((doneRows / allRows) * 100) + '%';
      }
    }
  }
  try{
    var data=await wrapFetch(fetch(BASE+'/task/'+id+'/done',{method:'POST'}),'toggleTask',{taskId:id}).then(function(r){return r.json()});
    if(data.ok)toast('Toggled done!');
  }catch(e){
    toast('Error syncing task');
    loadDashboard();
  }
}

async function delTaskWidget(id){
  try{
    var r=await fetch(BASE+'/task/'+id,{method:'DELETE'});
    var j=await r.json().catch(()=>({ok:false,detail:'Invalid JSON'}));
    if(j.ok||j.recycled){toast('Moved to recycle bin');loadDashboard()}
    else toast(j.detail||'Failed');
  }catch(e){toast('Error: '+e.message)}
}

var _feedCache='';
async function loadFeed(){
  try{
    var feedResults=await Promise.allSettled([
      wrapFetch(fetch(BASE+'/events/thought/today'),'loadFeed',{endpoint:'/events/thought/today'}).then(function(r){return r.json()}),
      wrapFetch(fetch(BASE+'/events/journal/today'),'loadFeed',{endpoint:'/events/journal/today'}).then(function(r){return r.json()}),
      wrapFetch(fetch(BASE+'/events/running/today'),'loadFeed',{endpoint:'/events/running/today'}).then(function(r){return r.json()}),
      wrapFetch(fetch(BASE+'/events/gita/today'),'loadFeed',{endpoint:'/events/gita/today'}).then(function(r){return r.json()})]);
    var thoughts=feedResults[0].status==='fulfilled'?feedResults[0].value:null;
    var journals=feedResults[1].status==='fulfilled'?feedResults[1].value:null;
    var runs=feedResults[2].status==='fulfilled'?feedResults[2].value:null;
    var gitas=feedResults[3].status==='fulfilled'?feedResults[3].value:null;
    var items=[];
    (thoughts?.events||[]).forEach(function(e){
      var topic=e.topic?' ('+esc(e.topic)+')':'';
      items.push({ts:e.ts,html:'<span style="color:var(--accent);text-transform:uppercase;margin-right:8px">THINK:</span>'+esc((e.text||'').slice(0,60))+topic});
    });
    (journals?.events||[]).forEach(function(e){
      var label=e.subtype==='win'?'<span style="color:var(--yellow);text-transform:uppercase;margin-right:8px">WIN:</span>':e.subtype==='lesson'?'<span style="color:var(--green);text-transform:uppercase;margin-right:8px">LESSON:</span>':'<span style="color:var(--green);text-transform:uppercase;margin-right:8px">JOURNAL:</span>';
      items.push({ts:e.ts,html:label+esc((e.text||'').slice(0,60))});
    });
    (runs?.events||[]).forEach(function(e){
      var durStr = e.duration_formatted || formatRunDuration(e.duration_sec || e.duration_min, e.distance_km);
      var pace = e.pace || '';
      var paceStr = pace ? ' (' + pace + (pace.includes('/') ? '' : '/km') + ')' : '';
      var typeStr = e.run_type ? ' (' + e.run_type + ')' : '';
      items.push({ts:e.ts,html:'<span style="color:var(--green);text-transform:uppercase;margin-right:8px">RUN:</span>'+((e.distance_km||0)+' km')+' in '+durStr+paceStr+typeStr});
    });
    (gitas?.events||[]).forEach(function(e){
      items.push({ts:e.ts,html:'<span style="color:var(--accent);text-transform:uppercase;margin-right:8px">GITA:</span>Read '+(e.chapter||'')+'.'+(e.verse||'')});
    });
    items.sort(function(a,b){return(b.ts||'').localeCompare(a.ts||'')});
    var feedHtml=items.length===0?'<div style="padding:6px 0;color:var(--text-inactive);opacity:0.5;font-style:italic">Waiting for new input...</div>':items.slice(0,5).map(function(i){
      var ts=i.ts?new Date(i.ts):null;
      var timeStr='';
      if(ts){var h=ts.getHours()%12||12;var m=String(ts.getMinutes()).padStart(2,'0');timeStr='['+h+':'+m+']';}
      return '<div style="display:flex;align-items:flex-start;gap:12px;padding:6px 0;border-bottom:1px solid rgba(27,27,27,0.5)"><span style="color:var(--text-inactive);white-space:nowrap">'+timeStr+'</span><span style="color:var(--text)">'+i.html+'</span></div>';
    }).join('');
    if(_feedCache!==feedHtml){_feedCache=feedHtml;document.getElementById('feedCard').innerHTML=feedHtml}
  }catch(e){}
}

var td=document.getElementById('todayDate');if(td)td.textContent=new Date().toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
var hd=document.getElementById('homeDateDisplay');if(hd)hd.textContent=new Date().toLocaleDateString('en-US',{weekday:'short',day:'numeric',month:'short'});
loadDashboard();
loadHomeChecklist();
loadDailyRituals();
loadReaderNook();
loadSessionStatus();
loadScreenTime(true);
loadDayTrackerPreview();
loadPluginNav();
setInterval(loadDashboard,30000);
setInterval(loadSessionStatus,2000);
var _lastScreenTimeLoad=Date.now();
setInterval(function(){_lastScreenTimeLoad=Date.now();loadScreenTime(true)},5*60*1000);
setInterval(checkMoodPrompt,60000);
if('serviceWorker'in navigator){navigator.serviceWorker.getRegistrations().then(function(regs){regs.forEach(function(r){r.unregister()})});caches.keys().then(function(ks){ks.forEach(function(k){caches.delete(k)})})}
document.addEventListener('visibilitychange',function(){if(!document.hidden){loadSessionStatus();if(Date.now()-_lastDashboardLoad>15000){loadDashboard();loadScreenTime(true);loadDayTrackerPreview()}if(Date.now()-_lastScreenTimeLoad>5*60*1000){_lastScreenTimeLoad=Date.now();loadScreenTime(true)}}})
window.addEventListener('beforeunload',function(){try{localStorage.setItem('sessTimerRemaining',timerRemaining);localStorage.setItem('sessTimerSeconds',timerSeconds);localStorage.setItem('sessTimerRunning',timerRunning?'1':'0');localStorage.setItem('sessTimerTs',Date.now())}catch(e){}})

// ─── Sessions Page ────────────────────────────────────────────────────────────

var timerSeconds=1500,timerRemaining=1500,timerRunning=false,timerInterval=null,timerMode='countdown';
try{var _savedTs=parseInt(localStorage.getItem('sessTimerTs'))||0;if(_savedTs>0&&Date.now()-_savedTs<10000){var _savedRemaining=parseInt(localStorage.getItem('sessTimerRemaining'))||0;if(_savedRemaining>0){timerRemaining=Math.max(0,_savedRemaining-Math.floor((Date.now()-_savedTs)/1000));timerSeconds=parseInt(localStorage.getItem('sessTimerSeconds'))||timerSeconds;timerRunning=localStorage.getItem('sessTimerRunning')==='1';if(timerRunning&&!timerInterval){timerStart()}}}}catch(e){}
var spb=null;

function formatTime(s){var m=Math.floor(s/60);var sec=s%60;return String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0')}

function updateTimerDisplay(){
  var el=document.getElementById('timerDisplay');
  if(timerMode==='stopwatch'){
    el.textContent=formatTime(timerRemaining);
    el.style.color='var(--green)';
  }else{
    el.textContent=formatTime(timerRemaining);
    el.style.color=timerRemaining<=60&&timerRemaining>0?'var(--red)':'var(--text)';
  }
  // Update home focus timer
  _setHomeTimer(timerRemaining,timerMode==='countdown');
  if(spb&&timerMode==='countdown'&&timerSeconds>0){spb.style.width=Math.round(((timerSeconds-timerRemaining)/timerSeconds)*100)+'%';}
}
function _setHomeTimer(totalSec,isCountdown){
  var h=document.getElementById('timerHH'),m=document.getElementById('timerMM'),s=document.getElementById('timerSS');
  var td=document.getElementById('timerDisplay');
  var hrs=Math.floor(totalSec/3600);var mins=Math.floor((totalSec%3600)/60);var secs=totalSec%60;
  if(h){ h.textContent=String(hrs).padStart(2,'0');m.textContent=String(mins).padStart(2,'0');s.textContent=String(secs).padStart(2,'0'); }
  if(td){
    var dispStr = hrs > 0 ? (hrs + ':' + String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0')) : (String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0'));
    td.textContent = dispStr;
    var warn=isCountdown&&totalSec<=60&&totalSec>0;
    td.style.color=warn?'var(--secondary)':'var(--text)';
  }
}

function setTimerMode(mode){
  if(timerRunning)return;
  timerMode=mode;localStorage.setItem('sessTimerMode',mode);
  var cd=document.getElementById('modeCountdown');
  var sw=document.getElementById('modeStopwatch');
  if(mode==='countdown'){
    cd.style.borderBottom='2px solid var(--primary)';cd.style.color='var(--primary)';
    sw.style.borderBottom='2px solid transparent';sw.style.color='var(--text-inactive)';
  }else{
    sw.style.borderBottom='2px solid var(--primary)';sw.style.color='var(--primary)';
    cd.style.borderBottom='2px solid transparent';cd.style.color='var(--text-inactive)';
  }
  document.getElementById('timerPresets').style.display=mode==='stopwatch'?'none':'';
  var stt=document.getElementById('sessionTargetText');
  if(stt){
    if(mode==='countdown'){
      stt.textContent='TARGET: '+(Math.round(timerSeconds/60)||25)+'m POMODORO';
    }else{
      stt.textContent='TARGET: OPEN-ENDED FOCUS';
    }
  }
  timerReset();
}

function setTimer(m,s){
  timerRunning=false;if(timerInterval){clearInterval(timerInterval);timerInterval=null}
  timerSeconds=m*60+s;timerRemaining=timerSeconds;updateTimerDisplay();
  var stt=document.getElementById('sessionTargetText');
  if(stt) stt.textContent='TARGET: '+m+'m POMODORO';
}

async function customTimer(){var inp=await customPrompt('How many minutes for the countdown?');if(inp===null)return;var m=parseInt(inp)||0;var s=parseInt(await customPrompt('And how many seconds?'))||0;if(m===0&&s===0)return;setTimer(m,s)}

function timerTick(){
  if(timerMode==='stopwatch'){
    timerRemaining++;
    updateTimerDisplay();
  }else{
    if(timerRemaining<=0){
      timerRunning=false;if(timerInterval){clearInterval(timerInterval);timerInterval=null}
      updateTimerDisplay();
      if('Notification' in window && Notification.permission==='granted'){
        new Notification('Timer Done!',{body:'Time is up.'});
      }
      toast('Time\'s up!');
      try{fetch(BASE+'/session/stop',{method:'POST'}).then(function(){loadSessionsPage()})}catch(e){}
      return;
    }
    timerRemaining--;
    updateTimerDisplay();
  }
}

function timerStart(){
  if(timerRunning)return;
  if(timerMode==='countdown'&&timerSeconds<=0){setTimer(25,0)}
  timerRunning=true;
  timerInterval=setInterval(timerTick,1000)
}

function timerPause(){timerRunning=false;if(timerInterval){clearInterval(timerInterval);timerInterval=null}}

function timerReset(){timerRunning=false;if(timerInterval){clearInterval(timerInterval);timerInterval=null}
  timerRemaining=timerMode==='stopwatch'?0:timerSeconds;updateTimerDisplay();
  document.getElementById('modeCountdown').disabled=false;document.getElementById('modeStopwatch').disabled=false}

async function sessionStart(){
  var activity=document.getElementById('sessActivity').value;
  var isCustom=false;
  if(activity==='__custom__'){
    activity=document.getElementById('customActivityInput').value.trim();
    if(!activity){toast('Enter a custom activity name');return}
    isCustom=true;
  }
  var label=document.getElementById('sessLabel').value.trim()||null;
  if(!activity){toast('Select an activity');return}
  try{
    var existing=await fetch(BASE+'/session/active').then(function(r){return r.json()});
    if(existing.active||existing.paused){toast('Session already active — stop it first');return}
    var r=await fetch(BASE+'/session/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({activity:activity,custom_label:label,timer_mode:timerMode,timer_seconds:timerMode==='countdown'?timerSeconds:0})});
    var j=await r.json();
    if(j.ok){
      if(isCustom){
        try{await fetch(BASE+'/session/add-custom-activity',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({activity:activity})})}catch(e2){}
        _sessActivityItems=[]
      }
      toast('Session started!');
      loadSessionStatus()
    }
    else if(j.detail) toast(j.detail)
  }catch(e){toast('Error')}
}

function toggleCustomActivity(){
  document.getElementById('customActivityWrap').style.display=document.getElementById('sessActivity').value==='__custom__'?'':'none';
}

async function loadSessionStatus(){
  try{
    var r=await fetch(BASE+'/session/active');
    var j=await r.json();
    var pauseBtn=document.getElementById('sessPauseBtn');
    var resumeBtn=document.getElementById('sessResumeBtn');
    var stopBtn=document.getElementById('sessStopBtn');
    var statusText=document.getElementById('sessionStatusText');
    var modeCd=document.getElementById('modeCountdown');
    var modeSw=document.getElementById('modeStopwatch');
    if(j.active||j.paused){
      var s=j.session||{};
      var sessMode=s.mode||'stopwatch';
      var targetMs=s.target_duration||0;
      var elapsedMs=s.elapsed_ms||0;
      var remainingSecs=sessMode==='countdown'&&targetMs>0?Math.max(Math.floor((targetMs-elapsedMs)/1000),0):0;
      var elapsedSecs=Math.floor(elapsedMs/1000);
      var sal=document.getElementById('sessionActivityLabel');
      if(j.active){
        pauseBtn.style.display='';resumeBtn.style.display='none';stopBtn.style.display='';
        statusText.textContent='Active: '+activityLabel(s.activity)+(j.elapsed_minutes!=null?' ('+j.elapsed_minutes+'m)':'');
        if(sal)sal.textContent=activityLabel(s.activity);
        if(sessMode==='countdown'&&targetMs>0){
          timerMode='countdown';timerSeconds=Math.floor(targetMs/1000);timerRemaining=remainingSecs;updateTimerDisplay();
          modeCd.className='btn btn-accent';modeSw.className='btn';
          document.getElementById('timerPresets').style.display='';
        }else{
          timerMode='stopwatch';timerRemaining=elapsedSecs;updateTimerDisplay();
          modeCd.className='btn';modeSw.className='btn btn-accent';
          document.getElementById('timerPresets').style.display='none';
        }
        modeCd.disabled=true;modeSw.disabled=true;
        timerRunning=false;if(timerInterval){clearInterval(timerInterval);timerInterval=null}
        timerStart();
      }else{
        pauseBtn.style.display='none';resumeBtn.style.display='';stopBtn.style.display='';
        statusText.textContent='Paused: '+activityLabel(s.activity)+(j.elapsed_minutes!=null?' ('+j.elapsed_minutes+'m)':'');
        if(sal)sal.textContent=activityLabel(s.activity);
        if(sessMode==='countdown'&&targetMs>0){
          timerMode='countdown';timerSeconds=Math.floor(targetMs/1000);timerRemaining=remainingSecs;updateTimerDisplay();
          modeCd.className='btn btn-accent';modeSw.className='btn';
          document.getElementById('timerPresets').style.display='';
        }else{
          timerMode='stopwatch';timerRemaining=elapsedSecs;updateTimerDisplay();
          modeCd.className='btn';modeSw.className='btn btn-accent';
          document.getElementById('timerPresets').style.display='none';
        }
        modeCd.disabled=true;modeSw.disabled=true;
        if(timerRunning)timerPause();
      }
      // Update home page focus timer
      var sab=document.getElementById('sessionActiveBadge');
      var spid=document.getElementById('sessionPid');
      var dpi=document.getElementById('dash-play-icon');
      spb=document.getElementById('sessionProgressBar');
      if(dpi) dpi.textContent = j.active ? 'pause' : 'play_arrow';
      if(sab)sab.textContent=j.active?'● ACTIVE':'◉ PAUSED';
      if(spid){spid.textContent=j.active?'Quiet Flow':'Paused';}
      _setHomeTimer(j.active?timerRemaining:(timerRemaining),sessMode==='countdown');
      if(spb){
        if(sessMode==='countdown'&&timerSeconds>0){spb.style.width=Math.round(((timerSeconds-timerRemaining)/timerSeconds)*100)+'%';spb.style.background='var(--green)';}
        else{
          var pct=j.today_progress!=null?Math.round(j.today_progress*100):0;
          spb.style.width=Math.min(pct,100)+'%';
          spb.style.background=pct>=100?'var(--secondary)':'var(--primary)';
        }
      }
      var spl=document.getElementById('sessionProgressBarLabel');
      if(spl){
        var tgt=j.daily_target||DEFAULT_DAILY_TARGET;
        var worked=j.today_minutes||0;
        spl.textContent=worked+'/'+tgt+'m';
        spl.style.color=worked>=tgt?'var(--secondary)':'var(--primary)';
      }
      var stt=document.getElementById('sessionTargetText');
      if(stt){
        if(j.active){
          stt.textContent = sessMode==='countdown'&&targetMs>0
            ? ('Mindful flow · ' + Math.max(1, Math.round(timerRemaining/60)) + 'm remaining')
            : ('In mindful session · ' + activityLabel(s.activity));
        } else {
          stt.textContent = 'Session paused · take a gentle breath';
        }
      }
      // Toggle home card buttons
      var hns=document.getElementById('homeSessionNoSession');
      var hsa=document.getElementById('homeSessionActive');
      var hsp=document.getElementById('homeSessionPaused');
      if(hns)hns.style.display='none';
      if(hsa)hsa.style.display=j.active?'flex':'none';
      if(hsp)hsp.style.display=j.paused?'flex':'none';
    }else{
      pauseBtn.style.display='none';resumeBtn.style.display='none';stopBtn.style.display='none';
      statusText.textContent='';
      modeCd.disabled=false;modeSw.disabled=false;
      var sal=document.getElementById('sessionActivityLabel');if(sal)sal.textContent='Deep breath session';
      var savedMode=localStorage.getItem('sessTimerMode')||'countdown';timerMode=savedMode;setTimerMode(savedMode);if(savedMode==='countdown'){setTimer(25,0)}else{setTimer(0,0)}
      var sab=document.getElementById('sessionActiveBadge');
      var spid=document.getElementById('sessionPid');
      var dpi=document.getElementById('dash-play-icon');
      if(dpi) dpi.textContent = 'play_arrow';
      spb=document.getElementById('sessionProgressBar');
      if(sab)sab.textContent='';
      if(spid)spid.textContent='Quiet Flow';
      _setHomeTimer(1500,true);
      var td=document.getElementById('timerDisplay');
      if(td) td.textContent='25:00';
      if(spb){spb.style.width='0%';}
      var stt=document.getElementById('sessionTargetText');
      if(stt){
        stt.textContent = 'Ready to start mindful block';
      }
      // Toggle home card buttons - show Start
      var hns=document.getElementById('homeSessionNoSession');
      var hsa=document.getElementById('homeSessionActive');
      var hsp=document.getElementById('homeSessionPaused');
      if(hns)hns.style.display='flex';
      if(hsa)hsa.style.display='none';
      if(hsp)hsp.style.display='none';
    }
  }catch(e){}
}

async function handleFocusToggle(){
  try{
    var r = await fetch(BASE + '/session/active');
    var j = await r.json();
    if(j.active){
      await sessionPause();
    } else if(j.paused){
      await sessionResume();
    } else {
      var r2 = await fetch(BASE + '/session/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          activity: 'deep_work',
          custom_label: 'Calm Flow',
          timer_mode: 'countdown',
          timer_seconds: 1500
        })
      });
      var j2 = await r2.json();
      if(j2.ok){
        toast('Focus block started!');
        loadSessionStatus();
      }
    }
  }catch(e){toast('Focus error')}
}

async function sessionReset(){
  try{
    var r = await fetch(BASE + '/session/active');
    var j = await r.json();
    if(j.active || j.paused){
      await sessionStop();
    } else {
      timerReset();
      _setHomeTimer(1500, true);
      var td = document.getElementById('timerDisplay');
      if(td) td.textContent = '25:00';
    }
  }catch(e){}
}

async function sessionPause(){
  try{
    await fetch(BASE+'/session/pause',{method:'POST'});
    if(timerRunning)timerPause();
    toast('Paused');
    loadSessionStatus()
  }catch(e){toast('Error')}
}
async function sessionResume(){
  try{
    await fetch(BASE+'/session/resume',{method:'POST'});
    toast('Resumed');
    loadSessionStatus()
  }catch(e){toast('Error')}
}
async function sessionStop(){
  try{
    await fetch(BASE+'/session/stop',{method:'POST'});
    toast('Stopped');
    loadSessionStatus();
    loadSessionsPage()
  }catch(e){toast('Error')}
}

async function deleteSessionEvent(category,eventId){
  if(!confirm('Move to recycle bin?'))return;
  try{
    var r=await fetch(BASE+'/event/'+category+'/'+eventId,{method:'DELETE'});
    var j=await r.json();
    if(j.ok||j.recycled){toast('Moved to recycle bin');loadSessionsPage()}
    else if(j.detail) toast(j.detail)
  }catch(e){toast('Error')}
}

function editSessionPair(startId,endId,activity,label,duration){
  var ov=document.getElementById('editSessOverlay');
  if(!ov){
    ov=document.createElement('div');
    ov.id='editSessOverlay';
    ov.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;z-index:9999';
    ov.innerHTML='<div style="background:var(--card-bg);border-radius:12px;padding:20px;width:300px;max-width:90vw;display:flex;flex-direction:column;gap:12px;color:var(--text);font-size:13px">'+
      '<div style="font-weight:700;font-size:15px;margin-bottom:4px">Edit Session</div>'+
      '<label>Activity</label>'+
      '<input id="editSessActivity" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px;color:var(--text);font-size:13px;width:100%;box-sizing:border-box">'+
      '<label>Label (optional)</label>'+
      '<input id="editSessLabel" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px;color:var(--text);font-size:13px;width:100%;box-sizing:border-box">'+
      '<label>Duration (minutes)</label>'+
      '<input id="editSessDuration" type="number" min="1" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px;color:var(--text);font-size:13px;width:100%;box-sizing:border-box">'+
      '<div style="display:flex;gap:8px;margin-top:4px">'+
      '<button id="editSessSaveBtn" style="flex:1;background:var(--primary);color:var(--bg);border:none;border-radius:6px;padding:8px;font-size:13px;cursor:pointer;font-weight:600">Save</button>'+
      '<button id="editSessCancelBtn" style="flex:1;background:var(--border);color:var(--text);border:none;border-radius:6px;padding:8px;font-size:13px;cursor:pointer">Cancel</button></div></div>';
    document.body.appendChild(ov);
  }
  ov.style.display='flex';
  var actInput=document.getElementById('editSessActivity');
  var lblInput=document.getElementById('editSessLabel');
  var durInput=document.getElementById('editSessDuration');
  actInput.value=activity;
  lblInput.value=label;
  durInput.value=duration;
  actInput.focus();
  var saveBtn=document.getElementById('editSessSaveBtn');
  var cancelBtn=document.getElementById('editSessCancelBtn');
  var cleanup=function(){ov.style.display='none';saveBtn.onclick=null;cancelBtn.onclick=null};
  cancelBtn.onclick=cleanup;
  saveBtn.onclick=async function(){
    var newAct=actInput.value.trim();
    var newLbl=lblInput.value.trim();
    var newDur=parseInt(durInput.value);
    if(!newAct||!newDur||newDur<1){toast('Invalid values');return}
    var body={activity:newAct,custom_label:newLbl,duration_minutes:newDur};
    try{
      var r=await fetch(BASE+'/event/sessions/'+startId+'/edit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      var j=await r.json();
      if(j.ok){toast('Updated');cleanup();loadSessionsPage();loadDashboard()}else toast('Edit failed: '+(j.error||'unknown'))
    }catch(e){toast('Error: '+e)}
  };
}

async function deleteSessionPair(startId,endId){
  if(!confirm('Move to recycle bin?'))return;
  try{
    var r1=await fetch(BASE+'/event/sessions/'+startId,{method:'DELETE'});
    var j1=await r1.json();
    var ok=!!(j1.ok||j1.recycled);
    if(endId){
      var r2=await fetch(BASE+'/event/sessions/'+endId,{method:'DELETE'});
      var j2=await r2.json();
      ok=ok||!!(j2.ok||j2.recycled);
    }
    if(ok){toast('Moved to recycle bin');loadSessionsPage()}
  }catch(e){toast('Error')}
}

async function loadSessionsPage(){
  loadSessActivities();
  loadSessionStatus();
  var d=document.getElementById('sessDate').value||localDate();
  try{
    var data=await wrapFetch(fetch(BASE+'/day/'+d),'sessionsPage',{date:d}).then(function(r){return r.json()});
    var list=document.getElementById('sessionList');
    var sessions=data.events.filter(function(e){return e._category==='sessions'});
    if(sessions.length===0){list.innerHTML='<div style="color:var(--text-inactive);font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;text-align:center;padding:12px">No sessions recorded for this day</div>';return}
    var pairs=[];
    var openStart=null;
    sessions.forEach(function(e){
      if(e.type==='start'){openStart=e}
      else if(e.type==='end'&&openStart){
        var dur=e.duration||0;
        var mins=Math.floor(dur);var secs=Math.round((dur-mins)*60);
        pairs.push({start:openStart,end:e,activity:openStart.activity||e.activity,label:openStart.custom_label||'',duration:mins,start_ts:openStart.ts});
        openStart=null
      }
    });
    if(openStart){
      var elapsed=Math.floor((Date.now()-new Date(openStart.ts).getTime())/60000);
      pairs.push({start:openStart,end:null,activity:openStart.activity,label:openStart.custom_label||'',duration:elapsed,start_ts:openStart.ts,active:true})
    }
    if(pairs.length===0&&sessions.length>0){
      list.innerHTML=sessions.map(function(e){
        var t=e.ts?.slice(11,16)||'';
        var label=e.activity||e.type||'session';
        var extra=e.custom_label?' ('+e.custom_label+')':'';
        return '<div style="padding:6px 8px;border-bottom:1px solid var(--border);font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;display:flex;justify-content:space-between;align-items:center">'+
          '<span style="color:var(--text-inactive)">['+t+']</span> <span style="flex:1;margin-left:6px">'+activityLabel(label)+extra+'</span>'+
          '<span onclick="deleteSessionEvent(\'sessions\',\''+e.id+'\')" style="color:var(--red);cursor:pointer;font-size:11px;padding:2px 6px">&#x2716;</span></div>'
      }).join('');
      return
    }
    list.innerHTML=pairs.map(function(p){
      var t=p.start_ts.slice(11,16);
      var durStr=p.duration+'m';
      var activeTag=p.active?' <span style="color:var(--green);font-size:10px">ACTIVE</span>':'';
      var label=p.label?' <span style="color:var(--text-inactive)">'+p.label+'</span>':'';
      var endTime=p.end?p.end.ts?.slice(11,16):'';
      var editBtn='<span onclick="event.stopPropagation();editSessionPair(\''+p.start.id+'\',\''+(p.end?p.end.id:'')+'\',\''+esc(p.activity)+'\',\''+esc(p.label||'')+'\',\''+p.duration+'\')" style="color:var(--primary);cursor:pointer;font-size:11px;padding:2px 6px">&#x270F;</span>';
      var delBtn='<span onclick="event.stopPropagation();deleteSessionPair(\''+p.start.id+'\',\''+(p.end?p.end.id:'')+'\')" style="color:var(--red);cursor:pointer;font-size:11px;padding:2px 6px">&#x2716;</span>';
      return '<div onclick="editSessionPair(\''+p.start.id+'\',\''+(p.end?p.end.id:'')+'\',\''+esc(p.activity)+'\',\''+esc(p.label||'')+'\',\''+p.duration+'\')" style="padding:6px 8px;border-bottom:1px solid var(--border);font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;cursor:pointer">'+
        '<div style="display:flex;justify-content:space-between;align-items:center">'+
        '<span><span style="color:var(--text-inactive)">['+t+']</span> <span style="color:var(--primary)">></span> <span style="font-weight:600">'+activityLabel(p.activity)+'</span>'+label+activeTag+'</span>'+
        '<span style="color:var(--green);flex-shrink:0;margin-left:6px">'+durStr+'</span></div>'+
        '<div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-inactive);margin-top:2px;padding-left:20px">'+
        '<span>'+(endTime?'&rarr; '+endTime:'...')+'</span>'+
        '<span>'+editBtn+' '+delBtn+'</span></div></div>'
    }).join('')
  }catch(e){document.getElementById('sessionList').innerHTML='<div style="color:var(--red);font-size:13px;text-align:center;padding:10px">Failed to load</div>'}
}

var _sessActivityItems=[];

function renderActivityDropdown(){
  var dd=document.getElementById('sessActivityDropdown');
  dd.innerHTML='';
  _sessActivityItems.forEach(function(item){
    if(item.sep){dd.innerHTML+='<div style="padding:2px 10px;color:var(--border);font-size:10px;text-align:center;pointer-events:none">\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</div>';return}
    var delBtn=item.deletable?'<span class="act-del" data-activity="'+esc(item.value)+'" style="margin-left:auto;padding:2px 6px;cursor:pointer;color:var(--red);font-size:11px;display:none" onclick="event.stopPropagation();deleteRecentActivity(\''+esc(item.value)+'\')">\u2716</span>':'';
    dd.innerHTML+='<div class="act-item" data-value="'+esc(item.value)+'" onclick="selectActivity(\''+esc(item.value)+'\',\''+esc(item.label)+'\')" style="padding:8px 10px;cursor:pointer;display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--border);font-size:13px'+(item.custom?';font-style:italic':'')+'">'+
      '<span>'+(item.icon||'')+'</span><span>'+item.label+'</span>'+delBtn+'</div>';
  });
  dd.querySelectorAll('.act-item').forEach(function(el){el.addEventListener('mouseenter',function(){var d=el.querySelector('.act-del');if(d)d.style.display='block'});el.addEventListener('mouseleave',function(){var d=el.querySelector('.act-del');if(d)d.style.display='none'})});
}

function toggleActivityDropdown(){
  var dd=document.getElementById('sessActivityDropdown');
  dd.style.display=dd.style.display==='none'?'block':'none';
}

function selectActivity(value,label){
  document.getElementById('sessActivity').value=value;
  document.getElementById('sessActivityLabel').textContent=label;
  document.getElementById('sessActivityDropdown').style.display='none';
  toggleCustomActivity();
}

function closeActivityDropdown(e){
  var t=e.target;
  if(!t.closest('.custom-select')){var dd=document.getElementById('sessActivityDropdown');if(dd)dd.style.display='none'}
}
document.addEventListener('click',closeActivityDropdown);

async function deleteRecentActivity(name){
  if(!confirm('Remove "'+name+'" from recent activities?'))return;
  try{
    var r=await fetch(BASE+'/session/delete-activity',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({activity:name})});
    var j=await r.json();
    if(j.ok){toast('Removed');_sessActivityItems=[];loadSessActivities()}
    else toast('Failed');
  }catch(e){toast('Error')}
}

async function loadSessActivities(){
  if(_sessActivityItems.length>0)return;
  var seen = {};
  try{
    var recent=await fetch(BASE+'/session/recent-activities').then(function(r){return r.json()});
    if(recent.ok&&recent.activities&&recent.activities.length){
      recent.activities.forEach(function(a){
        if(!seen[a]){
          seen[a]=true;
          _sessActivityItems.push({value:a,label:activityLabel(a),custom:true,deletable:true});
        }
      });
      if(_sessActivityItems.length) _sessActivityItems.push({sep:true});
    }
  }catch(e){}
  try{
    var acts=await wrapFetch(fetch(BASE+'/meta/activities'),'sessActivities',{}).then(function(r){return r.json()});
    if(Array.isArray(acts)){
      acts.forEach(function(a){
        if(!seen[a]){
          seen[a]=true;
          _sessActivityItems.push({value:a,label:activityLabel(a),custom:false,deletable:true});
        }
      });
    }
  }catch(e){}
  _sessActivityItems.push({value:'__custom__',label:'➕ Add Activity',custom:true,deletable:false});
  renderActivityDropdown();
  loadDailyTarget();
}

async function loadDailyTarget(){
  try{
    var r=await fetch(BASE+'/session/daily-target');
    var j=await r.json();
    if(j.ok){document.getElementById('sessTargetMinutes').value=j.daily_target||DEFAULT_DAILY_TARGET}
  }catch(e){}
}

async function saveDailyTarget(){
  var mins=parseInt(document.getElementById('sessTargetMinutes').value)||0;
  if(mins<=0){toast('Target must be > 0');return}
  try{
    var r=await fetch(BASE+'/session/daily-target',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({minutes:mins})});
    var j=await r.json();
    if(j.ok){toast('Daily target: '+mins+'m');loadSessionStatus()}else toast('Failed');
  }catch(e){toast('Error')}
}

function openSessionsPage(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('sessionsPage');el.scrollTop=0;el.classList.add('show');
  var today=localDate();
  document.getElementById('sessDate').value=today;
  loadSessionsPage()
}
function closeSessionsPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('sessionsPage').classList.remove('show')}

document.getElementById('sessDate').addEventListener('change',loadSessionsPage);

// ─── Mood/Energy Timeline ─────────────────────────────────────────────────────

function openMoodEnergyPage(){
  var hasVitals = (window._ALL_INSTALLED_PLUGINS || []).some(function(p){ return p.id === 'com.v07.vitals' && p.enabled !== false; });
  if(hasVitals && typeof openPluginPage === 'function'){
    openPluginPage('com.v07.vitals');
    return;
  }
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('moodEnergyPage');el.scrollTop=0;el.classList.add('show');
  loadMoodEnergyTimeline()
}
function closeMoodEnergyPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('moodEnergyPage').classList.remove('show')}

var MOOD_COLORS={'happy':'var(--secondary)','very_happy':'var(--secondary)','focused':'var(--secondary)','energetic':'var(--secondary)','neutral':'var(--text)','calm':'var(--primary)','tired':'var(--accent-red)','sad':'var(--accent-red)','anxious':'var(--accent)','angry':'var(--accent-red)','stressed':'var(--orange)','excited':'var(--yellow)','motivated':'var(--secondary)','confused':'var(--primary)','relaxed':'var(--primary)','frustrated':'var(--accent-red)','hopeful':'var(--yellow)'};
var ENERGY_COLORS={'very_high':'var(--secondary)','high':'var(--secondary)','peak':'var(--secondary)','moderate':'var(--primary)','medium':'var(--primary)','low':'var(--yellow)','exhausted':'var(--accent-red)','depleted':'var(--accent-red)','balanced':'var(--primary)'};
var MOOD_INTENSITY={'happy':'MODERATE','very_high':'HIGH','focused':'PEAK','energetic':'HIGH','neutral':'LOW','calm':'LOW','tired':'HIGH','sad':'MODERATE','anxious':'MODERATE','angry':'HIGH','stressed':'MODERATE','excited':'PEAK','motivated':'HIGH','confused':'LOW','relaxed':'LOW','frustrated':'MODERATE','hopeful':'MODERATE'};
var ENERGY_INTENSITY={'very_high':'PEAK','high':'HIGH','peak':'PEAK','moderate':'MODERATE','medium':'MODERATE','low':'HIGH','exhausted':'HIGH','depleted':'CRITICAL','balanced':'MODERATE'};

async function loadMoodEnergyTimeline(){
  var days=parseInt(document.getElementById('moodEnergyDays').value);if(isNaN(days))days=7;
  var cutoff=days===0?null:new Date();if(cutoff)cutoff.setDate(cutoff.getDate()-days);
  try{
    var cats=['mood','energy'];
    var allItems=[];
    for(var ci=0;ci<cats.length;ci++){
      var r=await wrapFetch(fetch(BASE+'/events/'+cats[ci]),'meTimeline_'+cats[ci],{});
      var j=await r.json();
      var events=j.events||[];
      events.forEach(function(e){
        if((e.mood||e.energy)&&(!cutoff||new Date(e.ts)>=cutoff)){
          var t=new Date(e.ts);
          var h=String(t.getHours()).padStart(2,'0')+':'+String(t.getMinutes()).padStart(2,'0');
          var dayKey=t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0');
          var isMood=!!e.mood;
          var rawKey=isMood?e.mood:e.energy;
          var color=isMood?(MOOD_COLORS[rawKey]||'var(--text)'):(ENERGY_COLORS[rawKey]||'var(--text)');
          var fullLabel=isMood?moodLabel(e.mood):energyLabel(e.energy);
          var parts=fullLabel.split(' ');
          var emoji=parts[0]||'';
          var label=parts.slice(1).join(' ');
          allItems.push({ts:e.ts,day:dayKey,time:h,label:label,color:color,emoji:emoji,note:e.note||''});
        }
      });
    }
    allItems.sort(function(a,b){return b.ts.localeCompare(a.ts)});
    var list=document.getElementById('moodEnergyList');
    if(allItems.length===0){list.innerHTML='<div style="color:var(--muted);font-size:13px;text-align:center;padding:20px;border-left:none">No mood or energy entries yet</div>';list.style.borderLeft='none';return}
    list.style.borderLeft='1px solid var(--border)';
    var grouped={};var order=[];
    allItems.forEach(function(item){
      if(!grouped[item.day]){grouped[item.day]=[];order.push(item.day)}
      grouped[item.day].push(item);
    });
    var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var html='';
    order.forEach(function(day,idx){
      var d=new Date(day+'T00:00:00');
      var months2=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
      var dayLabel=months2[d.getMonth()]+' '+d.getDate()+', '+d.getFullYear();
      var isToday=day===new Date().getFullYear()+'-'+String(new Date().getMonth()+1).padStart(2,'0')+'-'+String(new Date().getDate()).padStart(2,'0');
      var dayTag=isToday?' (TODAY)':'';
      html+='<div style="padding:14px 0 6px;display:flex;justify-content:space-between;align-items:center">';
      html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em">'+dayLabel+dayTag+'</span>';
      html+='</div>';
      grouped[day].forEach(function(item){
        html+='<div style="margin:4px 0;padding:12px;border:1px solid var(--border);border-radius:4px">';
        html+='<div style="display:flex;align-items:center;gap:12px">';
        html+='<span style="font-size:18px;flex-shrink:0">'+item.emoji+'</span>';
        html+='<div style="flex:1;min-width:0">';
        html+='<div style="display:flex;align-items:center;gap:8px">';
        html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:12px;font-weight:700;color:'+item.color+';text-transform:uppercase;letter-spacing:0.1em">'+item.label+'</span>';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive)">'+item.time+'</span>';
        html+='</div>';
        if(item.note)html+='<p style="margin:4px 0 0;font-size:12px;color:var(--text);opacity:0.7;font-style:italic">'+esc(item.note)+'</p>';
        html+='</div></div></div>';
      });
    });
    list.innerHTML=html;
  }catch(e){document.getElementById('moodEnergyList').innerHTML='<div style="color:var(--red);font-size:13px;text-align:center;padding:20px">Failed to load</div>'}
}

// ─── Sleep/Up Timeline ────────────────────────────────────────────────────────

function openSleepUpPage(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('sleepUpPage');el.scrollTop=0;el.classList.add('show');
  loadSleepUpTimeline()
}
function closeSleepUpPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('sleepUpPage').classList.remove('show')}

async function loadSleepUpTimeline(){
  try{
    var r=await wrapFetch(fetch(BASE+'/events/metrics'),'sleepUpTimeline',{});
    var j=await r.json();
    var events=(j.events||[]).filter(function(e){return e.type==='checkin'||e.type==='checkout'});
    var list=document.getElementById('sleepUpList');
    if(events.length===0){list.innerHTML='<div style="color:var(--muted);font-size:13px;text-align:center;padding:20px">No sleep/check-in entries yet</div>';return}
    var sorted=events.sort(function(a,b){return(a.ts||'').localeCompare(b.ts||'')});
    var pairs=[];var openCi=null;
    sorted.forEach(function(e){
      if(e.type==='checkin'){openCi=e}
      else if(e.type==='checkout'&&openCi){
        pairs.push({checkin:openCi,checkout:e});
        openCi=null
      }
    });
    if(openCi)pairs.push({checkin:openCi,checkout:null});
    var byDate={};var dateOrder=[];
    pairs.forEach(function(p){
      var ciDate=p.checkin.ts?.slice(0,10)||p.checkin.date||'';
      if(!ciDate)return;
      if(!byDate[ciDate]){byDate[ciDate]=[];dateOrder.push(ciDate)}
      byDate[ciDate].push(p);
    });
    dateOrder.sort().reverse();
    var months=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    var html='';
    dateOrder.forEach(function(day){
      var d=new Date(day+'T00:00:00');
      var dayLabel=months[d.getMonth()]+' '+d.getDate()+', '+d.getFullYear();
      var dayPairs=byDate[day];
      var totalSleep=0;
      dayPairs.forEach(function(p){
        if(p.checkout&&p.checkin.ts&&p.checkout.ts){
          var ciMs=new Date(p.checkin.ts).getTime();var coMs=new Date(p.checkout.ts).getTime();
          totalSleep+=Math.floor((coMs-ciMs)/60000);
        }
      });
      var sleepH=Math.floor(totalSleep/60);var sleepM=totalSleep%60;
      var sleepStr=totalSleep>0?(sleepH>0?sleepH+'h ':'')+sleepM+'m':'';
      html+='<div style="position:relative;padding:16px 0 8px 20px;border-left:1px solid var(--border);margin-left:12px">';
      html+='<div style="position:absolute;left:-5px;top:20px;width:9px;height:9px;background:var(--border);transform:rotate(45deg)"></div>';
      html+='<div style="display:flex;justify-content:space-between;align-items:center">';
      html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em">'+dayLabel+'</span>';
      if(sleepStr)html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:11px;color:var(--primary)">'+sleepStr+'</span>';
      html+='</div></div>';
      dayPairs.forEach(function(p){
        var fmtTime=function(t,ts){if(!t)return ts?.slice(11,16)||'';if(/^\d{1,2}:\d{2}$/.test(t))return t;return ts?.slice(11,16)||'';};
        var ciTime=fmtTime(p.checkin.time,p.checkin.ts);
        var coTime=p.checkout?fmtTime(p.checkout.time,p.checkout.ts):'';
        var durStr='';
        var durColor='var(--text-inactive)';
        if(p.checkout&&p.checkin.ts&&p.checkout.ts){
          var ciMs=new Date(p.checkin.ts).getTime();var coMs=new Date(p.checkout.ts).getTime();
          var diffMin=Math.floor((coMs-ciMs)/60000);
          var h=Math.floor(diffMin/60);var m=diffMin%60;
          durStr=(h>0?h+'h ':'')+m+'m';
          durColor=diffMin>=420?'var(--secondary)':diffMin>=360?'var(--primary)':'var(--yellow)';
        }
        html+='<div style="margin-left:12px;padding:12px 0 12px 20px;border-bottom:1px solid var(--border)">';
        html+='<div style="display:flex;align-items:center;gap:12px">';
        html+='<div style="flex-shrink:0;width:48px;text-align:center">';
        html+='<div style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:16px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+ciTime+'</div>';
        html+='<div style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--green);text-transform:uppercase;letter-spacing:0.1em">CHECK-IN</div>';
        html+='</div>';
        html+='<div style="flex-shrink:0;width:24px;height:1px;background:var(--border);position:relative">';
        html+='<div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:4px;height:4px;border-radius:50%;background:var(--border)"></div>';
        html+='</div>';
        html+='<div style="flex-shrink:0;width:48px;text-align:center">';
        html+='<div style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:16px;color:'+(coTime?'var(--text)':'var(--green)')+';white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+(coTime||'Active')+'</div>';
        html+='<div style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--accent-red);text-transform:uppercase;letter-spacing:0.1em">CHECK-OUT</div>';
        html+='</div>';
        if(durStr){
          html+='<div style="flex:1;text-align:right">';
          html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:14px;color:'+durColor+'">'+durStr+'</span>';
          html+='</div>';
        }
        html+='</div></div>';
      });
    });
    list.innerHTML=html;
  }catch(e){document.getElementById('sleepUpList').innerHTML='<div style="color:var(--red);font-size:13px;text-align:center;padding:20px">Failed to load</div>'}
}

// ─── Settings Page ────────────────────────────────────────────────────────────────

var _activeSettingsTab = 'general';
function switchSettingsTab(tab){
  _activeSettingsTab = tab || 'general';
  var genTab=document.getElementById('settingsTabGeneral');
  var aiTab=document.getElementById('settingsTabAI');
  var notifTab=document.getElementById('settingsTabNotif');
  var genPanel=document.getElementById('settingsPanelGeneral');
  var aiPanel=document.getElementById('settingsPanelAI');
  var notifPanel=document.getElementById('settingsPanelNotifications');
  if(genTab) genTab.classList.toggle('active', _activeSettingsTab === 'general');
  if(aiTab) aiTab.classList.toggle('active', _activeSettingsTab === 'ai');
  if(notifTab) notifTab.classList.toggle('active', _activeSettingsTab === 'notifications');
  if(genPanel) genPanel.style.display = (_activeSettingsTab === 'general' ? 'block' : 'none');
  if(aiPanel) aiPanel.style.display = (_activeSettingsTab === 'ai' ? 'block' : 'none');
  if(notifPanel) notifPanel.style.display = (_activeSettingsTab === 'notifications' ? 'block' : 'none');
  if(_activeSettingsTab === 'ai'){
    loadAISettings();
    loadPluginAIPrefs();
  } else if(_activeSettingsTab === 'notifications'){
    if(typeof loadPluginNotifPrefs === 'function') loadPluginNotifPrefs();
    loadNotifPrefs();
  }
}

function closeSettingsPage(){
  document.getElementById('mainFab').style.display='none';
  document.getElementById('settingsPage').classList.remove('show');
  setNavTabActive('home');
}
async function openSettingsPage(){
  setNavTabActive('profile');
  document.getElementById('mainFab').style.display='none';
  var el=document.getElementById('settingsPage');el.scrollTop=0;el.classList.add('show');
  switchSettingsTab(_activeSettingsTab || 'general');
  await loadNotifPrefs();
  loadThemePref();
  loadVaultPath();
  loadOverlayStatus();
  loadAccessibilityStatus();
  loadAppLimitsSettings();
  loadHomeScreenWidgetPref();
  if(typeof populateReaderSettings==='function')populateReaderSettings();
}
// ─── Theme ────────────────────────────────────────────────────────────────
var _systemDark=window.matchMedia('(prefers-color-scheme: dark)');
function applyTheme(mode){
  var isLight=false;
  if(mode==='light'){
    document.documentElement.dataset.theme='light';
    isLight=true;
  } else if(mode==='dark'){
    document.documentElement.dataset.theme='dark';
    isLight=false;
  } else {
    isLight=!_systemDark.matches;
    document.documentElement.dataset.theme=isLight?'light':'dark';
  }
  try{localStorage.setItem('v07_theme',isLight?'light':'dark');}catch(e){}
  if(window.Android && typeof window.Android.setSystemTheme==='function'){
    try{ window.Android.setSystemTheme(isLight); }catch(e){}
  }
  try{
    document.querySelectorAll('iframe').forEach(function(f){
      try{
        if(f.contentDocument&&f.contentDocument.documentElement){
          if(isLight) f.contentDocument.documentElement.setAttribute('data-theme','light');
          else f.contentDocument.documentElement.removeAttribute('data-theme');
        }
      }catch(e){}
    });
  }catch(e){}
  if(typeof setNavTabActive==='function' && typeof currentTab!=='undefined'){
    setNavTabActive(currentTab);
  }
}
function loadThemePref(){
  var saved=localStorage.getItem('theme')||'system';
  document.getElementById('themeSelect').value=saved;
  applyTheme(saved);
  updateThemeBtn();
}
function setTheme(mode){
  localStorage.setItem('theme',mode);
  applyTheme(mode);
  updateThemeBtn();
  try{fetch(BASE+'/meta/theme',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({theme:mode})})}catch(e){}
}
function toggleTheme(){
  var cur=localStorage.getItem('theme')||'system';
  var next=cur==='dark'?'light':cur==='light'?'system':'dark';
  setTheme(next);
}
function getThemeIcon(){
  var saved=localStorage.getItem('theme')||'system';
  if(saved==='dark')return '🌙';
  if(saved==='light')return '☀️';
  return '🔄';
}
function updateThemeBtn(){
  var btn=document.getElementById('themeToggleBtn');
  if(btn)btn.textContent=getThemeIcon();
}
_systemDark.addEventListener('change',function(){
  var saved=localStorage.getItem('theme')||'system';
  if(saved==='system')applyTheme('system');
  updateThemeBtn();
});
// Apply saved theme immediately on load
(function(){var m=localStorage.getItem('theme')||'system';applyTheme(m);updateThemeBtn()})();

// ─── Daily Checklist ──────────────────────────────────────────────────────────

var _clFreq='S';
function toggleClFreq(f){
  _clFreq=f;
  var s=document.getElementById('clFreqS'),d=document.getElementById('clFreqD'),w=document.getElementById('clFreqW');
  s.style.border=d.style.border=w.style.border='2px solid var(--border)';
  s.style.color=d.style.color=w.style.color='var(--text-inactive)';
  s.style.background=d.style.background=w.style.background='transparent';
  var el={S:s,D:d,W:w}[f];
  el.style.border='2px solid var(--primary)';el.style.color='var(--primary)';el.style.background='rgba(167,200,255,0.1)';
}
function openChecklist(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  document.getElementById('checklistPage').classList.add('show');
  document.getElementById('checklistPage').scrollTop=0;
  loadChecklistItems();
}
function closeChecklist(){
  document.getElementById('mainFab').style.display='flex';
  document.getElementById('checklistPage').classList.remove('show');
}

async function loadChecklistItems(){
  try{
    var r1=await fetch(BASE+'/checklist/today');
    var j1=await r1.json();
    var dailyItems=(j1.items||[]).map(function(i){i._freq='D';return i});
    var r2=await fetch(BASE+'/checklist/week');
    var j2=await r2.json();
    var weeklyItems=(j2.items||[]).map(function(i){i._freq='W';return i});
    var allItems=dailyItems.concat(weeklyItems);
    var seenIds={};
    allItems=allItems.filter(function(i){if(seenIds[i.id])return false;seenIds[i.id]=true;return true});
    var container=document.getElementById('checklistItems');
    if(allItems.length===0){
      container.innerHTML='<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 20px;opacity:0.3"><span class="material-symbols-outlined" style="font-size:40px;margin-bottom:12px">check_circle</span><span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.3em">ALL DIRECTIVES FULFILLED</span></div>';
      return;
    }
    var active=[], done=[], overdue=[];
    allItems.forEach(function(item){
      if(item.done)done.push(item);
      else if(item.overdue)overdue.push(item);
      else active.push(item);
    });
    var sorted=overdue.concat(active).concat(done);
    var html='';
    sorted.forEach(function(item){
      var isDone=!!item.done;
      var isOverdue=!isDone&&!!item.overdue;
      var cls='cl-item'+(isDone?' done':'')+(isOverdue?' overdue':'');
      var freq=item._freq||item.frequency||(item.recurring?'W':'D');
      var circleBg,circleIcon;
      if(isDone){circleBg='var(--secondary)';circleIcon='<span class="material-symbols-outlined" style="font-size:10px;color:#090909">check</span>'}
      else if(isOverdue){circleBg='var(--accent-orange)';circleIcon='<span class="material-symbols-outlined" style="font-size:10px;color:#090909">warning</span>'}
      else{circleBg='transparent';circleIcon=''}
      var labelColor=isDone?'var(--secondary)':(isOverdue?'var(--accent-orange)':'var(--text)');
      var labelStyle=isDone?'opacity:0.5;text-decoration:line-through':'';
      var freqLabel;
      if(isDone)freqLabel='<span style="color:var(--secondary);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;font-weight:700">COMPLETED</span>';
      else if(freq==='W')freqLabel='<span style="color:var(--accent-purple);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;font-weight:700">[W]</span>';
      else freqLabel='<span style="color:var(--text-inactive);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;font-weight:700">[D]</span>';
      html+='<div class="'+cls+'">';
      html+='<button onclick="event.stopPropagation();toggleChecklistItem(\''+item.id+'\')" style="width:16px;height:16px;border:1px solid '+(isDone?'var(--secondary)':(isOverdue?'var(--accent-orange)':'var(--border)'))+';display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;background:'+(isDone?'rgba(77,224,134,0.1)':circleBg)+';border-radius:50%;padding:0">'+circleIcon+'</button>';
      html+='<div style="flex:1;display:flex;align-items:center;justify-content:space-between;min-width:0;gap:8px">';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:14px;font-weight:500;color:'+labelColor+';text-transform:uppercase;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;'+labelStyle+'">'+esc(item.label)+'</span>';
      html+='<div style="display:flex;align-items:center;gap:6px;flex-shrink:0">';
      html+=freqLabel;
      html+='<span onclick="event.stopPropagation();deleteChecklistItem(\''+item.id+'\')" style="cursor:pointer;color:var(--text-inactive);display:flex;align-items:center;transition:color 0.15s" onmouseenter="this.style.color=\'var(--red)\'" onmouseleave="this.style.color=\'var(--text-inactive)\'"><span class="material-symbols-outlined" style="font-size:16px">delete</span></span>';
      html+='</div></div></div>';
    });
    container.innerHTML=html;
  }catch(e){}
}

async function addChecklistItem(){
  var input=document.getElementById('checklistInput');
  var label=input.value.trim();
  if(!label)return;
  var recurring=(_clFreq==='D'||_clFreq==='W');
  var frequency=_clFreq;
  try{
    await fetch(BASE+'/checklist/today',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({label:label,recurring:recurring,frequency:frequency})});
    input.value='';
    loadChecklistItems();
  }catch(e){}
}

async function toggleChecklistItem(id){
  try{
    await fetch(BASE+'/checklist/'+id+'/toggle',{method:'POST'});
    loadChecklistItems();
  }catch(e){}
}

async function editChecklistItem(id,currentLabel,currentRecurring){
  var newLabel=await customPrompt('Edit task label:',currentLabel);
  if(newLabel===null||!newLabel.trim())return;
  try{
    await fetch(BASE+'/checklist/'+id+'/edit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({label:newLabel.trim(),recurring:currentRecurring})});
    loadChecklistItems();
  }catch(e){}
}

async function deleteChecklistItem(id){
  if(!confirm('Delete this task?'))return;
  try{
    await fetch(BASE+'/checklist/'+id,{method:'DELETE'});
    loadChecklistItems();
  }catch(e){}
}

// ─── Vault Init ────────────────────────────────────────────────────────────────
async function initVault(){
  var ok=confirm('This will create empty data files in your vault. Continue?');
  if(!ok)return;
  try{
    var r=await fetch(BASE+'/vault/init',{method:'POST'});
    if(r.ok){toast('Vault initialized');setTimeout(loadDashboard,500)}
    else toast('Failed to initialize vault');
  }catch(e){toast('Error: '+e.message)}
}
async function loadVaultPath(){
  try{
    var r=await fetch(BASE+'/vault/path');
    var j=await r.json();
    var p=j.path||'not set';
    document.getElementById('vaultPathDisplay').textContent=p;
    var fp=document.getElementById('footerVaultPath');if(fp)fp.textContent='Current Vault: '+p;
  }catch(e){document.getElementById('vaultPathDisplay').textContent='error'}
}
async function loadNetworkInfo(){
  try{
    var r=await fetch(BASE+'/network/info');
    var j=await r.json();
    var url=j.url||'';
    var el=document.getElementById('networkUrl');
    if(el)el.textContent=url;
    if(url)renderQR(url);
  }catch(e){}
}
function copyNetworkUrl(){
  var url=document.getElementById('networkUrl').textContent;
  if(navigator.clipboard)navigator.clipboard.writeText(url).then(function(){toast('URL copied!')});
  else{var t=document.createElement('textarea');t.value=url;document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);toast('URL copied!')}
}
function renderQR(text){
  var img=document.getElementById('networkQR');
  if(!img)return;
  try{
    img.src=BASE+'/qr?text='+encodeURIComponent(text);
    img.style.display='block';
  }catch(e){img.style.display='none'}
}
function openNativeVaultPicker(){
  if(window.Android&&Android.openVaultPicker)Android.openVaultPicker();
  else toast('Not available — use FAB to change vault');
}
async function loadNotifPrefs(){
  try{
    var r=await fetch(BASE+'/notify-prefs');
    var j=await r.json();
    document.getElementById('notifOverdue').checked=j.overdue_alert!==false;
    document.getElementById('notifDueToday').checked=j.due_today_alert!==false;
    document.getElementById('notifHabits').checked=j.habits_reminder!==false;
    document.getElementById('notifMood').checked=j.mood_reminder!==false;
    if(document.getElementById('notifTimePriority'))document.getElementById('notifTimePriority').checked=j.time_priority!==false;
    if(document.getElementById('notifGitaDaily'))document.getElementById('notifGitaDaily').checked=j.gita_daily===true;
    if(document.getElementById('notifGitaDailyTime'))document.getElementById('notifGitaDailyTime').value=j.gita_daily_time||'07:00';
    if(document.getElementById('notifChecklist'))document.getElementById('notifChecklist').checked=j.checklist_reminder===true;
  }catch(e){}
  loadPluginNotifPrefs();
}
async function saveNotifPref(key,val){
  try{
    var body={};
    body[key]=val;
    await fetch(BASE+'/notify-prefs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  }catch(e){}
}
async function loadPluginNotifPrefs(){
  var container=document.getElementById('pluginNotifList');
  if(!container)return;
  try{
    var r=await fetch(BASE+'/plugins/registry');
    var j=await r.json();
    var plugins=(j&&j.plugins)||[];
    var notifPlugins=plugins.filter(function(p){
      return p.permissions&&p.permissions.indexOf('notification')!==-1;
    });
    if(!notifPlugins.length){
      container.innerHTML='<div style="font-size:11px;color:var(--text-inactive);font-family:\'Space Mono\',monospace;padding:6px 0">No plugins with notification permission installed.</div>';
      return;
    }
    var html='';
    notifPlugins.forEach(function(p){
      var feat=(p.features||[]).find(function(f){return f.id==='notifications'});
      var on=(feat?feat.enabled!==false:true)&&(p.enabled!==false);
      html+='<label class="toggle-row">'+
        '<div style="display:flex;flex-direction:column">'+
          '<span style="font-size:13px">'+p.name+'</span>'+
          '<span style="font-size:10px;color:var(--text-inactive);font-family:\'Space Mono\',monospace">'+p.id+'</span>'+
        '</div>'+
        '<label class="kb-toggle"><input type="checkbox" '+(on?'checked':'')+' onchange="savePluginNotifPref(\''+p.id+'\',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>'+
      '</label>';
    });
    container.innerHTML=html;
  }catch(e){
    container.innerHTML='<div style="font-size:11px;color:var(--red)">Failed to load plugin notification settings.</div>';
  }
}
async function savePluginNotifPref(id,enabled){
  try{
    await fetch(BASE+'/plugins/'+id+'/feature',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({feature:'notifications',enabled:enabled})});
    toast('Notifications '+(enabled?'ON':'OFF')+' for '+id);
  }catch(e){toast('Failed to update notification setting');}
  loadPluginNotifPrefs();
}

// ─── AI / Gemini Core Settings ──────────────────────────────────────────────
var _geminiKeyVisible = false;

function toggleGeminiKeyVisibility(){
  var inp = document.getElementById('geminiApiKeyInput');
  var btn = document.getElementById('geminiKeyToggleBtn');
  if(!inp || !btn) return;
  _geminiKeyVisible = !_geminiKeyVisible;
  inp.type = _geminiKeyVisible ? 'text' : 'password';
  btn.textContent = _geminiKeyVisible ? 'HIDE' : 'SHOW';
}

async function loadAISettings(){
  try {
    var r = await fetch(BASE + '/ai/config');
    var j = await r.json();
    var badge = document.getElementById('aiKeyStatusBadge');
    var modelSelect = document.getElementById('geminiModelSelect');
    var customGroup = document.getElementById('customModelGroup');
    var customInput = document.getElementById('geminiCustomModelInput');
    var provSelect = document.getElementById('aiProviderSelect');
    var provBadge = document.getElementById('aiProviderBadge');
    var baseInput = document.getElementById('geminiBaseUrlInput');

    if (badge) {
      if (j.configured) {
        badge.textContent = 'CONFIGURED (' + (j.maskedKey || 'ACTIVE') + ')';
        badge.style.color = 'var(--primary)';
        badge.style.background = 'rgba(167,200,255,0.12)';
        badge.style.border = '1px solid rgba(167,200,255,0.3)';
      } else {
        badge.textContent = 'NOT CONFIGURED';
        badge.style.color = 'var(--text-inactive)';
        badge.style.background = 'rgba(255,255,255,0.06)';
        badge.style.border = 'none';
      }
    }

    if (modelSelect && j.defaultModel) {
      var targetModel = j.defaultModel;
      var found = Array.from(modelSelect.options).some(function(opt){ return opt.value === targetModel; });
      if (found) {
        modelSelect.value = targetModel;
        if (customGroup) customGroup.style.display = 'none';
      } else {
        modelSelect.value = '__custom__';
        if (customGroup) customGroup.style.display = 'block';
        if (customInput) customInput.value = targetModel;
      }
    }

    if (provSelect && j.provider) {
      provSelect.value = j.provider;
    }
    if (provBadge) {
      provBadge.textContent = (j.effectiveProvider || 'AUTO').toUpperCase();
    }

    if (baseInput) {
      baseInput.value = (j.baseUrl && j.baseUrl !== 'https://generativelanguage.googleapis.com/v1beta/models') ? j.baseUrl : '';
    }
  } catch(e) {
    console.error('Failed to load AI config:', e);
  }
}

function onModelSelectChange(val){
  var customGroup = document.getElementById('customModelGroup');
  var customInput = document.getElementById('geminiCustomModelInput');
  if (val === '__custom__') {
    if (customGroup) customGroup.style.display = 'block';
    if (customInput) customInput.focus();
  } else {
    if (customGroup) customGroup.style.display = 'none';
    saveGeminiModel(val);
  }
}

function saveCustomModel(val){
  val = (val || '').trim();
  if (val) {
    saveGeminiModel(val);
  }
}

async function saveAIProvider(provider){
  try {
    var r = await fetch(BASE + '/ai/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ provider: provider })
    });
    var j = await r.json();
    toast('Protocol set to ' + (provider === 'auto' ? 'Auto-detect' : provider.toUpperCase()));
    var provBadge = document.getElementById('aiProviderBadge');
    if (provBadge && j.effectiveProvider) {
      provBadge.textContent = j.effectiveProvider.toUpperCase();
    }
  } catch(e){}
}

async function saveGeminiApiKey(){
  var inp = document.getElementById('geminiApiKeyInput');
  if(!inp) return;
  var key = (inp.value || '').trim();
  if(!key){
    toast('Please paste a valid API key');
    return;
  }
  try {
    var r = await fetch(BASE + '/ai/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ apiKey: key })
    });
    var j = await r.json();
    if(j.ok){
      inp.value = '';
      _geminiKeyVisible = false;
      inp.type = 'password';
      var btn = document.getElementById('geminiKeyToggleBtn');
      if(btn) btn.textContent = 'SHOW';
      toast('API key saved securely');
      loadAISettings();
    } else {
      toast('Failed to save API key: ' + (j.error || 'unknown error'));
    }
  } catch(e){
    toast('Error saving API key: ' + e.message);
  }
}

async function clearGeminiApiKey(){
  if(!confirm('Clear stored API key?')) return;
  try {
    var r = await fetch(BASE + '/ai/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ apiKey: '' })
    });
    var j = await r.json();
    if(j.ok){
      var inp = document.getElementById('geminiApiKeyInput');
      if(inp) inp.value = '';
      toast('API key cleared');
      loadAISettings();
    }
  } catch(e){
    toast('Failed to clear key');
  }
}

async function saveGeminiModel(model){
  if(!model) return;
  try {
    var r = await fetch(BASE + '/ai/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ defaultModel: model })
    });
    var j = await r.json();
    toast('Model set to ' + model);
    var provBadge = document.getElementById('aiProviderBadge');
    if (provBadge && j.effectiveProvider) {
      provBadge.textContent = j.effectiveProvider.toUpperCase();
    }
  } catch(e){}
}

async function saveGeminiBaseUrl(url){
  try {
    await fetch(BASE + '/ai/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ baseUrl: url.trim() })
    });
    toast('Custom endpoint updated');
  } catch(e){}
}

function onApiKeyInput(val){
  val = (val || '').trim();
  var provBadge = document.getElementById('aiProviderBadge');
  var modelSelect = document.getElementById('geminiModelSelect');
  if (!val) return;
  if (val.startsWith('AIza')) {
    if (provBadge) provBadge.textContent = 'AI STUDIO';
    if (modelSelect && (modelSelect.value === 'claude-3-5-sonnet-20241022')) {
      modelSelect.value = 'gemini-2.0-flash';
    }
  } else if (val.startsWith('sk-ant-')) {
    if (provBadge) provBadge.textContent = 'ANTHROPIC';
    if (modelSelect && !modelSelect.value.startsWith('claude-')) {
      modelSelect.value = 'claude-3-5-sonnet-20241022';
    }
  } else if (val.startsWith('sk-or-')) {
    if (provBadge) provBadge.textContent = 'OPENROUTER';
  } else if (val.startsWith('sk-')) {
    if (provBadge) provBadge.textContent = 'OPENAI';
  }
}

async function testGeminiConnection(){
  var resultEl = document.getElementById('aiTestResult');
  var btn = document.getElementById('btnTestAI');
  var keyInp = document.getElementById('geminiApiKeyInput');
  var modelSelect = document.getElementById('geminiModelSelect');
  if(!resultEl || !btn) return;

  var currentKey = keyInp ? (keyInp.value || '').trim() : '';
  var currentModel = modelSelect ? modelSelect.value : '';
  if (currentModel === '__custom__') {
    var customInput = document.getElementById('geminiCustomModelInput');
    currentModel = customInput ? (customInput.value || '').trim() : '';
  }

  resultEl.style.display = 'block';
  resultEl.innerHTML = '<span style="color:var(--text-inactive)">Testing connection to AI API...</span>';
  btn.disabled = true;

  try {
    var payload = {};
    if (currentKey) payload.apiKey = currentKey;
    if (currentModel) payload.model = currentModel;

    var r = await fetch(BASE + '/ai/test', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    var j = await r.json();
    if(j.ok){
      resultEl.innerHTML = '<span style="color:#67ac89;font-weight:700">🟢 Connected</span> · ' + (j.model || 'AI') + ' responding (' + (j.latencyMs || 0) + 'ms latency)';
      toast('API connected successfully!');
      if (keyInp && currentKey) {
        keyInp.value = '';
      }
      loadAISettings();
    } else {
      resultEl.innerHTML = '<span style="color:var(--red);font-weight:700">🔴 Connection failed:</span> ' + (j.error || 'Unknown error');
      toast('Connection test failed');
    }
  } catch(e){
    resultEl.innerHTML = '<span style="color:var(--red);font-weight:700">🔴 Error:</span> ' + e.message;
  } finally {
    btn.disabled = false;
  }
}

async function loadPluginAIPrefs(){
  var container = document.getElementById('pluginAIList');
  if(!container) return;
  try {
    var r = await fetch(BASE + '/plugins/registry');
    var j = await r.json();
    var plugins = (j && j.plugins) || [];
    var aiPlugins = plugins.filter(function(p){
      return p.permissions && p.permissions.indexOf('ai') !== -1;
    });

    if(!aiPlugins.length){
      container.innerHTML = '<div style="font-size:11px;color:var(--text-inactive);font-family:\'Space Mono\',monospace;padding:6px 0">No plugins currently requesting AI permission. Future plugins declaring "ai" in manifest will appear here with toggle controls.</div>';
      return;
    }

    var html = '';
    aiPlugins.forEach(function(p){
      var feat = (p.features || []).find(function(f){ return f.id === 'ai'; });
      var on = (feat ? feat.enabled !== false : true) && (p.enabled !== false);
      html += '<label class="toggle-row">' +
        '<div style="display:flex;flex-direction:column">' +
          '<span style="font-size:13px">' + p.name + '</span>' +
          '<span style="font-size:10px;color:var(--text-inactive);font-family:\'Space Mono\',monospace">' + p.id + '</span>' +
        '</div>' +
        '<label class="kb-toggle"><input type="checkbox" ' + (on ? 'checked' : '') + ' onchange="savePluginAIPref(\'' + p.id + '\',this.checked)"><div class="kb-toggle-track" data-on="ON" data-off="OFF"></div></label>' +
      '</label>';
    });
    container.innerHTML = html;
  } catch(e){
    container.innerHTML = '<div style="font-size:11px;color:var(--red)">Failed to load plugin AI settings.</div>';
  }
}

async function savePluginAIPref(id, enabled){
  try {
    await fetch(BASE + '/plugins/' + id + '/feature', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ feature: 'ai', enabled: enabled })
    });
    toast('AI access ' + (enabled ? 'GRANTED' : 'REVOKED') + ' for ' + id);
  } catch(e){
    toast('Failed to update plugin AI permission');
  }
  loadPluginAIPrefs();
}

var _moodPromptAcked=false;
function checkMoodPrompt(){
  if(_moodPromptAcked)return;
  fetch(BASE+'/mood/prompt').then(function(r){return r.json()}).then(function(j){
    var el=document.getElementById('moodPromptBar');
    if(j.prompt===true){
      el.style.display='flex';
      el.onclick=function(){_moodPromptAcked=true;el.style.display='none';openModal('mood')};
    }else if(el)el.style.display='none';
  }).catch(function(){})
}
function testNotification(){
  fetch(BASE+'/notify/test',{method:'POST'}).then(function(r){return r.json()}).then(function(){toast('Test notification sent!')}).catch(function(){toast('Failed to send test')})
}
function clearAllNotifications(){
  // This would need a server endpoint
  toast('Cleared');
}

// ─── Overlay Bubble ─────────────────────────────────────────────────────────
async function loadOverlayStatus(){
  try{
    var r=await fetch(BASE+'/overlay/status');
    var j=await r.json();
    document.getElementById('overlayToggle').checked=j.enabled===true;
    var statusEl=document.getElementById('overlayStatus');
    if(!j.can_draw_overlays){
      statusEl.innerHTML='⚠️ Overlay permission not granted. <span style="color:var(--accent);cursor:pointer" onclick="requestOverlayPermission()">Grant in Settings</span>';
    } else {
      statusEl.innerHTML=j.enabled?'🟢 Overlay is active':'Tap toggle to enable';
    }
  }catch(e){}
}
async function loadAccessibilityStatus(){
  try{
    var r=await fetch(BASE+'/meta/accessibility');
    var j=await r.json();
    document.getElementById('accessibilityStatus').innerHTML=j.connected
      ?'🟢 Service active'
      :'🔴 Not enabled — <a href="#" style="color:var(--accent)" onclick="openAccessibilitySettings();return false">Open Settings</a>';
  }catch(e){}
}
function openAccessibilitySettings(){
  fetch(BASE+'/meta/open-accessibility-settings',{method:'POST'});
}
async function toggleOverlay(enabled){
  try{
    var r=await fetch(BASE+'/overlay/toggle',{method:'POST'});
    var j=await r.json();
    document.getElementById('overlayToggle').checked=j.enabled===true;
    if(!j.can_draw_overlays){
      document.getElementById('overlayStatus').innerHTML='⚠️ Overlay permission not granted. <span style="color:var(--accent);cursor:pointer" onclick="requestOverlayPermission()">Grant in Settings</span>';
    } else {
      document.getElementById('overlayStatus').innerHTML=j.enabled?'🟢 Overlay is active':'Tap toggle to enable';
    }
    if(j.enabled)toast('Overlay enabled');
    else toast('Overlay disabled');
  }catch(e){toast('Failed to toggle overlay')}
}
function requestOverlayPermission(){
  toast('Grant "Display over other apps" permission for V07');
}

// ─── Recycle Bin Page ────────────────────────────────────────────────────────────

var _recycleFilter='';
var _recycleEntries=[];

async function openRecycleBinPage(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('recycleBinPage');el.scrollTop=0;el.classList.add('show');
  loadRecycleBin('');
}
function closeRecycleBinPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('recycleBinPage').classList.remove('show')}

async function loadRecycleBin(category){
  _recycleFilter=category;
  var btns=document.querySelectorAll('#recycleBinPage .page-header + div button');
  btns.forEach(function(b){b.className='btn'});
  var activeBtn=Array.from(btns).find(function(b){return(b.dataset.cat||'')===category});
  if(!activeBtn)activeBtn=btns[0];
  activeBtn.className='btn btn-accent';
  var container=document.getElementById('recycleBinContent');
  if(typeof renderSkeleton==='function') container.innerHTML=renderSkeleton('cards',3);
  else container.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px">Loading...</div>';
  try{
    var qs=category?'?category='+encodeURIComponent(category):'';
    var r=await fetch(BASE+'/recycle-bin'+qs);
    var j=await r.json();
    var entries=j.entries||[];
    _recycleEntries=entries;
    if(entries.length===0){
      container.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px">Recycle bin is empty</div>';
      return;
    }
    container.innerHTML=entries.map(function(e){
      var icon=CATEGORY_ICONS[e.category]||'\u{1F5D1}';
      var catLabel=e.category.charAt(0).toUpperCase()+e.category.slice(1);
      var preview='';
      var detail='';
      var snap=e.data.snapshot||e.data;
      if(e.category==='tasks'){
        preview='<b>'+(snap.title||'Task')+'</b>';
        detail=(snap.deadline?'Due '+snap.deadline:'')+(snap.priority?' \u00b7 ['+snap.priority+']':'')+(snap.time?' \u00b7 '+snap.time:'');
      }else if(e.category==='sessions'){
        preview=activityLabel(snap.activity||'')+(snap.custom_label?' \u00b7 '+snap.custom_label:'');
        detail=(snap.type||'start')+(snap.duration?' \u00b7 '+snap.duration+'m':'')+(snap.start_ts?' \u00b7 from '+snap.start_ts.slice(11,16):'');
      }else if(e.category==='mood'){
        preview=moodLabel(snap.mood||'');
        detail=snap.energy?'Energy: '+energyLabel(snap.energy):''+(snap.note?' \u00b7 '+snap.note:'');
      }else if(e.category==='energy'){
        preview=energyLabel(snap.energy||'');
        detail=snap.note?'Note: '+snap.note:'';
      }else if(e.category==='journal'){
        preview=(snap.subtype||'journal').toUpperCase();
        detail=(snap.text||'').slice(0,100);
      }else if(e.category==='metrics'){
        if(snap.type==='checkin')preview='\u2705 Check-in';else if(snap.type==='checkout')preview='\u{1F534} Checkout';
        else if(snap.type==='panic')preview='\u{1F630} Panic';
        else if(snap.doom_scroll)preview='Doom: '+snap.doom_scroll+'m';
        else if(snap.pushups)preview='Pushups: '+snap.pushups;
        else preview=snap.type||'Metric';
        detail=snap.note||snap.time||'';
      }else if(e.category==='dsa'){
        preview=(snap.problem||'DSA Problem');
        detail=(snap.topic?'('+snap.topic+')':'')+(snap.platform?' \u00b7 '+snap.platform:'')+(snap.difficulty?' \u00b7 '+snap.difficulty:'');
      }else if(e.category==='running'){
        preview=(snap.distance_km||0)+'km Run';
        detail=(snap.duration_formatted||formatRunDuration(snap.duration_sec||snap.duration_min, snap.distance_km))+(snap.run_type?' \u00b7 '+snap.run_type:'');
      }else if(e.category==='chess'){
        preview='Chess: '+(snap.result||'');
        detail='vs '+(snap.opponent||'')+(snap.color?' ('+snap.color+')':'');
      }else if(e.category==='thought'){
        preview=(snap.text||'').slice(0,60);
        detail=snap.topic?'Topic: '+snap.topic:'';
      }else if(e.category==='panics'){
        preview='Panic';
        detail=snap.note||'';
      }else if(e.category==='habits'){
        preview=activityLabel(snap.activity||'')+(snap.on?' \u2705':' \u274C');
        detail=snap.notes||'';
      }else{
        try{preview=JSON.stringify(snap).slice(0,80)}catch(_){preview=''}
      }
      var deletedAt=e.deleted_at?e.deleted_at.slice(0,16).replace('T',' '):'';
      return '<div style="background:var(--card);border-radius:8px;padding:8px 10px;margin-bottom:4px;display:flex;align-items:center;gap:8px;cursor:pointer" onclick="showRecycleDetail(\''+e.recycle_id+'\')">'+
        '<span style="font-size:18px">'+icon+'</span>'+
        '<div style="flex:1;min-width:0">'+
          '<div style="font-size:13px">'+preview+'</div>'+
          (detail?'<div style="font-size:11px;color:var(--muted);margin-top:2px">'+detail+'</div>':'')+
          '<div style="font-size:10px;color:var(--muted);margin-top:2px">'+catLabel+' \u00b7 '+deletedAt+'</div>'+
        '</div>'+
        '<button class="btn btn-accent" onclick="event.stopPropagation();restoreRecycleItem(\''+e.recycle_id+'\')" style="padding:4px 10px;font-size:11px">Restore</button>'+
      '</div>';
    }).join('');
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px">Failed to load</div>';
  }
}

function showRecycleDetail(recycleId){
  var en=_recycleEntries.find(function(x){return x.recycle_id===recycleId});
  if(!en)return;
  var snap={};
  var snapSrc=en.data&&en.data.snapshot?en.data.snapshot:(en.data&&en.data._raw?en.data._raw:null);
  if(snapSrc){try{snap=JSON.parse(snapSrc);}catch(e){snap={};}}
  else if(en.data){snap=en.data;}
  var typeIcon=CATEGORY_ICONS[en.category]||'\u{1F5D1}';
  var catLabel=(en.category||'unknown').charAt(0).toUpperCase()+(en.category||'unknown').slice(1);
  var deletedAt=en.deleted_at?en.deleted_at.slice(0,16).replace('T',' '):'';
  var rows=Object.keys(snap).filter(function(k){
    if(k==='_raw'||k==='id'||k==='recycle_id'||k==='data'||k==='deleted_at')return false;
    var v=snap[k];
    if(v===null||v===undefined)return false;
    if(typeof v==='string'&&v.trim()==='')return false;
    return true;
  }).map(function(k){
    var v=snap[k];
    var vs=(typeof v==='object')?JSON.stringify(v):String(v);
    return '<div style="margin-bottom:8px">'+
      '<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;display:block;margin-bottom:2px">'+esc(k)+'</span>'+
      '<span style="font-size:12px;color:var(--text);word-break:break-word;white-space:pre-wrap">'+esc(vs)+'</span>'+
      '</div>';
  }).join('');
  var html='<div style="text-align:center;font-size:26px;margin-bottom:8px">'+typeIcon+'</div>';
  html+='<h3 style="font-size:15px;margin:0 0 8px 0;font-family:\'JetBrains Mono\',\'Mono\',monospace;text-transform:uppercase">'+catLabel+'</h3>';
  html+='<div style="font-size:11px;color:var(--muted);margin-bottom:12px">Deleted: '+esc(deletedAt)+'</div>';
  html+=(rows?rows:'<div style="font-size:11px;color:var(--muted)">No additional data</div>');
  html+='<div class="modal-btns"><button class="btn btn-accent" onclick="restoreRecycleItem(\''+en.recycle_id+'\');closeModal()">Restore</button><button class="btn" onclick="closeModal()">Close</button></div>';
  document.getElementById('modalOverlay').innerHTML='<div class="modal" style="max-width:420px">'+html+'</div>';
  document.getElementById('modalOverlay').classList.add('show');
}

async function restoreRecycleItem(recycleId){
  try{
    var r=await fetch(BASE+'/recycle-bin/'+recycleId+'/restore',{method:'POST'});
    var j=await r.json();
    if(j.ok){toast('Restored!');loadRecycleBin(_recycleFilter);loadDashboard()}
    else if(j.detail)toast(j.detail)
  }catch(e){toast('Error restoring')}
}
async function clearAllRecycle(){
  if(!confirm('Permanently delete all items in the recycle bin? This cannot be undone.'))return;
  try{
    var qs=_recycleFilter?'?category='+encodeURIComponent(_recycleFilter):'';
    var r=await fetch(BASE+'/recycle-bin/clear'+qs,{method:'POST'});
    var j=await r.json();
    if(j.ok){toast('Recycle bin cleared');loadRecycleBin(_recycleFilter)}
  }catch(e){toast('Error clearing recycle bin')}
}

// ─── Thoughts Page ────────────────────────────────────────────────────────────

var _thoughtsFilter='all';
var _thoughtsExpanded=false;
var _allThoughtsData=[];
var _deletedThoughtsData=[];
var _deletedThoughtsLoaded=false;
async function loadDeletedThoughts(force){
  if(_deletedThoughtsLoaded&&!force)return;
  _deletedThoughtsLoaded=false;
  try{
    var r=await fetch(BASE+'/recycle-bin?category=thought');
    var j=await r.json();
    _deletedThoughtsData=(j.entries||[]).map(function(en){
      var raw={};
      try{raw=JSON.parse((en.data&&en.data._raw)||'{}');}catch(e){}
      return {id:en.recycle_id, ts:raw.ts||en.deleted_at||'', text:raw.text||'', topic:raw.topic||'', deleted:true, recycle_id:en.recycle_id};
    });
    _deletedThoughtsLoaded=true;
  }catch(e){_deletedThoughtsData=[];_deletedThoughtsLoaded=true;}
}
var THOUGHT_FILTERS=[
  {key:'all',label:'ALL',color:'var(--primary)',icon:'<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>'},
  {key:'quick',label:'QUICK',color:'var(--secondary)',icon:'<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 10 10-12h-9l1-10z"/></svg>'},
  {key:'gita',label:'GITA',color:'var(--yellow)',icon:'<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16v2H4zm0 4h16v12H4z"/></svg>'},
  {key:'pinned',label:'PINNED',color:'var(--red)',icon:'<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3a1 1 0 0 1 .7.3l4 4a1 1 0 0 1-.18 1.42l-10.5 7a1 1 0 0 1-1.24-.06l-3.5-3.5a1 1 0 0 1 .06-1.24l10.5-7a1 1 0 0 1 1.36.34zM7.5 14.5l3 3L5 23l1.5-5.5z"/></svg>'},
  {key:'deleted',label:'DELETED',color:'var(--text-inactive)',icon:'<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM8 9h8v10H8V9zm7.5-5l-1-1h-5l-1 1H5v2h14V4h-3.5z"/></svg>'}
];
var THOUGHT_PRIMARY_KEYS=['all','quick','gita'];

function renderThoughtFilters(){
  var c=document.getElementById('thoughtsFilters');
  var visible=_thoughtsExpanded?THOUGHT_FILTERS:THOUGHT_FILTERS.filter(function(f){return THOUGHT_PRIMARY_KEYS.indexOf(f.key)!==-1});
  var html=visible.map(function(f){
    var active=_thoughtsFilter===f.key;
    return '<span class="chip'+(active?' selected':'')+'" style="color:'+f.color+(active?';border-color:'+f.color:'')+'" onclick="setThoughtsFilter(\''+f.key+'\')">'+f.icon+f.label+'</span>';
  }).join('');
  html+='<span class="chip" onclick="toggleThoughtsExpand()" style="color:var(--text-inactive)">'+( _thoughtsExpanded?'LESS':'MORE')+'</span>';
  c.innerHTML=html;
}
function toggleThoughtsExpand(){_thoughtsExpanded=!_thoughtsExpanded;renderThoughtFilters()}
function setThoughtsFilter(f){_thoughtsFilter=f;renderThoughtFilters();renderFilteredThoughts()}
function filterThoughtsSearch(){renderFilteredThoughts()}

async function openThoughtsPage(){
  setNavTabActive('journal');
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('thoughtsPage');el.scrollTop=0;el.classList.add('show');
  renderThoughtFilters();
  var container=document.getElementById('thoughtsContent');
  if(typeof renderSkeleton==='function') container.innerHTML=renderSkeleton('cards',3);
  else container.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px">Loading...</div>';
  try{
    var r=await fetch(BASE+'/thoughts');
    var j=await r.json();
    _allThoughtsData=j.thoughts||[];
    renderFilteredThoughts();
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px">Failed to load</div>';
  }
}

async function renderFilteredThoughts(){
  var container=document.getElementById('thoughtsContent');
  var thoughts=_allThoughtsData.slice();
  var searchVal=(document.getElementById('thoughtsSearchInput')?.value||'').toLowerCase().trim();
  if(_thoughtsFilter==='deleted'){
    await loadDeletedThoughts();
    thoughts=_deletedThoughtsData.slice();
  }else if(_thoughtsFilter==='pinned'){
    thoughts=thoughts.filter(function(t){return t.pinned});
  }else if(_thoughtsFilter==='quick'){
    thoughts=thoughts.filter(function(t){return !t.visited});
  }else if(_thoughtsFilter==='gita'){
    thoughts=thoughts.filter(function(t){return(t.topic||'').toLowerCase()==='geeta'});
  }
  if(searchVal){
    thoughts=thoughts.filter(function(t){
      return (t.topic||'').toLowerCase().includes(searchVal)||(t.text||'').toLowerCase().includes(searchVal);
    });
  }
  if(thoughts.length===0){
    var emptyMsg=_thoughtsFilter==='deleted'?'RECYCLE BIN EMPTY \u00b7 NO DELETED NOTES':'ALL CAUGHT UP \u00b7 NO NOTES FOUND';
    container.innerHTML='<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 20px;opacity:0.4"><span class="material-symbols-outlined" style="font-size:40px;margin-bottom:12px">cloud_done</span><span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em">'+emptyMsg+'</span></div>';
    return;
  }
  var pinSvg='<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3a1 1 0 0 1 .7.3l4 4a1 1 0 0 1-.18 1.42l-10.5 7a1 1 0 0 1-1.24-.06l-3.5-3.5a1 1 0 0 1 .06-1.24l10.5-7a1 1 0 0 1 1.36.34zM7.5 14.5l3 3L5 23l1.5-5.5z"/></svg>';
  var html='<div style="display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:1fr;gap:1px;background:var(--border)">';
  thoughts.forEach(function(t,i){
    var time=t.ts?t.ts.slice(11,16)+' \u00b7 '+t.ts.slice(5,10).replace(/-/g,'.'):'';
    var dateTag=t.ts?t.ts.slice(0,10).replace(/-/g,'.'):'';
    var borderColor=(i%2===0)?'border-right:1px solid var(--border)':'';
    var topic=t.topic||t.text?.slice(0,40)||'Untitled';
    var preview=t.text?(t.text.length>140?t.text.slice(0,140)+'...':t.text):'';
    var cardIcon='';
    if(t.pinned)cardIcon='<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--red)"><path d="M16 3a1 1 0 0 1 .7.3l4 4a1 1 0 0 1-.18 1.42l-10.5 7a1 1 0 0 1-1.24-.06l-3.5-3.5a1 1 0 0 1 .06-1.24l10.5-7a1 1 0 0 1 1.36.34zM7.5 14.5l3 3L5 23l1.5-5.5z"/></svg>';
    else if(!t.visited)cardIcon='<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--secondary)"><path d="M13 2L3 14h9l-1 10 10-12h-9l1-10z"/></svg>';
    else if((t.topic||'').toLowerCase()==='geeta')cardIcon='<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--yellow)"><path d="M4 4h16v2H4zm0 4h16v12H4z"/></svg>';
    var isDeleted=t.recycle_id?true:false;
    html+='<div style="background:var(--surface);padding:14px;'+borderColor+';transition:border-color 0.2s;cursor:pointer;display:flex;flex-direction:column;overflow:hidden'+(isDeleted?';opacity:0.6':'')+'" onclick="openThoughtDetail(\''+esc(t.id)+'\')">';
    html+='<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em">'+time+(isDeleted?' <span style="color:var(--accent-red)">[DELETED]</span>':'')+'</span>';
    if(cardIcon)html+=cardIcon;
    html+='</div>';
    html+='<h3 style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:13px;font-weight:600;color:var(--text);margin-bottom:6px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(topic)+'</h3>';
    if(preview){
      html+='<p style="color:var(--text-inactive);font-size:11px;line-height:1.5;flex:1;opacity:0.7;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">'+esc(preview)+'</p>';
    }else{
      html+='<div style="flex:1"></div>';
    }
    html+='<div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);padding-top:6px;margin-top:auto">';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive)">'+dateTag+'</span>';
    html+=(isDeleted?'<span style="color:var(--text-inactive);flex-shrink:0;display:flex">'+pinSvg+'</span>':'<span onclick="event.stopPropagation();pinThought(\''+t.id+'\','+(t.pinned?'false':'true')+')" style="color:var(--text-inactive);cursor:pointer;flex-shrink:0;display:flex">'+pinSvg+'</span>');
    html+='</div></div>';
  });
  html+='</div>';
  html+='<div style="text-align:center;padding:24px 16px;color:var(--text-inactive);font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:11px;opacity:0.6">&sim; END OF FIELD NOTES &sim;</div>';
  container.innerHTML=html;
}
function closeThoughtsPage(){
  document.getElementById('mainFab').style.display='none';
  document.getElementById('thoughtsPage').classList.remove('show');
  setNavTabActive('home');
}
function openThoughtDetail(id){
  var t=_allThoughtsData.find(function(x){return x.id===id});
  var isDeleted=false;
  if(!t){
    t=_deletedThoughtsData.find(function(x){return x.id===id});
    isDeleted=!!t;
  }
  if(!t)return;
  var time=t.ts?t.ts.slice(11,16)+' \u00b7 '+t.ts.slice(0,10).replace(/-/g,'.'):'';
  var topic=t.topic||'Untitled';
  var text=t.text||'No content';
  var tags='';
  if(t.pinned)tags+='<span style="padding:3px 8px;border:1px solid var(--red);color:var(--red);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;letter-spacing:0.1em">PINNED</span>';
  if(isDeleted)tags+='<span style="padding:3px 8px;border:1px solid var(--accent-red);color:var(--accent-red);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;letter-spacing:0.1em">DELETED</span>';
  tags+='<span style="padding:3px 8px;border:1px solid var(--border);color:var(--text-inactive);font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;letter-spacing:0.1em">THOUGHT</span>';
  var modal=document.createElement('div');
  modal.id='thoughtDetailModal';
  modal.style.cssText='position:fixed;top:0;left:0;width:100%;height:100%;z-index:200;display:flex;align-items:center;justify-content:center';
  modal.innerHTML='<div style="position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6)" onclick="closeThoughtDetail()"></div>'+
    '<div style="position:relative;width:90%;max-width:480px;max-height:80vh;background:var(--surface);border:1px solid var(--border);overflow-y:auto;padding:24px">'+
    '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">'+
    '<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em">'+time+'</span>'+
    '<button onclick="closeThoughtDetail()" style="color:var(--text-inactive);background:none;border:none;cursor:pointer;padding:2px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>'+
    '</div>'+
    '<h3 style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:16px;font-weight:600;color:var(--text);margin-bottom:16px;line-height:1.4">'+esc(topic)+'</h3>'+
    '<p style="font-family:\'General Sans\',sans-serif;font-size:14px;line-height:1.8;color:var(--text-inactive);white-space:pre-wrap;margin-bottom:20px">'+esc(text)+'</p>'+
    '<div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);padding-top:12px">'+
    '<div style="display:flex;gap:6px;align-items:center">'+tags+'</div>'+
    (isDeleted
      ?'<button onclick="restoreRecycleItem(\''+esc(t.recycle_id)+'\');closeThoughtDetail();loadDeletedThoughts(true);renderFilteredThoughts()" style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--green);text-transform:uppercase;letter-spacing:0.1em;background:none;border:1px solid var(--green);padding:4px 12px;cursor:pointer;transition:all 0.15s">RESTORE</button>'
      :'<button onclick="deleteThoughtItem(\''+esc(t.id)+'\');closeThoughtDetail()" style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--red);text-transform:uppercase;letter-spacing:0.1em;background:none;border:1px solid var(--red);padding:4px 12px;cursor:pointer;transition:all 0.15s">DELETE</button>')+
    '</div></div>';
  document.body.appendChild(modal);
}
function closeThoughtDetail(){var m=document.getElementById('thoughtDetailModal');if(m)m.remove()}

async function toggleThoughtVisited(id,visited){
  try{
    await fetch(BASE+'/thought/visit?thought_id='+id+'&visited='+visited,{method:'POST'});
  }catch(e){}
}

async function deleteThoughtItem(id){
  if(!confirm('Move to recycle bin?'))return;
  try{
    var r=await fetch(BASE+'/event/thought/'+id,{method:'DELETE'});
    var j=await r.json();
    if(j.ok||j.recycled){toast('Moved to recycle bin');openThoughtsPage();loadDashboard()}
  }catch(e){toast('Error')}
}

// ─── Tasks Page ───────────────────────────────────────────────────────────────

var _tasksFilter='all';
async function openTasksPage(filter){
  var hasTasks = (window._ALL_INSTALLED_PLUGINS || []).some(function(p){ return p.id === 'com.v07.tasks' && p.enabled !== false; });
  if(hasTasks && typeof openPluginPage === 'function'){
    openPluginPage('com.v07.tasks');
    return;
  }
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('tasksPage');el.scrollTop=0;el.classList.add('show');
  loadTasksPage(filter||'all');
}
function closeTasksPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('tasksPage').classList.remove('show')}

function renderTaskFilters(){
  var c=document.getElementById('tasksFilters');
  var filters=[
    {key:'all',label:'ALL',color:'var(--primary)'},
    {key:'today',label:'TODAY',color:'var(--primary)'},
    {key:'upcoming',label:'UPCOMING',color:'var(--secondary)'},
    {key:'overdue',label:'OVERDUE',color:'var(--accent-red)'},
    {key:'done',label:'DONE',color:'var(--text-inactive)'}
  ];
  c.innerHTML=filters.map(function(f){
    var active=_tasksFilter===f.key;
    return '<span class="chip'+(active?' selected':'')+'" style="color:'+f.color+(active?';border-color:'+f.color:'')+'" onclick="loadTasksPage(\''+f.key+'\')">'+f.label+'</span>';
  }).join('');
}

async function loadTasksPage(filter){
  _tasksFilter=filter||'all';
  renderTaskFilters();
  var container=document.getElementById('tasksContent');
  if(typeof renderSkeleton==='function') container.innerHTML=renderSkeleton('cards',3);
  else container.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px">Loading...</div>';
  try{
    var r=await fetch(BASE+'/tasks?filter='+_tasksFilter);
    var j=await r.json();
    var tasks=j.tasks||[];
    var progressEl=document.getElementById('tasksProgress');
    if(tasks.length===0){
      progressEl.style.display='none';
      container.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px">No tasks</div>';
      return;
    }
    var today=localDate();
    var doneTasks=tasks.filter(function(t){return t.status==='done'});
    var activeTasks=tasks.filter(function(t){return t.status!=='done'});
    var todayTasks=activeTasks.filter(function(t){
      return t.deadline===today;
    });
    var overdueTasks=activeTasks.filter(function(t){
      return t.deadline&&t.deadline<today;
    });
    var upcomingTasks=activeTasks.filter(function(t){
      return !t.deadline||t.deadline>=today;
    }).filter(function(t){return todayTasks.indexOf(t)===-1});

    var totalActive=activeTasks.length;
    var totalDone=doneTasks.length;
    var total=totalActive+totalDone;
    if(total>0){
      progressEl.style.display='block';
      var pct=total>0?Math.round((totalDone/total)*100):0;
      document.getElementById('tasksProgressLabel').textContent=totalDone+' / '+total+' ('+pct+'%)';
      document.getElementById('tasksProgressBar').style.width=pct+'%';
    }else{
      progressEl.style.display='none';
    }

    var html='';

    function renderSection(title,color,count,label,tasksArr,opts){
      if(tasksArr.length===0&&opts&&opts.skipEmpty)return'';
      var h='';
      h+='<div style="margin-bottom:16px">';
      h+='<div style="display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--border);padding-bottom:4px;margin-bottom:2px">';
      h+='<h3 style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:11px;font-weight:700;color:'+color+';text-transform:uppercase;letter-spacing:0.06em">'+title+'</h3>';
      h+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase">'+label+'</span>';
      h+='</div>';
      if(tasksArr.length===0){
        h+='<div style="padding:12px 0;text-align:center;font-size:11px;color:var(--text-inactive);font-family:\'JetBrains Mono\',\'Mono\',monospace">No items</div>';
      }
      tasksArr.forEach(function(t){
        var isDone=t.status==='done';
        var checked=isDone;
        var priorityColor=t.priority==='high'?'var(--accent-red)':t.priority==='medium'?'var(--yellow)':'var(--text-inactive)';
        var priorityLabel=t.priority==='high'?'CRITICAL':t.priority==='medium'?'MEDIUM':'LOW';
        var deadline=t.deadline||'';
        var time=t.deadline_time?' '+t.deadline_time:'';
        var overdueLabel='';
        if(!isDone&&deadline&&deadline<today){
          var days=Math.floor((new Date()-new Date(deadline+'T00:00:00'))/(86400000));
          overdueLabel=' <span style="color:var(--accent-red);font-size:9px;font-family:\'JetBrains Mono\',\'Mono\',monospace">LATENCY: '+days+'D</span>';
        }
        var doneTime='';
        if(isDone&&t.completed_at){
          doneTime=t.completed_at.slice(11,16)||'';
        }
        h+='<div class="task-row" style="display:flex;gap:12px;padding:10px 4px;border-bottom:1px solid var(--divider);transition:background 0.15s">';
        if(isDone){
          h+='<div style="flex-shrink:0;width:16px;height:16px;background:var(--secondary);display:flex;align-items:center;justify-content:center;cursor:pointer;margin-top:1px" onclick="toggleTaskPage(\''+t.id+'\','+isDone+')">';
          h+='<span style="font-size:10px;color:var(--on-primary);font-weight:700">&#x2713;</span></div>';
        }else{
          h+='<div style="flex-shrink:0;width:16px;height:16px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;margin-top:1px;transition:border-color 0.15s" onclick="toggleTaskPage(\''+t.id+'\','+isDone+')"></div>';
        }
        h+='<div style="flex:1;min-width:0">';
        var titleStyle=isDone?'font-size:13px;color:var(--text-inactive);text-decoration:line-through;text-transform:uppercase;font-weight:500':'font-size:13px;color:var(--text);text-transform:uppercase;font-weight:500';
        h+='<div style="'+titleStyle+'">'+esc(t.title)+overdueLabel+'</div>';
        h+='<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:3px">';
        if(isDone&&doneTime){
          h+='<span style="font-size:9px;color:var(--secondary);font-family:\'JetBrains Mono\',\'Mono\',monospace;text-transform:uppercase">COMPLETED: '+doneTime+'</span>';
        }else{
          h+='<span style="font-size:9px;color:'+priorityColor+';font-family:\'JetBrains Mono\',\'Mono\',monospace;text-transform:uppercase">'+priorityLabel+'</span>';
          if(deadline)h+='<span style="font-size:9px;color:var(--text-inactive);font-family:\'JetBrains Mono\',\'Mono\',monospace;text-transform:uppercase">DUE: '+deadline+(time?' '+time:'')+'</span>';
        }
        h+='</div></div></div>';
      });
      h+='</div>';
      return h;
    }

    if(_tasksFilter==='all'){
      html+=renderSection('TODAY','var(--primary)',todayTasks.length,todayTasks.length+' ACTIVE',todayTasks,{skipEmpty:true});
      html+=renderSection('OVERDUE','var(--accent-red)',overdueTasks.length,overdueTasks.length+' LATENCY',overdueTasks,{skipEmpty:true});
      html+=renderSection('UPCOMING','var(--secondary)',upcomingTasks.length,upcomingTasks.length+' QUEUED',upcomingTasks);
      html+=renderSection('DONE','var(--text-inactive)',doneTasks.length,'COMPLETED',doneTasks);
    }else if(_tasksFilter==='today'){
      html+=renderSection('TODAY','var(--primary)',todayTasks.length,todayTasks.length+' ACTIVE',todayTasks);
    }else if(_tasksFilter==='upcoming'){
      html+=renderSection('UPCOMING','var(--secondary)',upcomingTasks.length,upcomingTasks.length+' QUEUED',upcomingTasks);
    }else if(_tasksFilter==='overdue'){
      html+=renderSection('OVERDUE','var(--accent-red)',overdueTasks.length,overdueTasks.length+' LATENCY',overdueTasks);
    }else if(_tasksFilter==='done'){
      html+=renderSection('DONE','var(--text-inactive)',doneTasks.length,'COMPLETED',doneTasks);
    }
    container.innerHTML=html;
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px">Failed to load</div>';
  }
}

async function toggleTaskPage(id,wasDone){
  // Optimistic update in place to prevent full page rerendering!
  var container=document.getElementById('tasksContent');
  if(container){
    var row=Array.from(container.querySelectorAll('.task-row')).find(function(r){
      return r.querySelector('[onclick*="'+id+'"]');
    });
    if(row){
      var checkDiv=row.querySelector('div[onclick*="toggleTaskPage"]');
      var titleDiv=row.querySelector('div[style*="font-size:13px"]');
      if(checkDiv){
        var willBeDone=!wasDone;
        if(willBeDone){
          checkDiv.style.background='var(--secondary)';
          checkDiv.style.border='none';
          checkDiv.innerHTML='<span style="font-size:10px;color:var(--on-primary);font-weight:700">&#x2713;</span>';
          if(titleDiv){titleDiv.style.color='var(--text-inactive)';titleDiv.style.textDecoration='line-through';}
        }else{
          checkDiv.style.background='transparent';
          checkDiv.style.border='1px solid var(--border)';
          checkDiv.innerHTML='';
          if(titleDiv){titleDiv.style.color='var(--text)';titleDiv.style.textDecoration='none';}
        }
      }
    }
  }

  try{
    if(wasDone){
      await fetch(BASE+'/task/'+id+'/reopen',{method:'POST'});
    }else{
      await fetch(BASE+'/task/'+id+'/done',{method:'POST'});
    }
  }catch(e){
    toast('Error syncing task');
    loadTasksPage(_tasksFilter||'all');
  }
}

async function deleteTaskPage(id){
  if(!confirm('Move to recycle bin?'))return;
  try{
    var r=await fetch(BASE+'/task/'+id,{method:'DELETE'});
    var j=await r.json().catch(()=>({ok:false,detail:'Invalid JSON'}));
    if(j.ok||j.recycled){toast('Moved to recycle bin');loadTasksPage(_tasksFilter||'all');loadDashboard()}
    else toast(j.detail||'Failed');
  }catch(e){toast('Error: '+e.message)}
}

// ─── Screen Time / App Usage ──────────────────────────────────────────────────

async function loadScreenTime(force,retry){
  try{
    var url=BASE+'/app-usage/today?t='+Date.now()+(force?'&force=true':'');
    var r=await fetch(url);
    var j=await r.json();
    var statEl=document.getElementById('statScreenHeader');
    var homeEl=document.getElementById('statScreenHome');
    var statusPill=document.getElementById('statScreenStatusPill');
    var ratioEl=document.getElementById('statScreenRatio');
    var barEl=document.getElementById('statScreenBar');
    var topAppsEl=document.getElementById('homeScreenTopApps');

    var limitSec = 3 * 3600; // 3h daily limit
    if(!j.exists||!j.summary){
      if(!retry){
        setTimeout(function(){loadScreenTime(true,true)},3000);
      }
      if(statEl) statEl.textContent='--';
      if(homeEl) homeEl.textContent='2h 15m';
      if(statusPill) statusPill.textContent='45m under limit';
      if(ratioEl) ratioEl.textContent='75% of limit';
      if(barEl) barEl.style.width='75%';
      return;
    }
    var s=j.summary;
    var formatted = s.total_screen_time_formatted||'0m';
    if(statEl) statEl.textContent=formatted;
    if(homeEl) homeEl.textContent=formatted;

    var totalSec = s.total_screen_time_sec != null ? s.total_screen_time_sec : (s.total_screen_time_seconds || 0);
    var diffSec = limitSec - totalSec;
    if(statusPill){
      if(diffSec >= 0){
        var diffMin = Math.round(diffSec / 60);
        var diffH = Math.floor(diffMin / 60);
        var remM = diffMin % 60;
        var underText = (diffH > 0 ? diffH + 'h ' : '') + remM + 'm under limit';
        statusPill.textContent = underText;
        statusPill.style.background = 'var(--secondary-container)';
        statusPill.style.color = 'var(--secondary)';
        statusPill.style.border = '1px solid var(--border)';
      } else {
        var overMin = Math.round(Math.abs(diffSec) / 60);
        var overH = Math.floor(overMin / 60);
        var overRemM = overMin % 60;
        var overText = (overH > 0 ? overH + 'h ' : '') + overRemM + 'm over limit';
        statusPill.textContent = overText;
        statusPill.style.background = 'var(--secondary-container)';
        statusPill.style.color = 'var(--secondary)';
        statusPill.style.border = '1px solid var(--border)';
      }
    }

    var pct = limitSec > 0 ? Math.round((totalSec / limitSec) * 100) : 0;
    if(ratioEl) ratioEl.textContent = pct + '% of limit';
    if(barEl) barEl.style.width = Math.min(100, Math.max(4, pct)) + '%';

    var usage = Array.isArray(j.usage) ? j.usage : [];
    var sorted = usage.slice().sort(function(a,b){ return (b.total_duration_sec||0) - (a.total_duration_sec||0); });
    if(topAppsEl && sorted.length >= 3){
      var appHtml = '';
      var colorPalette = [
        { color: 'var(--secondary)', icon: 'palette' },
        { color: 'var(--primary)', icon: 'chat_bubble' },
        { color: 'var(--text-inactive)', icon: 'menu_book' }
      ];
      sorted.slice(0, 3).forEach(function(u, idx){
        var appName = u.label || u.app || u.package || 'App';
        var durStr = u.duration_formatted || (Math.round((u.total_duration_sec||0)/60) + 'm');
        var theme = colorPalette[idx % colorPalette.length];
        var lower = (appName + ' ' + (u.package||'')).toLowerCase();
        var icon = theme.icon;
        if(lower.indexOf('read') !== -1 || lower.indexOf('book') !== -1 || lower.indexOf('gita') !== -1) icon = 'menu_book';
        else if(lower.indexOf('chat') !== -1 || lower.indexOf('mess') !== -1 || lower.indexOf('what') !== -1) icon = 'chat_bubble';
        else if(lower.indexOf('art') !== -1 || lower.indexOf('paint') !== -1 || lower.indexOf('draw') !== -1) icon = 'palette';
        else if(lower.indexOf('music') !== -1 || lower.indexOf('sound') !== -1 || lower.indexOf('pod') !== -1) icon = 'headphones';

        appHtml += '<div style="display:flex;align-items:center;gap:8px;padding:8px;border-radius:12px;background:var(--surface-container);border:1px solid var(--border);">';
        appHtml += '  <span class="material-symbols-outlined" style="font-size:16px;color:' + theme.color + ';">' + icon + '</span>';
        appHtml += '  <div style="min-width:0;flex:1;">';
        appHtml += '    <p style="font-size:11px;color:var(--text-inactive);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;">' + esc(appName) + '</p>';
        appHtml += '    <p style="font-size:12px;font-weight:700;color:var(--text);margin:0;">' + durStr + '</p>';
        appHtml += '  </div>';
        appHtml += '</div>';
      });
      topAppsEl.innerHTML = appHtml;
    }
  }catch(e){}
}

function refreshScreenTime(){
  var el=document.getElementById('statScreenHeader');
  if(el) el.textContent='...';
  var homeEl=document.getElementById('statScreenHome');
  if(homeEl) homeEl.textContent='...';
  loadScreenTime(true);
}

function screenDateNav(dir){
  var inp=document.getElementById('appUsageDate');
  var d=new Date(inp.value+'T00:00:00');
  d.setDate(d.getDate()+dir);
  inp.value=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  loadAppUsageForDate();
}

async function openAppUsagePage(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  var today=localDate();
  document.getElementById('appUsageDate').value=today;
  var el=document.getElementById('appUsagePage');el.scrollTop=0;el.classList.add('show');
  loadAppUsageForDate();
  loadScreenTime(true);
}

async function loadAppUsageForDate(){
  var dateVal=document.getElementById('appUsageDate').value;
  if(!dateVal)return;
  var container=document.getElementById('appUsageContent');
  if(typeof renderSkeleton==='function') container.innerHTML=renderSkeleton('grid',2)+renderSkeleton('chart')+renderSkeleton('cards',2);
  else container.innerHTML='<div style="color:var(--text-inactive);font-size:13px;text-align:center;padding:20px">Loading...</div>';
  try{
    var r=await fetch(BASE+'/app-usage?date='+dateVal);
    var j=await r.json();
    if(!j.exists||!j.summary){
      container.innerHTML='<div style="color:var(--text-inactive);text-align:center;padding:24px;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:13px">No usage recorded for '+dateVal+'</div>';
      return;
    }
    var s=j.summary;
    var usage=Array.isArray(j.usage)?j.usage:[];
    var hourly=Array.isArray(j.hourly_usage)?j.hourly_usage:[];
    var timeline=Array.isArray(j.timeline)?j.timeline:[];
    var sessions=Array.isArray(j.sessions)?j.sessions:[];
    var usageList=usage.slice().sort(function(a,b){return(b.total_duration_sec||0)-(a.total_duration_sec||0)});
    var top3=usageList.slice(0,3).map(function(u){return u.package||u.app});
    var appColors={};
    var rankColors=['var(--primary)','var(--accent-purple)','#FF9F45'];
    var OTHER_COLOR='rgba(167,200,255,0.18)';
    for(var ri=0;ri<top3.length;ri++){appColors[top3[ri]]=rankColors[ri];}
    var hourApps=[];
    var hourTotal=[];
    var hourTotalFromSessions=0;
    for(var hi=0;hi<24;hi++){hourApps.push({});hourTotal.push(0);}
    var dayStart=new Date(dateVal+'T00:00:00').getTime();
    sessions.forEach(function(se){
      var appKey=se.package||se.app;
      if(!appKey)return;
      var rawSt=se.start_ms||0;
      var rawEn=se.end_ms||(rawSt+(se.duration_sec?se.duration_sec*1000:0));
      var st=rawSt>1000000000000?(rawSt-dayStart):rawSt;
      var en=rawEn>1000000000000?(rawEn-dayStart):rawEn;
      if(en<=st||en<=0||st>=86400000)return;
      st=Math.max(st,0);
      en=Math.min(en,86400000);
      var sh=Math.max(Math.floor(st/3600000),0);
      var eh=Math.min(Math.floor((en-1)/3600000),23);
      for(var h=sh;h<=eh;h++){
        var hs=h*3600000;
        var ov=Math.min(en,hs+3600000)-Math.max(st,hs);
        if(ov<=0)continue;
        var mins=ov/60000;
        hourApps[h][appKey]=(hourApps[h][appKey]||0)+mins;
        hourTotal[h]+=mins;
        hourTotalFromSessions+=mins;
      }
    });
    if(hourTotalFromSessions<=0&&hourly.length>0){
      hourly.forEach(function(he){
        var hh=he.hour;
        if(hh>=0&&hh<24){
          var m=(he.duration_sec||(he.duration_min?he.duration_min*60:0))/60;
          hourTotal[hh]+=m;
        }
      });
    }
    // Strictly cap every hour bucket to 60 minutes max
    for(var ch=0;ch<24;ch++){
      if(hourTotal[ch]>60){
        var cScale=60/hourTotal[ch];
        hourTotal[ch]=60;
        if(hourApps[ch]){
          Object.keys(hourApps[ch]).forEach(function(k){
            hourApps[ch][k]*=cScale;
          });
        }
      }
    }
    var appDisplay=function(ak){
      for(var ui=0;ui<usage.length;ui++){if((usage[ui].package||usage[ui].app)===ak)return usage[ui].app||ak;}
      return ak;
    };
    var badge=document.getElementById('screenTimeBadge');
    if(badge)badge.textContent=s.total_screen_time_formatted||'';

    var html='';

    // ── Section 1: Summary Grid (2x2) ──
    html+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px">';
    html+='<div style="border:1px solid var(--paper-border);padding:10px;background:var(--paper-surface);border-radius:var(--radius);display:flex;flex-direction:column;gap:2px">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9.5px;color:var(--pencil-muted);text-transform:uppercase;letter-spacing:0.08em">TOTAL TIME</span>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;font-weight:700;color:var(--ink-text)">'+s.total_screen_time_formatted+'</span>';
    html+='</div>';
    html+='<div style="border:1px solid var(--paper-border);padding:10px;background:var(--paper-surface);border-radius:var(--radius);display:flex;flex-direction:column;gap:2px">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9.5px;color:var(--pencil-muted);text-transform:uppercase;letter-spacing:0.08em">APPS USED</span>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;font-weight:700;color:var(--ink-text)">'+s.unique_apps_used+'</span>';
    html+='</div>';
    html+='<div style="border:1px solid var(--paper-border);padding:10px;background:var(--paper-surface);border-radius:var(--radius);display:flex;flex-direction:column;gap:2px">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9.5px;color:var(--pencil-muted);text-transform:uppercase;letter-spacing:0.08em">SESSIONS</span>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;font-weight:700;color:var(--ink-text)">'+s.session_count+'</span>';
    html+='</div>';
    html+='<div style="border:1px solid var(--paper-border);padding:10px;background:var(--paper-surface);border-radius:var(--radius);display:flex;flex-direction:column;gap:2px">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9.5px;color:var(--pencil-muted);text-transform:uppercase;letter-spacing:0.08em">UNLOCKS</span>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;font-weight:700;color:var(--crayon-blue)">'+(s.unlock_count||s.session_count||'--')+'</span>';
    html+='</div>';
    html+='</div>';

    // ── Top App Peak Banner ──
    if(s.top_app){
      var topPct=s.top_app.percentage||Math.round(s.top_app.duration_sec/(s.total_screen_time_sec||1)*100);
      var topMin=Math.round((s.top_app.duration_sec||0)/60);
      var topPkg=s.top_app.package||'';
      var topIcon=topPkg?'<img src="/app-icon?package='+encodeURIComponent(topPkg)+'" style="width:16px;height:16px;border-radius:3px;object-fit:contain;flex-shrink:0;background:rgba(255,255,255,0.06)" onerror="this.style.display=\'none\'">':'';
      html+='<div style="border:1px solid rgba(255,159,69,0.3);background:rgba(255,159,69,0.05);border-radius:var(--radius);padding:10px 12px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between">';
      html+='<div style="display:flex;align-items:center;gap:8px">';
      html+=topIcon;
      html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10.5px;color:var(--crayon-amber);font-weight:700;letter-spacing:0.06em">MOST USED: '+(s.top_app.app||'').toUpperCase()+' ('+topPct+'%)</span>';
      html+='</div>';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;font-weight:700;color:var(--crayon-amber)">'+topMin+'m</span>';
      html+='</div>';
    }

    // ── Section 2: Chrono Distribution (Segmented Bar Chart) ──
    html+='<div style="margin-bottom:20px">';
    html+='<div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:10px;padding:0 4px">';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--pencil-muted);text-transform:uppercase;letter-spacing:0.08em;font-weight:700">HOURLY USAGE BREAKDOWN</span>';
    html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--pencil-muted);letter-spacing:0.05em">MAX 60M/HR · ⇄ SCROLL</span>';
    html+='</div>';
    html+='<div style="border:1px solid var(--paper-border);background:var(--paper-surface);border-radius:var(--radius);padding:14px 12px;overflow-x:auto;-webkit-overflow-scrolling:touch">';
    html+='<div style="display:flex;gap:8px;min-width:920px;position:relative">';
    // Y-axis labels
    html+='<div style="display:flex;flex-direction:column;justify-content:space-between;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:8px;color:var(--pencil-muted);height:140px;border-right:1px solid var(--paper-line);padding-right:6px;flex-shrink:0;user-select:none">';
    for(var yl=60;yl>=0;yl-=10){html+='<span>'+yl+'M</span>';}
    html+='</div>';
    // Main plot + X-axis area
    html+='<div style="flex:1;position:relative;display:flex;flex-direction:column">';
    // Dashed grid lines
    html+='<div style="position:absolute;top:0;left:0;right:0;height:140px;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none">';
    for(var gl=0;gl<7;gl++){html+='<div style="border-top:1px dashed var(--paper-line);width:100%"></div>';}
    html+='</div>';
    // Bars row
    html+='<div style="display:flex;align-items:flex-end;height:140px;padding:0 4px;position:relative;z-index:1;border-bottom:1px solid var(--paper-line)">';
    var Y_MAX=60;
    var peakMin=0;
    for(var hi=0;hi<24;hi++){if(hourTotal[hi]>peakMin)peakMin=hourTotal[hi];}
    var hasSessions=sessions.length>0&&hourTotalFromSessions>0;
    var durLabelFn=function(m){m=Math.min(60,m);return m>=60?'60m':m+'m';};
    var rankIdx=function(ak){return appColors[ak]?top3.indexOf(ak):99;};
    for(var hi=0;hi<24;hi++){
      var durMin=Math.min(60,Math.round(hourTotal[hi]));
      var barPct=Math.min((durMin/Y_MAX)*100,100);
      var isPeak=(durMin===Math.min(60,Math.round(peakMin))&&durMin>0);
      var topApp='';
      var segDesc='';
      if(durMin>0&&hasSessions){
        var segKeys=Object.keys(hourApps[hi]).sort(function(a,b){return hourApps[hi][b]-hourApps[hi][a]});
        topApp=appDisplay(segKeys[0]);
        segDesc=segKeys.slice(0,3).map(function(k){return appDisplay(k)+': '+Math.min(60,Math.round(hourApps[hi][k]))+'m'}).join(', ');
      }
      var hourStr=String(hi).padStart(2,'0')+':00';
      var tooltipTitle=hourStr+' ('+durMin+'m)'+(segDesc?' — '+segDesc:'');

      html+='<div class="chrono-bar-col" title="'+esc(tooltipTitle)+'" style="flex:1;min-width:34px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;padding:0 2px;box-sizing:border-box">';
      if(durMin>0){
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:8px;font-weight:600;color:'+(isPeak?'var(--crayon-amber)':'var(--pencil-muted)')+';margin-bottom:4px;white-space:nowrap;line-height:1">'+durLabelFn(durMin)+'</span>';
      }
      html+='<div style="width:16px;height:'+barPct+'%;background:'+(hasSessions?'transparent':'rgba(167,200,255,0.22)')+';border:'+(isPeak?'1px solid var(--primary)':'1px solid rgba(167,200,255,0.35)')+';border-radius:3px 3px 0 0;min-height:'+(durMin>0?'3px':'0')+';overflow:hidden;display:flex;flex-direction:column-reverse;transition:all 0.15s">';
      if(hasSessions&&durMin>0){
        var segApps=Object.keys(hourApps[hi]).sort(function(a,b){return hourApps[hi][b]-hourApps[hi][a]}).sort(function(a,b){return rankIdx(a)-rankIdx(b)});
        segApps.forEach(function(ak){
          var am=Math.round(hourApps[hi][ak]);
          if(am<=0)return;
          html+='<div title="'+esc(appDisplay(ak))+' '+am+'m" style="height:'+(am/durMin*100)+'%;min-height:2px;background:'+(appColors[ak]||OTHER_COLOR)+'"></div>';
        });
      }
      html+='</div>';
      html+='</div>';
    }
    html+='</div>';
    // X-axis hours row (cleanly separated from bars)
    html+='<div style="display:flex;padding:6px 4px 0;align-items:center">';
    for(var hi=0;hi<24;hi++){
      html+='<span style="flex:1;min-width:34px;text-align:center;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:8px;color:var(--text-inactive);user-select:none">'+String(hi).padStart(2,'0')+'</span>';
    }
    html+='</div>';
    html+='</div></div>';
    if(hasSessions&&top3.length>0){
      html+='<div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-top:12px;padding:6px 4px;border-top:1px solid var(--border)">';
      top3.forEach(function(ak,ti){
        html+='<span style="display:inline-flex;align-items:center;gap:6px;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:8px;color:var(--text-inactive);text-transform:uppercase"><span style="width:8px;height:8px;border-radius:2px;background:'+rankColors[ti]+';display:inline-block"></span>'+esc(appDisplay(ak))+'</span>';
      });
      html+='<span style="display:inline-flex;align-items:center;gap:6px;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:8px;color:var(--text-inactive);text-transform:uppercase"><span style="width:8px;height:8px;border-radius:2px;background:'+OTHER_COLOR+';display:inline-block"></span>OTHER</span>';
      html+='</div>';
    }
    html+='</div></div>';

    // ── Section 3: Category Distribution ──
    var cats={};
    usage.forEach(function(u){
      var cat=u.category||u.app_category||'other';
      if(!cats[cat])cats[cat]={time:0,apps:[]};
      cats[cat].time+=u.total_duration_sec||0;
      cats[cat].apps.push(u.app);
    });
    var catKeys=Object.keys(cats).sort(function(a,b){return cats[b].time-cats[a].time});
    if(catKeys.length>0){
      var catColors=['var(--primary)','var(--secondary)','var(--accent-purple)','#FF9F45','var(--text-inactive)'];
      html+='<div style="margin-bottom:16px">';
      html+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding:0 4px">';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;font-weight:700">CATEGORY BREAKDOWN</span>';
      html+='</div>';
      html+='<div style="border:1px solid var(--border);background:var(--surface);padding:12px">';
      html+='<div style="height:12px;display:flex;overflow:hidden;border-radius:2px;margin-bottom:12px">';
      var catTotal=catKeys.reduce(function(acc,k){return acc+cats[k].time},0)||1;
      catKeys.forEach(function(ck,ci){
        var pct=Math.round((cats[ck].time/catTotal)*100);
        if(pct>0){
          html+='<div style="height:100%;width:'+pct+'%;background:'+catColors[ci%catColors.length]+'" title="'+esc(ck)+' '+pct+'%"></div>';
        }
      });
      html+='</div>';
      html+='<div style="display:flex;flex-wrap:wrap;gap:12px">';
      catKeys.forEach(function(ck,ci){
        var min=Math.round(cats[ck].time/60);
        var label=min>=60?Math.floor(min/60)+'H '+min%60+'M':min+'M';
        html+='<div style="display:flex;align-items:center;gap:6px">';
        html+='<span style="width:8px;height:8px;border-radius:2px;background:'+catColors[ci%catColors.length]+';display:inline-block"></span>';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;text-transform:uppercase;color:var(--text)">'+esc(ck)+' ('+label+')</span>';
        html+='</div>';
      });
      html+='</div>';
      html+='</div></div>';
    }

    // ── Section 4: App Load Metrics ──
    var totalSec=s.total_screen_time_sec||1;
    var sortedUsage=usage.slice().sort(function(a,b){return b.total_duration_sec-a.total_duration_sec});
    if(sortedUsage.length>0){
      var SHOW_COUNT=5;
      html+='<div style="margin-bottom:16px">';
      html+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding:0 4px">';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;font-weight:700">APPLICATION USAGE BREAKDOWN</span>';
      html+='</div>';
      html+='<div style="border:1px solid var(--border);background:var(--surface);overflow:hidden">';
      var visibleApps=sortedUsage.slice(0,SHOW_COUNT);
      visibleApps.forEach(function(u,idx){
        var durMin=Math.round(u.total_duration_sec/60);
        var durLabel=durMin>=60?Math.floor(durMin/60)+'H '+durMin%60+'M':durMin+'M';
        var pct=Math.round((u.total_duration_sec/totalSec)*100);
        var color=pct>30?'var(--primary)':pct>15?'var(--secondary)':'var(--text)';
        var iconTag=u.package?'<img src="/app-icon?package='+encodeURIComponent(u.package)+'" style="width:20px;height:20px;border-radius:4px;object-fit:contain;flex-shrink:0;background:rgba(255,255,255,0.06)" onerror="this.style.display=\'none\'">':'';
        html+='<div style="padding:10px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border)'+(idx>=visibleApps.length-1?';border-bottom:none':'')+'">';
        html+='<div style="display:flex;align-items:center;gap:10px;overflow:hidden">'+iconTag+'<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;text-transform:uppercase;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(u.app)+'</span></div>';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;color:'+color+';flex-shrink:0">'+durLabel+'</span>';
        html+='</div>';
      });
      if(sortedUsage.length>SHOW_COUNT){
        html+='<div id="appUsageMore" style="display:none">';
        var moreApps=sortedUsage.slice(SHOW_COUNT);
        moreApps.forEach(function(u,idx){
          var durMin=Math.round(u.total_duration_sec/60);
          var durLabel=durMin>=60?Math.floor(durMin/60)+'H '+durMin%60+'M':durMin+'M';
          var pct=Math.round((u.total_duration_sec/totalSec)*100);
          var color=pct>30?'var(--primary)':pct>15?'var(--secondary)':'var(--text)';
          var iconTag=u.package?'<img src="/app-icon?package='+encodeURIComponent(u.package)+'" style="width:20px;height:20px;border-radius:4px;object-fit:contain;flex-shrink:0;background:rgba(255,255,255,0.06)" onerror="this.style.display=\'none\'">':'';
          html+='<div style="padding:10px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border)'+(idx>=moreApps.length-1?';border-bottom:none':'')+'">';
          html+='<div style="display:flex;align-items:center;gap:10px;overflow:hidden">'+iconTag+'<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;text-transform:uppercase;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(u.app)+'</span></div>';
          html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;color:'+color+';flex-shrink:0">'+durLabel+'</span>';
          html+='</div>';
        });
        html+='</div>';
        html+='<div onclick="var el=document.getElementById(\'appUsageMore\');el.style.display=el.style.display===\'none\'?\'block\':\'none\';this.textContent=el.style.display===\'none\'?\'[+] SHOW ALL APPS\':\'[-] HIDE APPS\'" style="padding:10px;text-align:center;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;cursor:pointer;transition:color 0.15s" onmouseover="this.style.color=\'var(--text)\'" onmouseout="this.style.color=\'var(--text-inactive)\'">[+] SHOW ALL APPS</div>';
      }
      html+='</div></div>';
    }

    // ── Section 5: Session Log ──
    if(timeline.length>0){
      var sortedAsc=timeline.slice().sort(function(a,b){return(a.timestamp_ms||0)-(b.timestamp_ms||0)});
      var sessions=[];
      var open=null;
      sortedAsc.forEach(function(ev){
        if(ev.event==='START'){
          open={app:ev.app,time:ev.time,startTime:ev.time,startMs:ev.timestamp_ms||0};
        }else if(ev.event==='END'&&open&&ev.app===open.app){
          open.endTime=ev.time;open.endMs=ev.timestamp_ms||0;
          open.durSec=Math.max(Math.round((open.endMs-open.startMs)/1000),0);
          sessions.push(open);
          open=null;
        }
      });
      sessions.sort(function(a,b){return(b.startMs||0)-(a.startMs||0)});
      if(sessions.length>0){
        var maxSessionSec=Math.max.apply(null,sessions.map(function(s){return s.durSec||0}))||1;
        window._stSessionsData=sessions;
        window._stCurrentPage=1;
        window._stMaxSessionSec=maxSessionSec;
        html+='<div style="margin-bottom:24px">';
        html+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding:0 4px">';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;font-weight:700">ACTIVE SESSIONS</span>';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive)">'+sessions.length+' SESSIONS</span>';
        html+='</div>';
        html+='<div id="screenTimeSessionsList" style="border:1px solid var(--border);background:var(--surface);padding:12px"></div>';
        html+='</div>';
      }
    }

    container.innerHTML=html;
    if(document.getElementById('screenTimeSessionsList')) renderScreenTimeSessionsPage(1);
  }catch(e){
    container.innerHTML='<div style="color:var(--red);text-align:center;padding:20px;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:13px">Failed to load<br><span style="font-size:11px;color:var(--text-inactive)">'+esc(e.message||e)+'</span></div>';
  }
}

window._stSessionsData=[];
window._stCurrentPage=1;
window._stPageSize=20;
window._stMaxSessionSec=1;

window.renderScreenTimeSessionsPage=function(page){
  var sessions=window._stSessionsData||[];
  if(!sessions.length)return;
  var total=sessions.length;
  var pageSize=window._stPageSize||20;
  var totalPages=Math.ceil(total/pageSize)||1;
  page=Math.max(1,Math.min(page,totalPages));
  window._stCurrentPage=page;

  var startIdx=(page-1)*pageSize;
  var endIdx=Math.min(startIdx+pageSize,total);
  var pageItems=sessions.slice(startIdx,endIdx);
  var maxSessionSec=window._stMaxSessionSec||1;
  var sessionColors=['var(--primary)','var(--secondary)','var(--accent-purple)','#FF9F45','var(--yellow)'];

  var listEl=document.getElementById('screenTimeSessionsList');
  if(!listEl)return;

  var h='';
  pageItems.forEach(function(s,idx){
    var durMin=Math.round(s.durSec/60);
    var durLabel=durMin>=60?(Math.floor(durMin/60)+'H '+(durMin%60)+'M'):(durMin+'M');
    var barPct=maxSessionSec>0?Math.min(Math.round((s.durSec/maxSessionSec)*100),100):0;
    var color=sessionColors[(startIdx+idx)%sessionColors.length];
    var isLong=s.durSec>1800;
    var timeRange=s.time||'';
    if(s.startTime&&s.endTime&&s.startTime!==s.endTime){
      timeRange=s.startTime+' — '+s.endTime;
    }
    h+='<div style="margin-bottom:'+(idx<pageItems.length-1?'12px':'0')+'">';
    h+='  <div style="display:flex;justify-content:space-between;align-items:center;font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;text-transform:uppercase;margin-bottom:4px">';
    h+='    <div style="display:flex;gap:8px;align-items:center;overflow:hidden;max-width:75%">';
    h+='      <span style="color:var(--text-inactive);font-size:9px;white-space:nowrap">['+esc(timeRange)+']</span>';
    h+='      <span style="color:var(--text);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(s.app||'')+'</span>';
    h+='    </div>';
    h+='    <span style="font-family:\'JetBrains Mono\',monospace;font-size:11px;font-weight:700;color:'+(isLong?'var(--primary)':'var(--text)')+'">'+durLabel+'</span>';
    h+='  </div>';
    h+='  <div style="width:100%;height:3px;background:var(--border);border-radius:2px;overflow:hidden">';
    h+='    <div style="height:100%;width:'+barPct+'%;background:'+color+';border-radius:2px"></div>';
    h+='  </div>';
    h+='</div>';
  });

  // Pagination Controls
  h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:10px;border-top:1px solid var(--border);user-select:none">';
  h+='  <button class="btn btn-sm" onclick="renderScreenTimeSessionsPage('+(page-1)+')" '+(page<=1?'disabled style="opacity:0.35;cursor:not-allowed"':'style="cursor:pointer"')+'>&laquo; PREV</button>';
  h+='  <div style="text-align:center">';
  h+='    <span style="font-family:\'Space Mono\',monospace;font-size:9.5px;font-weight:700;color:var(--text)">PAGE '+page+' / '+totalPages+'</span>';
  h+='    <span style="display:block;font-family:\'JetBrains Mono\',monospace;font-size:8.5px;color:var(--text-inactive)">('+(startIdx+1)+'–'+endIdx+' of '+total+')</span>';
  h+='  </div>';
  h+='  <button class="btn btn-sm" onclick="renderScreenTimeSessionsPage('+(page+1)+')" '+(page>=totalPages?'disabled style="opacity:0.35;cursor:not-allowed"':'style="cursor:pointer"')+'>NEXT &raquo;</button>';
  h+='</div>';

  listEl.innerHTML=h;
};
function closeAppUsagePage(){document.getElementById('mainFab').style.display='flex';document.getElementById('appUsagePage').classList.remove('show')}

// ─── Notifications ────────────────────────────────────────────────────────────

function requestNotifications(){
  if('Notification' in window && Notification.permission==='default'){
    Notification.requestPermission();
  }
}
requestNotifications();

// ─── Gita Tracker Sidebar ─────────────────────────────────────────────────────

var gitaTrackerData=null;

async function openGitaSidebar(){
  if(!document.getElementById('gitaPage').classList.contains('show'))return;
  document.getElementById('gitaSidebar').classList.add('open');
  document.getElementById('gitaSidebarOverlay').classList.add('show');
  if(typeof ReaderEngine !== 'undefined' && ReaderEngine._activeBookId !== 'bhagavad_gita'){
    ReaderEngine.renderSidebar();
  } else {
    var titleEl = document.getElementById('readerSidebarTitle');
    if(titleEl) titleEl.textContent = 'GITA TRACKER';
    await loadGitaTracker();
  }
}
function closeGitaSidebar(){
  document.getElementById('gitaSidebar').classList.remove('open');
  document.getElementById('gitaSidebarOverlay').classList.remove('show');
}

async function loadVerseFromSidebar(verseId){
  try{
    var r=await fetch(BASE+'/gita/verse/'+verseId);
    var j=await r.json();
    if(j.shloka||j.english_sivananda||j.hindi_translation){
      j.already_read=gitaTrackerData?.verses?.find(function(v){return v.id===verseId})?.read||false;
      var readIds=gitaTrackerData?.verses?.filter(function(v){return v.read}).length||0;
      var total=gitaTrackerData?.total||701;
      j.total_verses=total;
      j.read_count=readIds;
      j.unread_count=total-readIds;
      renderGita(j);
      closeGitaSidebar();
      openGitaPage();
    }else{
      toast('Verse data not found');
    }
  }catch(e){toast('Failed to load verse')}
}

async function loadGitaTracker(){
  var container=document.getElementById('gitaTrackerList');
  if(gitaTrackerData){renderGitaTracker(gitaTrackerData);return}
  try{
    var r=await fetch(BASE+'/gita/all');
    var j=await r.json();
    gitaTrackerData=j;
    renderGitaTracker(j);
  }catch(e){
    container.innerHTML='<div style="color:var(--red);font-size:13px;text-align:center;padding:10px">Failed to load</div>';
  }
}

function toggleChVerses(chNum){
  var el=document.getElementById('chVerses_'+chNum);
  var arrow=document.getElementById('chArrow_'+chNum);
  if(!el)return;
  if(el.classList.contains('open')){el.classList.remove('open');if(arrow)arrow.style.transform='rotate(0deg)'}
  else{el.classList.add('open');if(arrow)arrow.style.transform='rotate(90deg)'}
}
function renderGitaTracker(data){
  var container=document.getElementById('gitaTrackerList');
  var chapters=data.chapters||[];
  var readCount=data.read_count||0;
  var total=data.total||701;
  document.getElementById('gitaTrackerProgress').innerHTML=
    '<span style="color:var(--secondary)">'+readCount+'</span><span style="color:var(--text-inactive)">/'+total+' read</span>'+
    '<span style="margin-left:8px;color:var(--text-inactive)">('+(total-readCount)+' remaining)</span>';
  var firstUnread=null;
  for(var ci=0;ci<chapters.length;ci++){
    var chVerses=chapters[ci].verses||[];
    for(var vi=0;vi<chVerses.length;vi++){
      if(!chVerses[vi].read){firstUnread=chapters[ci].number;break;}
    }
    if(firstUnread)break;
  }
  var html='';
  chapters.forEach(function(ch){
    var chRead=ch.read||0;
    var chTotal=ch.total||0;
    var isOpen=ch.number==firstUnread;
    var chPct=chTotal>0?Math.round((chRead/chTotal)*100):0;
    html+='<div class="gita-chapter-block">';
    html+='<div class="ch-header" onclick="toggleChVerses('+ch.number+')">';
    html+='<span id="chArrow_'+ch.number+'" style="display:inline-block;transition:transform 0.2s;font-size:10px;color:var(--text-inactive);'+(isOpen?'transform:rotate(90deg)':'')+'">&#9654;</span>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);min-width:18px">'+ch.number+'</span>';
    html+='<div style="flex:1;min-width:0">';
    html+='<div style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+(ch.name||'Chapter '+ch.number)+'</div>';
    html+='<div style="display:flex;align-items:center;gap:6px;margin-top:4px">';
    html+='<div style="flex:1;height:2px;background:var(--border);overflow:hidden;border-radius:1px"><div style="height:100%;width:'+chPct+'%;background:'+(chPct===100?'var(--secondary)':'var(--primary)')+';border-radius:1px"></div></div>';
    html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);white-space:nowrap">'+chRead+'/'+chTotal+'</span>';
    html+='</div></div>';
    html+='</div>';
    html+='<div class="ch-verses'+(isOpen?' open':'')+'" id="chVerses_'+ch.number+'">';
    var verses=ch.verses||[];
    verses.forEach(function(v){
      var readColor=v.read?'var(--text-inactive)':'var(--text)';
      var opacity=v.read?'0.45':'1';
      html+='<div data-verse-id="'+esc(v.id)+'" style="display:flex;align-items:flex-start;gap:8px;padding:8px 4px;border-bottom:1px solid rgba(44,44,44,0.4);cursor:pointer;opacity:'+opacity+';transition:opacity 0.15s" onclick="loadVerseFromSidebar(\''+esc(v.id)+'\')">';
      html+='<input type="checkbox" '+(v.read?'checked':'')+' onclick="event.stopPropagation();toggleVerseRead(\''+esc(v.id)+'\',this.checked)" style="width:12px;height:12px;margin-top:2px;cursor:pointer;flex-shrink:0;accent-color:var(--primary)">';
      html+='<div style="flex:1;min-width:0">';
      html+='<div style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--primary);margin-bottom:2px">'+v.id+'</div>';
      if(v.shloka_preview){
        html+='<div style="font-size:11px;color:'+readColor+';line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-family:\'Marcellus\',serif">'+esc(v.shloka_preview)+'</div>';
      }
      html+='</div>';
      html+='</div>';
    });
    html+='</div></div>';
  });
  container.innerHTML=html;
}

async function toggleVerseRead(verseId, isRead){
  try{
    var row=event&&event.target?event.target.closest('[data-verse-id]'):null;
    if(row){row.style.opacity=isRead?'0.45':'1'}
    if(isRead){
      await fetch(BASE+'/gita/read',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({verse_id:verseId})});
    }else{
      await fetch(BASE+'/gita/unread?verse_id='+verseId,{method:'POST'});
    }
    gitaTrackerData=null;
    await loadGitaTracker();
    loadDashboard();
  }catch(e){toast('Error')}
}

// ─── Running Page ─────────────────────────────────────────────────────────────

var RUN_TYPE_COLORS={easy:'var(--green)',tempo:'var(--yellow)',interval:'var(--red)',long:'var(--accent2)',race:'var(--accent)'};
var RUN_TYPE_LABELS={easy:'Easy',tempo:'Tempo',interval:'Interval',long:'Long',race:'Race'};
var _runWeeks=4;

async function openRunningPage(){
  document.getElementById('mainFab').style.display='none';_pushOv();
  _runWeeks=4;
  var el=document.getElementById('runningPage');el.scrollTop=0;el.classList.add('show');
  var c=document.getElementById('runningContent');
  if(typeof renderSkeleton==='function') c.innerHTML=renderSkeleton('grid',4)+renderSkeleton('list',4);
  else c.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px;">Loading...</div>';
  await _renderRunPage(c);
}

function setRunWeeks(n){
  _runWeeks=n;
  var c=document.getElementById('runningContent');
  if(typeof renderSkeleton==='function') c.innerHTML=renderSkeleton('grid',4)+renderSkeleton('list',4);
  else c.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px;">Loading...</div>';
  _renderRunPage(c);
}

async function _renderRunPage(c){
  try{
    var r=await fetch(BASE+'/running/stats?weeks='+_runWeeks);
    if(!r.ok)throw new Error('HTTP '+r.status+' '+r.statusText);
    var j=await r.json();
    if(!j.weekly)throw new Error('Missing weekly field');
    var wk=j.weekly;
    var mo=j.monthly;
    var period=j.period;
    var daily=j.daily||[];
    var recent=j.recent_runs||[];
    var html='';

    function fmtTime(sec){
      var h=Math.floor(sec/3600);
      var m=Math.floor((sec%3600)/60);
      var s=sec%60;
      if(h>0)return h+'h '+m+'m '+s+'s';
      return m+'m '+s+'s';
    }
    var RUN_COLORS={easy:'var(--secondary)',tempo:'var(--accent-orange)',interval:'var(--red)',long:'var(--primary)',race:'var(--red)'};
    var RUN_LABELS={easy:'EASY',tempo:'TEMPO',interval:'INTERVAL',long:'LONG',race:'RACE'};

    html+='<button onclick="closeRunningPage();openModal(\'run\')" style="width:100%;height:44px;border:1px solid var(--border);background:var(--surface);display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:background 0.15s;margin-bottom:16px"><span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;color:var(--text);text-transform:uppercase;letter-spacing:0.15em">+ LOG RUN</span></button>';

    html+='<div style="display:flex;gap:4px;margin-bottom:16px">';
    var _filters=[{v:1,l:'1W'},{v:2,l:'2W'},{v:4,l:'1M'},{v:12,l:'3M'}];
    _filters.forEach(function(f){
      var sel=f.v===_runWeeks;
      html+='<button onclick="setRunWeeks('+f.v+')" style="flex:1;height:30px;border:1px solid '+(sel?'var(--primary)':'var(--border)')+';background:'+(sel?'var(--primary)':'var(--surface)')+';color:'+(sel?'var(--bg)':'var(--text)')+';cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.1em;border-radius:4px">'+f.l+'</button>';
    });
    html+='</div>';

    var pRuns = period ? (period.runs || 0) : (wk.runs || 0);
    var pKm = period ? (period.km || 0) : (wk.km || 0);
    var pSec = period ? (period.seconds || 0) : (wk.seconds || 0);
    var pPace = j.avg_pace || '--:--';

    html+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);margin-bottom:8px">';
    var stats=[
      {label:'DISTANCE ('+_runWeeks+'W)',value:pKm+'<span style="font-size:11px;margin-left:3px;color:var(--text-inactive)">KM</span>',color:'var(--primary)'},
      {label:'RUNS ('+_runWeeks+'W)',value:String(pRuns).padStart(2,'0'),color:'var(--text)'},
      {label:'AVG PACE',value:pPace+'<span style="font-size:11px;margin-left:3px;color:var(--text-inactive)">/KM</span>',color:'var(--secondary)'},
      {label:'TOTAL TIME',value:fmtTime(pSec),color:'var(--accent-orange)'}
    ];
    stats.forEach(function(s){
      html+='<div style="background:var(--surface);padding:10px">';
      html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;display:block;margin-bottom:6px">'+s.label+'</span>';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:20px;font-weight:500;color:'+s.color+'">'+s.value+'</span>';
      html+='</div>';
    });
    html+='</div>';

    html+='<div style="border:1px solid var(--border);background:var(--surface);padding:8px 12px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.05em">';
    html+='<span>THIS WEEK: <b style="color:var(--primary)">'+(wk.km||0)+' KM</b> ('+(wk.runs||0)+' runs)</span>';
    html+='<span>THIS MONTH: <b style="color:var(--primary)">'+(mo.km||0)+' KM</b> ('+(mo.runs||0)+' runs)</span>';
    html+='</div>';

    if(daily.length>0){
      html+='<div style="overflow-x:auto;margin-bottom:24px;border:1px solid var(--border)">';
      html+='<table style="width:100%;border-collapse:collapse;font-size:11px">';
      html+='<thead style="background:var(--surface-container-low)"><tr style="color:var(--text-inactive);text-align:left;border-bottom:1px solid var(--border)">';
      html+='<th style="padding:8px 4px;text-transform:uppercase;font-weight:500">DATE</th>';
      html+='<th style="padding:8px 4px;text-transform:uppercase;font-weight:500">RUNS</th>';
      html+='<th style="padding:8px 4px;text-transform:uppercase;font-weight:500;text-align:right">KM</th>';
      html+='<th style="padding:8px 4px;text-transform:uppercase;font-weight:500;text-align:right">TIME</th>';
      html+='<th style="padding:8px 4px;text-transform:uppercase;font-weight:500;text-align:right">PACE</th>';
      html+='</tr></thead><tbody>';
      daily.forEach(function(d){
        var dayName=new Date(d.date+'T00:00:00').toLocaleDateString('en-US',{weekday:'short'}).toUpperCase();
        html+='<tr style="border-bottom:1px solid var(--border);color:var(--text)">';
        html+='<td style="padding:8px 4px;font-family:\'Space Mono\',\'Mono\',monospace">'+dayName+' '+d.date.slice(5).replace(/-/g,'.')+'</td>';
        html+='<td style="padding:8px 4px;font-family:\'JetBrains Mono\',\'Mono\',monospace">'+d.count+'</td>';
        html+='<td style="padding:8px 4px;text-align:right;font-family:\'JetBrains Mono\',\'Mono\',monospace">'+d.total_km+'</td>';
        html+='<td style="padding:8px 4px;text-align:right;font-family:\'JetBrains Mono\',\'Mono\',monospace">'+fmtTime(d.total_sec)+'</td>';
        html+='<td style="padding:8px 4px;text-align:right;color:var(--primary);font-family:\'JetBrains Mono\',\'Mono\',monospace">'+d.avg_pace+'</td>';
        html+='</tr>';
      });
      html+='</tbody></table></div>';
    }

    if(recent.length>0){
      html+='<div style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px">RECENT RUNS</div>';
      html+='<div style="display:flex;flex-direction:column;gap:8px">';
      recent.forEach(function(run){
        var color=RUN_COLORS[run.run_type]||'var(--text-inactive)';
        var typeLabel=RUN_LABELS[run.run_type]||(run.run_type||'').toUpperCase();
        var runDate=run.ts?run.ts.slice(0,10).replace(/-/g,'.')+' \u00b7 '+run.ts.slice(11,16):'';
        html+='<div style="background:var(--surface);border:1px solid var(--border);border-left:4px solid '+color+';padding:8px;display:flex;justify-content:space-between;align-items:center;transition:background 0.15s">';
        html+='<div>';
        html+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;font-weight:600;color:var(--text)">'+run.distance_km+' KM</span>';
        html+='<span style="font-size:10px;padding:2px 8px;border:1px solid '+color+';color:'+color+';background:'+color+'/10;border-radius:9999px;text-transform:uppercase;font-family:\'Space Mono\',\'Mono\',monospace;font-weight:500">'+typeLabel+'</span>';
        html+='</div>';
        html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em">'+runDate+'</span>';
        html+='</div>';
        html+='<div style="text-align:right">';
        html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;font-weight:500;color:var(--text);display:block">'+fmtTime(run.duration_sec||0)+'</span>';
        html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase">'+run.pace+' /KM</span>';
        html+='</div>';
        html+='</div>';
      });
      html+='</div>';
    }

    if(recent.length===0&&daily.length===0){
      html+='<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 20px;opacity:0.3"><span class="material-symbols-outlined" style="font-size:40px;margin-bottom:12px">directions_run</span><span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.3em">NO RUNS LOGGED YET</span></div>';
    }

    c.innerHTML=html;
  }catch(e){
    c.innerHTML='<div style="color:var(--red);text-align:center;padding:20px">Failed to load running stats<br><span style="font-size:11px;color:var(--muted)">'+esc(e.message||e)+'</span></div>';
  }
}
function closeRunningPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('runningPage').classList.remove('show')}

// ─── Pin Functions ──────────────────────────────────────────────────────────

async function pinTask(id,pinned,e,cb){
  if(e)e.stopPropagation();
  try{await fetch(BASE+'/task/'+id+'/pin?pinned='+pinned,{method:'POST'});loadDashboard();if(typeof cb==='function')cb();}catch(e){}
}

async function pinThought(id,pinned){
  try{await fetch(BASE+'/thought/pin?thought_id='+id+'&pinned='+pinned,{method:'POST'});openThoughtsPage();loadDashboard();loadDayTrackerPreview()}catch(e){}
}

// ─── Time Tracker ────────────────────────────────────────────────────────────

function openDayTrackerPage(){
  var hasTracker = (window._ALL_INSTALLED_PLUGINS || []).some(function(p){ return p.id === 'com.v07.timetracker' && p.enabled !== false; });
  if(hasTracker && typeof openPluginPage === 'function'){
    openPluginPage('com.v07.timetracker');
    return;
  }
  document.getElementById('mainFab').style.display='none';_pushOv();
  var el=document.getElementById('dayTrackerPage');el.scrollTop=0;el.classList.add('show');
  loadDayTrackerEntries();
}
function closeDayTrackerPage(){document.getElementById('mainFab').style.display='flex';document.getElementById('dayTrackerPage').classList.remove('show')}

function _hourOpts(selected){
  var h=selected!=null?parseInt(selected):new Date().getHours();
  var opts='';for(var i=0;i<24;i++){
    var v=i<10?'0'+i:''+i;
    opts+='<option value="'+v+'"'+(i==h?' selected':'')+'>'+v+':00</option>';
  }
  return opts;
}

function _timeDiffLabel(dateStr,hour){
  var now=new Date();
  var h=(hour!=null&&hour!=='')?parseInt(hour):0;
  var entry=new Date(dateStr+'T'+(h<10?'0':'')+h+':00:00');
  var diffMs=entry-now;
  var absMs=Math.abs(diffMs);
  var sign=diffMs>=0?1:-1;
  var totalHours=Math.floor(absMs/3600000);
  var diffDays=Math.floor(totalHours/24);
  var remHours=totalHours%24;
  var label,dColor;
  if(sign>0){
    if(diffDays>0)label=diffDays+'d '+remHours+'h left';
    else if(totalHours>0)label=totalHours+'h left';
    else label='Now';
    dColor='var(--accent2)';
  }else if(sign<0){
    if(diffDays>0)label=diffDays+'d '+remHours+'h ago';
    else if(totalHours>0)label=totalHours+'h ago';
    else label='Today';
    dColor='var(--muted)';
  }else{
    label='Now';dColor='var(--green)';
  }
  return{label:label,dColor:dColor};
}

var _dtMarqueeIdx=0;var _dtMarqueeTimer=null;
async function loadDayTrackerPreview(){
  try{
    var r=await fetch(BASE+'/daytracker');
    var j=await r.json();
    var entries=j.entries||[];
    var pinned=entries.filter(function(e){return e.pinned===true||e.pinned==='true'}).sort(function(a,b){return(a.date||'').localeCompare(b.date||'')});
    var carousel=document.getElementById('dayTrackerCarousel');
    var countEl=document.getElementById('dayTrackerCount');
    if(countEl)countEl.textContent=pinned.length>0?String(pinned.length).padStart(2,'0')+' PINNED':'';
    if(!carousel)return;
    if(pinned.length===0){
      carousel.innerHTML='<div style="flex-shrink:0;scroll-snap-align:start;border:1px solid var(--border);background:var(--surface-container);padding:12px;display:flex;flex-direction:column;gap:8px;border-radius:8px;width:160px;cursor:pointer" onclick="openDayTrackerPage()"><div style="display:flex;justify-content:space-between;align-items:center"><span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.05em">NO PINNED ITEMS</span></div><div style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:12px;color:var(--text-inactive)">Pin items here</div></div>';
    }else{
      var icons=['flight_takeoff','cake','event_busy','school','work','favorite'];
      var bcolors=[{c:'rgba(167,200,255,0.2)',t:'var(--primary)'},{c:'rgba(141,108,255,0.3)',t:'var(--accent)'},{c:'rgba(244,211,94,0.3)',t:'var(--yellow)'},{c:'rgba(77,224,134,0.2)',t:'var(--green)'},{c:'rgba(255,159,69,0.3)',t:'var(--orange)'},{c:'rgba(141,108,255,0.3)',t:'var(--accent)'}];
      carousel.innerHTML=pinned.map(function(e,i){
        var td=_timeDiffLabel(e.date,e.hour);
        var bc=bcolors[i%bcolors.length];
        var catIcon=DT_ICONS[e.category]||DT_ICONS['default'];
        var catColor=DT_COLORS[e.category]||DT_COLORS['default'];
        var subLabel='Scheduled';
        if(td.dColor==='var(--muted)')subLabel='Past';
        else if(td.label.indexOf('d')>0)subLabel='Upcoming';
        return '<div style="flex-shrink:0;scroll-snap-align:start;border:1px solid var(--border);border-color:'+bc.c+';background:var(--surface-container);padding:12px;display:flex;flex-direction:column;gap:8px;border-radius:8px;width:160px;cursor:pointer" onclick="openDayTrackerPage()">'+
          '<div style="display:flex;justify-content:space-between;align-items:center">'+
            '<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.05em">'+esc((e.title||e.date).toUpperCase()).slice(0,10)+'</span>'+
            _dbIconSvg(catIcon,12,catColor)+
          '</div>'+
          '<div style="display:flex;align-items:baseline;gap:8px">'+
            '<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;color:var(--text);font-variant-numeric:tabular-nums">'+td.label+'</span>'+
            '<span style="font-size:8px;color:'+bc.t+';text-transform:uppercase;font-weight:bold;letter-spacing:-0.02em">'+subLabel+'</span>'+
          '</div>'+
        '</div>';
      }).join('');
    }
  }catch(e){}
}

var _dtFilter='all';
var DT_CATEGORIES=[
  {key:'all',label:'ALL',color:'var(--primary)'},
  {key:'travel',label:'TRAVEL',color:'var(--primary)'},
  {key:'birthday',label:'BIRTHDAY',color:'var(--accent)'},
  {key:'assignment',label:'ASSIGNMENT',color:'var(--secondary)'},
  {key:'others',label:'OTHERS',color:'var(--text-inactive)'}
];
var DT_ICONS={travel:'flight_takeoff',birthday:'cake',assignment:'menu_book',others:'folder',default:'event'};
var DT_COLORS={travel:'var(--primary)',birthday:'var(--accent)',assignment:'var(--secondary)',others:'var(--text-inactive)',default:'var(--primary)'};

function renderDtFilters(){
  var c=document.getElementById('dayTrackerFilters');
  c.innerHTML=DT_CATEGORIES.map(function(f){
    var active=_dtFilter===f.key;
    var iconName=DT_ICONS[f.key];
    var iconHtml='';
    if(iconName&&_iconPaths[iconName]){
      iconHtml='<svg viewBox="0 -960 960 960" width="12" height="12" fill="'+(active?f.color:'var(--text-inactive)')+'" style="flex-shrink:0"><path d="'+_iconPaths[iconName]+'"/></svg>';
    }
    return '<span class="chip'+(active?' selected':'')+'" style="color:'+f.color+(active?';border-color:'+f.color:'')+'" onclick="setDtFilter(\''+f.key+'\')">'+iconHtml+f.label+'</span>';
  }).join('');
}
function setDtFilter(f){_dtFilter=f;renderDtFilters();loadDayTrackerEntries()}

async function loadDayTrackerEntries(){
  renderDtFilters();
  var c=document.getElementById('dayTrackerContent');
  if(typeof renderSkeleton==='function') c.innerHTML=renderSkeleton('cards',3);
  else c.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px">Loading...</div>';
  try{
    var r=await fetch(BASE+'/daytracker');
    var j=await r.json();
    var entries=j.entries||[];
    if(entries.length===0){
      c.innerHTML='<div style="color:var(--muted);text-align:center;padding:20px">No dates tracked yet</div>';
      return;
    }
    if(_dtFilter!=='all'){
      entries=entries.filter(function(e){
        return(e.category||'others').toLowerCase()===_dtFilter;
      });
    }
    function _hourTint(h){
      if(h==null||h==='')return '';
      var hue=((parseInt(h)+6)*10)%360;
      return ';background:hsla('+hue+',40%,50%,0.06)';
    }
    entries.sort(function(a,b){return(b.pinned?'1':'0').localeCompare(a.pinned?'1':'0')||(b.date||'').localeCompare(a.date||'')});
    var html='<div style="display:flex;flex-direction:column;gap:8px">';
    entries.forEach(function(e){
      var td=_timeDiffLabel(e.date,e.hour);
      var cat=(e.category||'others').toLowerCase();
      var iconName=DT_ICONS[cat]||DT_ICONS.default;
      var color=DT_COLORS[cat]||DT_COLORS.default;
      var svgPath=_iconPaths[iconName];
      var iconHtml=svgPath?'<svg viewBox="0 -960 960 960" width="14" height="14" fill="'+color+'"><path d="'+svgPath+'"/></svg>':'<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:'+color+';text-transform:uppercase">'+iconName.replace(/_/g,' ')+'</span>';
      var catLabel=cat.toUpperCase();
      var dateDisplay=e.date+(e.hour!=null?' '+e.hour+':00':'');
      html+='<div style="border:1px solid var(--border);background:var(--surface-container-low);padding:12px;transition:border-color 0.2s'+_hourTint(e.hour)+'">';
      html+='<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">';
      html+='<div style="display:flex;align-items:center;gap:8px">';
      html+=iconHtml;
      html+='<span style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:10px;color:'+color+';text-transform:uppercase">'+catLabel+'</span>';
      html+='</div>';
      html+='<div style="display:flex;gap:8px;align-items:center">';
      html+='<span onclick="toggleDayTrackerPin(\''+e.id+'\','+(e.pinned?'false':'true')+')" style="cursor:pointer;font-size:14px;color:'+(e.pinned?'var(--yellow)':'var(--text-inactive)')+'">'+(e.pinned?'\uD83D\uDCCC':'\u25CB')+'</span>';
      html+='<span onclick="editDayTrackerEntry(\''+e.id+'\',\''+esc(e.title||'')+'\',\''+e.date+'\','+(e.hour!=null?e.hour:'null')+',\''+cat+'\')" style="cursor:pointer;color:var(--text-inactive);transition:color 0.15s"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>';
      html+='<span onclick="deleteDayTrackerEntry(\''+e.id+'\')" style="cursor:pointer;color:var(--text-inactive);transition:color 0.15s"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>';
      html+='</div></div>';
      html+='<div style="font-family:\'Space Mono\',\'Mono\',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:2px">'+esc(e.title||'Untitled')+'</div>';
      html+='<div style="display:flex;justify-content:space-between;align-items:baseline">';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:10px;color:var(--text-inactive)">'+dateDisplay+'</span>';
      html+='<span style="font-family:\'JetBrains Mono\',\'Mono\',monospace;font-size:18px;color:'+td.dColor+'">'+td.label+'</span>';
      html+='</div></div>';
    });
    html+='</div>';
    c.innerHTML=html;
  }catch(e){
    c.innerHTML='<div style="color:var(--red);text-align:center;padding:20px">Failed to load</div>';
  }
}

function showAddDayTrackerModal(){
  var overlay=document.getElementById('modalOverlay');
  document.getElementById('modalTitle').textContent='Add Date';
  var catHtml='<label>Category</label><div style="display:flex;gap:8px;margin-bottom:8px">'+
    '<div class="dt-cat-btn" data-cat="travel" onclick="selectDtCat(this,\'travel\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">✈</span>TRAVEL</div>'+
    '<div class="dt-cat-btn" data-cat="birthday" onclick="selectDtCat(this,\'birthday\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">🎂</span>BIRTHDAY</div>'+
    '<div class="dt-cat-btn" data-cat="assignment" onclick="selectDtCat(this,\'assignment\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">📚</span>ASSIGNMENT</div>'+
    '<div class="dt-cat-btn" data-cat="others" onclick="selectDtCat(this,\'others\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">📁</span>OTHERS</div>'+
    '</div>';
  document.getElementById('modalFields').innerHTML=
    catHtml+
    '<label>Title</label><input id="dtTitle" placeholder="e.g. Birthday, Project Deadline">'+
    '<label>Date</label><input type="date" id="dtDate" value="'+localDate()+'">'+
    '<label>Hour</label><select id="dtHour">'+_hourOpts(new Date().getHours())+'</select>';
  _dtModalCat='others';
  var defBtn=document.querySelector('.dt-cat-btn[data-cat="others"]');
  if(defBtn)selectDtCat(defBtn,'others');
  document.getElementById('modalSubmit').onclick=async function(){
    var title=document.getElementById('dtTitle').value;
    var date=document.getElementById('dtDate').value;
    var hour=document.getElementById('dtHour').value;
    if(!date){toast('Date required');return}
    await fetch(BASE+'/daytracker',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:title||date,date:date,hour:parseInt(hour),category:_dtModalCat,pinned:false})});
    closeModal();loadDayTrackerEntries();loadDayTrackerPreview();
  };
  overlay.classList.add('show');
}

var _dtModalCat='others';
function selectDtCat(el,cat){
  _dtModalCat=cat;
  var colors={travel:'var(--primary)',birthday:'var(--accent-purple)',assignment:'var(--secondary)',others:'var(--text-inactive)'};
  var bgs={travel:'rgba(167,200,255,0.1)',birthday:'rgba(141,108,255,0.15)',assignment:'rgba(77,224,134,0.1)',others:'transparent'};
  document.querySelectorAll('.dt-cat-btn').forEach(function(b){
    b.style.border='2px solid var(--border)';b.style.color='var(--text-inactive)';b.style.background='transparent';
  });
  el.style.border='2px solid '+colors[cat];el.style.color=colors[cat];el.style.background=bgs[cat];
}

function editDayTrackerEntry(id,oldTitle,oldDate,oldHour,oldCat){
  var overlay=document.getElementById('modalOverlay');
  document.getElementById('modalTitle').textContent='Edit Date';
  var cat=oldCat||'others';
  var catHtml='<label>Category</label><div style="display:flex;gap:8px;margin-bottom:8px">'+
    '<div class="dt-cat-btn" data-cat="travel" onclick="selectDtCat(this,\'travel\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">✈</span>TRAVEL</div>'+
    '<div class="dt-cat-btn" data-cat="birthday" onclick="selectDtCat(this,\'birthday\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">🎂</span>BIRTHDAY</div>'+
    '<div class="dt-cat-btn" data-cat="assignment" onclick="selectDtCat(this,\'assignment\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">📚</span>ASSIGNMENT</div>'+
    '<div class="dt-cat-btn" data-cat="others" onclick="selectDtCat(this,\'others\')" style="flex:1;padding:10px 6px;border:2px solid var(--border);text-align:center;cursor:pointer;font-family:\'Space Mono\',\'Mono\',monospace;font-size:9px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em;transition:all 0.15s;display:flex;flex-direction:column;align-items:center;gap:4px"><span style="font-size:16px">📁</span>OTHERS</div>'+
    '</div>';
  document.getElementById('modalFields').innerHTML=
    catHtml+
    '<label>Title</label><input id="dtTitle" value="'+esc(oldTitle)+'">'+
    '<label>Date</label><input type="date" id="dtDate" value="'+oldDate+'">'+
    '<label>Hour</label><select id="dtHour">'+_hourOpts(oldHour)+'</select>';
  _dtModalCat=cat;
  var targetBtn=document.querySelector('.dt-cat-btn[data-cat="'+cat+'"]');
  if(targetBtn)selectDtCat(targetBtn,cat);
  document.getElementById('modalSubmit').onclick=async function(){
    var title=document.getElementById('dtTitle').value;
    var date=document.getElementById('dtDate').value;
    var hour=document.getElementById('dtHour').value;
    if(!date){toast('Date required');return}
    try{
      await fetch(BASE+'/daytracker',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,title:title,date:date,hour:parseInt(hour),category:_dtModalCat})});
      loadDayTrackerEntries();loadDayTrackerPreview();closeModal();
    }catch(e){toast('Error')}
  };
  overlay.classList.add('show');
}

async function deleteDayTrackerEntry(id){
  if(!confirm('Delete this date?'))return;
  try{await fetch(BASE+'/daytracker?id='+id,{method:'DELETE'});loadDayTrackerEntries();loadDayTrackerPreview()}catch(e){}
}

async function toggleDayTrackerPin(id,pinned){
  try{
    await fetch(BASE+'/daytracker',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,pinned:pinned})});
    loadDayTrackerEntries();loadDayTrackerPreview();
  }catch(e){}
}

// ─── App Limits ────────────────────────────────────────────────────────────────
var _appLimits={};
async function loadAppLimitsSettings(){
  try{
    var r=await fetch(BASE+'/app-limits');var j=await r.json();
    if(j.limits){_appLimits=JSON.parse(j.limits);}
    var def=_appLimits['default']||30;
    var defInput=document.getElementById('appLimitDefault');
    if(defInput)defInput.value=def;
    renderAppLimitsList();
  }catch(e){}
}
function renderAppLimitsList(){
  var el=document.getElementById('appLimitsList');if(!el)return;
  var keys=Object.keys(_appLimits).filter(function(k){return k!=='default';});
  if(!keys.length){el.innerHTML='<div style="color:var(--text-inactive);padding:4px 0">No custom limits set. All apps default to '+(_appLimits['default']||30)+' min.</div>';return;}
  var h='';
  keys.forEach(function(pkg){
    var min=_appLimits[pkg]||30;
    var name=pkg.split('.').pop();
    h+='<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border)">';
    h+='<img src="/app-icon?package='+encodeURIComponent(pkg)+'" style="width:20px;height:20px;border-radius:4px;object-fit:contain;flex-shrink:0;background:rgba(255,255,255,0.06)" onerror="this.style.display=\'none\'">';
    h+='<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);font-size:12px">'+name+'</span>';
    h+='<input type="number" value="'+min+'" min="5" max="480" style="width:50px;padding:4px 6px;background:var(--surface-container-low);border:1px solid var(--border);border-radius:4px;color:var(--text);font-family:monospace;font-size:12px;text-align:center" onchange="saveAppLimit(\''+pkg+'\',this.value)">';
    h+='<span style="font-size:10px;color:var(--text-inactive)">m</span>';
    h+='<span style="cursor:pointer;color:var(--red);font-size:14px" onclick="removeAppLimit(\''+pkg+'\')">&#x2715;</span>';
    h+='</div>';
  });
  el.innerHTML=h;
}
async function saveAppLimitDefault(){
  var v=parseInt(document.getElementById('appLimitDefault').value)||30;
  _appLimits['default']=v;
  await saveAppLimitsToServer();
}
async function saveAppLimit(pkg,min){
  _appLimits[pkg]=parseInt(min)||30;
  await saveAppLimitsToServer();
}
async function removeAppLimit(pkg){
  delete _appLimits[pkg];
  await saveAppLimitsToServer();
  renderAppLimitsList();
}
async function saveAppLimitsToServer(){
  try{
    await fetch(BASE+'/app-limits',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({limits:_appLimits})});
  }catch(e){}
}

// ─── Track Page (Segmented Timeline) ─────────────────────────────────────────
var _trackDate=new Date();
var _trackSegments=[
  {label:'Dawn / Early Hours',start:0,end:6},
  {label:'Morning Routine',start:6,end:9},
  {label:'Morning Focus',start:9,end:12},
  {label:'Midday & Afternoon',start:12,end:15},
  {label:'Afternoon Work',start:15,end:18},
  {label:'Evening Routine',start:18,end:21},
  {label:'Night / Late Hours',start:21,end:24}
];
var _TRACK_CATS={mood:'MOOD',energy:'ENERGY',metrics:'METRIC',habits:'HABIT',journal:'JOURNAL',thought:'THOUGHT',dsa:'LEETCODE',chess:'CHESS',running:'RUN',panics:'PANIC',sessions:'FOCUS',tasks:'TASK',checklist:'CHECKLIST',daytracker:'LOG',shares:'CAPSULE'};
var _TRACK_COLORS={mood:'var(--crayon-green)',energy:'var(--crayon-blue)',metrics:'var(--crayon-blue)',habits:'var(--crayon-green)',journal:'var(--crayon-amber)',thought:'var(--crayon-purple)',dsa:'var(--crayon-purple)',chess:'var(--pencil-text)',running:'var(--crayon-green)',panics:'var(--crayon-red)',sessions:'var(--crayon-blue)',tasks:'var(--crayon-amber)',checklist:'var(--ink-text)',daytracker:'var(--pencil-text)',shares:'var(--crayon-amber)'};
var _TRACK_ICONS={mood:'mood',energy:'bolt',metrics:'analytics',habits:'emoji_events',journal:'edit_note',thought:'psychology',dsa:'school',chess:'chess',running:'directions_run',panics:'warning',sessions:'timer',tasks:'task_alt',checklist:'checklist',daytracker:'calendar_month',shares:'hourglass_empty'};

function openTrackPage(){
  setNavTabActive('tracker');
  document.getElementById('mainFab').style.display='none';_pushOv();
  document.getElementById('trackPage').classList.add('show');
  _trackDate=new Date();
  renderTrackDate();
  loadTrackPage();
}
function closeTrackPage(){
  document.getElementById('mainFab').style.display='none';
  document.getElementById('trackPage').classList.remove('show');
  setNavTabActive('home');
}

function trackPageNav(dir){
  _trackDate.setDate(_trackDate.getDate()+dir);
  renderTrackDate();
  loadTrackPage();
}

function renderTrackDate(){
  var d=_trackDate;
  var y=d.getFullYear();
  var m=String(d.getMonth()+1).padStart(2,'0');
  var day=String(d.getDate()).padStart(2,'0');
  var el=document.getElementById('trackDateDisplay');
  if(el) el.textContent=day+'.'+m+'.'+String(y).slice(2);
}

function openTrackDatePicker(){
  var picker=document.getElementById('trackDatePicker');
  if(!picker) return;
  var d=_trackDate;
  picker.value=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  picker.style.pointerEvents='auto';
  picker.style.opacity='0.01';
  picker.style.zIndex='9999';
  try{
    if(picker.showPicker)picker.showPicker();
    else picker.click();
  }catch(e){picker.click()}
  setTimeout(function(){
    picker.style.pointerEvents='none';
    picker.style.opacity='0';
    picker.style.zIndex='-1';
  },500);
}
function onTrackDatePicked(el){
  if(!el||!el.value)return;
  var parts=el.value.split('-');
  _trackDate=new Date(parseInt(parts[0]),parseInt(parts[1])-1,parseInt(parts[2]));
  renderTrackDate();
  loadTrackPage();
}

function _trackDateStr(){
  var d=_trackDate;
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}

function _trackParseTs(ts, ev){
  if(!ts && ev && ev.time) ts = ev.time;
  if(ev && (ev.type === 'checkin' || ev.type === 'checkout') && ev.time && /^\d{1,2}:\d{2}/.test(ev.time.trim())){
    var parts = ev.time.trim().split(':');
    var d = new Date(_trackDate);
    d.setHours(parseInt(parts[0], 10), parseInt(parts[1], 10), 0, 0);
    return d;
  }
  if(!ts && ev && ev.hour != null){
    var h = parseInt(ev.hour, 10);
    if(!isNaN(h)){
      var d = new Date(_trackDate);
      d.setHours(h, 0, 0, 0);
      return d;
    }
  }
  if(!ts) return null;
  if(typeof ts === 'string' && /^\d{1,2}:\d{2}(:\d{2})?$/.test(ts.trim())){
    var parts = ts.trim().split(':');
    var d = new Date(_trackDate);
    d.setHours(parseInt(parts[0], 10), parseInt(parts[1], 10), parts[2] ? parseInt(parts[2], 10) : 0, 0);
    return d;
  }
  try{
    var t = new Date(ts);
    if(!isNaN(t.getTime())){
      var d = new Date(_trackDate);
      d.setHours(t.getHours(), t.getMinutes(), t.getSeconds(), 0);
      return d;
    }
    if(typeof ts === 'string' && ts.indexOf(' ') !== -1){
      t = new Date(ts.replace(' ', 'T'));
      if(!isNaN(t.getTime())){
        var d = new Date(_trackDate);
        d.setHours(t.getHours(), t.getMinutes(), t.getSeconds(), 0);
        return d;
      }
    }
    return null;
  }catch(e){
    return null;
  }
}

function _trackSegColor(seg,now){
  var isNow=now&&now.getHours()>=seg.start&&now.getHours()<seg.end;
  var isPast=now&&now.getHours()>=seg.end;
  if(isNow)return{border:'var(--crayon-blue)',bg:'rgba(79,141,245,0.08)',text:'var(--crayon-blue)',label:'Active Now'};
  if(isPast)return{border:'var(--border)',bg:'transparent',text:'var(--text-inactive)',label:seg.label};
  return{border:'var(--border)',bg:'transparent',text:'var(--text-inactive)',label:seg.label};
}

function _renderTrackItemHtml(ev, dt, isToday, now){
  var timeStr=dt?String(dt.getHours()).padStart(2,'0')+':'+String(dt.getMinutes()).padStart(2,'0'):'--:--';
  var cat=ev._category||'unknown';
  var badge=_TRACK_CATS[cat]||cat.toUpperCase();
  var bColor=_TRACK_COLORS[cat]||'var(--ink-text)';
  var icon=_TRACK_ICONS[cat]||'circle';
  if(cat==='metrics'){
    if(ev.type==='checkin'){ badge='CHECK-IN'; bColor='var(--crayon-green)'; icon='login'; }
    else if(ev.type==='checkout'){ badge='CHECK-OUT'; bColor='var(--crayon-purple)'; icon='logout'; }
    else if(ev.pushups){ badge='PUSHUPS'; bColor='var(--crayon-blue)'; icon='fitness_center'; }
    else if(ev.doom_scroll){ badge='DOOM'; bColor='var(--crayon-red)'; icon='phone_android'; }
  }
  var isActive=isToday&&dt&&dt.getHours()===now.getHours()&&Math.abs(dt.getMinutes()-now.getMinutes())<=15;
  var borderColor=isActive?'var(--crayon-blue)':'var(--border)';
  var shadowStyle=isActive?'box-shadow:0 0 8px rgba(79,141,245,0.15)':'';
  var leftBorderStyle=isActive?'border-left:3px solid var(--crayon-blue)':'';

  var h='<div style="display:flex;gap:10px;margin-bottom:10px">';
  h+='<div style="width:44px;flex-shrink:0;text-align:right;font-size:11px;font-family:\'Space Mono\',monospace;font-weight:700;color:'+(isActive?'var(--crayon-blue)':'var(--text-inactive)')+';padding-top:8px;border-right:'+(isActive?'2px solid var(--crayon-blue)':'1px solid var(--border)')+';padding-right:8px">'+timeStr+'</div>';
  h+='<div style="flex-grow:1;background:var(--surface);border:1px solid '+borderColor+';border-radius:6px;padding:9px 12px;'+leftBorderStyle+';'+shadowStyle+'">';
  h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">';
  h+='<span style="font-size:10px;color:'+bColor+';font-family:\'Space Mono\',monospace;font-weight:700;letter-spacing:0.04em">['+badge+']</span>';
  h+='<div style="display:flex;align-items:center;gap:6px">';
  h+='<span class="material-symbols-outlined" style="font-size:16px;color:'+bColor+'">'+icon+'</span>';
  h+='<span onclick="deleteTrackEvent(\''+encodeURIComponent(ev._category||cat)+'\',\''+encodeURIComponent(ev.id||'')+'\')" style="cursor:pointer;padding:2px;border-radius:3px;display:flex;align-items:center;transition:background 0.15s" onmouseover="this.style.background=\'rgba(248,113,113,0.15)\'" onmouseout="this.style.background=\'transparent\'"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>';
  h+='</div>';
  h+='</div>';
  h+='<div style="font-size:13px;color:var(--text);line-height:1.4">';
  h+=_trackRenderEvent(ev,cat);
  h+='</div>';
  h+='</div>';
  h+='</div>';
  return h;
}

async function loadTrackPage(){
  var container=document.getElementById('trackTimelineContent');
  if(!container) return;
  container.innerHTML='<div style="color:var(--text-inactive);text-align:center;padding:20px;font-size:12px;font-family:\'Space Mono\',monospace">Loading timeline...</div>';
  try{
    var ds=_trackDateStr();
    var r=await fetch(BASE+'/day/'+ds);
    var j=await r.json();
    var events=j.events||[];
    var countEl=document.getElementById('trackEventCount');
    if(countEl) countEl.textContent=events.length;
    // Compute summary stats
    var totalDuration=0,sessCount=0,lastMoodKey='',lastEnergyKey='';
    var habitDone=0,habitTotal=0,dsaCount=0,journalCount=0,thoughtCount=0;
    var pushupsTotal=0,doomTotal=0,checkinCount=0,checkoutCount=0;
    var runCount=0,runKm=0,runSecs=0;
    events.forEach(function(e){
      var cat=e._category||'';
      if(cat==='sessions'&&e.type==='end'){sessCount++;totalDuration+=(e.duration||0)}
      if(cat==='mood'&&e.mood)lastMoodKey=e.mood;
      if(cat==='energy'&&e.energy)lastEnergyKey=e.energy;
      if(cat==='habits'){habitTotal++;if(e.on)habitDone++}
      if(cat==='dsa')dsaCount++;
      if(cat==='journal')journalCount++;
      if(cat==='thought')thoughtCount++;
      if(cat==='running'){
        runCount++;
        runKm += (parseFloat(e.distance_km) || 0);
        var s = (e.duration_sec != null && e.duration_sec > 0) ? Number(e.duration_sec) : formatRunSeconds(e.duration_min || e.duration, e.distance_km);
        runSecs += s;
      }
      if(cat==='metrics'){
        if(e.pushups) pushupsTotal += parseInt(e.pushups, 10) || 0;
        if(e.doom_scroll) doomTotal += parseInt(e.doom_scroll, 10) || 0;
        if(e.type==='checkin') checkinCount++;
        if(e.type==='checkout') checkoutCount++;
      }
    });
    var summaryEl=document.getElementById('trackSummary');
    if(summaryEl){
      var parts=[];
      if(sessCount)parts.push(sessCount+' sessions'+(totalDuration?' ('+totalDuration+'m)':''));
      if(lastMoodKey)parts.push('Mood: '+moodLabel(lastMoodKey));
      if(lastEnergyKey)parts.push('Energy: '+energyLabel(lastEnergyKey));
      if(habitDone)parts.push('Habits: '+habitDone+'/'+habitTotal);
      if(runCount){
        var rm = Math.floor(runSecs / 60);
        var rs = runSecs % 60;
        var rTimeStr = rm + 'm' + (rs > 0 ? ' ' + rs + 's' : '');
        parts.push('Run: ' + (Math.round(runKm * 10) / 10) + 'km (' + rTimeStr + ')');
      }
      if(pushupsTotal)parts.push('Pushups: '+pushupsTotal);
      if(doomTotal)parts.push('Doom: '+doomTotal+'m');
      if(checkinCount)parts.push('Check-in: '+checkinCount);
      if(dsaCount)parts.push('DSA: '+dsaCount);
      if(journalCount)parts.push('Journal: '+journalCount);
      if(thoughtCount)parts.push('Thoughts: '+thoughtCount);
      if(parts.length > 0){
        summaryEl.style.display='flex';
        summaryEl.innerHTML=parts.map(function(p){return '<span style="padding:2px 8px;background:var(--surface);border:1px solid var(--border);border-radius:4px">'+p+'</span>'}).join('');
      } else {
        summaryEl.style.display='none';
      }
    }
    if(!events.length){
      container.innerHTML='<div style="color:var(--text-inactive);text-align:center;padding:40px 20px;font-size:12px;font-family:\'Space Mono\',monospace">No events recorded for this date</div>';
      return;
    }
    var now=new Date();
    var todayD=new Date();
    var todayStr=todayD.getFullYear()+'-'+String(todayD.getMonth()+1).padStart(2,'0')+'-'+String(todayD.getDate()).padStart(2,'0');
    var isToday=ds===todayStr;
    var html='';
    var unassignedEvents=[];

    var eventMap={};
    _trackSegments.forEach(function(seg, idx){ eventMap[idx] = []; });

    events.forEach(function(ev){
      var dt=_trackParseTs(ev.ts, ev);
      if(!dt){
        unassignedEvents.push(ev);
        return;
      }
      var hour = dt.getHours();
      var assigned = false;
      for(var i=0; i<_trackSegments.length; i++){
        if(hour >= _trackSegments[i].start && hour < _trackSegments[i].end){
          eventMap[i].push({ev: ev, dt: dt});
          assigned = true;
          break;
        }
      }
      if(!assigned){
        unassignedEvents.push(ev);
      }
    });

    _trackSegments.forEach(function(seg, idx){
      var segItems=eventMap[idx];
      var sc=_trackSegColor(seg,isToday?now:null);
      html+='<div style="border:1px solid '+sc.border+';background:var(--surface-container-lowest);border-radius:6px;margin-bottom:12px;overflow:hidden">';
      html+='<div style="background:'+sc.bg+';padding:8px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid '+sc.border+'">';
      html+='<span style="font-size:11px;font-weight:700;color:'+sc.text+';letter-spacing:0.04em">'+seg.label+' ('+String(seg.start).padStart(2,'0')+':00 - '+String(seg.end).padStart(2,'0')+':00)</span>';
      html+='<span style="font-size:10px;font-family:\'Space Mono\',monospace;color:'+sc.text+';font-weight:600">'+sc.label+'</span>';
      html+='</div>';
      html+='<div style="padding:10px 12px">';
      if(segItems.length===0){
        html+='<div style="text-align:center;padding:12px;opacity:0.35"><span style="font-size:11px;color:var(--text-inactive)">— No entries —</span></div>';
      }else{
        segItems.forEach(function(item){
          html+=_renderTrackItemHtml(item.ev, item.dt, isToday, now);
        });
      }
      html+='</div></div>';
    });

    if(unassignedEvents.length > 0){
      html+='<div style="border:1px dashed var(--border);background:var(--surface-container-lowest);border-radius:6px;margin-bottom:12px;overflow:hidden">';
      html+='<div style="padding:8px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px dashed var(--border)">';
      html+='<span style="font-size:11px;font-weight:700;color:var(--pencil-text);letter-spacing:0.04em">All-Day / Untimed Logs</span>';
      html+='<span style="font-size:10px;font-family:\'Space Mono\',monospace;color:var(--pencil-muted)">'+unassignedEvents.length+' ITEMS</span>';
      html+='</div>';
      html+='<div style="padding:10px 12px">';
      unassignedEvents.forEach(function(ev){
        html+=_renderTrackItemHtml(ev, null, isToday, now);
      });
      html+='</div></div>';
    }

    container.innerHTML=html;
  }catch(e){
    container.innerHTML='<div style="color:var(--accent-red);text-align:center;padding:20px;font-size:12px;font-family:\'Space Mono\',monospace">Failed to load timeline<br>'+esc(e.message||e)+'</div>';
  }
}

function _trackRenderEvent(ev,cat){
  if(cat==='mood'){
    var moodVal=ev.mood!=null?ev.mood:'?';
    var moodNote=ev.note?' <span style="color:var(--text-inactive);font-size:10px;font-style:italic">('+esc(ev.note)+')</span>':'';
    return '<div style="font-size:13px;font-weight:600">MOOD: '+moodVal+'</div>'+moodNote;
  }
  if(cat==='energy'){
    var eVal=ev.energy!=null?ev.energy:'?';
    var eNote=ev.note?' <span style="color:var(--text-inactive);font-size:10px;font-style:italic">('+esc(ev.note)+')</span>':'';
    return '<div style="font-size:13px;font-weight:600">ENERGY: '+eVal+'</div>'+eNote;
  }
  if(cat==='sessions'){
    var act=activityLabel(ev.activity);
    if(ev.type==='start')return '<div style="font-size:13px;font-weight:600">'+act+' started</div>';
    if(ev.type==='end')return '<div style="font-size:13px;font-weight:600">'+act+' ended</div><div style="font-size:10px;color:var(--text-inactive);margin-top:2px">Duration: '+(ev.duration||0)+'m</div>';
    return '<div style="font-size:13px;font-weight:600">'+act+'</div>';
  }
  if(cat==='habits'){
    var act=activityLabel(ev.activity);
    return '<div style="font-size:13px;font-weight:600">'+(ev.on?'\u2713':'\u2717')+' '+act+'</div>';
  }
  if(cat==='metrics'){
    var parts=[];
    if(ev.pushups)parts.push('PUSHUPS: <span style="color:var(--secondary);font-weight:600">'+ev.pushups+'</span>');
    if(ev.doom_scroll)parts.push('DOOM_SCROLL: <span style="color:var(--accent-red);font-weight:600">'+ev.doom_scroll+'m</span>'+(ev.trigger?' <span style="color:var(--text-inactive);font-size:11px">Trigger: '+esc(ev.trigger)+'</span>':''));
    if(ev.type==='checkin'){
      var tStr=ev.time||(ev.ts?ev.ts.slice(11,16):'');
      if(tStr.indexOf('T')!==-1) tStr=tStr.slice(tStr.indexOf('T')+1, tStr.indexOf('T')+6);
      parts.push('CHECK-IN: <span style="color:var(--primary);font-weight:600">'+esc(tStr||'--:--')+'</span>');
    }
    if(ev.type==='checkout'){
      var tStr=ev.time||(ev.ts?ev.ts.slice(11,16):'');
      if(tStr.indexOf('T')!==-1) tStr=tStr.slice(tStr.indexOf('T')+1, tStr.indexOf('T')+6);
      parts.push('CHECK-OUT: <span style="color:var(--primary);font-weight:600">'+esc(tStr||'--:--')+'</span>');
    }
    if(ev.label||ev.name||ev.metric){
      var mVal=ev.value!=null?ev.value:(ev.count!=null?ev.count:'');
      parts.push(esc((ev.label||ev.name||ev.metric).toUpperCase())+': <span style="color:var(--secondary);font-weight:600">'+esc(String(mVal))+'</span>');
    }
    if(ev.note)parts.push('<span style="color:var(--text-inactive);font-size:11px">Note: '+esc(ev.note)+'</span>');
    if(ev.trigger&&!ev.doom_scroll)parts.push('<span style="color:var(--text-inactive);font-size:11px">Trigger: '+esc(ev.trigger)+'</span>');
    return parts.join('<br>')||'<span>'+esc(JSON.stringify(ev).slice(0,60))+'</span>';
  }
  if(cat==='journal'){
    return '<em style="color:var(--accent-orange)">"'+esc((ev.text||'').slice(0,100))+'"</em>';
  }
  if(cat==='panics'){
    return '<div style="color:var(--accent-red);font-weight:600">PANIC_EVENT</div>'+(ev.trigger?'<div style="font-size:10px;color:var(--text-inactive)">'+esc(ev.trigger)+'</div>':'');
  }
  if(cat==='dsa'){
    return '<div style="font-weight:600">LEETCODE: <span style="color:var(--accent-purple)">#'+esc(ev.problem||'?')+'</span></div>';
  }
  if(cat==='chess'){
    return '<div style="font-weight:600">CHESS \u2014 '+(ev.result||'')+'</div>';
  }
  if(cat==='running'){
    var durFormatted = ev.duration_formatted || formatRunDuration(ev.duration_sec || ev.duration_min, ev.distance_km);
    var paceStr = ev.pace ? ' <span style="color:var(--text-inactive);font-size:11px">· ' + esc(ev.pace) + (ev.pace.includes('/') ? '' : '/km') + '</span>' : '';
    var typeBadge = ev.run_type ? ' <span style="font-size:10px;padding:1px 6px;border-radius:3px;background:rgba(0,255,136,0.1);color:var(--green)">' + esc(ev.run_type).toUpperCase() + '</span>' : '';
    var notesStr = ev.notes ? '<div style="font-size:11px;color:var(--text-inactive);margin-top:2px">' + esc(ev.notes) + '</div>' : '';
    return '<div style="font-weight:600">' + (ev.distance_km || 0) + 'km in ' + durFormatted + typeBadge + '</div>' + paceStr + notesStr;
  }
  if(cat==='tasks'){
    return '<div style="font-weight:600">'+esc(ev.action||'')+(ev.title?' \u2014 '+esc(ev.title):'')+'</div>';
  }
  if(cat==='daytracker'){
    var dtParts=[];
    var dtTitle=esc(ev.title||'');
    if(dtTitle)dtParts.push('<span style="font-weight:600">'+dtTitle+'</span>');
    var dtCat=(ev.category||'others').toUpperCase();
    dtParts.push('<span style="color:var(--text-inactive);font-size:10px">['+esc(dtCat)+']</span>');
    if(ev.hour!=null)dtParts.push('<span style="font-size:10px;color:var(--text-inactive)">@ '+String(ev.hour).padStart(2,'0')+':00</span>');
    if(ev.pinned===true||ev.pinned==='true')dtParts.push('<span style="font-size:10px;color:var(--yellow)">PINNED</span>');
    return dtParts.join(' ')+(ev.note?' <div style="font-size:11px;color:var(--text-inactive)">'+esc(ev.note)+'</div>':'');
  }
  if(cat==='thought'){
    var thParts=[];
    if(ev.topic)thParts.push('<span style="font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em">TOPIC: '+esc(ev.topic)+'</span>');
    thParts.push('<div style="font-weight:600;margin-top:2px">'+esc(ev.text||'')+'</div>');
    if(ev.verse_id)thParts.push('<div style="font-size:10px;color:var(--accent-orange)">VERSE: '+esc(ev.verse_id)+'</div>');
    return thParts.join('');
  }
  if(cat==='checklist'){
    var chkLabel=ev.label||ev.title||ev.text||'';
    var chkDone=ev.done===true;
    var chkFreq=ev.frequency?' <span style="font-size:10px;color:var(--text-inactive)">['+esc(ev.frequency)+']</span>':'';
    return '<div style="font-weight:600">'+(chkDone?'\u2713 ':'\u2717 ')+esc(chkLabel)+chkFreq+'</div>'+(ev.done===true?'<div style="font-size:10px;color:var(--green)">DONE</div>':'');
  }
  if(cat==='shares'){
    var shType=ev.type?'<span style="font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em">['+esc(ev.type)+']</span> ':'';
    var shParts=['<div style="font-weight:600">'+shType+esc(ev.title||'Untitled')+'</div>'];
    if(ev.info)shParts.push('<div style="font-size:11px;color:var(--text-inactive)">'+esc(ev.info)+'</div>');
    if(ev.text)shParts.push('<div style="font-size:11px;color:var(--muted);word-break:break-word">'+esc(ev.text.length>200?ev.text.slice(0,200)+'...':ev.text)+'</div>');
    var shTags=ev.tags?ev.tags.split(',').filter(function(t){return t.trim()}).map(function(t){return '<span style="display:inline-block;padding:1px 7px;background:var(--card2);color:var(--text);border-radius:10px;font-size:9px;margin:2px 4px 0 0">'+esc(t.trim())+'</span>'}).join(''):'';
    if(shTags)shParts.push('<div>'+shTags+'</div>');
    if(ev.pinned===true)shParts.push('<span style="font-size:10px;color:var(--yellow)">PINNED</span>');
    return shParts.join('');
  }
  var simple=JSON.stringify(ev,['activity','type','note','text','title','mood','energy','value','status','action','duration','distance_km','subtype','topic','result','label','on']).slice(0,100);
  if(simple.length>4)return '<div style="font-size:11px;color:var(--text-inactive)">'+esc(simple)+'</div>';
  return '<div style="font-size:11px;color:var(--text-inactive)">'+esc(JSON.stringify(ev)).slice(0,60)+'</div>';
}

async function deleteTrackEvent(catEncoded,idEncoded){
  var cat=decodeURIComponent(catEncoded);
  var id=decodeURIComponent(idEncoded);
  if(!id||!cat)return;
  if(!confirm('Delete this event? It will be moved to recycle bin.'))return;
  try{
    var r=await fetch(BASE+'/event/'+encodeURIComponent(cat)+'/'+encodeURIComponent(id),{method:'DELETE'});
    if(r.ok){loadTrackPage();}
  }catch(ex){}
}


// Prevent accidental text selection while tapping or reordering
document.addEventListener('selectstart', function(e) {
  if (!e.target.closest('input, textarea, select, [contenteditable="true"]')) {
    e.preventDefault();
    return false;
  }
});
</script>

<!-- ═══ WIDGET GALLERY MODAL ═══ -->
<div class="modal-overlay" id="widgetGalleryModal" onclick="if(event.target===this)closeWidgetGalleryModal()">
  <div class="modal" style="max-width:440px;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;border-bottom:1px solid var(--border);padding-bottom:8px">
      <span style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:14px;color:var(--primary)">WIDGET GALLERY</span>
      <button onclick="closeWidgetGalleryModal()" style="background:transparent;border:none;color:var(--text-inactive);font-size:18px;cursor:pointer">✕</button>
    </div>
    <div id="widgetGalleryList" style="display:flex;flex-direction:column;gap:4px;max-height:60vh;overflow-y:auto"></div>
  </div>
</div>

<script src="js/widgets.js"></script>
<script src="js/dashboard-customizer.js"></script>
</body>
</html>
