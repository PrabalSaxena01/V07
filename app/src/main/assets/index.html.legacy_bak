        <div id="psmSizePills" style="display:flex;gap:4px;flex-wrap:wrap">
          <button class="chip" data-size="compact" onclick="setPluginWidgetSizeChoice('compact')">COMPACT</button>
          <button class="chip" data-size="small" onclick="setPluginWidgetSizeChoice('small')">SMALL</button>
          <button class="chip" data-size="medium" onclick="setPluginWidgetSizeChoice('medium')">MEDIUM</button>
          <button class="chip" data-size="large" onclick="setPluginWidgetSizeChoice('large')">LARGE</button>
          <button class="chip" data-size="hidden" onclick="setPluginWidgetSizeChoice('hidden')">OFF</button>
        </div>
      </div>
      <div style="font-size:10px;color:var(--text-inactive)">Compact (70px), Small (100px), Medium (160px), Large (240px), or Off.</div>
      <div style="margin-top:10px;padding-top:8px;border-top:1px dashed var(--divider);display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="font-size:11px;color:var(--text);font-weight:600">Android Home Screen</div>
          <div style="font-size:9.5px;color:var(--text-inactive)">Add interactive widget to Android launcher</div>
        </div>
        <button class="btn btn-outline" style="padding:4px 8px;font-size:10px" onclick="pinCurrentPluginWidget()">+ PIN WIDGET</button>
      </div>
    </div>

    <!-- Section 2: FAB Quick Action -->
    <div class="kb-settings-group" style="padding:10px;margin-bottom:0">
      <div style="font-family:'Space Mono',monospace;font-size:10px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px">CENTRAL JOTTER ACTION</div>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span style="font-size:12px;color:var(--text)" id="psmFabLabel">Show in FAB Menu</span>
