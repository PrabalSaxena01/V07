function _makeIconSvg(name, size, color) {
  var d = _iconPaths[name];
  if (!d) return null;
  var ns = 'http://www.w3.org/2000/svg';
  var svg = document.createElementNS(ns, 'svg');
  svg.setAttribute('viewBox', '0 -960 960 960');
  svg.setAttribute('width', size);
  svg.setAttribute('height', size);
  svg.setAttribute('fill', color);
  var path = document.createElementNS(ns, 'path');
  path.setAttribute('d', d);
  svg.appendChild(path);
  return svg;
}
function replaceMaterialIcons(root) {
  var elRoot = (root && root.querySelectorAll) ? root : ((root && root.nodeType === 1) ? root : document);
  elRoot.querySelectorAll('.material-symbols-outlined').forEach(function(el) {
    if (el.getAttribute('data-replaced')) return;
    el.setAttribute('data-replaced', '1');
    var name = el.textContent.trim();
    var cs = window.getComputedStyle(el);
    var fs = parseInt(cs.fontSize) || 24;
    var fc = cs.color || 'currentColor';
    var svg = _makeIconSvg(name, fs, fc);
    if (!svg) {
      // Do NOT replace with a text circle! Keep as original element so font renders cleanly
      return;
    }
    var ogStyle = el.getAttribute('style') || '';
    svg.setAttribute('style', ogStyle ? ogStyle + ';' + svg.getAttribute('style') : svg.getAttribute('style') || '');
    svg.style.display = 'inline-block';
    svg.style.verticalAlign = 'middle';
    svg.style.fontSize = fs + 'px';
    if (el.onclick) svg.onclick = el.onclick;
    el.parentNode.replaceChild(svg, el);
  });
}
document.addEventListener('DOMContentLoaded', function() {
  replaceMaterialIcons();
  var obs = new MutationObserver(function(muts) {
    for (var i = 0; i < muts.length; i++) {
      if (muts[i].addedNodes.length) {
        replaceMaterialIcons(muts[i].target);
      }
    }
  });
  obs.observe(document.body, { childList: true, subtree: true });
  try{history.replaceState({tab:'home'},'',location.href)}catch(e){}
  window.addEventListener('popstate', function(e){
    var overlayIds=['pluginFramePage','pluginsPage','gitaPage','databasePage','vaultPage','sessionsPage','moodEnergyPage','sleepUpPage','checklistPage','recycleBinPage','thoughtsPage','tasksPage','appUsagePage','runningPage','dayTrackerPage','logDashboardPage','settingsPage','trackPage'];
    var closed=false;
    for(var i=0;i<overlayIds.length;i++){
      var el=document.getElementById(overlayIds[i]);
      if(el&&el.classList.contains('show')){el.classList.remove('show');closed=true;break}
    }
    if(!closed){
      var cmdPal=document.getElementById('cmdPaletteOverlay');
      if(cmdPal){cmdPal.remove();return}
      if(currentTab!=='home'){switchTab('home',true)}
    }else{
      var fab=document.getElementById('mainFab');
      if(fab)fab.style.display='none';
      var anyOpen = overlayIds.some(function(id){ var el = document.getElementById(id); return el && el.classList.contains('show'); });
      if(!anyOpen){
        setNavTabActive('home');
      } else {
        var lp = document.getElementById('logDashboardPage');
        var pf = document.getElementById('pluginFramePage');
        if((lp && lp.classList.contains('show')) || (pf && pf.classList.contains('show'))){
          setNavTabActive('toolkit');
        }
      }
    }
  });
  setInterval(function(){ if(currentTab==='home') sizePluginWidgets(); }, 1500);
  updateDashboardHeaderName();
  initGitaSwipe();
});
</script>

<!-- Floating Gentle Header -->
<header class="topappbar" id="topAppBar" style="position: fixed; top: 0; left: 0; right: 0; width: 100%; max-width: 480px; margin: 0 auto; z-index: 40; height: 68px; padding: 0 20px; background-color: var(--appbar-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--appbar-border); display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;">
  <div style="display: flex; align-items: center; gap: 12px;">
    <div style="width: 40px; height: 40px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--surface); color: var(--primary); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(30,45,40,0.04);">
      <span class="material-symbols-outlined" style="font-size: 22px;">spa</span>
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="display: flex; align-items: center; gap: 6px;">
        <h1 style="font-weight: 700; font-size: 17px; letter-spacing: -0.02em; color: var(--text); margin: 0;">
          Hello, <span id="dashboardHeaderName" onclick="changeDashboardHeaderName()" style="cursor: pointer;" title="Tap to rename">Sarah</span>
        </h1>
        <span style="font-size: 15px;">✨</span>
      </div>
      <span style="font-size: 11px; font-weight: 500; color: var(--text-inactive);">A calm space for your day</span>
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 8px;">
    <button aria-label="Notifications" onclick="openTimelineSidebar()" style="width: 40px; height: 40px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; position: relative; background: var(--surface); border: 1px solid var(--border); color: var(--text-inactive); cursor: pointer; box-shadow: 0 2px 8px rgba(30,45,40,0.04); transition: transform 0.1s ease;">
      <span class="material-symbols-outlined" style="font-size: 20px;">notifications</span>
      <span id="headerNotifDot" style="position: absolute; top: 10px; right: 10px; width: 8px; height: 8px; border-radius: 9999px; background: var(--primary); border: 2px solid var(--surface);"></span>
    </button>
    <div onclick="switchTab('profile')" style="width: 40px; height: 40px; border-radius: 9999px; padding: 2px; background: var(--primary); cursor: pointer; box-sizing: border-box;">
      <div style="width: 100%; height: 100%; border-radius: 9999px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--surface);">
        <span class="material-symbols-outlined" style="font-size: 22px; color: var(--primary);">face_3</span>
      </div>
    </div>
  </div>
  <div class="title" id="pageTitle" style="display: none;"></div>
  <span id="streakBadge" style="display: none;"></span>
  <span id="homeDateDisplay" style="display: none;"></span>
</header>

<div id="moodPromptBar" style="display:none;padding:12px 16px;border:1px solid #DDE7E2;background:#FFFFFF;border-radius:1.25rem;cursor:pointer;transition:all 0.2s;margin-bottom:14px;box-shadow:0 4px 16px rgba(30,45,40,0.03)" onclick="openModal('mood')">
  <div style="display:flex;align-items:center;gap:12px">
    <span class="material-symbols-outlined" style="font-size:20px;color:#8C5E58">edit_note</span>
    <div style="flex:1">
      <div style="font-size:11px;color:#8C5E58;text-transform:uppercase;letter-spacing:0.06em;font-weight:700">Gentle Mood Check-in</div>
      <div style="font-size:12px;color:#5B6A78">Take a pause to reflect on your energy</div>
    </div>
    <span class="material-symbols-outlined" style="font-size:18px;color:#5B6A78">arrow_forward</span>
  </div>
</div>

<!-- 1. Screen Time Section (Top Hierarchy) -->
<section id="homeScreenTimeSection" onclick="openAppUsagePage()" class="calm-card" style="padding: 20px; border-radius: 1.75rem; position: relative; overflow: hidden; margin-top: 4px; margin-bottom: 16px; background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: var(--card-shadow); cursor: pointer; transition: transform 0.12s ease;">
  <div style="position: absolute; right: -24px; bottom: -24px; width: 128px; height: 128px; border-radius: 9999px; background: rgba(46, 125, 106, 0.09); filter: blur(32px); pointer-events: none;"></div>
  <div style="position: relative; z-index: 10; display: flex; flex-direction: column;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600; background: var(--primary); color: var(--on-primary);">
        <span class="material-symbols-outlined" style="font-size: 15px;">smartphone</span>
        <span>Mindful Screen Time</span>
      </div>
      <span id="statScreenStatusPill" style="font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 9999px; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border);">45m under limit</span>
    </div>
    <div style="display: flex; align-items: baseline; justify-content: space-between;">
      <div>
        <h2 style="font-size: 1.35rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.02em; color: var(--text); margin: 0;">
          <span id="statScreenHome" style="color: var(--primary);">2h 15m</span> today
        </h2>
        <p id="statScreenSub" style="font-size: 12px; margin-top: 4px; color: var(--text-inactive); margin-bottom: 0;">Gentle screen balance · Daily limit 3h 00m</p>
      </div>
      <div style="text-align: right;">
        <span id="statScreenRatio" style="font-size: 12px; font-weight: 600; color: var(--text-inactive);">75% of limit</span>
      </div>
    </div>
    <div style="width: 100%; height: 10px; border-radius: 9999px; overflow: hidden; padding: 2px; margin-top: 12px; background: var(--divider); box-sizing: border-box;">
      <div id="statScreenBar" style="height: 100%; border-radius: 9999px; width: 75%; background: linear-gradient(90deg, var(--primary), var(--accent2)); transition: width 0.5s ease;"></div>
    </div>
    <div id="homeScreenTopApps" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; padding-top: 8px; border-top: 1px solid var(--border-subtle);">
      <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 12px; background: var(--surface-container); border: 1px solid var(--border);">
        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--secondary);">palette</span>
        <div style="min-width: 0; flex: 1;">
          <p style="font-size: 11px; color: var(--text-inactive); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0;">Creative</p>
          <p style="font-size: 12px; font-weight: 700; color: var(--text); margin: 0;">1h 10m</p>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 12px; background: var(--surface-container); border: 1px solid var(--border);">
        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--primary);">chat_bubble</span>
        <div style="min-width: 0; flex: 1;">
          <p style="font-size: 11px; color: var(--text-inactive); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0;">Messages</p>
          <p style="font-size: 12px; font-weight: 700; color: var(--text); margin: 0;">38m</p>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 12px; background: var(--surface-container); border: 1px solid var(--border);">
        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--text-inactive);">menu_book</span>
        <div style="min-width: 0; flex: 1;">
          <p style="font-size: 11px; color: var(--text-inactive); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0;">Reading</p>
          <p style="font-size: 12px; font-weight: 700; color: var(--text); margin: 0;">27m</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. Focus Timer Section -->
<section id="homeFocusSection" onclick="openSessionsPage()" class="calm-card" style="padding: 20px; border-radius: 1.75rem; display: flex; flex-direction: column; gap: 16px; margin-bottom: 16px; background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: var(--card-shadow); cursor: pointer; transition: transform 0.12s ease;">
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 8px;">
      <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--primary-container); color: var(--primary);">
        <span class="material-symbols-outlined" style="font-size: 18px;">timer</span>
      </div>
      <div>
        <h3 style="font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); margin: 0;">Calm Focus Timer</h3>
        <p id="sessionActivityLabel" style="font-size: 12px; color: var(--text-inactive); margin: 0;">Deep breath session</p>
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: 6px;">
      <span id="sessionPid" style="font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 9999px; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border);">Quiet Flow</span>
    </div>
  </div>
  <div style="padding: 16px; border-radius: 1.25rem; display: flex; align-items: center; justify-content: space-between; background: var(--surface-container); border: 1px solid var(--border); box-shadow: 0 2px 6px rgba(30,45,40,0.02);">
    <div style="display: flex; align-items: center; gap: 14px;">
      <div style="width: 48px; height: 48px; border-radius: 1.25rem; display: flex; align-items: center; justify-content: center; color: var(--on-primary); background: var(--primary); box-shadow: 0 4px 16px rgba(46, 125, 106, 0.28);">
        <span class="material-symbols-outlined" style="font-size: 24px;">hourglass_bottom</span>
      </div>
      <div>
        <span id="timerDisplay" style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; color: var(--text); line-height: 1.1;">25:00</span>
        <span id="timerHH" style="display:none">00</span>
        <span id="timerMM" style="display:none">25</span>
        <span id="timerSS" style="display:none">00</span>
        <p id="sessionTargetText" style="font-size: 12px; color: var(--text-inactive); margin: 2px 0 0 0;">Ready to start mindful block</p>
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;" onclick="event.stopPropagation()">
      <button aria-label="Reset timer" id="dash-btn-reset" onclick="sessionReset();event.stopPropagation()" style="width: 36px; height: 36px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--surface); color: var(--text-inactive); border: 1px solid var(--border); cursor: pointer; transition: all 0.1s ease;">
        <span class="material-symbols-outlined" style="font-size: 18px;">restart_alt</span>
      </button>
      <button aria-label="Start focus session" id="dash-btn-play" onclick="handleFocusToggle();event.stopPropagation()" style="width: 40px; height: 40px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; color: var(--on-primary); background: var(--primary); box-shadow: 0 4px 16px rgba(46, 125, 106, 0.35); border: none; cursor: pointer; transition: all 0.1s ease;">
        <span class="material-symbols-outlined" id="dash-play-icon" style="font-size: 22px;">play_arrow</span>
      </button>
    </div>
  </div>
  <!-- Compatibility hooks for session state machine -->
  <div id="homeSessionNoSession" style="display: none;"></div>
  <div id="homeSessionActive" style="display: none;"></div>
  <div id="homeSessionPaused" style="display: none;"></div>
  <div id="sessionProgressBar" style="display: none;"></div>
  <div id="sessionProgressBarLabel" style="display: none;"></div>
</section>

<!-- 3. Tasks (Gentle To-Do List) -->
<section id="homeChecklistSection" class="calm-card" style="padding: 20px; border-radius: 1.75rem; display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: var(--card-shadow);">
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 8px;">
      <div style="width: 10px; height: 10px; border-radius: 9999px; background: var(--primary); box-shadow: 0 0 8px rgba(46, 125, 106, 0.5);"></div>
      <h3 style="font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); margin: 0;">Gentle to-do list</h3>
    </div>
    <span id="homeChecklistCountBadge" onclick="openChecklist()" style="font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 9999px; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border); cursor: pointer;">2 of 3 open</span>
  </div>
  <div id="homeChecklistItems" style="display: flex; flex-direction: column; gap: 10px; padding-top: 4px;">
    <div class="task-item" style="padding: 10px 12px; border-radius: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--surface-container); border: 1px solid var(--border);">
      <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
        <button aria-label="Mark task complete" class="task-pill" style="width: 24px; height: 24px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--surface); border: 2px solid var(--border); color: var(--primary); cursor: pointer; padding: 0;">
        </button>
        <span style="font-size: 12px; font-weight: 500; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Morning tea and sketching</span>
      </div>
      <span style="font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border); flex-shrink: 0;">Creative</span>
    </div>
    <div class="task-item" style="padding: 10px 12px; border-radius: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--surface-subtle); border: 1px solid var(--border);">
      <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
        <button aria-label="Mark task incomplete" class="task-pill" style="width: 24px; height: 24px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--primary); border: 2px solid var(--primary); color: var(--on-primary); cursor: pointer; padding: 0;">
          <span class="material-symbols-outlined" style="font-size: 14px; line-height: 1;">check</span>
        </button>
        <span style="font-size: 12px; font-weight: 500; text-decoration: line-through; color: var(--muted); opacity: 0.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Water the indoor ferns</span>
      </div>
      <span style="font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: var(--primary-container); color: var(--primary); border: 1px solid var(--border); flex-shrink: 0;">Kindness</span>
    </div>
    <div class="task-item" style="padding: 10px 12px; border-radius: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--surface-container); border: 1px solid var(--border);">
      <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
        <button aria-label="Mark task complete" class="task-pill" style="width: 24px; height: 24px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--surface); border: 2px solid var(--border); color: var(--primary); cursor: pointer; padding: 0;">
        </button>
        <span style="font-size: 12px; font-weight: 500; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Gentle evening stretch</span>
      </div>
      <span style="font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: var(--surface-container); color: var(--text-inactive); border: 1px solid var(--border); flex-shrink: 0;">Self-care</span>
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: 10px; margin-top: 4px;">
    <input type="text" id="homeQuickDirectiveInput" placeholder="+ Add a gentle task..." 
      onkeydown="if(event.key==='Enter')quickAddHomeDirective()" 
      style="flex: 1; background: transparent; border: none; font-size: 13px; font-family: inherit; color: var(--text); outline: none; padding: 4px 8px;">
    <button onclick="quickAddHomeDirective()" style="padding: 6px 14px; border-radius: 9999px; font-size: 12px; font-weight: 600; background: var(--primary); color: var(--on-primary); border: none; cursor: pointer; box-shadow: 0 2px 8px rgba(46,125,106,0.25);">
      + Add
    </button>
  </div>
</section>

<!-- 4. Active Plugins Container Section -->
<div id="pluginWidgetsSection" style="padding-top: 4px; display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
  <!-- Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; padding: 0 4px;">
    <div style="display: flex; align-items: center; gap: 8px;">
      <span class="material-symbols-outlined" style="font-size: 19px; color: var(--primary);">extension</span>
      <h3 style="font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-inactive); margin: 0;">Active Plugins</h3>
    </div>
    <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; background: var(--primary-container); border: 1px solid var(--border); color: var(--primary);">
      <span style="width: 6px; height: 6px; border-radius: 9999px; background-color: var(--primary); box-shadow: 0 0 6px rgba(46, 125, 106, 0.4);"></span>
      <span id="pluginsActiveCount">2 Enabled</span>
    </div>
  </div>

  <!-- Plugin 1: Daily Rituals / Habit Bubbles -->
  <section class="calm-card" onclick="openHabitsOrPlugin()" style="padding: 20px; border-radius: 1.75rem; display: flex; flex-direction: column; gap: 12px; background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: var(--card-shadow); cursor: pointer; transition: transform 0.12s ease;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <h4 style="font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); margin: 0;">Daily rituals</h4>
          <span style="font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border);">Habit Plugin</span>
        </div>
        <p id="habitStreakText" style="font-size: 12px; margin-top: 4px; color: var(--text-inactive); margin-bottom: 0;">14-day streak — you are doing wonderful!</p>
      </div>
      <div style="width: 36px; height: 36px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border);">
        <span class="material-symbols-outlined" style="font-size: 19px;">favorite</span>
      </div>
    </div>
    <div id="habitWeekBubbles" style="padding: 14px; border-radius: 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 6px; background: var(--surface-container); border: 1px solid var(--border);">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-inactive);">M</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; color: var(--on-primary); font-size: 12px; font-weight: 700; background: var(--primary);">
          <span class="material-symbols-outlined" style="font-size: 15px; line-height: 1;">check</span>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-inactive);">T</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; color: var(--on-primary); font-size: 12px; font-weight: 700; background: var(--primary);">
          <span class="material-symbols-outlined" style="font-size: 15px; line-height: 1;">check</span>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-inactive);">W</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; color: var(--on-primary); font-size: 12px; font-weight: 700; background: var(--primary);">
          <span class="material-symbols-outlined" style="font-size: 15px; line-height: 1;">check</span>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--primary);">T</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: var(--primary-container); color: var(--primary); border: 2px solid var(--accent2);">
          <span class="material-symbols-outlined" style="font-size: 15px; line-height: 1;">check</span>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-inactive);">F</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: var(--surface); border: 1px dashed var(--border); color: var(--text-inactive);">
          <span style="width: 6px; height: 6px; border-radius: 9999px; background: var(--border); display: inline-block;"></span>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-inactive);">S</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: var(--surface); border: 1px dashed var(--border); color: var(--text-inactive);">
          <span style="width: 6px; height: 6px; border-radius: 9999px; background: var(--border); display: inline-block;"></span>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <span style="font-size: 11px; font-weight: 700; color: var(--text-inactive);">S</span>
        <div style="width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: var(--surface); border: 1px dashed var(--border); color: var(--text-inactive);">
          <span style="width: 6px; height: 6px; border-radius: 9999px; background: var(--border); display: inline-block;"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Plugin 2: Reading Nook -->
  <section class="calm-card" onclick="openReaderOrPlugin()" style="padding: 20px; border-radius: 1.75rem; display: flex; flex-direction: column; gap: 12px; background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: var(--card-shadow); cursor: pointer; transition: transform 0.12s ease;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary);">auto_stories</span>
        <h4 style="font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); margin: 0;">Reading nook</h4>
        <span style="font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: var(--primary); color: var(--on-primary);">Reader Plugin</span>
      </div>
      <div style="display: flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 9999px; background: var(--secondary-container); color: var(--secondary); border: 1px solid var(--border);">
        <span class="material-symbols-outlined" style="font-size: 14px;">bookmark</span>
        <span id="readerChapterText">Chapter 4</span>
      </div>
    </div>
    <div style="padding: 14px; border-radius: 1.25rem; display: flex; flex-direction: column; gap: 12px; background: var(--surface-container); border: 1px solid var(--border);">
      <div style="display: flex; align-items: start; justify-content: space-between; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 48px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--text); flex-shrink: 0; background: var(--surface-container-highest); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);">
            <span class="material-symbols-outlined" style="font-size: 24px;">menu_book</span>
          </div>
          <div>
            <h5 id="readerBookTitle" style="font-weight: 700; font-size: 14px; color: var(--text); margin: 0;">Quiet: The Power of Introverts</h5>
            <p id="readerBookMeta" style="font-size: 12px; margin-top: 2px; color: var(--text-inactive); margin-bottom: 0;">Susan Cain · p. 142 of 220</p>
          </div>
        </div>
        <button aria-label="Resume reading" onclick="openReaderOrPlugin();event.stopPropagation()" style="width: 36px; height: 36px; border-radius: 9999px; color: var(--on-primary); display: flex; align-items: center; justify-content: center; background: var(--primary); box-shadow: 0 4px 14px rgba(46, 125, 106, 0.35); border: none; cursor: pointer; transition: transform 0.1s ease;">
          <span class="material-symbols-outlined" style="font-size: 20px;">play_arrow</span>
        </button>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 12px; font-weight: 500;">
          <span style="color: var(--text-inactive);">Book progress</span>
          <span id="readerProgressPct" style="font-weight: 700; color: var(--secondary);">64% read</span>
        </div>
        <div style="width: 100%; height: 8px; border-radius: 9999px; overflow: hidden; background: var(--divider);">
          <div id="readerProgressBar" style="height: 100%; border-radius: 9999px; width: 64%; background: linear-gradient(90deg, var(--primary), var(--accent2)); box-shadow: 0 0 8px rgba(46, 125, 106, 0.3);"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dynamic installed plugin widgets area -->
  <div id="pluginWidgetsArea" style="display: flex; flex-direction: column; gap: 12px; width: 100%;"></div>
</div>

<!-- Ultra-Rounded Floating Dock Bottom Nav (5 Tabs) -->
<nav id="bottomNav" style="position: fixed; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); left: 0; right: 0; z-index: 250; padding: 0 10px; max-width: 440px; margin: 0 auto; box-sizing: border-box; pointer-events: none;">
  <div id="bottomNavDock" style="backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); padding: 5px 6px; border-radius: 9999px; display: flex; align-items: center; justify-content: space-between; pointer-events: auto; background-color: var(--nav-dock-bg); border: 1px solid var(--nav-dock-border); box-shadow: var(--nav-dock-shadow); transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;">
    <!-- Tab 1: Dashboard (Active initially) -->
    <a id="navTabHome" class="bottom-nav-item active" data-tab="home" href="#" onclick="switchTab('home');return false">
      <span class="material-symbols-outlined" style="font-size: 19px; line-height: 1;">spa</span>
      <span>Dashboard</span>
    </a>
    <!-- Tab 2: Tool Kit (All plugins page) -->
    <a id="navTabToolkit" class="bottom-nav-item" data-tab="toolkit" href="#" onclick="switchTab('toolkit');return false" title="Tool Kit">
      <span class="material-symbols-outlined" style="font-size: 20px; line-height: 1;">extension</span>
    </a>
    <!-- Tab 3: Journal -->
    <a id="navTabJournal" class="bottom-nav-item" data-tab="journal" href="#" onclick="switchTab('journal');return false" title="Journal">
      <span class="material-symbols-outlined" style="font-size: 20px; line-height: 1;">edit_note</span>
    </a>
    <!-- Tab 4: Tracker (Log of data) -->
    <a id="navTabTracker" class="bottom-nav-item" data-tab="tracker" href="#" onclick="switchTab('tracker');return false" title="Tracker">
      <span class="material-symbols-outlined" style="font-size: 20px; line-height: 1;">insights</span>
    </a>
    <!-- Tab 5: Profile (+setting) -->
    <a id="navTabProfile" class="bottom-nav-item" data-tab="profile" href="#" onclick="switchTab('profile');return false" title="Profile">
      <span class="material-symbols-outlined" style="font-size: 20px; line-height: 1;">person</span>
    </a>
  </div>
</nav>

<button class="fab" id="mainFab" onclick="handleFabClick()" aria-label="Command Menu" style="display: none; position: fixed; bottom: 84px; right: 20px; width: 48px; height: 48px; border-radius: 9999px; background: #2E7D6A; color: #FFFFFF; border: none; box-shadow: 0 4px 16px rgba(46,125,106,0.35); align-items: center; justify-content: center; z-index: 45; cursor: pointer;">
  <span class="material-symbols-outlined" style="font-size: 22px;">bolt</span>
</button>

<div class="page-overlay" id="gitaPage">
  <div class="page-header" style="padding:12px 16px;border-bottom:1px solid var(--border);margin-bottom:0">
    <div style="display:flex;align-items:center;gap:8px">
      <img src="v07_logo.png" onclick="goToHome()" style="width:24px;height:24px;border-radius:6px;object-fit:contain;cursor:pointer" alt="Home">
      <h2>READ</h2>
    </div>
    <div style="display:flex;align-items:center;gap:12px">
      <div onclick="openGitaSidebar()" style="display:flex;flex-direction:column;gap:5px;cursor:pointer;padding:8px">
      <div style="width:20px;height:2px;background:var(--primary);border-radius:1px"></div>
      <div style="width:20px;height:2px;background:var(--primary);border-radius:1px"></div>
    </div>
  </div>
  </div>
  <div class="gita-reading" id="gitaReadingArea" style="flex:1;overflow-y:auto;padding-bottom:60px">
    <div style="max-width:560px;margin:0 auto;padding:40px 24px">
      <div class="gita-section" id="gitaMetaSection" style="text-align:center;margin-bottom:40px">
        <div id="gitaChapterLabel" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text);text-transform:uppercase;letter-spacing:0.3em;margin-bottom:6px"></div>
        <div id="gitaVerseCounter" style="font-family:'JetBrains Mono','Mono',monospace;font-size:10px;color:var(--primary);text-transform:uppercase;letter-spacing:0.2em"></div>
      </div>
      <div class="gita-divider gita-section" id="gitaDivider1"></div>
      <div class="gita-section" id="gitaShlokaSection" style="text-align:center;margin:40px 0">
        <div id="gitaPageShloka" style="font-family:'Marcellus','Georgia',serif;font-size:22px;line-height:2;color:var(--text);font-weight:500"></div>
      </div>
      <div class="gita-divider gita-section" id="gitaDivider2"></div>
      <div class="gita-section" id="gitaTransSection" style="margin:40px 0">
        <p id="gitaPageTrans" style="font-family:'General Sans','sans-serif';font-style:italic;font-size:15px;line-height:1.8;color:var(--text-inactive);text-align:center"></p>
      </div>
      <div class="gita-section" id="gitaHindiTransSection" style="margin:40px 0;display:none">
        <div style="font-family:'Space Mono','Mono',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.2em;margin-bottom:12px;text-align:center">Hindi Translation</div>
        <p id="gitaPageHindiTrans" style="font-family:'General Sans','sans-serif';font-size:14px;line-height:1.8;color:var(--text-inactive);text-align:center"></p>
      </div>
      <div class="gita-section" id="gitaHindiCommSection" style="margin:40px 0;display:none">
        <div style="font-family:'Space Mono','Mono',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.2em;margin-bottom:12px;text-align:center">Hindi Commentary</div>
        <p id="gitaPageHindiComm" style="font-family:'General Sans','sans-serif';font-size:14px;line-height:1.8;color:var(--text-inactive);text-align:center"></p>
      </div>
      <div class="gita-section" id="gitaGambSection" style="margin:40px 0;display:none">
        <div style="font-family:'Space Mono','Mono',monospace;font-size:10px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.2em;margin-bottom:12px;text-align:center">Gambirananda</div>
        <p id="gitaPageGamb" style="font-family:'General Sans','sans-serif';font-size:14px;line-height:1.8;color:var(--text-inactive);text-align:center"></p>
      </div>
      <div class="gita-divider gita-section" id="gitaDivider3"></div>
      <div id="gitaVerseThoughts" style="margin:40px 0"></div>
      <div id="gitaThoughtInput" style="display:none;margin:40px 0">
        <textarea id="gitaThoughtText" style="width:100%;padding:12px;background:var(--surface-container-low);border:1px solid var(--border);color:var(--text);font-size:14px;min-height:80px;resize:vertical;font-family:'JetBrains Mono','Mono',monospace;outline:none" placeholder="Your thoughts on this verse..."></textarea>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:10px">
          <button onclick="submitGitaThought()" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text);text-transform:uppercase;letter-spacing:0.15em;padding:8px 20px;border:1px solid var(--secondary);background:transparent;cursor:pointer;transition:all 0.2s">SAVE</button>
          <button onclick="closeGitaThoughtInput()" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em;padding:8px 20px;border:1px solid var(--border);background:transparent;cursor:pointer;transition:all 0.2s">CANCEL</button>
        </div>
      </div>
      <div id="gitaActionsSection" style="display:flex;gap:12px;justify-content:center;margin:40px 0">
        <button onclick="toggleGitaThoughtInput()" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em;padding:8px 20px;border:1px solid var(--border);background:transparent;cursor:pointer;transition:all 0.2s">ADD THOUGHT</button>
        <button onclick="toggleGitaRead()" id="gitaPageReadBtn" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--primary);text-transform:uppercase;letter-spacing:0.15em;padding:8px 20px;border:1px solid var(--primary);background:transparent;cursor:pointer;transition:all 0.2s">MARK READ</button>
      </div>
    </div>
  </div>
  <div style="position:fixed;bottom:0;left:0;right:0;padding:14px 24px;display:flex;justify-content:space-between;align-items:center;background:var(--bg);border-top:1px solid var(--border);z-index:10">
    <a onclick="navGita('prev')" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em;cursor:pointer;transition:color 0.15s">[ PREV ]</a>
    <a onclick="navGita('next')" style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.15em;cursor:pointer;transition:color 0.15s">[ NEXT ]</a>
  </div>
  <div id="gitaProgressDots" style="position:fixed;right:12px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:8px;z-index:10"></div>
  <div id="gitaPageProgress" style="display:none"></div>
</div>

<div class="page-overlay" id="databasePage">
  <div class="page-header">
    <div style="display:flex;align-items:center;gap:8px">
      <img src="v07_logo.png" onclick="goToHome()" style="width:24px;height:24px;border-radius:6px;object-fit:contain;cursor:pointer" alt="Home">
      <h2>ACTIVITY RECORDS</h2>
    </div>
  </div>
  <!-- Last N Days Dropdown -->
  <div style="padding:8px 0 10px;border-bottom:1px solid var(--border);background:var(--surface);margin-bottom:0">
    <div style="display:flex;align-items:center;justify-content:space-between;border:1px solid var(--border);padding:6px 10px;background:var(--bg)">
      <div style="display:flex;align-items:center;gap:10px;flex:1">
        <span class="material-symbols-outlined" style="font-size:14px;color:var(--accent-orange)">calendar_today</span>
        <select id="dbDays" onchange="changeDbDays()" style="background:transparent;border:none;color:var(--text);font-size:13px;outline:none;font-family:'JetBrains Mono','Mono',monospace;text-transform:uppercase;cursor:pointer">
          <option value="7">Last 7 Days</option>
          <option value="14">Last 14 Days</option>
          <option value="30" selected>Last 30 Days</option>
          <option value="60">Last 60 Days</option>
          <option value="90">Last 90 Days</option>
          <option value="365">Last 1 Year</option>
          <option value="0">All Time</option>
        </select>
      </div>
    </div>
  </div>
  <!-- Tactical Filter Bar -->
  <div id="databaseFilters" style="display:flex;gap:6px;padding:10px 0;overflow-x:auto;border-bottom:1px solid var(--border);-ms-overflow-style:none;scrollbar-width:none"></div>
  <!-- Table -->
  <div style="overflow-x:auto;padding-top:8px">
    <div id="databaseContent">
      <div style="color:var(--text-inactive);font-size:14px;text-align:center;padding:20px;">Loading...</div>
    </div>
  </div>
</div>

<div id="dbEventDetailOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;justify-content:center;align-items:center;padding:16px" onclick="if(event.target===this)closeDbEventDetail()">
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;max-width:600px;width:100%;max-height:80vh;display:flex;flex-direction:column">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border)">
      <span style="font-family:'Space Mono','Mono',monospace;font-size:11px;color:var(--text-inactive);text-transform:uppercase;letter-spacing:0.1em">EVENT DETAIL</span>
      <div style="display:flex;gap:8px;align-items:center">
        <button onclick="deleteDbEvent()" style="background:none;border:1px solid var(--accent-red);color:var(--accent-red);font-family:'Space Mono','Mono',monospace;font-size:10px;padding:4px 10px;cursor:pointer;text-transform:uppercase;letter-spacing:0.05em;border-radius:4px">Delete</button>
        <span onclick="closeDbEventDetail()" style="cursor:pointer;color:var(--text-inactive);font-size:18px;line-height:1">&times;</span>
      </div>
    </div>
    <div id="dbEventDetailContent" style="padding:16px;overflow-y:auto;flex:1">
    </div>
  </div>
</div>

<div class="page-overlay" id="vaultPage">
  <div class="page-header">
    <div style="display:flex;align-items:center;gap:8px">
