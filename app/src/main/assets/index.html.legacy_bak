<div class="modal-overlay" id="pluginSettingsModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:200;align-items:center;justify-content:center;padding:16px;box-sizing:border-box">
  <div class="modal" style="max-width:440px;width:100%;max-height:85vh;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;box-sizing:border-box;display:flex;flex-direction:column;gap:14px">
