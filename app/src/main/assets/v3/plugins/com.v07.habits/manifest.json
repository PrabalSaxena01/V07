{
  "$schema": "https://v07.app/schemas/v3/plugin-manifest.json",
  "id": "com.v07.habits",
  "name": "Habits Matrix",
  "version": "3.0.0",
  "apiVersion": "3.0",
  "description": "Daily recurring consistency checklist and streak tracker on a calendar heatmap.",
  "publisher": {
    "name": "V07 Core Team",
    "url": "https://v07.app"
  },
  "permissions": [
    "storage:isolated",
    "events:listen",
    "events:emit",
    "notifications:schedule"
  ],
  "capabilities": [
    "ui:widget",
    "ui:kitTile",
    "ui:page"
  ],
  "dependencies": {
    "v07-platform": ">=3.0.0"
  },
  "extensionPoints": {
    "widgets": [
      {
        "id": "habits_matrix_card",
        "title": "HABITS MATRIX",
        "entry": "widget.html",
        "icon": "local_fire_department",
        "color": "#FFB454",
        "supportedSizes": [
          "compact",
          "small",
          "medium",
          "large"
        ],
        "defaultSize": "medium"
      }
    ],
    "kitTile": {
      "label": "HABITS",
      "icon": "local_fire_department",
      "color": "#FFB454"
    },
    "page": {
      "entry": "index.html",
      "title": "Habits Matrix"
    },
    "settings": {
      "entry": "settings.html",
      "schema": "settings.schema.json"
    }
  },
  "entry": "index.html",
  "settings": "settings.html",
  "nav": {
    "icon": "local_fire_department",
    "label": "HABITS",
    "color": "#FFB454"
  },
  "widgets": [
    {
      "id": "habits_matrix_card",
      "title": "HABITS MATRIX",
      "path": "widget.html",
      "entry": "widget.html",
      "icon": "local_fire_department",
      "color": "#FFB454",
      "supportedSizes": [
        "compact",
        "small",
        "medium",
        "large"
      ],
      "defaultSize": "medium"
    }
  ],
  "config": {
    "dailyReminderTime": {
      "type": "string",
      "format": "time",
      "default": "21:00",
      "description": "Daily notification time to complete habits"
    }
  }
}