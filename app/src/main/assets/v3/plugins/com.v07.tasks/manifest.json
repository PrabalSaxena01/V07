{
  "$schema": "https://v07.app/schemas/v3/plugin-manifest.json",
  "id": "com.v07.tasks",
  "name": "Sovereign Tasks",
  "version": "3.0.0",
  "apiVersion": "3.0",
  "description": "Priority queue, tag filtering, deadlines, and unhurried daily step checklists.",
  "publisher": {
    "name": "V07 Core Team",
    "url": "https://v07.app"
  },
  "permissions": [
    "storage:isolated",
    "events:listen",
    "events:emit",
    "notifications:schedule"
  ],
  "capabilities": [
    "ui:widget",
    "ui:kitTile",
    "ui:page"
  ],
  "dependencies": {
    "v07-platform": ">=3.0.0"
  },
  "extensionPoints": {
    "widgets": [
      {
        "id": "tasks_today",
        "title": "TASKS & DIRECTIVES",
        "entry": "widget.html",
        "icon": "checklist",
        "color": "#5CE1E6",
        "supportedSizes": [
          "compact",
          "small",
          "medium",
          "large"
        ],
        "defaultSize": "medium"
      }
    ],
    "kitTile": {
      "label": "TASKS",
      "icon": "checklist",
      "color": "#5CE1E6"
    },
    "page": {
      "entry": "index.html",
      "title": "Sovereign Tasks"
    },
    "settings": {
      "entry": "settings.html"
    }
  },
  "entry": "index.html",
  "settings": "settings.html",
  "nav": {
    "icon": "checklist",
    "label": "TASKS",
    "color": "#5CE1E6"
  },
  "widgets": [
    {
      "id": "tasks_today",
      "title": "TASKS & DIRECTIVES",
      "path": "widget.html",
      "entry": "widget.html",
      "icon": "checklist",
      "color": "#5CE1E6",
      "supportedSizes": [
        "compact",
        "small",
        "medium",
        "large"
      ],
      "defaultSize": "medium"
    }
  ]
}