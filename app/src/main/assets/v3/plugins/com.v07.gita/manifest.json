{
  "$schema": "https://v07.app/schemas/v3/plugin-manifest.json",
  "id": "com.v07.gita",
  "name": "Gita Wisdom",
  "version": "3.0.0",
  "apiVersion": "3.0",
  "description": "Contemplative verses and philosophical clarity for daily life. 700+ verses with search, reflections, and study tracking.",
  "publisher": {
    "name": "V07 Core Team",
    "url": "https://v07.app"
  },
  "permissions": [
    "storage:isolated",
    "events:listen",
    "events:emit"
  ],
  "capabilities": [
    "ui:widget",
    "ui:kitTile",
    "ui:page"
  ],
  "dependencies": {
    "v07-platform": ">=3.0.0"
  },
  "extensionPoints": {
    "widgets": [
      {
        "id": "gita_daily_verse",
        "title": "DAILY GITA CONTEMPLATION",
        "entry": "widget.html",
        "icon": "auto_stories",
        "color": "#FF9F43",
        "supportedSizes": [
          "small",
          "medium"
        ],
        "defaultSize": "medium"
      }
    ],
    "kitTile": {
      "label": "GITA",
      "icon": "auto_stories",
      "color": "#FF9F43"
    },
    "page": {
      "entry": "index.html",
      "title": "Gita Wisdom"
    },
    "settings": {
      "entry": "settings.html"
    }
  },
  "entry": "index.html",
  "settings": "settings.html",
  "nav": {
    "icon": "auto_stories",
    "label": "GITA",
    "color": "#FF9F43"
  },
  "widgets": [
    {
      "id": "gita_daily_verse",
      "title": "DAILY GITA CONTEMPLATION",
      "path": "widget.html",
      "entry": "widget.html",
      "icon": "auto_stories",
      "color": "#FF9F43",
      "supportedSizes": [
        "small",
        "medium"
      ],
      "defaultSize": "medium"
    }
  ]
}