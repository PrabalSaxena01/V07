  "nav": {
    "placement": "kit",
    "icon": "directions_run",
    "label": "RUNNING",
    "color": "#10B981"
  },
  "widgets": [
    {
      "id": "running_weekly_stats",
      "title": "WEEKLY RUNNING DISTANCE",
      "icon": "directions_run",
      "path": "widget.html",
      "color": "#10B981",
      "supportedSizes": ["small", "medium"],
      "defaultSize": "medium"
    }
  ]
}
