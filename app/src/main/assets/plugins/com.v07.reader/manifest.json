{
  "$schema": "https://v07.app/schemas/v3/plugin-manifest.json",
  "id": "com.v07.reader",
  "name": "Reading Companion",
  "version": "3.0.0",
  "apiVersion": "3.0",
  "description": "Book collection and reading tracker. Manage library shelves, log pacing, and track reading milestones.",
  "publisher": {
    "name": "V07 Core Team",
    "url": "https://v07.app"
  },
  "permissions": [
    "storage:isolated",
    "events:listen",
    "events:emit",
    "notifications:schedule"
  ],
  "capabilities": [
    "ui:widget",
    "ui:kitTile",
    "ui:page"
  ],
  "dependencies": {
    "v07-platform": ">=3.0.0"
  },
  "extensionPoints": {
    "widgets": [
      {
        "id": "reader_active",
        "title": "READING TRACKER",
        "entry": "widget.html",
        "icon": "auto_stories",
        "color": "#8D6CFF",
        "supportedSizes": [
          "compact",
          "small",
          "medium",
          "large"
        ],
        "defaultSize": "medium"
      }
    ],
    "kitTile": {
      "label": "READING",
      "icon": "auto_stories",
      "color": "#8D6CFF"
    },
    "page": {
      "entry": "index.html",
      "title": "Reading Companion"
    },
    "settings": {
      "entry": "settings.html"
    }
  },
  "entry": "index.html",
  "settings": "settings.html",
  "nav": {
    "icon": "auto_stories",
    "label": "READING",
    "color": "#8D6CFF"
  },
  "widgets": [
    {
      "id": "reader_active",
      "title": "READING TRACKER",
      "path": "widget.html",
      "entry": "widget.html",
      "icon": "auto_stories",
      "color": "#8D6CFF",
      "supportedSizes": [
        "compact",
        "small",
        "medium",
        "large"
      ],
      "defaultSize": "medium"
    }
  ]
}