{
  "$schema": "https://v07.app/schemas/v3/plugin-manifest.json",
  "id": "com.v07.gamify",
  "name": "Gamify Quests",
  "version": "3.0.0",
  "apiVersion": "3.0",
  "description": "Earn XP for conscious daily focus and logging. Track levels, unlock mastery badges, and build streaks.",
  "publisher": {
    "name": "V07 Core Team",
    "url": "https://v07.app"
  },
  "permissions": [
    "storage:isolated",
    "events:listen",
    "events:emit",
    "notifications:schedule"
  ],
  "capabilities": [
    "ui:widget",
    "ui:kitTile",
    "ui:page"
  ],
  "dependencies": {
    "v07-platform": ">=3.0.0"
  },
  "extensionPoints": {
    "widgets": [
      {
        "id": "gamify_stats",
        "title": "GAMIFY PROGRESS",
        "entry": "widget.html",
        "icon": "military_tech",
        "color": "#4DE086",
        "supportedSizes": [
          "compact",
          "small",
          "medium",
          "large"
        ],
        "defaultSize": "medium"
      }
    ],
    "kitTile": {
      "label": "GAMIFY",
      "icon": "military_tech",
      "color": "#4DE086"
    },
    "page": {
      "entry": "index.html",
      "title": "Gamify Quests"
    },
    "settings": {
      "entry": "settings.html"
    }
  },
  "entry": "index.html",
  "settings": "settings.html",
  "nav": {
    "icon": "military_tech",
    "label": "GAMIFY",
    "color": "#4DE086"
  },
  "widgets": [
    {
      "id": "gamify_stats",
      "title": "GAMIFY PROGRESS",
      "path": "widget.html",
      "entry": "widget.html",
      "icon": "military_tech",
      "color": "#4DE086",
      "supportedSizes": [
        "compact",
        "small",
        "medium",
        "large"
      ],
      "defaultSize": "medium"
    }
  ]
}