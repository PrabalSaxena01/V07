<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v3_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/v3_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar: Title & Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="V07 FOCUS"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_v3_focus_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/v3_widget_pill_slate"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="IDLE"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Information: Topic & Large Timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_v3_focus_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Ready to focus"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_v3_focus_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            android:text="00:00"
            android:textColor="#F8FAFC"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Controls: Interactive Homescreen Action Buttons -->
    <LinearLayout
        android:id="@+id/layout_v3_focus_controls_running"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_v3_focus_pause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/v3_widget_btn_secondary"
            android:text="Pause"
            android:textAllCaps="false"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_v3_focus_stop"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/v3_widget_btn_danger"
            android:text="Finish"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_v3_focus_controls_paused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_v3_focus_resume"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/v3_widget_btn_primary"
            android:text="Resume"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_v3_focus_stop_paused"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/v3_widget_btn_danger"
            android:text="Finish"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_v3_focus_controls_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="visible">

        <Button
            android:id="@+id/btn_v3_focus_start_25"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/v3_widget_btn_primary"
            android:text="25m Focus"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_v3_focus_start_stopwatch"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/v3_widget_btn_secondary"
            android:text="Stopwatch"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
