<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v3_thought_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/v3_thought_card"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/v3_overlay_card_bg"
        android:elevation="18dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="💭"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK THOUGHT"
                    android:textColor="#8D6CFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capture Reflection"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/v3_thought_close_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#88FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Input Field -->
        <EditText
            android:id="@+id/v3_thought_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp"
            android:maxHeight="160dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/v3_overlay_input_bg"
            android:gravity="top|start"
            android:hint="Type a quick observation, note, or parking thought..."
            android:textColorHint="#5A6270"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:scrollbars="vertical"
            android:inputType="textMultiLine|textCapSentences" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/v3_thought_cancel_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Dismiss"
                android:textColor="#8E95A2"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/v3_overlay_item_bg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/v3_thought_save_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Record Thought"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:background="@drawable/v3_overlay_primary_btn_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
