<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_actions_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000">

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/overlay_card_bg"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#1A191C21">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="// QUICK_ACTIONS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#A7C8FF"
                android:fontFamily="monospace"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/btn_close_quick"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="\u2715"
                android:textSize="10sp"
                android:textColor="#717171"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/btn_think"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="  > THINK"
                android:textSize="13sp"
                android:textColor="#C1C6D4"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/overlay_action_row_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="2dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Think" />

            <TextView
                android:id="@+id/btn_share"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="  &lt; SHARE"
                android:textSize="13sp"
                android:textColor="#C1C6D4"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/overlay_action_row_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="2dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Share" />

            <TextView
                android:id="@+id/btn_checklist"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="  # CHECKLIST"
                android:textSize="13sp"
                android:textColor="#C1C6D4"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/overlay_action_row_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Checklist" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
