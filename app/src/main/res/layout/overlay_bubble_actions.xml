<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_actions_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="6dp">

    <!-- THINK -->
    <LinearLayout
        android:id="@+id/ba_think"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/overlay_bubble_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#x2726;"
                android:textSize="18sp"
                android:textColor="#8D6CFF"
                android:fontFamily="sans-serif" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="THINK"
            android:textSize="8sp"
            android:textColor="#C1C6D4"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- SHARE -->
    <LinearLayout
        android:id="@+id/ba_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/overlay_bubble_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#x2398;"
                android:textSize="18sp"
                android:textColor="#4DE086"
                android:fontFamily="sans-serif" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="SHARE"
            android:textSize="8sp"
            android:textColor="#C1C6D4"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- CHK_LIST -->
    <LinearLayout
        android:id="@+id/ba_checklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/overlay_bubble_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#x2713;"
                android:textSize="18sp"
                android:textColor="#F4D35E"
                android:fontFamily="sans-serif" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="CHK_LIST"
            android:textSize="8sp"
            android:textColor="#C1C6D4"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- OFF / DISABLE -->
    <LinearLayout
        android:id="@+id/ba_off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/overlay_bubble_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#x23FB;"
                android:textSize="18sp"
                android:textColor="#FF5C5C"
                android:fontFamily="sans-serif" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="OFF"
            android:textSize="8sp"
            android:textColor="#FF5C5C"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Close (X) -->
    <LinearLayout
        android:id="@+id/ba_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/overlay_bubble_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#x2715;"
                android:textSize="14sp"
                android:textColor="#C1C6D4"
                android:fontFamily="sans-serif" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CLOSE"
            android:textSize="7sp"
            android:textColor="#717171"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
